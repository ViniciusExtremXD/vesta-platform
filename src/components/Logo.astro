---
/**
 * The owner's logo (ROUND3 §Brand), rendered from his artwork — never
 * redrawn, never stretched.
 *
 *   <Logo />                   the lockup: violet V, orbit ring, star, VESTA
 *   <Logo mark />              the symbol alone (compact spots)
 *   <Logo height={44} />       rendered height in CSS px (width follows)
 *
 * The artwork is WHITE + violet on transparent: it only works on dark
 * surfaces (void / night / plate). The nav therefore stays dark everywhere.
 *
 * astro:assets turns the PNG into WebP at 1× and 2× the rendered size, with
 * explicit width/height (no layout shift). CSS may shrink the height at a
 * breakpoint; keep `width: auto` so the ratio holds.
 */
import { Image } from 'astro:assets';
import lockup from '../assets/brand/vesta-logo.png';
import symbol from '../assets/brand/vesta-mark.png';

export interface Props {
  class?: string;
  /** The symbol only, instead of the lockup. */
  mark?: boolean;
  /** Rendered height in px. */
  height?: number;
  /** Above the fold (the nav): load eagerly, high priority. */
  eager?: boolean;
  /** Empty when a parent already names the link ("Vesta, home"). */
  alt?: string;
}

const { class: cls = '', mark = false, height = 36, eager = false, alt = 'Vesta' } = Astro.props;
const src = mark ? symbol : lockup;
const width = Math.round((height * src.width) / src.height);
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  densities={[1, 2]}
  format="webp"
  quality={90}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  draggable="false"
  class:list={['brand-logo', mark ? 'is-mark' : 'is-lockup', cls]}
/>

<style>
  .brand-logo {
    display: block;
    flex: 0 0 auto;
    max-width: none;
    width: auto;
    user-select: none;
  }
</style>
