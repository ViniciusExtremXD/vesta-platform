---
/**
 * Concept 05 BEFORE — Ironbark Strength Club (fictional) on a loud late-2000s
 * gym template, last touched in 2016. Dated and poor, not a parody: a diamond-
 * plate wallpaper, a black-to-red header with flame clip art and a yellow
 * Impact logo with a drop shadow, red gel tab buttons, a purple "Flash"
 * banner with a low-res stock photo, "NO PAIN, NO GAIN!!!", a Comic Sans
 * welcome, a bevelled neon "Join Now!" that blinks, a photo gallery that is
 * still placeholder boxes, the class schedule posted as a screenshot, the
 * price list as an image, three boxes that do not line up, a visitor
 * counter, an "under construction" note, and the phone number only in a
 * 6px footer. Mixed Impact / Verdana / Comic Sans / Arial Black. Every text
 * pair passes AA on its own fill (on gradients, against every stop that sits
 * behind the text; the element's background-color is the stop the gate reads).
 * Rendered by ConceptPlate.astro through the registry; sizes use --u (one
 * reference px of the 760-wide drawing). Renders twice in hero mode: no ids.
 */
import { fitness, fitnessPlate as P } from '../../../data/concepts/fitness';

export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const B = fitness.before;

/* drawing-only strings (the dated site's own clutter) */
const F = {
  follow: 'Follow Ironbark:',
  viewed: 'Best viewed at 1024 x 768',
  navExtra: ['Gallery', 'Links'],
  slogan: 'No Pain, No Gain!!!',
  welcome: 'Welcome to Ironbark Strength Club!!!',
  burst: 'Open 7 Days!',
  gallery: 'Photo Gallery',
  galleryLink: 'View all photos »',
  skip: 'Skip intro »',
  visitor: 'You are visitor #',
  counter: '018473',
  construction: 'Online sign-up coming soon!',
  guestbook: 'Sign the Guestbook!',
  updated: 'Last updated: 06/12/2016',
  rights: '© 2016',
  rightsTail: 'All Rights Reserved · Site Map',
};

/* the screenshot of a spreadsheet timetable: 7 columns × 6 rows of cells,
   a few of them coloured the way a gym owner colours a class */
const cells: [number, number, string][] = [
  [0, 0, '#39FF14'], [2, 0, '#39FF14'], [4, 0, '#39FF14'], [1, 1, '#FF7AC6'], [3, 1, '#FF7AC6'],
  [0, 2, '#6EC1FF'], [5, 2, '#39FF14'], [2, 3, '#FFD84D'], [4, 3, '#6EC1FF'], [1, 4, '#39FF14'],
  [3, 4, '#39FF14'], [6, 4, '#FF7AC6'], [0, 5, '#FFD84D'], [5, 5, '#6EC1FF'],
];

/* low-res stock photo: a lifter squatting, 24 × 16 pixels, drawn as runs */
const pal: Record<string, string> = {
  d: '#231A2E', w: '#3D3346', l: '#5A4D63', s: '#C89070', S: '#8A5A40', r: '#B02020',
  b: '#1A1A1A', m: '#A0A0A0', p: '#0E0E0E', f: '#4A4040', k: '#111111',
};
const lifter = [
  'dddddddddddddddddddddddd',
  'dddwwwwwwwwllllwwwwwwddd',
  'dpppwwwwwwwsSswwwwwpppdd',
  'dpppwwwwwwwssswwwwwpppdd',
  'dpppmmmmmmmmmmmmmmmpppdd',
  'dpppwwwSrrrrrrrrSwwpppdd',
  'dpppwwwwrrrrrrrrwwwpppdd',
  'ddwwwwwwwrrrrrrwwwwwwddd',
  'ddwwwwwwwrrrrrrwwwwwwddd',
  'ddwwwwwwbbbbbbbbwwwwwddd',
  'ddwwwwwbbbbbbbbbbwwwwddd',
  'ddwwwwssswwwwwwsssswwddd',
  'ddwwwwwSSwwwwwwSSwwwwddd',
  'ddwwwwwSSwwwwwwSSwwwwddd',
  'ffffffkkkfffffffkkkfffff',
  'ffffffffffffffffffffffff',
];
const px = lifter.flatMap((row, y) => {
  const out: { x: number; y: number; w: number; f: string }[] = [];
  let x = 0;
  while (x < row.length) {
    let w = 1;
    while (row[x + w] === row[x]) w++;
    out.push({ x, y, w, f: pal[row[x]] });
    x += w;
  }
  return out;
});

/* header flames: tips every 24 units, taller to the right of the logo */
const flame = (scale: number) => {
  let d = 'M0 26V21';
  for (let i = 0; i < 32; i++) {
    const x = i * 24;
    const h = (x < 250 ? 5 + (i % 3) * 2 : 12 + ((i * 7) % 5) * 2.4) * scale;
    const tip = 26 - h;
    d += `Q${x + 7} ${tip + 7} ${x + 11} ${tip}Q${x + 16} ${tip + 9} ${x + 24} 21`;
  }
  return d + 'V26Z';
};

/* starburst: 16 spikes on an ellipse (viewBox 100 × 64) */
const burst = Array.from({ length: 32 }, (_, i) => {
  const a = (i / 32) * Math.PI * 2;
  const r = i % 2 ? 0.76 : 1;
  return `${(50 + Math.cos(a) * 49 * r).toFixed(1)},${(32 + Math.sin(a) * 31 * r).toFixed(1)}`;
}).join(' ');
---

<div class:list={['b-site', 'b-fit', cls]} aria-hidden="true">
  <div class="b-top">
    <span>{B.topBar}</span>
    <span class="b-follow">{F.follow}<i></i><i></i><i></i></span>
    <span>{F.viewed}</span>
  </div>

  <div class="b-head">
    <svg class="b-flames" viewBox="0 0 760 26" preserveAspectRatio="none" aria-hidden="true">
      <path d={flame(1)} fill="#E8500A"></path>
      <path d={flame(0.55)} fill="#FFB400"></path>
    </svg>
    <svg class="b-bell" viewBox="0 0 50 24" aria-hidden="true">
      <path d="M8 10h34v4H8Z" fill="#C8C8C8"></path>
      <path d="M3 2h7v20H3ZM40 2h7v20h-7Z" fill="#4A4A4A"></path>
      <path d="M10 5h4v14h-4ZM36 5h4v14h-4Z" fill="#8C8C8C"></path>
      <path d="M4 3h2v18H4ZM41 3h2v18h-2ZM9 10.5h33v1H9Z" fill="#EDEDED"></path>
    </svg>
    <span class="b-logo">
      <span class="b-logo-a">{B.logo}</span>
      <span class="b-logo-b">{P.beforeTagline}</span>
    </span>
    <span class="b-burst">
      <svg viewBox="0 0 100 64" preserveAspectRatio="none" aria-hidden="true">
        <polygon points={burst} fill="#FFE000" stroke="#B00000" stroke-width="1.4"></polygon>
      </svg>
      <span class="b-burst-t">{F.burst}</span>
    </span>
  </div>

  <div class="b-nav">
    {[...B.nav, ...F.navExtra].map((l, i) => <span class:list={['b-gel', i === 0 && 'is-on']}>{l}</span>)}
  </div>

  <div class="b-hero">
    <span class="b-shot">
      <svg viewBox="0 0 24 16" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
        {px.map((p) => <rect x={p.x} y={p.y} width={p.w + 0.05} height="1.05" fill={p.f} />)}
      </svg>
    </span>
    <div class="b-cap">
      <span class="b-slogan">{F.slogan}</span>
      <span class="b-welcome">{F.welcome}</span>
      <span class="b-join"><i class="b-ring"></i>{B.heroButton}</span>
    </div>
    <div class="b-gal">
      <span class="b-gal-t">{F.gallery}</span>
      <span class="b-thumbs">
        {
          [0, 1, 2].map(() => (
            <svg viewBox="0 0 60 48" aria-hidden="true">
              <rect width="60" height="48" fill="#BDBDBD"></rect>
              <circle cx="43" cy="14" r="6" fill="#EFEFEF"></circle>
              <path d="M4 42 20 20l10 12 7-8 19 18Z" fill="#8E8E8E"></path>
            </svg>
          ))
        }
      </span>
      <span class="b-gal-l">{F.galleryLink}</span>
    </div>
    <span class="b-dots"><i class="is-on"></i><i></i><i></i><i></i><i></i></span>
    <span class="b-skip">{F.skip}</span>
  </div>

  <!-- three boxes that never quite line up, and a sidebar -->
  <div class="b-box b-box--1">
    <span class="b-bh b-bh--silver">{B.boxes[0]}</span>
    <svg class="b-img" viewBox="0 0 206 88" preserveAspectRatio="none" aria-hidden="true">
      <rect width="206" height="88" fill="#F2F2F2"></rect>
      <rect width="206" height="11" fill="#3B3B3B"></rect>
      {cells.map(([c, r, f]) => <rect x={20 + c * 26.6} y={11 + r * 12.8} width="26.6" height="12.8" fill={f} fill-opacity=".72" />)}
      <path
        d="M20 0V88M46.6 0V88M73.2 0V88M99.8 0V88M126.4 0V88M153 0V88M179.6 0V88M0 11H206M0 23.8H206M0 36.6H206M0 49.4H206M0 62.2H206M0 75H206"
        stroke="#A8A8A8"
        stroke-width=".8"></path>
      <g fill="#8C8C8C">
        {[0, 1, 2, 3, 4, 5].map((r) => <rect x="4" y={16 + r * 12.8} width="12" height="3" />)}
        {[0, 1, 2, 3, 4, 5, 6].map((c) => <rect x={25 + c * 26.6} y="4" width="16" height="3" fill="#CFCFCF" />)}
      </g>
    </svg>
    <span class="b-small">{P.beforeUpdated} · {P.beforeShot}</span>
  </div>

  <div class="b-box b-box--2">
    <span class="b-bh b-bh--pink">{B.boxes[1]}</span>
    <svg class="b-img" viewBox="0 0 206 88" preserveAspectRatio="none" aria-hidden="true">
      <rect width="206" height="88" fill="#1A1A1A"></rect>
      {
        [0, 1, 2].map((k) => (
          <g>
            <rect x={10 + k * 66} y={k === 1 ? 4 : 10} width="56" height={k === 1 ? 80 : 70} fill="#262626" stroke={k === 1 ? '#39FF14' : '#3A3A3A'} />
            <rect x={10 + k * 66} y={k === 1 ? 4 : 10} width="56" height="12" fill={k === 1 ? '#39FF14' : '#4A4A4A'} />
            <rect x={24 + k * 66} y={k === 1 ? 26 : 30} width="28" height="9" fill="#E6E6E6" />
            {[0, 1, 2, 3].map((r) => (
              <rect x={18 + k * 66} y={(k === 1 ? 42 : 46) + r * 8} width="40" height="2.5" fill="#6A6A6A" />
            ))}
          </g>
        ))
      }
    </svg>
    <span class="b-small">{P.beforeShot}</span>
  </div>

  <div class="b-box b-box--3">
    <span class="b-bh b-bh--red">{B.boxes[2]}</span>
    <svg class="b-arm" viewBox="0 0 60 50" aria-hidden="true">
      <path d="M2 44C2 36 10 30 20 28c4-8 12-8 14 0l4-14c-2-4 0-10 6-10s8 6 6 10l-4 24c-2 8-10 10-18 10H2Z" fill="#E0A878" stroke="#5A3010" stroke-width="1.5"></path>
      <path d="M24 30c3-4 7-4 9 0" fill="none" stroke="#5A3010" stroke-width="1"></path>
      <path d="M0 38h9v12H0Z" fill="#B00000"></path>
    </svg>
    <span class="b-text">{B.boxText}</span>
    <span class="b-link">{B.boxLink}</span>
  </div>

  <div class="b-side">
    <span class="b-visit">{F.visitor}</span>
    <span class="b-digits">{F.counter.split('').map((d) => <b>{d}</b>)}</span>
    <span class="b-uc">
      <i></i>
      <span>{F.construction}</span>
    </span>
    <span class="b-guest">{F.guestbook}</span>
    <span class="b-upd">{F.updated}</span>
  </div>

  <div class="b-foot">{F.rights} {B.footer} · {F.rightsTail}</div>
</div>

<style>
  .b-fit {
    --u: calc(100cqi / 760);
    --b-neon: #39ff14;
    /* Impact where it exists; elsewhere the site's own face, narrowed, so
       the no-wrap slogan never outgrows its box */
    --b-impact: Impact, Haettenschweiler, var(--font-sans, 'Arial Narrow'), sans-serif;
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* diamond-plate wallpaper (imagery, not UI) */
    background-color: #1c1c1c;
    background-image:
      repeating-linear-gradient(45deg, #2b2b2b 0 calc(1.6 * var(--u)), transparent calc(1.6 * var(--u)) calc(9 * var(--u))),
      repeating-linear-gradient(-45deg, #262626 0 calc(1.6 * var(--u)), transparent calc(1.6 * var(--u)) calc(9 * var(--u)));
    color: #d6d6d6;
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-stretch: 100%;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  .b-fit > * {
    position: absolute;
  }

  /* ---------- top strip ---------- */
  .b-top {
    inset: 0 0 auto;
    height: calc(15 * var(--u));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: calc(10 * var(--u));
    background-color: #000000;
    color: #a8a8a8;
    font-size: calc(6.2 * var(--u));
  }

  .b-follow {
    display: flex;
    align-items: center;
    gap: calc(3 * var(--u));
  }

  .b-follow i {
    width: calc(8 * var(--u));
    height: calc(8 * var(--u));
    background-color: #3b5998;
  }

  .b-follow i + i {
    background-color: #33ccff;
  }

  .b-follow i + i + i {
    background-color: #cc0000;
  }

  /* ---------- header: flames, dumbbell, Impact logo, starburst ---------- */
  .b-head {
    top: calc(15 * var(--u));
    left: 0;
    right: 0;
    height: calc(65 * var(--u));
    overflow: hidden;
    background-color: #2a0000;
    background-image: linear-gradient(#000000, #4a0000);
  }

  .b-head > * {
    position: absolute;
  }

  .b-flames {
    left: 0;
    bottom: 0;
    width: 100%;
    height: calc(26 * var(--u));
  }

  .b-bell {
    left: calc(14 * var(--u));
    top: calc(14 * var(--u));
    width: calc(52 * var(--u));
    height: calc(25 * var(--u));
    transform: rotate(-14deg);
  }

  .b-logo {
    left: calc(72 * var(--u));
    top: calc(6 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
  }

  .b-logo-a {
    color: #ffe000;
    font-family: var(--b-impact);
    font-stretch: 75%;
    font-synthesis: none;
    font-weight: 800;
    font-size: calc(35 * var(--u));
    line-height: 1;
    letter-spacing: 0.02em;
    text-shadow:
      calc(2 * var(--u)) calc(2 * var(--u)) 0 #b00000,
      calc(-1 * var(--u)) calc(-1 * var(--u)) 0 #000000;
  }

  .b-logo-b {
    color: #ffffff;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(7.6 * var(--u));
    font-weight: 900;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .b-burst {
    right: calc(22 * var(--u));
    top: calc(4 * var(--u));
    width: calc(98 * var(--u));
    height: calc(56 * var(--u));
    display: grid;
    place-items: center;
    transform: rotate(8deg);
  }

  .b-burst svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .b-burst-t {
    position: relative;
    max-width: calc(60 * var(--u));
    background-color: #ffe000;
    color: #b00000;
    font-family: var(--b-impact);
    font-stretch: 75%;
    font-synthesis: none;
    font-weight: 800;
    font-size: calc(11 * var(--u));
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---------- red gel tabs ---------- */
  .b-nav {
    top: calc(80 * var(--u));
    left: 0;
    right: 0;
    height: calc(21 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(3 * var(--u));
    padding-inline: calc(8 * var(--u));
    border-top: calc(1.5 * var(--u)) solid #ffe000;
    background-color: #000000;
  }

  .b-gel {
    padding: calc(3 * var(--u)) calc(9 * var(--u));
    border: 1px solid #5a0000;
    border-radius: calc(4 * var(--u));
    background-color: #b00000;
    background-image: linear-gradient(#d91a1a 0 48%, #b00000 52%, #7a0000);
    color: #ffffff;
    font-size: calc(7.4 * var(--u));
    font-weight: 700;
  }

  .b-gel.is-on {
    border-color: #8c7000;
    background-color: #ffe000;
    background-image: linear-gradient(#fff27a 0 48%, #ffe000 52%, #e0b800);
    color: #000000;
  }

  /* ---------- purple "Flash" banner ---------- */
  .b-hero {
    top: calc(101 * var(--u));
    left: 0;
    right: 0;
    height: calc(160 * var(--u));
    overflow: hidden;
    border-bottom: calc(3 * var(--u)) solid var(--b-neon);
    background-color: #2b0a4a;
    background-image: radial-gradient(ellipse 50% 70% at 48% 40%, #6a1fa0, #2b0a4a);
  }

  .b-hero > * {
    position: absolute;
  }

  .b-shot {
    left: calc(16 * var(--u));
    top: calc(12 * var(--u));
    padding: calc(2 * var(--u));
    background-color: #ffffff;
  }

  .b-shot svg {
    display: block;
    width: calc(192 * var(--u));
    height: calc(128 * var(--u));
  }

  .b-cap {
    left: calc(226 * var(--u));
    top: calc(22 * var(--u));
    width: calc(236 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(8 * var(--u));
    text-align: center;
  }

  .b-slogan {
    color: #ffe000;
    font-family: var(--b-impact);
    font-stretch: 75%;
    font-synthesis: none;
    font-weight: 800;
    font-size: calc(30 * var(--u));
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
    text-shadow: calc(2 * var(--u)) calc(2 * var(--u)) 0 #000000;
  }

  .b-welcome {
    color: #ffffff;
    font-family: 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', 'Comic Neue', sans-serif;
    font-size: calc(10.5 * var(--u));
    font-weight: 700;
  }

  .b-join {
    position: relative;
    margin-top: calc(6 * var(--u));
    padding: calc(6 * var(--u)) calc(18 * var(--u));
    border: calc(2.5 * var(--u)) outset #7cff5a;
    background-color: #2ee010;
    background-image: linear-gradient(#8aff6e, #39ff14 50%, #22c20a);
    color: #000000;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(11 * var(--u));
    font-weight: 900;
    text-transform: uppercase;
  }

  /* the old "blink": a neon ring flashing around the button (the label
     itself never fades, so it stays legible) */
  .b-ring {
    position: absolute;
    inset: calc(-5 * var(--u));
    border: calc(1.5 * var(--u)) solid #ffe000;
  }

  :global(.cp--hero) .b-ring {
    animation: bfit-blink 0.9s steps(1, end) infinite;
  }

  :global(.cp.is-offscreen) .b-ring,
  :global(.cp.is-paused) .b-ring {
    animation-play-state: paused;
  }

  @keyframes bfit-blink {
    50% {
      opacity: 0;
    }
  }

  .b-gal {
    left: calc(484 * var(--u));
    top: calc(16 * var(--u));
    width: calc(250 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--u));
  }

  .b-gal-t {
    color: #ffffff;
    font-family: var(--b-impact);
    font-stretch: 75%;
    font-synthesis: none;
    font-weight: 800;
    font-size: calc(13 * var(--u));
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .b-thumbs {
    display: flex;
    gap: calc(6 * var(--u));
  }

  .b-thumbs svg {
    width: calc(76 * var(--u));
    height: calc(61 * var(--u));
    border: calc(2 * var(--u)) solid #ffffff;
  }

  .b-gal-l {
    color: var(--b-neon);
    font-size: calc(7.5 * var(--u));
    font-weight: 700;
    text-decoration: underline;
  }

  .b-dots {
    left: calc(302 * var(--u));
    bottom: calc(9 * var(--u));
    display: flex;
    gap: calc(4 * var(--u));
  }

  .b-dots i {
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    border: 1px solid #ffffff;
    background-color: #5a3a7a;
  }

  .b-dots i.is-on {
    background-color: var(--b-neon);
  }

  .b-skip {
    right: calc(10 * var(--u));
    bottom: calc(7 * var(--u));
    color: #ffffff;
    font-size: calc(6.4 * var(--u));
    text-decoration: underline;
  }

  /* ---------- boxes that never line up ---------- */
  .b-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(6 * var(--u));
    padding-bottom: calc(8 * var(--u));
    border: 1px solid #3a3a3a;
    background-color: #151515;
    text-align: center;
  }

  .b-box--1 {
    left: calc(10 * var(--u));
    top: calc(272 * var(--u));
    width: calc(214 * var(--u));
  }

  .b-box--2 {
    left: calc(232 * var(--u));
    top: calc(281 * var(--u));
    width: calc(200 * var(--u));
  }

  .b-box--3 {
    left: calc(440 * var(--u));
    top: calc(268 * var(--u));
    width: calc(176 * var(--u));
    height: calc(172 * var(--u));
  }

  .b-bh {
    align-self: stretch;
    padding: calc(4 * var(--u)) calc(6 * var(--u));
    font-size: calc(8.5 * var(--u));
    font-weight: 900;
    text-transform: uppercase;
  }

  .b-bh--silver {
    background-color: #c8c8c8;
    background-image: linear-gradient(#f4f4f4, #c8c8c8 50%, #a8a8a8);
    color: #000000;
    font-family: 'Arial Black', Arial, sans-serif;
  }

  .b-bh--pink {
    background-color: #ff3ea5;
    background-image: linear-gradient(#ff8cc6, #ff3ea5);
    color: #000000;
    font-family: var(--b-impact);
    font-stretch: 75%;
    font-synthesis: none;
    font-weight: 800;
    font-size: calc(10.5 * var(--u));
    letter-spacing: 0.04em;
  }

