---
/**
 * Concept 05 BEFORE — Ironbark Strength Club (fictional) on a loud 2016 gym
 * template. Dated, not a parody: neon green on black, Arial Black, a stock
 * "No pain, no gain" banner with slider arrows, a blinking "Join now!", the
 * class schedule posted as a screenshot, the price list as an image, and the
 * phone number only in the footer. Every text pair passes AA on its own fill.
 * Rendered by ConceptPlate.astro through the registry; sizes use --u (one
 * reference px of the 760-wide drawing). Renders twice in hero mode: no ids.
 */
import { fitness, fitnessPlate as P } from '../../../data/concepts/fitness';

export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const B = fitness.before;
/* the screenshot of a spreadsheet timetable: 7 columns × 6 rows of cells,
   a few of them coloured the way a gym owner colours a class */
const cells: [number, number, string][] = [
  [0, 0, '#39FF14'], [2, 0, '#39FF14'], [4, 0, '#39FF14'], [1, 1, '#FF7AC6'], [3, 1, '#FF7AC6'],
  [0, 2, '#6EC1FF'], [5, 2, '#39FF14'], [2, 3, '#FFD84D'], [4, 3, '#6EC1FF'], [1, 4, '#39FF14'],
  [3, 4, '#39FF14'], [6, 4, '#FF7AC6'], [0, 5, '#FFD84D'], [5, 5, '#6EC1FF'],
];
---

<div class:list={['b-site', 'b-fit', cls]} aria-hidden="true">
  <div class="b-top">
    <span class="b-mail">{B.topBar}</span>
    <span class="b-social"><i></i><i></i><i></i></span>
  </div>
  <div class="b-head">
    <span class="b-logo">
      <span class="b-logo-a">{B.logo}</span>
      <span class="b-logo-b">{P.beforeTagline}</span>
    </span>
    <span class="b-nav">
      {B.nav.map((l, i) => <span class:list={['b-navl', i === 0 && 'is-on']}>{l}</span>)}
    </span>
  </div>

  <div class="b-hero">
    <svg class="b-photo" viewBox="0 0 760 190" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect y="152" width="760" height="38" fill="#141414"></rect>
      <!-- stock lifter, squat with the bar on the back -->
      <g fill="#0C0C0C">
        <rect x="58" y="70" width="176" height="6"></rect>
        <rect x="66" y="52" width="16" height="42"></rect>
        <rect x="84" y="58" width="9" height="30"></rect>
        <rect x="210" y="52" width="16" height="42"></rect>
        <rect x="199" y="58" width="9" height="30"></rect>
        <circle cx="146" cy="58" r="10"></circle>
        <path d="M128 72h36l6 42-10 4 -4 34h-12l-2-30h-6l-2 30h-12l-4-34-10-4Z"></path>
      </g>
      <!-- dumbbell rack -->
      <g fill="#101010">
        <rect x="560" y="118" width="170" height="5"></rect>
        <rect x="560" y="146" width="170" height="5"></rect>
        <rect x="566" y="118" width="5" height="34"></rect>
        <rect x="719" y="118" width="5" height="34"></rect>
      </g>
      <g fill="#0A0A0A">
        {[0, 1, 2, 3, 4].map((k) => <rect x={578 + k * 30} y="104" width="22" height="14" />)}
        {[0, 1, 2, 3, 4].map((k) => <rect x={578 + k * 30} y="132" width="22" height="14" />)}
      </g>
    </svg>
    <span class="b-arrow b-arrow--l"><svg viewBox="0 0 10 16" aria-hidden="true"><path d="M7 2 2 8l5 6" fill="none" stroke="#39FF14" stroke-width="2"></path></svg></span>
    <span class="b-arrow b-arrow--r"><svg viewBox="0 0 10 16" aria-hidden="true"><path d="m3 2 5 6-5 6" fill="none" stroke="#39FF14" stroke-width="2"></path></svg></span>
    <div class="b-cap">
      <span class="b-slogan">{B.heroSub}</span>
      <span class="b-welcome">{B.welcome}</span>
      <span class="b-join"><i class="b-ring"></i>{B.heroButton}</span>
    </div>
    <span class="b-dots"><i class="is-on"></i><i></i><i></i><i></i></span>
  </div>

  <div class="b-boxes">
    <div class="b-box">
      <span class="b-title">{B.boxes[0]}</span>
      <svg class="b-img" viewBox="0 0 206 88" preserveAspectRatio="none" aria-hidden="true">
        <rect width="206" height="88" fill="#F2F2F2"></rect>
        <rect width="206" height="11" fill="#3B3B3B"></rect>
        {cells.map(([c, r, f]) => <rect x={20 + c * 26.6} y={11 + r * 12.8} width="26.6" height="12.8" fill={f} fill-opacity=".72" />)}
        <path
          d="M20 0V88M46.6 0V88M73.2 0V88M99.8 0V88M126.4 0V88M153 0V88M179.6 0V88M0 11H206M0 23.8H206M0 36.6H206M0 49.4H206M0 62.2H206M0 75H206"
          stroke="#A8A8A8"
          stroke-width=".8"></path>
        <g fill="#8C8C8C">
          {[0, 1, 2, 3, 4, 5].map((r) => <rect x="4" y={16 + r * 12.8} width="12" height="3" />)}
          {[0, 1, 2, 3, 4, 5, 6].map((c) => <rect x={25 + c * 26.6} y="4" width="16" height="3" fill="#CFCFCF" />)}
        </g>
      </svg>
      <span class="b-small">{P.beforeUpdated} · {P.beforeShot}</span>
    </div>
    <div class="b-box">
      <span class="b-title">{B.boxes[1]}</span>
      <svg class="b-img" viewBox="0 0 206 88" preserveAspectRatio="none" aria-hidden="true">
        <rect width="206" height="88" fill="#1A1A1A"></rect>
        {
          [0, 1, 2].map((k) => (
            <g>
              <rect x={10 + k * 66} y={k === 1 ? 4 : 10} width="56" height={k === 1 ? 80 : 70} fill="#262626" stroke={k === 1 ? '#39FF14' : '#3A3A3A'} />
              <rect x={10 + k * 66} y={k === 1 ? 4 : 10} width="56" height="12" fill={k === 1 ? '#39FF14' : '#4A4A4A'} />
              <rect x={24 + k * 66} y={k === 1 ? 26 : 30} width="28" height="9" fill="#E6E6E6" />
              {[0, 1, 2, 3].map((r) => (
                <rect x={18 + k * 66} y={(k === 1 ? 42 : 46) + r * 8} width="40" height="2.5" fill="#6A6A6A" />
              ))}
            </g>
          ))
        }
      </svg>
      <span class="b-small">{P.beforeShot}</span>
    </div>
    <div class="b-box">
      <span class="b-title">{B.boxes[2]}</span>
      <span class="b-icon">
        <svg viewBox="0 0 20 12" aria-hidden="true">
          <path d="M1 6h18M4 2v8M7 1v10M13 1v10M16 2v8" fill="none" stroke="#050505" stroke-width="2"></path>
        </svg>
      </span>
      <span class="b-text">{B.boxText}</span>
      <span class="b-link">{B.boxLink}</span>
    </div>
  </div>

  <div class="b-foot">{B.footer}</div>
</div>

<style>
  .b-fit {
    --u: calc(100cqi / 760);
    --b-bg: #0b0b0b;
    --b-neon: #39ff14;
    --b-bar: #1b1b1b;
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--b-bg);
    color: #d6d6d6;
    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    font-stretch: 100%;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  /* ---------- top bar + header ---------- */
  .b-top {
    position: absolute;
    inset: 0 0 auto;
    height: calc(20 * var(--u));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: calc(22 * var(--u));
    background-color: var(--b-bar);
  }

  .b-mail {
    color: #bdbdbd;
    font-size: calc(7.5 * var(--u));
  }

  .b-social {
    display: flex;
    gap: calc(4 * var(--u));
  }

  .b-social i {
    width: calc(10 * var(--u));
    height: calc(10 * var(--u));
    border: 1px solid var(--b-neon);
  }

  .b-head {
    position: absolute;
    top: calc(20 * var(--u));
    left: 0;
    right: 0;
    height: calc(52 * var(--u));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: calc(22 * var(--u));
    border-bottom: 1px solid #262626;
    background-color: #050505;
  }

  .b-logo {
    display: flex;
    flex-direction: column;
    gap: calc(1 * var(--u));
  }

  .b-logo-a {
    color: #ffffff;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(21 * var(--u));
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.02em;
    transform: skewX(-8deg);
  }

  .b-logo-b {
    color: var(--b-neon);
    font-size: calc(7 * var(--u));
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .b-nav {
    display: flex;
    gap: calc(15 * var(--u));
  }

  .b-navl {
    position: relative;
    color: #ffffff;
    font-size: calc(8 * var(--u));
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .b-navl.is-on {
    color: var(--b-neon);
  }

  .b-navl.is-on::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-6 * var(--u));
    height: calc(2 * var(--u));
    background-color: var(--b-neon);
  }

  /* ---------- slider hero ---------- */
  .b-hero {
    position: absolute;
    top: calc(72 * var(--u));
    left: 0;
    right: 0;
    height: calc(190 * var(--u));
    overflow: hidden;
    background-color: #1c1c1c;
    /* the stock photo's spotlight (imagery, not UI) */
    background-image: radial-gradient(ellipse 60% 110% at 50% 0%, #4a4a4a, #1c1c1c);
    border-bottom: calc(4 * var(--u)) solid var(--b-neon);
  }

  .b-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .b-arrow {
    position: absolute;
    top: calc(74 * var(--u));
    display: grid;
    place-items: center;
    width: calc(22 * var(--u));
    height: calc(34 * var(--u));
    background-color: #000000;
  }

  .b-arrow svg {
    width: calc(8 * var(--u));
    height: calc(14 * var(--u));
  }

  .b-arrow--l {
    left: calc(14 * var(--u));
  }

  .b-arrow--r {
    right: calc(14 * var(--u));
  }

  .b-cap {
    position: absolute;
    left: calc(262 * var(--u));
    top: calc(26 * var(--u));
    width: calc(236 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(7 * var(--u));
    padding: calc(14 * var(--u)) calc(10 * var(--u)) calc(16 * var(--u));
    background-color: #0d0d0d;
    text-align: center;
  }

  .b-slogan {
    color: #ffffff;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(27 * var(--u));
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: skewX(-8deg);
  }

  .b-welcome {
    color: var(--b-neon);
    font-size: calc(9.5 * var(--u));
    font-weight: 700;
  }

  .b-join {
    position: relative;
    margin-top: calc(5 * var(--u));
    padding: calc(7 * var(--u)) calc(20 * var(--u));
    background-color: var(--b-neon);
    color: #050505;
    font-size: calc(10 * var(--u));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* the 2016 "blink": a neon ring flashing around the button (the label
     itself never fades, so it stays legible) */
  .b-ring {
    position: absolute;
    inset: calc(-4 * var(--u));
    border: calc(1.5 * var(--u)) solid var(--b-neon);
  }

  :global(.cp--hero) .b-ring {
    animation: bfit-blink 0.9s steps(1, end) infinite;
  }

  :global(.cp.is-offscreen) .b-ring,
  :global(.cp.is-paused) .b-ring {
    animation-play-state: paused;
  }

  @keyframes bfit-blink {
    50% {
      opacity: 0;
    }
  }

  .b-dots {
    position: absolute;
    left: 50%;
    bottom: calc(10 * var(--u));
    display: flex;
    gap: calc(5 * var(--u));
    transform: translateX(-50%);
  }

  .b-dots i {
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border-radius: 50%;
    background-color: #5a5a5a;
  }

  .b-dots i.is-on {
    background-color: var(--b-neon);
  }

  /* ---------- three identical boxes ---------- */
  .b-boxes {
    position: absolute;
    top: calc(266 * var(--u));
    left: 0;
    right: 0;
    height: calc(180 * var(--u));
    display: flex;
    justify-content: center;
    gap: calc(12 * var(--u));
    padding-top: calc(14 * var(--u));
    background-color: var(--b-bg);
  }

  .b-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(7 * var(--u));
    width: calc(230 * var(--u));
    height: calc(152 * var(--u));
    padding: calc(12 * var(--u));
    border: 1px solid #2a2a2a;
    background-color: #151515;
    text-align: center;
  }

  .b-title {
    position: relative;
    padding-bottom: calc(5 * var(--u));
    color: #ffffff;
    font-size: calc(10 * var(--u));
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .b-title::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: calc(24 * var(--u));
    height: calc(2 * var(--u));
    background-color: var(--b-neon);
    transform: translateX(-50%);
  }

  .b-img {
    flex: 0 0 auto;
    width: calc(206 * var(--u));
    height: calc(88 * var(--u));
  }

  .b-small {
    color: #a0a0a0;
    font-size: calc(7.5 * var(--u));
  }

  .b-icon {
    display: grid;
    place-items: center;
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
    margin-top: calc(6 * var(--u));
    border-radius: 50%;
    background-color: var(--b-neon);
  }

  .b-icon svg {
    width: 62%;
    height: 62%;
  }

  .b-text {
    max-width: calc(170 * var(--u));
    font-size: calc(8.5 * var(--u));
  }

  .b-link {
    color: var(--b-neon);
    font-size: calc(8.5 * var(--u));
    font-weight: 700;
    text-decoration: underline;
  }

  /* ---------- footer ---------- */
  .b-foot {
    position: absolute;
    inset: auto 0 0;
    height: calc(29 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--b-bar);
    color: #bdbdbd;
    font-size: calc(8 * var(--u));
  }
</style>
