---
/**
 * STUB AFTER — a neutral, palette-themed rebuild used by every concept that
 * has not been drawn yet. Same geometry as Halden (so defaultAnchors in
 * src/data/concepts/types.ts land on the right features), same six-layer DOM
 * contract (see ../README.md). A niche designer replaces the call to this
 * component in concepts/<id>/Layers.astro with a bespoke drawing.
 *
 *   .cp-layer.cp-l1  wireframe hairlines + box tags        --i:0
 *   .cp-layer.cp-l2  surfaces, brand, headline, art        --i:1  (opaque)
 *   .cp-layer.cp-l3  image frames + load waterfall bars    --i:2
 *   .cp-layer.cp-l4  JSON-LD card + sitemap tree           --i:3
 *   .cp-layer.cp-l5  buttons                               --i:4
 *   .cp-layer.cp-l6  event pins                            --i:5
 */
import type { Concept } from '../../../data/concepts/types';

export interface Props {
  concept: Concept;
}
const { concept: c } = Astro.props;
const A = c.after;
const P = c.palette;
/* the palette travels as custom properties on every layer (the layers are
   siblings, there is no wrapper to hang them on) */
const vars = [
  `--c-base:${P.base}`,
  `--c-base-2:${P.base2}`,
  `--c-deep:${P.deep}`,
  `--c-text:${P.text}`,
  `--c-muted:${P.muted}`,
  `--c-band:${P.band}`,
  `--c-band-2:${P.band2}`,
  `--c-ink:${P.ink}`,
  `--c-ink-2:${P.ink2}`,
  `--c-accent:${P.accent}`,
  `--c-on-accent:${P.onAccent}`,
  `--c-line:${P.line}`,
].join(';');
const st = (i: number) => `--i:${i};${vars}`;
const initial = c.name.trim().charAt(0);
---

<div class="cp-layer cp-l1" style={st(0)}>
  <svg class="w-grid" viewBox="0 0 760 475" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M32 .5V475M92.5 .5V475M153 .5V475M213.5 .5V475M274 .5V475M334.5 .5V475M395 .5V475M455.5 .5V475M516 .5V475M576.5 .5V475M637 .5V475M697.5 .5V475M728 .5V475"
      fill="none"
      stroke={P.line}
      stroke-opacity=".2"
      vector-effect="non-scaling-stroke"></path>
  </svg>
  <span class="w-box w-nav"><span class="w-tag">{A.wireframeTags[0]}</span></span>
  <span class="w-box w-h1"><span class="w-tag">{A.wireframeTags[1]}</span></span>
  <span class="w-box w-cta"><span class="w-tag">{A.wireframeTags[2]}</span></span>
  <span class="w-box w-svc"><span class="w-tag">{A.wireframeTags[3]}</span></span>
</div>

<div class="cp-layer cp-l4" style={st(3)}>
  <span class="d-card">
    <span class="d-brace">{'{'}</span>
    <span class="d-line">{A.jsonLd[0]},</span>
    <span class="d-line">{A.jsonLd[1]}</span>
    <span class="d-brace">{'}'}</span>
  </span>
  <span class="d-tree">
    {A.sitemap.map((p, i) => <span class:list={['d-node', i === 0 ? 'is-root' : 'is-leaf']}>{p}</span>)}
  </span>
</div>

<div class="cp-layer cp-l6" style={st(5)}>
  <span class="e-pin e-pin--book"><i></i><span class="e-chip">{A.events[2]}</span></span>
  <span class="e-pin e-pin--call"><i></i><span class="e-chip">{A.events[1]}</span></span>
  <span class="e-pin e-pin--wa"><span class="e-chip">{A.events[0]}</span><i></i></span>
</div>

<div class="cp-layer cp-l2" style={st(1)}>
  <div class="s-nav">
    <span class="s-logo">
      <span class="s-mark" aria-hidden="true">{initial}</span>
      <span class="s-name" data-cp-name>{c.name}</span>
    </span>
    <span class="s-links">{A.nav.map((l) => <span class="s-link">{l}</span>)}</span>
  </div>
  <span class="s-eyebrow"><i></i>{c.city}</span>
  <span class="s-h1">{A.headline}</span>
  <span class="s-sub">{A.sub}</span>
  <div class="s-media">
    <svg viewBox="0 0 356 294" preserveAspectRatio="none" aria-hidden="true">
      <rect width="356" height="294" fill={P.base2}></rect>
      <circle cx="226" cy="150" r="118" fill="none" stroke={P.line} stroke-opacity=".16"></circle>
      <circle cx="226" cy="150" r="82" fill="none" stroke={P.line} stroke-opacity=".24"></circle>
      <circle cx="226" cy="150" r="46" fill={P.accent} fill-opacity=".86"></circle>
      <path d="M0 238.5H356" stroke={P.line} stroke-opacity=".18"></path>
      <path d="M0 238H356V294H0Z" fill={P.deep} fill-opacity=".6"></path>
      <path d="M40 262H140M40 274H104" stroke={P.line} stroke-opacity=".3" stroke-width="2"></path>
    </svg>
  </div>
  <div class="s-band">
    <span class="s-band-label">{A.nav[0]}</span>
    <span class="s-thumb" aria-hidden="true">
      <svg viewBox="0 0 200 72" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="72" fill={P.band2}></rect>
        <path d="M0 19.5 200 19.5" stroke={P.accent} stroke-width="3"></path>
        <g fill={P.ink} fill-opacity=".14">
          <rect x="14" y="32" width="52" height="28"></rect>
          <rect x="74" y="32" width="52" height="28"></rect>
          <rect x="134" y="32" width="52" height="28"></rect>
        </g>
      </svg>
    </span>
    <span class="s-rows">
      {
        A.services.map((s, i) => (
          <span class="s-row" style={`--k:${i}`}>
            <span class="s-idx">0{i + 1}</span>
            <span class="s-svc-name">{s}</span>
            <svg class="s-svc-arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke={P.ink} stroke-width="1.5" />
            </svg>
          </span>
        ))
      }
    </span>
  </div>
</div>

<div class="cp-layer cp-l3" style={st(2)}>
  <span class="f-frame f-hero"><i class="f-c f-c1"></i><i class="f-c f-c2"></i><i class="f-c f-c3"></i><i class="f-c f-c4"></i></span>
  <span class="f-frame f-thumb"></span>
  <svg class="f-fall" viewBox="0 0 356 294" preserveAspectRatio="none" aria-hidden="true">
    <g fill={P.line} fill-opacity=".2">
      <rect x="176" y="120" width="24" height="4"></rect>
      <rect x="184" y="132" width="42" height="4"></rect>
      <rect x="194" y="144" width="30" height="4"></rect>
      <rect x="204" y="156" width="56" height="4"></rect>
      <rect x="218" y="168" width="38" height="4"></rect>
      <rect x="230" y="180" width="64" height="4"></rect>
    </g>
    <rect x="176" y="120" width="10" height="4" fill={P.accent}></rect>
    <rect x="204" y="156" width="16" height="4" fill={P.accent}></rect>
  </svg>
</div>

<div class="cp-layer cp-l5" style={st(4)}>
  <span class="k-btn k-book">{A.buttons[0]}</span>
  <span class="k-btn k-call">{A.buttons[1]}</span>
  <span class="k-btn k-wa">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    </svg>
    {A.buttons[2]}
  </span>
</div>

<style>
  .cp-layer {
    --u: calc(100cqi / 760);
    position: absolute;
    inset: 0;
    color: var(--c-text);
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }

  /* flat z-order: the invisible parts of a real site sit under l2 */
  .cp-l1,
  .cp-l4,
  .cp-l6 {
    z-index: 0;
  }

  .cp-l2 {
    z-index: 1;
    background-color: var(--c-base);
  }

  .cp-l3 {
    z-index: 2;
    pointer-events: none;
  }

  .cp-l5 {
    z-index: 3;
  }

  /* ---------- L1 wireframe ---------- */
  .w-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .w-box {
    position: absolute;
    border: 1px solid var(--c-line);
  }

  .w-nav {
    left: calc(8 * var(--u));
    top: calc(6 * var(--u));
    width: calc(744 * var(--u));
    height: calc(34 * var(--u));
  }

  .w-h1 {
    left: calc(24 * var(--u));
    top: calc(96 * var(--u));
    width: calc(372 * var(--u));
    height: calc(104 * var(--u));
  }

  .w-cta {
    left: calc(24 * var(--u));
    top: calc(258 * var(--u));
    width: calc(330 * var(--u));
    height: calc(52 * var(--u));
  }

  .w-svc {
    left: calc(8 * var(--u));
    top: calc(348 * var(--u));
    width: calc(744 * var(--u));
    height: calc(119 * var(--u));
  }

  /* text outside l2 sits on its own opaque chip: AA on any backdrop */
  .w-tag {
    position: absolute;
    left: -1px;
    bottom: 100%;
    padding: calc(2 * var(--u)) calc(5 * var(--u));
    background-color: var(--c-accent);
    color: var(--c-on-accent);
    font-size: calc(7.5 * var(--u));
    font-weight: 700;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .w-nav .w-tag,
  .w-svc .w-tag {
    bottom: auto;
    top: -1px;
  }

  /* ---------- L2 surfaces ---------- */
  .s-nav {
    position: absolute;
    inset: 0 0 auto;
    height: calc(46 * var(--u));
    display: flex;
    align-items: center;
    padding-inline: calc(32 * var(--u));
    border-bottom: 1px solid color-mix(in srgb, var(--c-line) 14%, transparent);
    background-color: var(--c-base);
  }

  .s-logo {
    display: flex;
    align-items: center;
    gap: calc(9 * var(--u));
    min-width: 0;
    max-width: calc(360 * var(--u));
  }

  .s-mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    background-color: var(--c-accent);
    color: var(--c-on-accent);
    font-size: calc(10 * var(--u));
    font-weight: 750;
    line-height: 1;
  }

  .s-name {
    overflow: hidden;
    color: var(--c-text);
    font-size: calc(10.5 * var(--u));
    font-stretch: 112%;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .s-links {
    position: absolute;
    left: calc(424 * var(--u));
    display: flex;
    gap: calc(26 * var(--u));
  }

  .s-link {
    color: var(--c-muted);
    font-size: calc(10 * var(--u));
    font-weight: 500;
  }

  .s-eyebrow {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(78 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    color: var(--c-muted);
    font-size: calc(8.5 * var(--u));
    font-weight: 620;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .s-eyebrow i {
    width: calc(18 * var(--u));
    height: calc(2 * var(--u));
    background-color: var(--c-accent);
  }

  .s-h1 {
    position: absolute;
    left: calc(29 * var(--u));
    top: calc(98 * var(--u));
    width: calc(360 * var(--u));
    color: var(--c-text);
    font-size: calc(46 * var(--u));
    font-stretch: 82%;
    font-weight: 660;
    line-height: 0.98;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .s-sub {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(212 * var(--u));
    width: calc(300 * var(--u));
    color: var(--c-muted);
    font-size: calc(11.5 * var(--u));
    line-height: 1.5;
  }

  .s-media {
    position: absolute;
    left: calc(404 * var(--u));
    top: calc(46 * var(--u));
    right: 0;
    height: calc(294 * var(--u));
    background-color: var(--c-base-2);
  }

  .s-media svg,
  .f-fall {
    display: block;
    width: 100%;
    height: 100%;
  }

  .s-band {
    position: absolute;
    inset: auto 0 0;
    height: calc(135 * var(--u));
    background-color: var(--c-band);
    color: var(--c-ink);
  }

  .s-band-label {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(24 * var(--u));
    color: var(--c-ink-2);
    font-size: calc(8.5 * var(--u));
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .s-thumb {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(44 * var(--u));
    width: calc(200 * var(--u));
    height: calc(72 * var(--u));
    overflow: hidden;
    background-color: var(--c-band-2);
  }

  .s-thumb svg {
    width: 100%;
    height: 100%;
  }

  .s-rows {
    position: absolute;
    left: calc(272 * var(--u));
    top: calc(18 * var(--u));
    width: calc(456 * var(--u));
    border-bottom: 1px solid color-mix(in srgb, var(--c-ink) 20%, transparent);
  }

  .s-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(18 * var(--u));
    height: calc(33 * var(--u));
    border-top: 1px solid color-mix(in srgb, var(--c-ink) 20%, transparent);
    background-color: var(--c-band);
  }

  .s-idx {
    width: calc(18 * var(--u));
    color: var(--c-ink-2);
    font-size: calc(8.5 * var(--u));
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .s-svc-name {
    color: var(--c-ink);
    font-size: calc(13 * var(--u));
    font-stretch: 90%;
    font-weight: 640;
    letter-spacing: -0.01em;
  }

  .s-svc-arrow {
    margin-left: auto;
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
  }

  .s-row:first-child::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: calc(48 * var(--u));
    height: 2px;
    background-color: var(--c-accent);
  }

  /* ---------- L3 frames + waterfall ---------- */
  .f-frame {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--c-line) 30%, transparent);
  }

  .f-hero {
    left: calc(418 * var(--u));
    top: calc(60 * var(--u));
    width: calc(328 * var(--u));
    height: calc(266 * var(--u));
  }

  .f-c {
    position: absolute;
    width: calc(9 * var(--u));
    height: calc(9 * var(--u));
    border: 0 solid var(--c-accent);
  }

  .f-c1 {
    left: -1px;
    top: -1px;
    border-width: 2px 0 0 2px;
  }

  .f-c2 {
    right: -1px;
    top: -1px;
    border-width: 2px 2px 0 0;
  }

  .f-c3 {
    left: -1px;
    bottom: -1px;
    border-width: 0 0 2px 2px;
  }

  .f-c4 {
    right: -1px;
    bottom: -1px;
    border-width: 0 2px 2px 0;
  }

  .f-thumb {
    left: calc(32 * var(--u));
    top: calc(384 * var(--u));
    width: calc(200 * var(--u));
    height: calc(72 * var(--u));
    border-color: color-mix(in srgb, var(--c-ink) 24%, transparent);
  }

  .f-fall {
    position: absolute;
    left: calc(404 * var(--u));
    top: calc(46 * var(--u));
    width: calc(356 * var(--u));
    height: calc(294 * var(--u));
  }

  /* ---------- L4 data (the card is opaque; the tree is AA on base + void) */
  .d-card {
    position: absolute;
    left: calc(430 * var(--u));
    top: calc(72 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(3 * var(--u));
    width: calc(252 * var(--u));
    padding: calc(10 * var(--u)) calc(12 * var(--u));
    border: 1px solid var(--c-accent);
    background-color: var(--c-deep);
    font-size: calc(9 * var(--u));
    line-height: 1.35;
  }

  .d-brace {
    color: var(--c-muted);
  }

  .d-line {
    padding-left: calc(12 * var(--u));
    color: var(--c-text);
    white-space: nowrap;
  }

  .d-tree {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(366 * var(--u));
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: calc(5 * var(--u)) calc(28 * var(--u));
    font-size: calc(9 * var(--u));
  }

  .d-node {
    position: relative;
    color: var(--c-muted);
    white-space: nowrap;
  }

  .d-node.is-root {
    grid-column: 1 / -1;
    color: var(--c-text);
  }

  .d-node.is-leaf {
    padding-left: calc(12 * var(--u));
  }

  .d-node.is-leaf::before {
    content: '';
    position: absolute;
    left: 0;
    top: 55%;
    width: calc(7 * var(--u));
    height: 1px;
    background-color: var(--c-line);
  }

  /* ---------- L5 buttons ---------- */
  .k-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(6 * var(--u));
    height: calc(36 * var(--u));
    padding-inline: calc(16 * var(--u));
    font-size: calc(10 * var(--u));
    font-weight: 650;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .k-book {
    left: calc(32 * var(--u));
    top: calc(266 * var(--u));
    background-color: var(--c-accent);
    color: var(--c-on-accent);
  }

  /* outline buttons carry the base fill so they stay AA when lifted */
  .k-call {
    left: calc(194 * var(--u));
    top: calc(266 * var(--u));
    border: 1px solid var(--c-accent);
    background-color: var(--c-base);
    color: var(--c-text);
  }

  .k-wa {
    right: calc(28 * var(--u));
    top: calc(10 * var(--u));
    height: calc(26 * var(--u));
    padding-inline: calc(12 * var(--u));
    border: 1px solid color-mix(in srgb, var(--c-line) 40%, transparent);
    background-color: var(--c-base);
    color: var(--c-text);
    font-size: calc(9 * var(--u));
  }

  .k-wa svg {
    width: calc(11 * var(--u));
    height: calc(11 * var(--u));
    color: var(--c-accent);
  }

  /* ---------- L6 events ---------- */
  .e-pin {
    position: absolute;
    display: flex;
    align-items: center;
    gap: calc(5 * var(--u));
  }

  .e-pin i {
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    background-color: var(--c-accent);
  }

  .e-chip {
    padding: calc(2 * var(--u)) calc(5 * var(--u));
    background-color: var(--c-accent);
    color: var(--c-on-accent);
    font-size: calc(8 * var(--u));
    font-weight: 650;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .e-pin--book {
    left: calc(34 * var(--u));
    top: calc(312 * var(--u));
  }

  .e-pin--call {
    left: calc(196 * var(--u));
    top: calc(312 * var(--u));
  }

  .e-pin--wa {
    right: calc(30 * var(--u));
    top: calc(44 * var(--u));
  }
</style>
