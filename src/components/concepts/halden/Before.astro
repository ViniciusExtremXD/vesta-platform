---
/**
 * Concept 01 BEFORE — Halden Roofing (fictional) on a plausible 2016 template.
 * Dated, not a parody: Arial, tan header with a centred logo, green slider
 * hero with a placeholder photo, "Welcome to…", three identical boxes, phone
 * number only in the footer. Every text pair passes AA on its own.
 * Rendered by ConceptPlate.astro through the registry (../registry.ts); sizes use --u (one reference px of the
 * 760-wide drawing, resolved against the nearest size container).
 */
import { halden } from '../../../data/concepts/halden';

export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const B = halden.before;
---

<div class:list={['b-site', cls]} aria-hidden="true">
  <div class="b-head">
    <span class="b-mail">{B.topBar}</span>
    <span class="b-logo">{B.logo}</span>
  </div>
  <div class="b-nav">
    {B.nav.map((l, i) => <span class:list={['b-navl', i === 0 && 'is-on']}>{l}</span>)}
  </div>
  <div class="b-hero">
    <div class="b-photo"></div>
    <svg class="b-arrow b-arrow--l" viewBox="0 0 10 16" aria-hidden="true"><path d="M7 2 2 8l5 6" fill="none" stroke="#FFFFFF" stroke-width="1.6"></path></svg>
    <svg class="b-arrow b-arrow--r" viewBox="0 0 10 16" aria-hidden="true"><path d="m3 2 5 6-5 6" fill="none" stroke="#FFFFFF" stroke-width="1.6"></path></svg>
    <div class="b-copy">
      <span class="b-welcome">{B.welcome}</span>
      <span class="b-sub">{B.heroSub}</span>
      <span class="b-more">{B.heroButton}</span>
    </div>
    <span class="b-dots"><i class="is-on"></i><i></i><i></i></span>
  </div>
  <div class="b-boxes">
    {
      B.boxes.map((t) => (
        <div class="b-box">
          <span class="b-icon">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 9.5 8 5l5 4.5M5 8.5V12h6V8.5" fill="none" stroke="#FFFFFF" stroke-width="1.4" />
            </svg>
          </span>
          <span class="b-title">{t}</span>
          <span class="b-text">{B.boxText}</span>
          <span class="b-link">{B.boxLink}</span>
        </div>
      ))
    }
  </div>
  <div class="b-foot">{B.footer}</div>
</div>

<style>
  .b-site {
    --u: calc(100cqi / 760);
    --b-bg: #f7f4ee;
    --b-text: #333333;
    --b-green: #3d5a3a;
    --b-tan: #c9b99a;
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--b-bg);
    color: var(--b-text);
    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    font-stretch: 100%;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  .b-head {
    position: absolute;
    inset: 0 0 auto;
    height: calc(64 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--b-tan);
  }

  .b-mail {
    position: absolute;
    right: calc(18 * var(--u));
    top: calc(7 * var(--u));
    font-size: calc(7.5 * var(--u));
  }

  .b-logo {
    font-size: calc(21 * var(--u));
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .b-nav {
    position: absolute;
    top: calc(64 * var(--u));
    left: 0;
    right: 0;
    height: calc(26 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(22 * var(--u));
    background-color: #ffffff;
    border-bottom: 1px solid #d9d4c9;
  }

  .b-navl {
    font-size: calc(8.5 * var(--u));
  }

  .b-navl.is-on {
    color: var(--b-green);
    font-weight: 700;
  }

  .b-hero {
    position: absolute;
    top: calc(90 * var(--u));
    left: 0;
    right: 0;
    height: calc(200 * var(--u));
    background-color: var(--b-green);
  }

  .b-photo {
    position: absolute;
    inset: calc(16 * var(--u)) calc(52 * var(--u));
    background-color: #587455;
  }

  .b-arrow {
    position: absolute;
    top: calc(82 * var(--u));
    width: calc(22 * var(--u));
    height: calc(36 * var(--u));
    padding: calc(9 * var(--u)) calc(6 * var(--u));
    background-color: #2c422a;
  }

  .b-arrow--l {
    left: calc(16 * var(--u));
  }

  .b-arrow--r {
    right: calc(16 * var(--u));
  }

  .b-copy {
    position: absolute;
    inset: calc(46 * var(--u)) calc(90 * var(--u)) auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(8 * var(--u));
    background-color: #587455;
    text-align: center;
  }

  .b-welcome {
    color: #ffffff;
    font-size: calc(25 * var(--u));
    font-weight: 700;
  }

  .b-sub {
    color: #ffffff;
    font-size: calc(10.5 * var(--u));
  }

  .b-more {
    margin-top: calc(6 * var(--u));
    padding: calc(7 * var(--u)) calc(16 * var(--u));
    background-color: var(--b-tan);
    font-size: calc(9 * var(--u));
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .b-dots {
    position: absolute;
    left: 50%;
    bottom: calc(26 * var(--u));
    display: flex;
    gap: calc(5 * var(--u));
    transform: translateX(-50%);
  }

  .b-dots i {
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    background-color: #9fb29c;
  }

  .b-dots i.is-on {
    background-color: #ffffff;
  }

  .b-boxes {
    position: absolute;
    top: calc(290 * var(--u));
    left: 0;
    right: 0;
    height: calc(154 * var(--u));
    display: flex;
    justify-content: center;
    gap: calc(20 * var(--u));
    padding-top: calc(16 * var(--u));
    background-color: var(--b-bg);
  }

  .b-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(6 * var(--u));
    width: calc(200 * var(--u));
    height: calc(122 * var(--u));
    padding: calc(12 * var(--u)) calc(14 * var(--u));
    border: 1px solid #d9d4c9;
    background-color: #ffffff;
    text-align: center;
  }

  .b-icon {
    display: grid;
    place-items: center;
    width: calc(26 * var(--u));
    height: calc(26 * var(--u));
    background-color: var(--b-tan);
  }

  .b-icon svg {
    width: 70%;
    height: 70%;
  }

  .b-title {
    font-size: calc(11.5 * var(--u));
    font-weight: 700;
  }

  .b-text {
    font-size: calc(8.5 * var(--u));
  }

  .b-link {
    color: var(--b-green);
    font-size: calc(8.5 * var(--u));
    text-decoration: underline;
  }

  .b-foot {
    position: absolute;
    inset: auto 0 0;
    height: calc(31 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--b-text);
    color: var(--b-bg);
    font-size: calc(8.5 * var(--u));
  }
</style>
