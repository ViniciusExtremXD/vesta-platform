---
/**
 * Concept 01 BEFORE — Halden Roofing (fictional) on a plausible 2010-era
 * contractor template (last touched in 2016), the kind site builders sold
 * small trades for years:
 * a fixed-width white column on a pinstriped blue page, a sky-gradient
 * header with a clip-art house and a "FREE Estimates!" starburst, a glossy
 * Web 2.0 tab bar with an orange active tab, a yellow "call today" ticker,
 * a cluttered left sidebar (links, bevelled button, areas-served keyword
 * list, visitor counter), a blurry upscaled slider photo, "Welcome to…!" in
 * Times, three not-quite-aligned boxes (one with a broken image) and the
 * phone number only in the tiny footer. Dated and poor, not a parody.
 * Findings A1–A4: src/data/concepts/halden.ts. Every text pair passes AA on
 * its own opaque fill. Sizes use --u (one reference px of the 760 × 475
 * drawing, resolved against the nearest size container).
 */
import { halden } from '../../../data/concepts/halden';

export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const B = halden.before;

/* drawing-only strings (period copy, fictional business) */
const X = {
  tagline: 'Roofing • Repairs • Gutters',
  burst: ['FREE', 'Estimates!'],
  ticker: '*** STORM SEASON IS HERE! Call today for a FREE roof inspection!! ***',
  sideHead: 'Services',
  sideLinks: ['Roof Repair', 'Re-Roofing', 'Metal Roofs', 'Gutters', 'Skylights', 'Insurance Claims'],
  formHead: 'Free Quote Request',
  fields: ['Name:', 'Phone:', 'Email:'],
  button: 'Get a FREE Estimate!',
  areasHead: 'Areas Served',
  areas: 'Austin, Round Rock, Cedar Park, Pflugerville, Georgetown, Leander, Kyle, Buda and surrounding areas.',
  counter: 'You are visitor #',
  digits: '004817',
  updated: 'Last updated: 03/14/2016',
  slideCount: '1 / 3',
  intro:
    'Halden Roofing is a full service roofing contractor serving Austin and the surrounding areas. From minor repairs to complete re-roofing, no job is too big or too small! Residential & Commercial. Call today for your FREE estimate!!',
  broken: 'roof-repair2.jpg',
  footLinks: 'Home | About | Services | Gallery | Contact',
  rights: 'All Rights Reserved.',
  bestViewed: 'Best viewed in Internet Explorer 8 at 1024 x 768',
};

/* the slider "photo": a 70 × 20 thumbnail blown up to 490 px wide, drawn as
   run-length pixel rows and softened in CSS (an upscaled JPEG) */
const sky = ['#6fa3db', '#74a6dc', '#79aade', '#7fade0', '#84b1e1', '#8ab4e2', '#8fb8e4', '#95bce5', '#9bc0e7', '#a1c4e8', '#a6c8ea', '#abcbeb'];
const px = (x: number, y: number): string => {
  if (y >= 17) return x > 55 && x < 67 ? '#b3ada1' : y === 17 ? '#6f9a3e' : '#5d8531';
  if (x >= 7 && x <= 8 && y >= 11) return '#5a3d22';
  const dx = x - 8;
  const dy = (y - 8) * 1.3;
  if (dx * dx + dy * dy <= 24) return (x + y) % 3 === 0 ? '#3d6628' : '#4c7a33';
  if (x >= 46 && x <= 48 && y >= 3 && y <= 6) return '#9a4a33';
  if (y >= 2 && y <= 10 && Math.abs(x - 37) <= (y - 2) * 2.4) return y === 10 ? '#e6e0d4' : y % 2 ? '#57534c' : '#48453f';
  if (y >= 11 && y <= 16 && x >= 21 && x <= 53) {
    if (y >= 12 && y <= 14 && ((x >= 25 && x <= 29) || (x >= 45 && x <= 49))) return '#6d8fae';
    if (y >= 13 && x >= 35 && x <= 38) return '#6b3f22';
    return y % 2 ? '#d7c7a1' : '#cdbc95';
  }
  if ((y === 3 && x >= 56 && x <= 64) || (y === 4 && x >= 58 && x <= 62)) return '#e4edf6';
  return sky[Math.min(y, sky.length - 1)];
};
const runs: { x: number; y: number; w: number; c: string }[] = [];
for (let y = 0; y < 20; y++) {
  let start = 0;
  for (let x = 1; x <= 70; x++) {
    if (x === 70 || px(x, y) !== px(start, y)) {
      runs.push({ x: start, y, w: x - start, c: px(start, y) });
      start = x;
    }
  }
}

/* the starburst behind "FREE Estimates!" */
const burst = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2;
  const r = i % 2 ? 23 : 31;
  return `${(32 + Math.cos(a) * r).toFixed(1)},${(32 + Math.sin(a) * r).toFixed(1)}`;
}).join(' ');
---

<div class:list={['b-site', cls]} aria-hidden="true">
  <div class="b-page">
    <!-- header: clip-art house, embossed Times logo, starburst -->
    <div class="b-head">
      <svg class="b-house" viewBox="0 0 64 50" aria-hidden="true">
        <circle cx="55" cy="9" r="6.5" fill="#FFD200" stroke="#E08A00" stroke-width="1.2"></circle>
        <path d="M44 7h6v14h-6z" fill="#9A4A33" stroke="#222222" stroke-width="1.6"></path>
        <path d="M11 24h42v22H11z" fill="#F5E6B8" stroke="#222222" stroke-width="2"></path>
        <path d="M3 27 32 5l29 22z" fill="#C8102E" stroke="#222222" stroke-width="2" stroke-linejoin="round"></path>
        <path d="M11 22.5 32 7" stroke="#FF7A8A" stroke-width="1.6" stroke-linecap="round"></path>
        <path d="M14 20h36M21 14.5h22" stroke="#8A0B1F" stroke-width="1.2"></path>
        <path d="M28 33h9v13h-9z" fill="#8B4513" stroke="#222222" stroke-width="1.4"></path>
        <path d="M15 30h8v8h-8zM41 30h8v8h-8z" fill="#9CD3F7" stroke="#222222" stroke-width="1.4"></path>
        <path d="M19 30v8M15 34h8M45 30v8M41 34h8" stroke="#222222" stroke-width="0.9"></path>
        <path d="M1 47h62" stroke="#3E7D2A" stroke-width="3"></path>
      </svg>
      <span class="b-logo">{B.logo}</span>
      <span class="b-tagline">{X.tagline}</span>
      <span class="b-mail">{B.topBar}</span>
      <span class="b-burst">
        <svg viewBox="0 0 64 64" aria-hidden="true"><polygon points={burst} fill="#FFDD00" stroke="#C8102E" stroke-width="1.6"></polygon></svg>
        <span class="b-burst-t"><b>{X.burst[0]}</b>{X.burst[1]}</span>
      </span>
    </div>

    <!-- glossy tab bar -->
    <div class="b-nav">
      {B.nav.map((l, i) => <span class:list={['b-navl', i === 0 && 'is-on']}>{l}</span>)}
    </div>

    <div class="b-ticker"><span>{X.ticker}</span></div>

    <!-- cluttered left sidebar -->
    <div class="b-side">
      <span class="b-bar">{X.sideHead}</span>
      <span class="b-links">{X.sideLinks.map((l) => <span class="b-sl">» <u>{l}</u></span>)}</span>
      <span class="b-bar b-bar--3">{X.formHead}</span>
      <span class="b-form">
        {X.fields.map((f) => <span class="b-field"><span class="b-lab">{f}</span><i></i></span>)}
        <span class="b-btn">{X.button}</span>
      </span>
      <span class="b-bar b-bar--2">{X.areasHead}</span>
      <span class="b-areas">{X.areas}</span>
      <span class="b-count">
        <span class="b-count-l">{X.counter}</span>
        <span class="b-digits">{[...X.digits].map((d) => <i>{d}</i>)}</span>
      </span>
      <span class="b-upd">{X.updated}</span>
    </div>

    <!-- slider: an upscaled, soft photo -->
    <div class="b-slide">
      <svg class="b-pic" viewBox="0 0 70 20" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
        {runs.map((r) => <rect x={r.x} y={r.y} width={r.w + 0.04} height="1.04" fill={r.c} />)}
      </svg>
      <span class="b-arr b-arr--l"><svg viewBox="0 0 10 16" aria-hidden="true"><path d="M7 2 2 8l5 6" fill="none" stroke="#222222" stroke-width="2.2"></path></svg></span>
      <span class="b-arr b-arr--r"><svg viewBox="0 0 10 16" aria-hidden="true"><path d="m3 2 5 6-5 6" fill="none" stroke="#222222" stroke-width="2.2"></path></svg></span>
      <span class="b-cap"><span class="b-cap-t">{B.heroSub}</span><span class="b-cap-n">{X.slideCount}</span></span>
    </div>

    <span class="b-welcome">{B.welcome}!</span>
    <span class="b-intro">{X.intro}</span>

    <!-- three boxes, not quite aligned; the middle photo never loaded -->
    <div class="b-boxes">
      {
        B.boxes.map((t, i) => (
          <div class:list={['b-box', `b-box--${i + 1}`]}>
            <span class="b-box-h">{t}</span>
            {i === 0 && (
              <svg class="b-clip" viewBox="0 0 32 32" aria-hidden="true">
                <path d="m6 28 13-13 3 3-13 13c-1 1-2.2 1-3 0s-1-2 0-3Z" fill="#E0A458" stroke="#222222" stroke-width="1.4" />
                <path d="m14 8 6-6c2-1 4 0 5 1l-3 3 7 7-4 4-7-7-3 3Z" fill="#9AA4AD" stroke="#222222" stroke-width="1.4" />
                <path d="m21 5 3-2" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" />
              </svg>
            )}
            {i === 1 && (
              <span class="b-broken">
                <svg viewBox="0 0 12 14" aria-hidden="true">
                  <path d="M.5.5h8l3 3v10H.5z" fill="#FFFFFF" stroke="#8A8A8A" />
                  <path d="m3 5 5 5M8 5l-5 5" stroke="#D0021B" stroke-width="1.6" />
                </svg>
                <span class="b-alt">{X.broken}</span>
              </span>
            )}
            {i === 2 && (
              <svg class="b-clip" viewBox="0 0 32 32" aria-hidden="true">
                <path d="M7 17c-4 0-5-6 0-7 0-5 7-7 9-3 2-3 8-2 8 2 5 0 5 8 0 8Z" fill="#CFD8E3" stroke="#222222" stroke-width="1.4" />
                <path d="m9 22-2 4M15 22l-2 4M21 22l-2 4M12 27l-1 2M18 27l-1 2" stroke="#2B7BD6" stroke-width="2" stroke-linecap="round" />
              </svg>
            )}
            <span class="b-box-t">{B.boxText}</span>
            <span class="b-box-l">{B.boxLink}</span>
          </div>
        ))
      }
    </div>

    <!-- footer: the only place the phone number appears -->
    <div class="b-foot">
      <span class="b-foot-l">{X.footLinks}</span>
      <span class="b-foot-c">© 2016 {B.footer} · {X.rights}</span>
      <span class="b-foot-v">{X.bestViewed}</span>
    </div>
  </div>
</div>

<style>
  .b-site {
    --u: calc(100cqi / 760);
    --b-navy: #12306b;
    --b-blue: #1d4f91;
    --b-red: #b3121b;
    --b-link: #0645ad;
    --b-times: 'Times New Roman', Times, 'Liberation Serif', serif;
    --b-verdana: Verdana, Geneva, Tahoma, sans-serif;
    --b-comic: 'Comic Sans MS', 'Comic Neue', 'Chalkboard SE', 'Comic Sans', cursive;
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* the page behind the fixed-width column: pinstriped blue */
    background-color: #3f6ea3;
    background-image: repeating-linear-gradient(
      135deg,
      rgb(255 255 255 / 0.07) 0 calc(2 * var(--u)),
      rgb(255 255 255 / 0) calc(2 * var(--u)) calc(6 * var(--u))
    );
    color: #333333;
    font-family: Arial, Helvetica, sans-serif;
    font-stretch: 100%;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }

  .b-page {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(56 * var(--u));
    width: calc(648 * var(--u));
    border-inline: 1px solid #1c3d66;
    background-color: #ffffff;
  }

  /* ---------- header ---------- */
  .b-head {
    position: absolute;
    inset: 0 0 auto;
    height: calc(64 * var(--u));
    background-color: #cfe6f7;
    background-image: linear-gradient(180deg, #a3cff0 0%, #e3f1fb 100%);
    border-bottom: 1px solid #7fa6cf;
  }

  .b-house {
    position: absolute;
    left: calc(10 * var(--u));
    top: calc(7 * var(--u));
    width: calc(62 * var(--u));
    height: calc(49 * var(--u));
  }

  .b-logo {
    position: absolute;
    left: calc(80 * var(--u));
    top: calc(9 * var(--u));
    color: var(--b-navy);
    font-family: var(--b-times);
    font-size: calc(28 * var(--u));
    font-weight: 700;
    line-height: 1;
    text-shadow:
      calc(1.5 * var(--u)) calc(1.5 * var(--u)) 0 #ffffff,
      calc(2.5 * var(--u)) calc(2.5 * var(--u)) 0 #7fa6cf;
    white-space: nowrap;
  }

  .b-tagline {
    position: absolute;
    left: calc(84 * var(--u));
    top: calc(42 * var(--u));
    color: #b0120a;
    font-family: var(--b-comic);
    font-size: calc(10 * var(--u));
    font-weight: 700;
    white-space: nowrap;
  }

  .b-mail {
    position: absolute;
    right: calc(96 * var(--u));
    top: calc(5 * var(--u));
    color: var(--b-navy);
    font-family: var(--b-verdana);
    font-size: calc(6.5 * var(--u));
    white-space: nowrap;
  }

  .b-burst {
    position: absolute;
    right: calc(14 * var(--u));
    top: calc(-2 * var(--u));
    width: calc(68 * var(--u));
    height: calc(68 * var(--u));
    transform: rotate(-12deg);
  }

  .b-burst svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .b-burst-t {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 calc(1 * var(--u));
    background-color: #ffdd00;
    color: #a50c22;
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(7.5 * var(--u));
    font-weight: 700;
    line-height: 1.05;
    transform: translate(-50%, -50%);
  }

  .b-burst-t b {
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(12 * var(--u));
    font-weight: 900;
  }

  /* ---------- glossy tab bar ---------- */
  .b-nav {
    position: absolute;
    top: calc(64 * var(--u));
    left: 0;
    right: 0;
    height: calc(22 * var(--u));
    display: flex;
    padding-left: calc(6 * var(--u));
    background-color: var(--b-blue);
    background-image: linear-gradient(180deg, #4a7bbd 0%, #2b5e9e 50%, var(--b-blue) 50%, #173f75 100%);
    border-bottom: 1px solid #0f2f5c;
  }

  .b-navl {
    display: flex;
    align-items: center;
    padding-inline: calc(13 * var(--u));
    border-left: 1px solid #6d95c8;
    border-right: 1px solid #0f2f5c;
    color: #ffffff;
    font-family: var(--b-verdana);
    font-size: calc(8 * var(--u));
    font-weight: 700;
    text-shadow: 0 calc(-1 * var(--u)) 0 #0f2f5c;
  }

  .b-navl.is-on {
    background-color: #f5b041;
    background-image: linear-gradient(180deg, #ffd27a 0%, #f5b041 50%, #f09a1a 51%, #f5b041 100%);
    color: var(--b-navy);
    text-shadow: 0 calc(1 * var(--u)) 0 #ffe7b0;
  }

  /* ---------- the ticker ---------- */
  .b-ticker {
    position: absolute;
    top: calc(87 * var(--u));
    left: 0;
    right: 0;
    height: calc(13 * var(--u));
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-left: calc(118 * var(--u));
    border-bottom: 1px solid #d9c200;
    background-color: #fff38a;
    white-space: nowrap;
  }

  .b-ticker span {
    color: #b0120a;
    font-size: calc(7.5 * var(--u));
    font-weight: 700;
  }

  /* ---------- sidebar ---------- */
  .b-side {
    position: absolute;
    top: calc(101 * var(--u));
    left: 0;
    width: calc(140 * var(--u));
    bottom: calc(40 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--u));
    padding: calc(6 * var(--u)) calc(6 * var(--u)) 0;
    border-right: 1px solid #b8c6d8;
    background-color: #e9eef5;
  }

  .b-bar {
    padding: calc(3 * var(--u)) calc(5 * var(--u));
    background-color: #9c3906;
    background-image: linear-gradient(180deg, #b54e12 0%, #93360a 100%);
    color: #ffffff;
    font-family: var(--b-verdana);
    font-size: calc(8 * var(--u));
    font-weight: 700;
    text-shadow: calc(1 * var(--u)) calc(1 * var(--u)) 0 #5c2004;
  }

  .b-bar--2 {
    margin-top: calc(2 * var(--u));
    background-color: var(--b-blue);
    background-image: linear-gradient(180deg, #2b5e9e 0%, #173f75 100%);
    text-shadow: calc(1 * var(--u)) calc(1 * var(--u)) 0 #0f2f5c;
  }

  .b-bar--3 {
    margin-top: calc(2 * var(--u));
    background-color: #276b2b;
    background-image: linear-gradient(180deg, #2f7d33 0%, #1b5220 100%);
    text-shadow: calc(1 * var(--u)) calc(1 * var(--u)) 0 #0f3312;
  }

  .b-links {
    display: flex;
    flex-direction: column;
    gap: calc(2.5 * var(--u));
    padding-left: calc(3 * var(--u));
  }

  .b-sl {
    color: var(--b-link);
    font-family: var(--b-verdana);
    font-size: calc(7.5 * var(--u));
  }

  .b-form {
    display: flex;
    flex-direction: column;
    gap: calc(3 * var(--u));
    padding-inline: calc(2 * var(--u));
  }

  .b-field {
    display: flex;
    align-items: center;
    gap: calc(3 * var(--u));
  }

  .b-lab {
    width: calc(26 * var(--u));
    color: #333333;
    font-family: var(--b-verdana);
    font-size: calc(6.5 * var(--u));
  }

  .b-field i {
    flex: 1;
    height: calc(10 * var(--u));
    border: 1px solid;
    border-color: #7a7a7a #dcdcdc #dcdcdc #7a7a7a;
    background-color: #ffffff;
  }

  .b-btn {
    align-self: center;
    margin-top: calc(2 * var(--u));
    padding: calc(4 * var(--u)) calc(7 * var(--u));
    border: calc(2 * var(--u)) outset #e59a5f;
    background-color: #a8400a;
    background-image: linear-gradient(180deg, #bd5214 0%, #93360a 100%);
    color: #ffffff;
    font-size: calc(8 * var(--u));
    font-weight: 700;
    white-space: nowrap;
  }

  .b-areas {
    color: #333333;
    font-family: var(--b-times);
    font-size: calc(7.5 * var(--u));
    line-height: 1.25;
  }

  .b-count {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(2 * var(--u));
    margin-top: calc(4 * var(--u));
  }

  .b-count-l,
  .b-upd {
    color: #555555;
    font-family: var(--b-verdana);
    font-size: calc(6.5 * var(--u));
  }

  .b-upd {
    align-self: center;
  }

  .b-digits {
    display: flex;
    gap: 1px;
    padding: 1px;
    background-color: #777777;
  }

  .b-digits i {
    padding: calc(1 * var(--u)) calc(2 * var(--u));
    background-color: #111111;
    color: #ffffff;
    font-size: calc(8 * var(--u));
    font-style: normal;
    font-weight: 700;
  }

  /* ---------- slider ---------- */
  .b-slide {
    position: absolute;
    top: calc(106 * var(--u));
    left: calc(148 * var(--u));
    width: calc(492 * var(--u));
    height: calc(136 * var(--u));
    overflow: hidden;
    border: 1px solid #1c3d66;
    background-color: #8fb8e4;
  }

  .b-pic {
    position: absolute;
    inset: calc(-3 * var(--u));
    display: block;
    width: calc(100% + 6 * var(--u));
    height: calc(100% + 6 * var(--u));
    filter: blur(calc(2.2 * var(--u))) saturate(1.3) contrast(1.08);
  }

  /* a cheap camera: dark corners, a warm cast */
  .b-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 75% 85% at 50% 45%, rgb(0 0 0 / 0) 55%, rgb(20 16 0 / 0.38) 100%),
      linear-gradient(180deg, rgb(255 214 120 / 0.14), rgb(255 214 120 / 0.14));
    pointer-events: none;
  }

  .b-arr,
  .b-cap {
    z-index: 1;
  }

  .b-arr {
    position: absolute;
    top: calc(48 * var(--u));
    display: grid;
    place-items: center;
    width: calc(16 * var(--u));
    height: calc(24 * var(--u));
    border: calc(2 * var(--u)) outset #f2f2f2;
    background-color: #dddddd;
  }

  .b-arr svg {
    width: calc(6 * var(--u));
    height: calc(10 * var(--u));
  }

  .b-arr--l {
    left: calc(5 * var(--u));
  }

  .b-arr--r {
    right: calc(5 * var(--u));
  }

  .b-cap {
    position: absolute;
    inset: auto 0 0;
    height: calc(17 * var(--u));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: calc(8 * var(--u));
    background-color: #1a1a1a;
    color: #ffffff;
    font-size: calc(8.5 * var(--u));
  }

  .b-cap-n {
    font-size: calc(7 * var(--u));
  }

  /* ---------- welcome + intro ---------- */
  .b-welcome {
    position: absolute;
    top: calc(247 * var(--u));
    left: calc(156 * var(--u));
    color: var(--b-red);
    font-family: var(--b-times);
    font-size: calc(20 * var(--u));
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }

  .b-intro {
    position: absolute;
    top: calc(273 * var(--u));
    left: calc(156 * var(--u));
    width: calc(478 * var(--u));
