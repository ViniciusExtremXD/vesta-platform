---
/**
 * Concept 04 AFTER — Marlowe & Pike Injury Law (fictional), rebuilt, as six
 * stacked layers. Rendered by ConceptPlate.astro through the registry; DOM
 * contract: src/components/concepts/README.md.
 *
 *   .cp-layer.cp-l1  wireframe hairlines + box tags          --i:0
 *   .cp-layer.cp-l2  charcoal + stone, wide-caps name, serif
 *                    headline, the ampersand, practice index --i:1  (opaque)
 *   .cp-layer.cp-l3  art frame + load waterfall bars         --i:2
 *   .cp-layer.cp-l4  JSON-LD card + sitemap tree             --i:3
 *   .cp-layer.cp-l5  brass / outline / chat buttons          --i:4
 *   .cp-layer.cp-l6  event pins                              --i:5
 *
 * Identity (vs Halden's slate + copper + condensed sans): warm charcoal,
 * stone and a restrained brass; the firm name in wide Mona Sans caps
 * (wdth 125), the headline in a system serif, the firm's own ampersand as the
 * only art. Internal motion (transform/opacity only, paused offscreen): the
 * ampersand drifts slowly, a hairline ring breathes around the primary
 * button, and a brass marker walks the four practice areas.
 */
import { law, lawDrawing } from '../../../data/concepts/law';

const A = law.after;
const X = lawDrawing.after;
---

<div class="cp-layer cp-l1" style="--i:0">
  <svg class="w-grid" viewBox="0 0 760 475" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M32 .5V475M90 .5V475M148 .5V475M206 .5V475M264 .5V475M322 .5V475M380 .5V475M438 .5V475M496 .5V475M554 .5V475M612 .5V475M670 .5V475M728 .5V475"
      fill="none"
      stroke="#ADA597"
      stroke-opacity=".2"
      vector-effect="non-scaling-stroke"></path>
    <path d="M0 48.5H760M0 336.5H760" fill="none" stroke="#B39459" stroke-opacity=".35" vector-effect="non-scaling-stroke"></path>
  </svg>
  <span class="w-box w-nav"><span class="w-tag">{A.wireframeTags[0]}</span></span>
  <span class="w-box w-h1"><span class="w-tag">{A.wireframeTags[1]}</span></span>
  <span class="w-box w-cta"><span class="w-tag">{A.wireframeTags[2]}</span></span>
  <span class="w-box w-svc"><span class="w-tag">{A.wireframeTags[3]}</span></span>
</div>

<div class="cp-layer cp-l4" style="--i:3">
  <span class="d-card">
    <span class="d-brace">{'{'}</span>
    <span class="d-line">{A.jsonLd[0]},</span>
    <span class="d-line">{A.jsonLd[1]}</span>
    <span class="d-brace">{'}'}</span>
  </span>
  <span class="d-tree">
    {A.sitemap.map((p, i) => <span class:list={['d-node', i === 0 ? 'is-root' : 'is-leaf']}>{p}</span>)}
  </span>
</div>

<div class="cp-layer cp-l6" style="--i:5">
  <span class="e-pin e-pin--review"><i></i><span class="e-chip">{A.events[2]}</span></span>
  <span class="e-pin e-pin--call"><i></i><span class="e-chip">{A.events[1]}</span></span>
  <span class="e-pin e-pin--wa"><i></i><span class="e-chip">{A.events[0]}</span></span>
</div>

<div class="cp-layer cp-l2" style="--i:1">
  <div class="s-nav">
    <span class="s-logo">
      <span class="s-mark" aria-hidden="true"><span>&amp;</span></span>
      <span class="s-name" data-cp-name>{X.brand}</span>
      <span class="s-kind">{X.brandSub}</span>
    </span>
    <span class="s-links">{A.nav.map((l) => <span class="s-link">{l}</span>)}</span>
    <span class="s-phone">{law.phone}</span>
  </div>

  <span class="s-eyebrow"><i></i>{X.eyebrow}</span>
  <span class="s-h1">{X.headlineLines.map((l) => <span>{l}</span>)}</span>
  <span class="s-sub">{A.sub.split(/(?<=\.) /).map((l) => <span>{l}</span>)}</span>

  <div class="s-art" aria-hidden="true">
    <span class="s-amp">&amp;</span>
  </div>

  <div class="s-band">
    <span class="s-band-label">{X.practiceLabel}</span>
    <span class="s-cols">
      {
        A.services.map((s, i) => (
          <span class="s-col">
            <span class="s-idx">0{i + 1}</span>
            <span class="s-svc">{s}</span>
            <svg class="s-arrow" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="#B39459" stroke-width="1.4" />
            </svg>
          </span>
        ))
      }
      <i class="s-walk" aria-hidden="true"></i>
    </span>
    <span class="s-served">{X.served}</span>
  </div>
</div>

<div class="cp-layer cp-l3" style="--i:2">
  <span class="f-frame f-art"><i class="f-c f-c1"></i><i class="f-c f-c2"></i><i class="f-c f-c3"></i><i class="f-c f-c4"></i></span>
  <svg class="f-fall" viewBox="0 0 320 288" preserveAspectRatio="none" aria-hidden="true">
    <g fill="#8C8577" fill-opacity=".26">
      <rect x="30" y="30" width="24" height="3"></rect>
      <rect x="36" y="39" width="40" height="3"></rect>
      <rect x="46" y="48" width="28" height="3"></rect>
      <rect x="54" y="57" width="52" height="3"></rect>
      <rect x="66" y="66" width="34" height="3"></rect>
      <rect x="76" y="75" width="58" height="3"></rect>
    </g>
    <rect x="30" y="30" width="10" height="3" fill="#B39459"></rect>
    <rect x="54" y="57" width="16" height="3" fill="#B39459"></rect>
  </svg>
</div>

<div class="cp-layer cp-l5" style="--i:4">
  <span class="k-btn k-review">
    <i class="k-ring" aria-hidden="true"></i>
    {A.buttons[0]}
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </span>
  <span class="k-btn k-call">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M4.2 1.8 6.4 4 5 6.1c.8 1.9 2.2 3.3 4.1 4.1L11.2 9l2.2 2.2-1.6 2.3c-4.7-.4-8.5-4.2-9-9Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"></path>
    </svg>
    {A.buttons[1]}
  </span>
  <span class="k-btn k-wa">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    </svg>
    {A.buttons[2]}
  </span>
</div>

<style>
  .cp-layer {
    --u: calc(100cqi / 760);
    --l-char: #1a1918;
    --l-char-2: #242220;
    --l-deep: #100f0e;
    --l-stone: #e3ddd2;
    --l-stone-2: #d5cdbf;
    --l-white: #eee9e0;
    --l-muted: #ada597;
    --l-ink-2: #5a5449;
    --l-brass: #b39459;
    --l-serif: Georgia, 'Times New Roman', Times, serif;
    position: absolute;
    inset: 0;
    color: var(--l-white);
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
  }

  /* flat z-order: the invisible parts of a real site sit under l2 */
  .cp-l1,
  .cp-l4,
  .cp-l6 {
    z-index: 0;
  }

  .cp-l2 {
    z-index: 1;
    overflow: hidden;
    background-color: var(--l-char);
  }

  .cp-l3 {
    z-index: 2;
    pointer-events: none;
  }

  .cp-l5 {
    z-index: 3;
  }

  /* ---------- L1 wireframe ---------- */
  .w-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .w-box {
    position: absolute;
    border: 1px solid rgb(173 165 151 / 0.6);
  }

  .w-nav {
    left: calc(8 * var(--u));
    top: calc(6 * var(--u));
    width: calc(744 * var(--u));
    height: calc(36 * var(--u));
  }

  .w-h1 {
    left: calc(24 * var(--u));
    top: calc(92 * var(--u));
    width: calc(392 * var(--u));
    height: calc(136 * var(--u));
  }

  .w-cta {
    left: calc(24 * var(--u));
    top: calc(274 * var(--u));
    width: calc(368 * var(--u));
    height: calc(50 * var(--u));
  }

  .w-svc {
    left: calc(8 * var(--u));
    top: calc(346 * var(--u));
    width: calc(744 * var(--u));
    height: calc(120 * var(--u));
  }

  .w-tag {
    position: absolute;
    left: -1px;
    bottom: 100%;
    padding: calc(2 * var(--u)) calc(5 * var(--u));
    background-color: var(--l-brass);
    color: var(--l-char);
    font-size: calc(7.5 * var(--u));
    font-weight: 700;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .w-nav .w-tag,
  .w-svc .w-tag {
    bottom: auto;
    top: -1px;
  }

  /* ---------- L2 surfaces ---------- */
  .s-nav {
    position: absolute;
    inset: 0 0 auto;
    height: calc(48 * var(--u));
    display: flex;
    align-items: center;
    padding-inline: calc(32 * var(--u));
    border-bottom: 1px solid rgb(173 165 151 / 0.16);
    background-color: var(--l-char);
  }

  .s-logo {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    min-width: 0;
    max-width: calc(340 * var(--u));
  }

  .s-mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
    border: 1px solid var(--l-brass);
    color: var(--l-brass);
    font-family: var(--l-serif);
    font-size: calc(13 * var(--u));
    line-height: 1;
  }

  .s-mark span {
    translate: 0 calc(0.5 * var(--u));
  }

  .s-name {
    overflow: hidden;
    color: var(--l-white);
    font-size: calc(10 * var(--u));
    font-stretch: 125%;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .s-kind {
    flex: 0 0 auto;
    padding-left: calc(10 * var(--u));
    border-left: 1px solid rgb(173 165 151 / 0.4);
    color: var(--l-muted);
    font-size: calc(7.5 * var(--u));
    font-stretch: 110%;
    font-weight: 560;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .s-links {
    position: absolute;
    left: calc(420 * var(--u));
    display: flex;
    gap: calc(22 * var(--u));
  }

  .s-link {
    color: var(--l-muted);
    font-size: calc(9.5 * var(--u));
    font-weight: 500;
  }

  .s-phone {
    position: absolute;
    right: calc(32 * var(--u));
    color: var(--l-white);
    font-size: calc(10 * var(--u));
    font-weight: 620;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .s-eyebrow {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(76 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    color: var(--l-muted);
    font-size: calc(7.5 * var(--u));
    font-stretch: 112%;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .s-eyebrow i {
    width: calc(22 * var(--u));
    height: 1px;
    background-color: var(--l-brass);
  }

  .s-h1 {
    position: absolute;
    left: calc(30 * var(--u));
    top: calc(94 * var(--u));
    display: flex;
    flex-direction: column;
    color: var(--l-white);
    font-family: var(--l-serif);
    font-size: calc(41 * var(--u));
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.012em;
    white-space: nowrap;
  }

  .s-sub {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(234 * var(--u));
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    color: var(--l-muted);
    font-size: calc(11 * var(--u));
    line-height: 1.5;
  }

  /* the art: the firm's own ampersand, cut from a stone panel */
  .s-art {
    position: absolute;
    left: calc(440 * var(--u));
    top: calc(48 * var(--u));
    right: 0;
    height: calc(288 * var(--u));
    overflow: hidden;
    background-color: var(--l-stone);
  }

  .s-amp {
    position: absolute;
    left: calc(58 * var(--u));
    top: calc(-40 * var(--u));
    color: var(--l-char);
    font-family: var(--l-serif);
    font-size: calc(372 * var(--u));
    font-weight: 400;
    line-height: 1;
  }

  .s-band {
    position: absolute;
    inset: auto 0 0;
    height: calc(139 * var(--u));
    background-color: var(--l-char-2);
  }

  .s-band-label {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(13 * var(--u));
    color: var(--l-muted);
    font-size: calc(7.5 * var(--u));
    font-stretch: 112%;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .s-cols {
    position: absolute;
    left: calc(32 * var(--u));
    right: calc(32 * var(--u));
    top: calc(31 * var(--u));
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: calc(16 * var(--u));
  }

  .s-col {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    row-gap: calc(5 * var(--u));
    padding-top: calc(9 * var(--u));
    border-top: 1px solid rgb(173 165 151 / 0.28);
  }

  .s-idx {
    grid-column: 1 / -1;
    color: var(--l-brass);
    font-size: calc(8 * var(--u));
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .s-svc {
    color: var(--l-white);
    font-size: calc(13.5 * var(--u));
    font-weight: 560;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .s-arrow {
    width: calc(11 * var(--u));
    height: calc(11 * var(--u));
    margin-bottom: calc(2 * var(--u));
  }

  /* the brass marker on the first practice column; it walks the four
     columns when motion runs */
  .s-walk {
    position: absolute;
    left: 0;
    top: -1px;
    width: calc(42 * var(--u));
    height: 2px;
    background-color: var(--l-brass);
  }

  .s-served {
    position: absolute;
    left: calc(32 * var(--u));
    bottom: calc(28 * var(--u));
    color: var(--l-muted);
    font-size: calc(8 * var(--u));
    letter-spacing: 0.01em;
  }

  /* ---------- L3 frames + waterfall ---------- */
  .f-frame {
    position: absolute;
    border: 1px solid rgb(173 165 151 / 0.34);
  }

  .f-art {
    left: calc(454 * var(--u));
    top: calc(62 * var(--u));
    width: calc(292 * var(--u));
    height: calc(260 * var(--u));
  }

  .f-c {
    position: absolute;
    width: calc(9 * var(--u));
    height: calc(9 * var(--u));
    border: 0 solid var(--l-brass);
  }

  .f-c1 {
    left: -1px;
    top: -1px;
    border-width: 2px 0 0 2px;
  }

  .f-c2 {
    right: -1px;
    top: -1px;
    border-width: 2px 2px 0 0;
  }

  .f-c3 {
    left: -1px;
    bottom: -1px;
    border-width: 0 0 2px 2px;
  }

  .f-c4 {
    right: -1px;
    bottom: -1px;
    border-width: 0 2px 2px 0;
  }

  .f-fall {
    position: absolute;
    left: calc(440 * var(--u));
    top: calc(48 * var(--u));
    width: calc(320 * var(--u));
    height: calc(288 * var(--u));
  }

  /* ---------- L4 data ---------- */
  .d-card {
    position: absolute;
    left: calc(466 * var(--u));
    top: calc(86 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(3 * var(--u));
    width: calc(250 * var(--u));
    padding: calc(10 * var(--u)) calc(12 * var(--u));
    border: 1px solid rgb(179 148 89 / 0.7);
    background-color: var(--l-deep);
    font-size: calc(9 * var(--u));
    line-height: 1.35;
  }

  .d-brace {
    color: var(--l-muted);
  }

  .d-line {
    padding-left: calc(12 * var(--u));
    color: var(--l-white);
    white-space: nowrap;
  }

  .d-tree {
    position: absolute;
    left: calc(32 * var(--u));
    top: calc(362 * var(--u));
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: calc(5 * var(--u)) calc(26 * var(--u));
    font-size: calc(9 * var(--u));
  }

  .d-node {
    position: relative;
    color: var(--l-muted);
    white-space: nowrap;
  }

  .d-node.is-root {
    grid-column: 1 / -1;
    color: var(--l-white);
  }

  .d-node.is-leaf {
    padding-left: calc(12 * var(--u));
  }

  .d-node.is-leaf::before {
    content: '';
    position: absolute;
    left: 0;
    top: 55%;
    width: calc(7 * var(--u));
    height: 1px;
    background-color: rgb(173 165 151 / 0.6);
  }

  /* ---------- L5 buttons ---------- */
  .k-btn {
    position: absolute;
    top: calc(280 * var(--u));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(7 * var(--u));
    height: calc(36 * var(--u));
    padding-inline: calc(15 * var(--u));
    font-size: calc(10 * var(--u));
    font-weight: 620;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .k-btn svg {
    flex: 0 0 auto;
    width: calc(11 * var(--u));
    height: calc(11 * var(--u));
  }

  .k-review {
    left: calc(32 * var(--u));
    background-color: var(--l-brass);
    color: var(--l-char);
  }

  .k-ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--l-brass);
    pointer-events: none;
    opacity: 0;
  }

  .k-call {
    left: calc(184 * var(--u));
    border: 1px solid rgb(238 233 224 / 0.5);
    background-color: var(--l-char);
    color: var(--l-white);
  }

  .k-call svg {
    color: var(--l-brass);
  }

  .k-wa {
    left: calc(284 * var(--u));
    padding-inline: calc(8 * var(--u));
    background-color: var(--l-char);
    color: var(--l-white);
    text-decoration: underline;
    text-decoration-color: rgb(179 148 89 / 0.8);
    text-underline-offset: calc(4 * var(--u));
  }

  .k-wa svg {
    color: var(--l-brass);
  }

  /* ---------- L6 events ---------- */
  .e-pin {
    position: absolute;
    top: calc(326 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(5 * var(--u));
  }

  .e-pin i {
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    background-color: var(--l-brass);
  }

  .e-chip {
    padding: calc(2 * var(--u)) calc(5 * var(--u));
    background-color: var(--l-brass);
    color: var(--l-char);
    font-size: calc(8 * var(--u));
    font-weight: 650;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .e-pin--review {
    left: calc(34 * var(--u));
  }

  .e-pin--call {
    left: calc(186 * var(--u));
    top: calc(342 * var(--u));
  }

  .e-pin--wa {
    left: calc(292 * var(--u));
    top: calc(358 * var(--u));
  }

  /* ---------- internal motion: transform / opacity only, paused offscreen */
  :global(html:not(.motion-reduced)) .s-amp {
    animation: law-drift 18s ease-in-out infinite alternate;
  }

  :global(html:not(.motion-reduced)) .k-ring {
    animation: law-ring 3.6s cubic-bezier(0.22, 1, 0.36, 1) 2.4s infinite;
  }

  :global(html:not(.motion-reduced)) .s-walk {
    animation: law-walk 12s cubic-bezier(0.65, 0, 0.35, 1) 1.6s infinite;
  }

  /* (html + .cp + state) outranks the html:not(...) rules above, whose
     animation shorthand would otherwise reset the play state */
  :global(html .cp.is-offscreen) .s-amp,
  :global(html .cp.is-offscreen) .k-ring,
  :global(html .cp.is-offscreen) .s-walk,
  :global(html .cp.cp--build) .s-amp,
  :global(html .cp.cp--build) .k-ring,
  :global(html .cp.cp--build) .s-walk {
    animation-play-state: paused;
  }

  @keyframes law-drift {
    from {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    to {
      transform: translate3d(calc(-14 * var(--u)), calc(6 * var(--u)), 0) rotate(-1.2deg);
    }
  }

  @keyframes law-ring {
    0% {
      opacity: 0.9;
      transform: scale(1, 1);
    }
    55%,
    100% {
      opacity: 0;
      transform: scale(1.08, 1.35);
    }
  }

