    align-items: center;
    justify-content: space-between;
    padding-inline: calc(8 * var(--u));
    border-bottom: 1px solid #c9bc98;
    background-color: #f2ecdc;
    color: var(--b-navy);
    font-size: calc(6.2 * var(--u));
  }

  /* ---------- banner ---------- */
  .b-banner {
    top: calc(13 * var(--u));
    left: 0;
    right: 0;
    height: calc(74 * var(--u));
    background-color: #2a1f4a;
    background-image: linear-gradient(90deg, #1b2a5c, #2b2f63 45%, #6b1414);
  }

  .b-scales {
    position: absolute;
    left: calc(14 * var(--u));
    top: calc(9 * var(--u));
    width: calc(60 * var(--u));
    height: calc(56 * var(--u));
  }

  .b-name {
    position: absolute;
    left: calc(82 * var(--u));
    top: calc(10 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
  }

  .b-firm {
    color: #ebcb73;
    font-family: 'Times New Roman', Times, serif;
    font-size: calc(29 * var(--u));
    font-weight: 700;
