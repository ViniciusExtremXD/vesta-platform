    color: var(--b-navy);
    font-family: 'Times New Roman', Times, serif;
    font-size: calc(13 * var(--u));
    font-weight: 700;
  }

  .b-form-lead {
    font-size: calc(6.8 * var(--u));
  }

  .b-fields {
    display: flex;
