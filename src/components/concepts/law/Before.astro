  }

  .b-serve {
    color: #d9d9d9;
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(7 * var(--u));
  }

  .b-cols {
    position: absolute;
    left: calc(398 * var(--u));
    top: 0;
    width: calc(90 * var(--u));
    height: calc(74 * var(--u));
  }

  /* ---------- glossy gold tabs ---------- */
  .b-nav {
    top: calc(87 * var(--u));
    left: 0;
    right: 0;
    height: calc(19 * var(--u));
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid #8c7330;
    background-color: #d8b95e;
    background-image: linear-gradient(#f6e7ae, #e2c678 48%, #cfad4c 52%, #c4a043);
  }

  .b-tab {
    display: flex;
    align-items: center;
    padding-inline: calc(10 * var(--u));
    border-left: 1px solid #fff3c8;
    border-right: 1px solid #8c7330;
    color: #5a0f0f;
    font-size: calc(7.3 * var(--u));
    font-weight: 700;
  }

  .b-tab.is-on {
    background-color: #1b2a5c;
    background-image: linear-gradient(#3b4f8c, #1b2a5c 55%);
    color: #ffffff;
  }

  /* ---------- red-on-yellow ticker (drifts in hero mode) ---------- */
  .b-ticker {
    top: calc(106 * var(--u));
    left: 0;
    right: 0;
    height: calc(12 * var(--u));
    overflow: hidden;
    border-bottom: 1px solid #d4c020;
