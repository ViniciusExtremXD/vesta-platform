  }

  .b-hours {
    display: flex;
    flex-direction: column;
    padding: calc(4 * var(--u)) calc(6 * var(--u));
    font-family: 'Times New Roman', Times, serif;
    font-size: calc(8.4 * var(--u));
    line-height: 1.3;
  }

  .b-count {
    display: flex;
    align-items: center;
    gap: calc(4 * var(--u));
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(6.8 * var(--u));
  }

  .b-digits {
    display: flex;
    gap: 1px;
  }

  .b-digits b {
    padding: calc(1 * var(--u)) calc(2 * var(--u));
    background-color: #000000;
    color: #7cfc00;
    font-size: calc(8 * var(--u));
  }

  .b-updated {
    color: #595959;
    font-size: calc(6 * var(--u));
  }

  /* ---------- main column ---------- */
  .b-main,
  .b-form {
    left: calc(158 * var(--u));
    width: calc(306 * var(--u));
    gap: calc(5 * var(--u));
  }

  .b-form {
    top: calc(334 * var(--u));
  }

  .b-h1 {
    color: #7a1a1a;
    font-family: 'Times New Roman', Times, serif;
    font-size: calc(17 * var(--u));
    font-weight: 700;
