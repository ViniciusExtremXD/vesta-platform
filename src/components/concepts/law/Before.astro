---
/**
 * Concept 04 BEFORE — Marlowe & Pike Injury Law (fictional) on a plausible
 * late-2000s small-firm template, last touched in 2014. Dated and poor, not a
 * parody: a fixed-width white page centred on a linen wallpaper, a navy-to-
 * maroon banner with scales-of-justice clip art, a Times New Roman firm name
 * with a drop shadow, a glossy gold tab bar, a red-on-yellow ticker, three
 * crowded columns (practice list, visitor counter, stale news, an
 * "under construction" note), a low-res skyline photo, a wall of grey
 * Verdana, a shouted "Welcome…!!!" and the only contact form cut off by the
 * fold (no phone number anywhere on screen). Mixed Times / Verdana / Arial.
 * Every text pair passes AA on its own fill (text on a gradient sits on the
 * gradient's darkest or lightest stop that still passes, and the element's
 * background-color is that stop).
 * Rendered by ConceptPlate.astro through the registry (../registry.ts);
 * sizes use --u (one reference px of the 760-wide drawing). Renders twice in
 * hero mode: no ids.
 */
import { law, lawDrawing } from '../../../data/concepts/law';

export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;

const B = law.before;
const X = lawDrawing.before;

/* drawing-only strings (the dated site's own clutter) */
const L = {
  welcome: 'Welcome to Marlowe & Pike Injury Law!!!',
  util: ['Home', 'Site Map', 'Bookmark This Page'],
  navExtra: ['Links', 'FAQ'],
  ticker: ['Hablamos Español', 'Free Consultation', 'No Fee Unless You Win', 'Serving Atlanta and All of Georgia'],
  practiceMore: ['Truck Accidents', 'Dog Bites', 'Nursing Home Abuse'],
  visitors: 'Visitors:',
  counter: '004127',
  updated: 'Last updated: 12/02/2014',
  photoCap: 'Downtown Atlanta',
  newsTitle: 'Legal News',
  news: [
    ['11/24/2014', 'Holiday Office Closing'],
    ['08/04/2014', 'Firm Moves to Suite 400'],
    ['04/15/2014', 'Spring Newsletter Now Available'],
  ],
  construction: 'Case Results page under construction. Check back soon!',
  submit: 'Submit',
};
const practice = [...X.practice, ...L.practiceMore];

/* low-res stock photo: a 20 × 14 skyline, drawn as runs of pixels */
const pal: Record<string, string> = {
  a: '#6F8FB8', b: '#86A3C6', c: '#A3B9D4', d: '#BCCBDD',
  g: '#4C5A6E', h: '#5F6D82', y: '#D8C98A', k: '#39424F',
};
const sky = [
  'aaaaaaaaaaaaaaaaaaaa',
  'aaaaaaaaaaaaaaaaaaaa',
  'bbbbbbbbbbbbhbbbbbbb',
  'bbbbbbbbbbbhhhbbbbbb',
  'cccccgccccchhhcccccc',
  'cccccgccccchyhcccgcc',
  'ddddgggdddhhhhhddggd',
  'ddkkgygddkhyhhhdgggd',
  'dkkkgggkkkhhhyhkgygk',
  'kkykgygkkkhhhhhkgggk',
  'kkkkgggkykhyhhhkgygk',
  'kkykgggkkkhhhhhkgggk',
  'kkkkkkkkkkkkkkkkkkkk',
  'kkkkkkkkkkkkkkkkkkkk',
];
const runs = (rows: string[]) =>
  rows.flatMap((row, y) => {
    const out: { x: number; y: number; w: number; f: string }[] = [];
    let x = 0;
    while (x < row.length) {
      let w = 1;
      while (row[x + w] === row[x]) w++;
      out.push({ x, y, w, f: pal[row[x]] });
      x += w;
    }
    return out;
  });
const skyline = runs(sky);

/* starburst: 18 spikes on an ellipse (viewBox 100 × 64) */
const burst = Array.from({ length: 36 }, (_, i) => {
  const a = (i / 36) * Math.PI * 2;
  const r = i % 2 ? 0.78 : 1;
  return `${(50 + Math.cos(a) * 49 * r).toFixed(1)},${(32 + Math.sin(a) * 31 * r).toFixed(1)}`;
}).join(' ');
---

<div class:list={['b-site', cls]} aria-hidden="true">
  <div class="b-page">
    <div class="b-util">
      <span>{B.topBar}</span>
      <span>{L.util.join(' | ')}</span>
    </div>

    <div class="b-banner">
      <svg class="b-scales" viewBox="0 0 60 56" aria-hidden="true">
        <path d="M29 6h2v40h-2Z" fill="#E3C06A"></path>
        <circle cx="30" cy="5" r="3" fill="#E3C06A"></circle>
        <path d="M8 12h44v2.4H8Z" fill="#E3C06A"></path>
        <path d="M9 14 3 30M9 14l6 16M51 14l-6 16M51 14l6 16" stroke="#B08A34" stroke-width="0.9" fill="none"></path>
        <path d="M1 30h16c-1 5-4 7-8 7s-7-2-8-7ZM43 30h16c-1 5-4 7-8 7s-7-2-8-7Z" fill="#E3C06A"></path>
        <path d="M22 46h16l3 6H19Z" fill="#B08A34"></path>
      </svg>
      <span class="b-name">
        <span class="b-firm">{B.logo}</span>
        <span class="b-atty">Injury Law &nbsp;·&nbsp; {B.heroSub}</span>
        <span class="b-serve">{X.topLeft}</span>
      </span>
      <svg class="b-cols" viewBox="0 0 90 74" aria-hidden="true">
        <g fill="#34467C">
          <path d="M6 8h26v5H6ZM8 64h22v6H8ZM52 8h26v5H52ZM54 64h22v6H54Z"></path>
          <path d="M10 13h3v51h-3ZM15.5 13h3v51h-3ZM21 13h3v51h-3ZM26 13h2v51h-2ZM56 13h3v51h-3ZM61.5 13h3v51h-3ZM67 13h3v51h-3ZM72 13h2v51h-2Z"></path>
          <path d="M0 8 42 0l42 8Z"></path>
        </g>
      </svg>
    </div>

    <div class="b-nav">
      {[...B.nav, ...L.navExtra].map((l, i) => <span class:list={['b-tab', i === 0 && 'is-on']}>{l}</span>)}
    </div>

    <div class="b-ticker">
      <span class="b-ticker-run">
        {[0, 1].map(() => L.ticker.map((t) => <span>*** {t} </span>))}
      </span>
    </div>

    <div class="b-burst">
      <svg viewBox="0 0 100 64" preserveAspectRatio="none" aria-hidden="true">
        <polygon points={burst} fill="#FFE600" stroke="#C00000" stroke-width="1.2"></polygon>
      </svg>
      <span class="b-burst-t">{X.headRight}!</span>
    </div>

    <!-- left: practice list, hours, visitor counter -->
    <div class="b-lside">
      <div class="b-box">
        <span class="b-boxh">{B.nav[2]}</span>
        <span class="b-list">
          {practice.map((p, i) => <span class:list={['b-li', i === 2 && 'is-seen']}>» <u>{p}</u></span>)}
        </span>
      </div>
      <div class="b-box">
        <span class="b-boxh b-boxh--navy">{X.hoursTitle}</span>
        <span class="b-hours">{X.hours.map((h) => <span>{h}</span>)}</span>
      </div>
      <span class="b-count">
        <span class="b-count-l">{L.visitors}</span>
        <span class="b-digits">{L.counter.split('').map((d) => <b>{d}</b>)}</span>
      </span>
      <span class="b-updated">{L.updated}</span>
    </div>

    <!-- main: welcome, slogan, photo + wall -->
    <div class="b-main">
      <span class="b-h1">{L.welcome}</span>
      <span class="b-slogan">{B.welcome}</span>
      <span class="b-copy">
        <span class="b-photo">
          <svg viewBox="0 0 20 14" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
            {skyline.map((p) => <rect x={p.x} y={p.y} width={p.w + 0.05} height="1.05" fill={p.f} />)}
          </svg>
          <span class="b-photo-cap">{L.photoCap}</span>
        </span>
        <span class="b-wall">{B.boxText}</span>
        <span class="b-wall">{X.wall2}</span>
      </span>
      <span class="b-more">{B.heroButton}</span>
    </div>

    <!-- the only contact form, pinned where the fold cuts it -->
    <div class="b-form">
      <span class="b-hr"></span>
      <span class="b-form-title">{X.formTitle}</span>
      <span class="b-form-lead">{X.formLead}</span>
      <span class="b-fields">
        {X.fields.slice(0, 3).map((f) => <span class="b-field"><span class="b-flabel">{f}</span><i></i></span>)}
      </span>
      <span class="b-field b-field--area"><span class="b-flabel">{X.fields[3]}</span><i></i></span>
    </div>

    <!-- right: gavel box, stale news, under construction -->
    <div class="b-rside">
      <div class="b-gavel">
        <svg viewBox="0 0 160 96" aria-hidden="true">
          <rect x="62" y="78" width="72" height="11" fill="#5E3B20"></rect>
          <rect x="70" y="71" width="56" height="8" fill="#855632"></rect>
          <path d="M22 76 88 36l5 8-66 40Z" fill="#8A5A33"></path>
          <path d="M22 76 88 36l1.6 2.6-66 40Z" fill="#B07A4B"></path>
          <g transform="rotate(-31 100 30)">
            <rect x="88" y="6" width="24" height="48" fill="#6B4426"></rect>
            <rect x="88" y="11" width="24" height="5" fill="#C8B27A"></rect>
            <rect x="88" y="44" width="24" height="5" fill="#C8B27A"></rect>
            <rect x="91" y="6" width="3" height="48" fill="#8F6038"></rect>
          </g>
        </svg>
        <span class="b-gavel-cap">{X.gavelCaption}</span>
      </div>
      <span class="b-call">{X.photoCaption}</span>
      <div class="b-box b-news">
        <span class="b-boxh b-boxh--navy">{L.newsTitle}</span>
        {
          L.news.map(([d, t]) => (
            <span class="b-item">
              <b>{d}</b>
              <u>{t}</u>
            </span>
          ))
        }
      </div>
      <div class="b-uc">
        <span class="b-uc-stripe"></span>
        <span class="b-uc-body">
          <svg viewBox="0 0 16 18" aria-hidden="true">
            <path d="M8 0 14 16H2Z" fill="#F07A10"></path>
            <path d="M5.6 6.5h4.8l1 3H4.6ZM3.8 12h8.4l.9 2.4H2.9Z" fill="#FFFFFF"></path>
            <path d="M0 16h16v2H0Z" fill="#333333"></path>
          </svg>
          <span>{L.construction}</span>
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .b-site {
    --u: calc(100cqi / 760);
    --b-navy: #1b2a5c;
    --b-maroon: #6b1414;
    --b-link: #0033cc;
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* the linen wallpaper around the fixed-width page (imagery, not UI) */
    background-color: #d6cbae;
    background-image: repeating-linear-gradient(45deg, #cdc1a0 0 calc(2 * var(--u)), transparent calc(2 * var(--u)) calc(6 * var(--u)));
    color: #333333;
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-stretch: 100%;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

