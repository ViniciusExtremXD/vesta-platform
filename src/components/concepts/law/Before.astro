  :global(.cp.is-paused) .b-ticker-run {
    animation-play-state: paused;
  }

  @keyframes blaw-tick {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* ---------- starburst, hanging off the banner onto the tabs ---------- */
  .b-burst {
    top: calc(54 * var(--u));
    left: calc(540 * var(--u));
    width: calc(112 * var(--u));
    height: calc(64 * var(--u));
    display: grid;
    place-items: center;
    transform: rotate(-9deg);
  }

  .b-burst svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .b-burst-t {
    position: relative;
    max-width: calc(66 * var(--u));
    background-color: #ffe600;
    color: #b00000;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: calc(9 * var(--u));
    font-weight: 900;
    line-height: 1.05;
    text-align: center;
  }

  /* ---------- shared sidebar boxes ---------- */
  .b-lside,
  .b-rside,
  .b-main,
  .b-form {
    top: calc(124 * var(--u));
    display: flex;
    flex-direction: column;
  }

  .b-lside {
    left: calc(8 * var(--u));
    width: calc(142 * var(--u));
    gap: calc(7 * var(--u));
  }

  .b-box {
    display: flex;
    flex-direction: column;
    border: 1px solid #b7a98a;
    background-color: #f4efe1;
  }

  .b-boxh {
