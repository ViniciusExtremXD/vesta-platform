---
/** Tiny inline icon set. Stroke icons inherit currentColor. */
export interface Props {
  name: 'arrow' | 'external' | 'whatsapp' | 'linkedin' | 'mail' | 'check' | 'clock' | 'bolt' | 'shield';
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  arrow: '<path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  external: '<path d="M5 3h8v8M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  whatsapp:
    '<path d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5.7 5.4c.2-.4.4-.4.6-.4h.4c.1 0 .3 0 .4.3l.6 1.3c0 .1.1.3 0 .4l-.4.5c-.1.1-.1.2 0 .4.4.7 1 1.3 1.8 1.7.1.1.3 0 .4-.1l.5-.6c.1-.1.3-.1.4 0l1.3.6c.2.1.3.1.3.2 0 .3-.1.8-.4 1.1-.3.3-.9.5-1.3.5-1.1-.1-2.3-.7-3.2-1.6-.9-.9-1.5-2-1.6-3 0-.5.1-.9.2-1.3Z" fill="currentColor"/>',
  linkedin:
    '<path d="M3.5 6.5v6M3.5 3.6v.1M7 12.5v-6M7 9c0-1.4 1-2.5 2.5-2.5S12 7.6 12 9v3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  mail: '<rect x="2" y="3.5" width="12" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 4.5 8 9l5.5-4.5" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  check: '<path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  clock: '<circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5V8l2.4 1.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  bolt: '<path d="M9 1.5 3.5 9h4l-.5 5.5L12.5 7h-4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  shield: '<path d="M8 1.5 13 3.5v4c0 3.2-2.1 5.6-5 7-2.9-1.4-5-3.8-5-7v-4z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
};
---

<svg class={cls} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" set:html={paths[name]} />
