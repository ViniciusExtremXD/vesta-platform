---
/**
 * Footer (SPEC §5.13, SPEC_COSMOS §4, ROUND2, ROUND3), void.
 *
 * Mark + one line · Pricing (package names + the free price analysis) ·
 * Studio · Contact (WhatsApp, Email, LinkedIn) as hairline rows that draw
 * in from the left, row by row; 4 Vesta in 3D (<Asteroid>) beside the
 * orbit of 4 Vesta drawn to scale between Mars and Jupiter; then the
 * owner's logo lockup, large, with Back to top. No build line, no legal
 * line, no Motion toggle (owner, ROUND3).
 *
 * Depth: the inner wrapper is a [data-scene] (it swings up out of a tilted,
 * deeper plane as the footer scrolls in). The lockup rises from below the
 * fold as the last screen arrives (scroll-linked, transform-only), flips up
 * on its baseline when revealed, and tilts toward the pointer.
 *
 * The orbit diagram: semi-major axes and eccentricities from site.ts
 * (footer.orbit). Each orbit is a true Kepler ellipse with the Sun at one
 * focus, seen from above the ecliptic at a shallow angle (y x VIEW_K) and
 * turned by VIEW_TILT. Periods follow Kepler's third law (T = a^1.5 years),
 * so the three planets move at their true relative rates, time-lapsed:
 * one Vesta year = VESTA_LAP seconds. Each planet drags a short trail of
 * its own recent positions. The time-lapse spins up when the diagram first
 * comes into view and runs faster while the pointer is over it. Transform
 * and opacity only, paused offscreen and on a hidden tab.
 *
 * data-sticky-hide: the mobile sticky bar never covers the footer.
 */
import { footer, wa, mail, contact as contactInfo } from '../data/site';
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Cosmos from './Cosmos.astro';
import Asteroid from './Asteroid.astro';
import Arrow from './ui/Arrow.astro';
import WaGlyph from './ui/WaGlyph.astro';
import MailGlyph from './ui/MailGlyph.astro';

/* ------------------------------------------------------ the orbit diagram */

/** px per AU in viewBox units. */
const SCALE = 80;
/** Viewing angle: cos of the elevation above the ecliptic plane. */
const VIEW_K = 0.34;
/** Screen rotation of the whole plane, degrees (the orbit mark's −24°, softened). */
const VIEW_TILT = -9;
/** Seconds per Vesta year in the time-lapse. */
const VESTA_LAP = 26;
/** Trail: dots per planet, and the time window they cover (Earth years). */
const TRAIL_N = 6;
const TRAIL_YEARS = 0.2;
/**
 * Longitude of perihelion ϖ (degrees) and a starting mean anomaly for the
 * drawing. ϖ: Mars 336.0°, 4 Vesta ≈ 255° (Ω 103.8° + ω 151.2°), Jupiter
 * 14.7° (JPL mean elements). The start anomalies only place the planets for
 * the still frame; they are not an ephemeris.
 */
const ELEMENTS: Record<string, { peri: number; m0: number; r: number }> = {
  Mars: { peri: 336.0, m0: 200, r: 2.6 },
  '4 Vesta': { peri: 255.0, m0: 300, r: 3.6 },
  Jupiter: { peri: 14.7, m0: 120, r: 4.8 },
};

const rad = (d: number) => (d * Math.PI) / 180;
const cT = Math.cos(rad(VIEW_TILT));
const sT = Math.sin(rad(VIEW_TILT));
/** orbital-plane (AU, y toward the far side) → screen offset from the Sun */
const project = (X: number, Y: number): [number, number] => {
  const px = X * SCALE;
  const py = -Y * SCALE * VIEW_K;
  return [px * cT - py * sT, px * sT + py * cT];
};

const kepler = (M: number, e: number) => {
  let E = M;
  for (let i = 0; i < 6; i++) E -= (E - e * Math.sin(E) - M) / (1 - e * Math.cos(E));
  return E;
};

/** heliocentric orbital-plane position at mean anomaly M */
const position = (a: number, e: number, peri: number, M: number): [number, number] => {
  const E = kepler(M, e);
  const b = a * Math.sqrt(1 - e * e);
  const xp = a * (Math.cos(E) - e);
  const yp = b * Math.sin(E);
  const c = Math.cos(rad(peri));
  const s = Math.sin(rad(peri));
  return [xp * c - yp * s, xp * s + yp * c];
};

const bodies = footer.orbit.bodies.map((body) => {
  const el = ELEMENTS[body.name] ?? { peri: 0, m0: 0, r: 3 };
  const { a, e } = body;
  const b = a * Math.sqrt(1 - e * e);
  const period = a ** 1.5;
  const u: [number, number] = [Math.cos(rad(el.peri)), Math.sin(rad(el.peri))];
  const v: [number, number] = [-u[1], u[0]];
  // centre and conjugate semi-diameters of the projected ellipse
  const C = project(-a * e * u[0], -a * e * u[1]);
  const A = project(a * u[0], a * u[1]);
  const B = project(b * v[0], b * v[1]);
  const s11 = A[0] * A[0] + B[0] * B[0];
  const s22 = A[1] * A[1] + B[1] * B[1];
  const s12 = A[0] * A[1] + B[0] * B[1];
  const mid = (s11 + s22) / 2;
  const half = Math.sqrt(((s11 - s22) / 2) ** 2 + s12 ** 2);
  const angle = (0.5 * Math.atan2(2 * s12, s11 - s22) * 180) / Math.PI;
  const at = (years: number) => project(...position(a, e, el.peri, rad(el.m0) + (Math.PI * 2 * years) / period));
  return {
    name: body.name,
    a,
    e,
    peri: el.peri,
    m0: el.m0,
    r: el.r,
    period,
    vesta: body.name === '4 Vesta',
    cx: C[0],
    cy: C[1],
    rx: Math.sqrt(mid + half),
    ry: Math.sqrt(Math.max(0, mid - half)),
    angle,
    start: at(0),
    /** the still frame's trail: where the planet was just before */
    trail: Array.from({ length: TRAIL_N }, (_, k) => at((-TRAIL_YEARS * (k + 1)) / TRAIL_N)),
  };
});

/* bounding box of all three orbits (sampled), padded, Sun at (sunX, sunY) */
let minX = 0;
let maxX = 0;
let minY = 0;
let maxY = 0;
for (const o of bodies) {
  for (let i = 0; i < 180; i++) {
    const [x, y] = project(...position(o.a, o.e, o.peri, (i / 180) * Math.PI * 2));
    minX = Math.min(minX, x);
    maxX = Math.max(maxX, x);
    minY = Math.min(minY, y);
    maxY = Math.max(maxY, y);
  }
}
const PAD = 14;
const sunX = +(PAD - minX).toFixed(2);
const sunY = +(PAD - minY).toFixed(2);
const VB_W = Math.ceil(maxX - minX + PAD * 2);
const VB_H = Math.ceil(maxY - minY + PAD * 2);

const orbitData = JSON.stringify({
  sun: [sunX, sunY],
  k: VIEW_K,
  tilt: VIEW_TILT,
  scale: SCALE,
  lap: VESTA_LAP / bodies.find((b) => b.vesta)!.period,
  trail: TRAIL_YEARS,
  bodies: bodies.map((b) => ({ a: b.a, e: b.e, peri: b.peri, m0: b.m0, period: b.period })),
});

const fmtAu = (a: number) => `${a.toFixed(2)} AU`;
const tr = (x: number, y: number) => `translate(${(sunX + x).toFixed(2)}px, ${(sunY + y).toFixed(2)}px)`;

/* ------------------------------------------------------------- columns */

const { pricing, studio, contact } = footer.columns;
const backToTop = footer.backToTop.replace(/\s*↑\s*$/, '');
---

<footer class="foot s-void" data-nav-theme="dark" data-sticky-hide>
  <div class="wrap foot-in" data-scene>
    <div class="foot-cols g">
      <div class="foot-id" data-reveal>
        <a class="foot-home" href={url('/')} aria-label="Vesta, home"><Logo mark alt="" height={64} /></a>
        <p class="foot-blurb">{footer.brand.blurb}</p>
        <p class="foot-tagline">{footer.brand.tagline}</p>
      </div>

      <nav class="foot-col foot-pricing" aria-labelledby="foot-h-pricing" data-reveal style="--i:1">
        <h2 class="foot-h label" id="foot-h-pricing">{pricing.title}</h2>
        <ul class="foot-rows">
          {
            pricing.links.map((l, r) => {
              const accent = /price analysis/i.test(l.label);
              return (
                <li style={`--r:${r}`}>
                  <a class:list={['frow', { 'is-accent': accent }]} href={url(l.href)}>
                    <span class="frow-name">
                      {accent && <span class="stripe frow-mark" aria-hidden="true" />}
                      {l.label}
                    </span>
                    <Arrow size={12} />
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <nav class="foot-col foot-studio" aria-labelledby="foot-h-studio" data-reveal style="--i:2">
        <h2 class="foot-h label" id="foot-h-studio">{studio.title}</h2>
        <ul class="foot-rows">
          {
            studio.links.map((l, r) => (
              <li style={`--r:${r}`}>
                <a class="frow" href={url(l.href)}>
                  <span class="frow-name">{l.label}</span>
                  <Arrow size={12} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="foot-col foot-contact" data-reveal style="--i:3">
        <h2 class="foot-h label">{contact.title}</h2>
        <ul class="foot-rows">
          <li style="--r:0">
            <a class="frow" href={wa(contact.whatsapp.text)} target="_blank" rel="noopener" data-wa-intent="footer">
              <span class="frow-name frow-icon"><WaGlyph size={14} /><span class="tnum">{contact.whatsapp.label}</span></span>
              <Arrow dir="up-right" size={12} />
            </a>
          </li>
          <li style="--r:1">
            <a class="frow" href={mail()}>
              <span class="frow-name frow-icon"><MailGlyph size={14} /><span>{contactInfo.email.address}</span></span>
              <Arrow dir="up-right" size={12} />
            </a>
          </li>
          <li style="--r:2">
            <a class="frow" href={contact.linkedin.href} target="_blank" rel="noopener">
              <span class="frow-name">{contact.linkedin.label}</span>
              <Arrow dir="up-right" size={12} />
            </a>
          </li>
        </ul>
        <p class="foot-hours small">
          <span class="foot-hours-main">{contact.hours}</span>
          <span class="foot-hours-offset">{contact.offset}</span>
        </p>
      </div>
    </div>

    <!-- the orbit of 4 Vesta, to scale -->
    <div class="orb g">
      <span class="orb-rule rule" data-reveal="draw" aria-hidden="true"></span>

      <div class="orb-key" data-reveal style="--i:1">
        <div class="orb-body">
          <Asteroid size={260} drag class="orb-asteroid" />
        </div>
        <p class="orb-caption">
          {
            /* lines break only between the "·" segments, never inside one */
            footer.orbit.caption.split(' · ').map((part, i, all) => (
              <Fragment>
                <span class="orb-seg">{part}</span>
                {i < all.length - 1 && ' · '}
              </Fragment>
            ))
          }
        </p>
        <ul class="orb-rows">
          {
            bodies.map((b) => (
              <li class:list={['orb-row', { 'is-vesta': b.vesta }]}>
                <span class="orb-swatch" aria-hidden="true" />
                <span class="orb-name">{b.name}</span>
                <span class="orb-au num">{fmtAu(b.a)}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="orb-fig" data-reveal="fade" style={`--i:2; --vb-ratio:${VB_W} / ${VB_H}`} aria-hidden="true">
        <Cosmos variant="stars" class="orb-cosmos" />
        <div class="orb-stage" data-tilt="5">
          <svg
            class="orb-svg"
            viewBox={`0 0 ${VB_W} ${VB_H}`}
            preserveAspectRatio="xMidYMid slice"
            focusable="false"
            data-orbit={orbitData}
          >
            {
              bodies.map((b, i) => (
                <g class="orb-ring" style={`--o:${i}; transform-origin:${sunX}px ${sunY}px`}>
                  <ellipse
                    class:list={['orb-path', { 'is-vesta': b.vesta }]}
                    cx={(sunX + b.cx).toFixed(2)}
                    cy={(sunY + b.cy).toFixed(2)}
                    rx={b.rx.toFixed(2)}
                    ry={b.ry.toFixed(2)}
                    transform={`rotate(${b.angle.toFixed(3)} ${(sunX + b.cx).toFixed(2)} ${(sunY + b.cy).toFixed(2)})`}
                  />
                </g>
              ))
            }
            <circle class="orb-sun" cx={sunX} cy={sunY} r="3.2"></circle>
            {
              bodies.map((b, i) => (
                <g class="orb-ring" style={`--o:${i}; transform-origin:${sunX}px ${sunY}px`}>
                  {b.trail
                    .map((p, k) => (
                      <circle
                        class:list={['orb-trail', { 'is-vesta': b.vesta }]}
                        cx="0"
                        cy="0"
                        r={(b.r * (1 - (k + 1) * 0.1)).toFixed(2)}
                        data-orbit-trail={`${i}-${k + 1}`}
                        style={`transform: ${tr(p[0], p[1])}; opacity: ${(0.6 * (1 - (k + 1) / (TRAIL_N + 1))).toFixed(3)}`}
                      />
                    ))
                    .reverse()}
                  <circle
                    class:list={['orb-planet', { 'is-vesta': b.vesta }]}
                    cx="0"
                    cy="0"
                    r={b.r}
                    data-orbit-body={i}
                    style={`transform: ${tr(b.start[0], b.start[1])}`}
                  />
                </g>
              ))
            }
          </svg>
        </div>
      </div>
    </div>

    <span class="foot-rule rule" data-reveal="draw" aria-hidden="true"></span>

    <div class="foot-end">
      <div class="foot-brand" data-reveal data-wordmark>
        <div class="foot-lift">
          <div class="foot-flip">
            <a class="foot-lockup" href={url('/')} aria-label="Vesta, home" data-tilt="7">
              <Logo alt="" height={240} />
            </a>
          </div>
        </div>
      </div>
      <a class="foot-top small" href="#top" data-back-to-top data-reveal="fade" style="--d:200ms">
        {backToTop}
        <Arrow dir="up" size={12} />
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    padding-block-start: clamp(4.5rem, 3rem + 5vw, 8rem);
    /* the sticky bar hides over the footer; only the home indicator needs room */
    padding-block-end: env(safe-area-inset-bottom);
    overflow: clip;
  }

  /* ------------------------------------------------------------ columns */

  .foot-cols {
    row-gap: var(--s-64);
  }

  .foot-home {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-block-start: -8px;
    margin-inline-start: -6px;
    color: var(--starlight);
    text-decoration: none;
  }

  .foot-blurb {
    margin-block-start: var(--s-24);
    max-width: 34ch;
    color: var(--haze);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .foot-tagline {
    margin-block-start: var(--s-16);
    max-width: 26ch;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .foot-h {
    padding-block-end: var(--s-16);
    color: var(--dim);
  }

  /* hairline rows: the top rule and each row's rule draw in from the left,
     one after another, as the column arrives */
  .foot-rows {
    position: relative;
    margin: 0;
  }

  .foot-rows::before,
  .foot-rows > li::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background-color: var(--line-dark);
    transform-origin: left center;
    transition: transform 1300ms var(--ease-quint);
    pointer-events: none;
  }

  .foot-rows::before {
    top: 0;
    transition-delay: 120ms;
  }

  .foot-rows > li {
    position: relative;
  }

  .foot-rows > li::after {
    bottom: 0;
    transition-delay: calc(220ms + var(--r, 0) * 90ms);
  }

  .frow {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    min-height: 48px;
    padding-block: 14px 13px;
    color: var(--haze);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color var(--t-micro) linear,
      opacity 600ms linear,
      transform 1000ms var(--ease-expo);
    transition-delay: 0ms, calc(260ms + var(--r, 0) * 90ms), calc(260ms + var(--r, 0) * 90ms);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .foot-col:not(.is-in) .foot-rows::before,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .foot-col:not(.is-in) .foot-rows > li::after {
    transform: scaleX(0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .foot-col:not(.is-in) .frow {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
  }

  /* hover: a lilac hairline sweeps along the row from the left */
  .frow::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background-color: var(--lilac);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 520ms var(--ease-expo);
  }

  .frow-name {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    transition: transform var(--t-ui) var(--ease-expo);
  }

  .frow-icon {
    gap: 10px;
  }

  .frow-icon :global(svg) {
    flex: 0 0 auto;
  }

  .frow-icon > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* the free price analysis: the one row that is an offer, marked */
  .frow.is-accent {
    color: var(--starlight);
  }

  .frow-mark {
    margin-inline-end: 12px;
  }

  .frow.is-accent :global(.arrow) {
    color: var(--lilac);
  }

  .frow :global(.arrow) {
    flex: 0 0 auto;
    align-self: center;
    color: var(--dim);
    transition:
      transform var(--t-ui) var(--ease-expo),
      color var(--t-micro) linear;
  }

  @media (hover: hover) and (pointer: fine) {
    .frow:hover {
      color: var(--starlight);
    }

    .frow:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }

    .frow:hover .frow-name {
      transform: translateX(6px);
    }

    .frow:hover :global(.arrow) {
      color: var(--lilac);
      transform: translateX(3px);
    }
  }

  .frow:focus-visible {
    color: var(--starlight);
    outline-offset: 2px;
  }

  .tnum {
    font-variant-numeric: tabular-nums;
  }

  .foot-hours {
    display: grid;
    gap: 2px;
    margin-block-start: var(--s-16);
    color: var(--haze);
  }

  .foot-hours-offset {
    color: var(--dim);
  }

  /* ----------------------------------------------------- orbit diagram */

  .orb {
    position: relative;
    margin-block-start: var(--s-96);
    row-gap: var(--s-32);
    align-items: end;
  }

  .orb-rule {
    background-color: var(--line-dark);
  }

  .orb-key {
    padding-block-end: var(--s-8);
  }

  /* 4 Vesta itself, in 3D, above its numbers (drag to spin) */
  .orb-body {
    width: clamp(180px, 60%, 260px);
    margin-block-end: var(--s-24);
    margin-inline-start: -4%;
  }

  .orb-body :global(.orb-asteroid) {
    width: 100%;
  }

  .orb-caption {
    max-width: 30ch;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
    font-variant-numeric: tabular-nums;
  }

  .orb-seg {
    white-space: nowrap;
  }

  .orb-rows {
    margin: var(--s-24) 0 0;
    border-block-start: 1px solid var(--line-dark);
  }

  .orb-row {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    min-height: 40px;
    border-block-end: 1px solid var(--line-dark);
    color: var(--haze);
    font-size: var(--t-small);
    line-height: 1.4;
  }

  /* a short run of the orbit line, as drawn in the figure */
  .orb-swatch {
    flex: 0 0 auto;
    width: 20px;
    height: 1px;
    background-color: var(--line-dark-strong);
  }

  .orb-name {
    flex: 1 1 auto;
  }

  .orb-au {
    color: var(--starlight);
    font-size: var(--t-small);
    font-weight: 560;
  }

  .orb-row.is-vesta {
    color: var(--starlight);
  }

  .orb-row.is-vesta .orb-swatch {
    background-color: var(--lilac);
  }

  .orb-row.is-vesta .orb-au {
    color: var(--lilac);
  }

  .orb-fig {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: clip;
    background-color: var(--void);
  }

  /* the star field feathers out at the edges: no box around the sky */
  .orb-fig :global(.orb-cosmos) {
    opacity: 0.85;
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 45%, transparent 100%);
  }

  /* the diagram tilts toward the pointer over a still sky: depth */
  .orb-stage {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  .orb-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orb-path {
    fill: none;
    stroke: var(--line-dark-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orb-path.is-vesta {
    stroke: var(--lilac);
  }

  .orb-sun {
    fill: var(--starlight);
  }

  .orb-planet,
  .orb-trail {
    fill: var(--haze);
    transform-origin: 0 0;
  }

  .orb-planet.is-vesta,
  .orb-trail.is-vesta {
    fill: var(--lilac);
  }

  /* the rings open out from the Sun, inner orbit first */
  .orb-ring {
    transition:
      transform 1800ms var(--ease-expo),
      opacity 700ms linear;
    transition-delay: calc(200ms + var(--o, 0) * 140ms);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orb-fig:not(.is-in) .orb-ring {
    transform: scale(0.82);
    opacity: 0;
  }

  /* ------------------------------------------------------ the logo end */

  .foot-rule {
    margin-block-start: clamp(4rem, 3rem + 4vw, 7rem);
    background-color: var(--line-dark);
  }

  .foot-end {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-24) var(--s-48);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) calc(var(--s-32) + env(safe-area-inset-bottom));
  }

  /* rises 40px over 1200ms expo (the verify gate measures this curve) */
  .foot-brand[data-reveal] {
    flex: 0 1 auto;
    width: min(100%, 680px);
    min-width: 0;
    transition-duration: 1200ms, 1200ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .foot-brand[data-reveal]:not(.is-in) {
    transform: translate3d(0, 40px, 0);
  }

  /* scroll-linked: the lockup surfaces from below as the last screen
     arrives (the script writes --dy; transform-only) */
  .foot-lift {
    perspective: 1200px;
    perspective-origin: 30% 100%;
    transform: translate3d(0, var(--dy, 0px), 0);
  }

  /* …and flips up on its baseline, out of depth, when revealed */
  .foot-flip {
    transform-origin: 50% 100%;
    transition:
      transform 1800ms var(--ease-expo) 120ms,
      opacity 600ms linear 120ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .foot-brand:not(.is-in) .foot-flip {
    opacity: 0;
    transform: translate3d(0, 18%, -220px) rotateX(-70deg);
  }

  .foot-lockup {
    display: block;
    text-decoration: none;
  }

  .foot-lockup :global(.brand-logo) {
    width: 100%;
    height: auto;
  }

  .foot-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--haze);
    text-decoration: none;
    transition: color var(--t-micro) linear;
  }

  .foot-top :global(.arrow) {
    transition: transform var(--t-ui) var(--ease-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .foot-top:hover {
      color: var(--starlight);
    }

    .foot-top:hover :global(.arrow) {
      transform: translateY(-3px);
    }
  }

  /* ----------------------------------------------------------- layouts */

  @media (max-width: 767px) {
    .foot-cols {
      row-gap: var(--s-48);
    }

    .foot-studio .foot-rows {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gap);
    }

    .orb {
      margin-block-start: var(--s-64);
    }

    /* the figure first, the key under it */
    .orb-fig {
      grid-row: 2;
    }

    .orb-key {
      grid-row: 3;
    }
  }

  @media (min-width: 768px) {
    .foot-id {
      grid-column: 1 / span 4;
    }

    .foot-contact {
      grid-column: 5 / span 4;
    }

    .foot-pricing {
      grid-column: 1 / span 4;
      grid-row: 2;
    }

    .foot-studio {
      grid-column: 5 / span 4;
      grid-row: 2;
    }

    .orb-key {
      grid-column: 1 / span 3;
      grid-row: 2;
    }

    .orb-fig {
      grid-column: 4 / -1;
      grid-row: 2;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1100px) {
    .foot-cols {
      row-gap: 0;
    }

    .foot-id {
      grid-column: 1 / span 4;
    }

    .foot-pricing {
      grid-column: 5 / span 3;
      grid-row: 1;
    }

    .foot-studio {
      grid-column: 8 / span 2;
      grid-row: 1;
    }

    .foot-contact {
      grid-column: 10 / span 3;
      grid-row: 1;
    }

    .orb {
      margin-block-start: var(--s-96);
    }

    .orb-key {
      grid-column: 1 / span 4;
    }

    .orb-fig {
      grid-column: 5 / -1;
      /* the whole system, uncropped */
      aspect-ratio: var(--vb-ratio);
    }
  }

  :global(html.motion-reduced) .orb-ring,
  :global(html.motion-reduced) .frow,
  :global(html.motion-reduced) .frow::after,
  :global(html.motion-reduced) .foot-rows::before,
  :global(html.motion-reduced) .foot-rows > li::after,
  :global(html.motion-reduced) .foot-flip {
    transition: none;
  }

  :global(html.motion-reduced) .foot-lift {
    transform: none;
  }
</style>

<script>
  import { addFrame, isReduced, vestibular, travelTo } from '../scripts/motion';

  // Back to top travels on the site's eased curve (instant with Motion: off),
  // then focus returns to the top so keyboard users continue from there.
  document.querySelectorAll<HTMLAnchorElement>('[data-back-to-top]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      travelTo(0);
      const home = document.querySelector<HTMLElement>('[data-nav] .nav-home');
      if (home) window.setTimeout(() => home.focus({ preventScroll: true }), 0);
    });
  });

  /* ------------------------------------------------------------------ */
  /* the lockup surfaces from below the fold as the last screen arrives */
  /* ------------------------------------------------------------------ */

  const brandEl = document.querySelector<HTMLElement>('[data-wordmark]');
  const foot = brandEl?.closest<HTMLElement>('footer');
  const lift = brandEl?.querySelector<HTMLElement>('.foot-lift');
  if (brandEl && foot && lift) initLift(brandEl, foot, lift);

  function initLift(brandEl: HTMLElement, foot: HTMLElement, lift: HTMLElement): void {
    let dist = 0;
    let range = 1;
    let full = 0;
    let near = false;
    let written = -1;

    addFrame({
      read(_y, vh) {
        const r = foot.getBoundingClientRect();
        near = r.top < vh + 200;
        if (!near) return;
        dist = r.bottom - vh;
        range = Math.max(240, Math.min(vh * 0.7, 640));
        full = brandEl.offsetHeight;
      },
      write() {
        const still = vestibular();
        const p = still ? 1 : near ? 1 - Math.min(1, Math.max(0, dist / range)) : 0;
        const key = Math.round(p * 1000);
        if (key === written) return;
        written = key;
        const eased = 1 - Math.pow(1 - p, 3);
        lift.style.setProperty('--dy', `${((1 - eased) * full * 0.55).toFixed(1)}px`);
      },
    });
  }

  /* ------------------------------------------------------------------ */
  /* the orbit diagram: three planets on true Kepler orbits              */
  /* ------------------------------------------------------------------ */

  interface OrbitData {
    sun: [number, number];
    k: number;
    tilt: number;
    scale: number;
    /** seconds per Earth year in the time-lapse */
    lap: number;
    /** trail window, Earth years */
    trail: number;
    bodies: { a: number; e: number; peri: number; m0: number; period: number }[];
  }

  const svg = document.querySelector<SVGSVGElement>('svg[data-orbit]');
  const fig = svg?.closest<HTMLElement>('.orb-fig');
  if (svg && fig) initOrbit(svg, fig);

  function initOrbit(svg: SVGSVGElement, fig: HTMLElement): void {
    let data: OrbitData;
    try {
      data = JSON.parse(svg.dataset.orbit || '');
    } catch {
      return;
    }
    const dots = data.bodies.map((_, i) => svg.querySelector<SVGCircleElement>(`[data-orbit-body="${i}"]`));
    if (dots.some((d) => !d)) return;
    const trails = data.bodies.map((_, i) =>
      Array.from(svg.querySelectorAll<SVGCircleElement>(`[data-orbit-trail^="${i}-"]`)).sort(
        (a, b) => Number(a.dataset.orbitTrail!.split('-')[1]) - Number(b.dataset.orbitTrail!.split('-')[1])
      )
    );

    const rad = (d: number) => (d * Math.PI) / 180;
    const cT = Math.cos(rad(data.tilt));
    const sT = Math.sin(rad(data.tilt));
    const TAU = Math.PI * 2;

    /** screen transform of body b at time `years`; near side a touch larger */
    const at = (b: OrbitData['bodies'][number], years: number): string => {
      const M = rad(b.m0) + (TAU * years) / b.period;
      let E = M;
      for (let n = 0; n < 5; n++) E -= (E - b.e * Math.sin(E) - M) / (1 - b.e * Math.cos(E));
      const xp = b.a * (Math.cos(E) - b.e);
      const yp = b.a * Math.sqrt(1 - b.e * b.e) * Math.sin(E);
      const c = Math.cos(rad(b.peri));
      const s = Math.sin(rad(b.peri));
      const X = xp * c - yp * s;
      const Y = xp * s + yp * c;
      const px = X * data.scale;
      const py = -Y * data.scale * data.k;
      const x = data.sun[0] + px * cT - py * sT;
      const y = data.sun[1] + px * sT + py * cT;
      const depth = 1 - 0.14 * (Y / b.a);
      return `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px) scale(${depth.toFixed(3)})`;
    };

    /** planets plus trails; the trail stretches with the time-lapse speed */
    const place = (years: number, speed: number) => {
      const win = data.trail * Math.min(2.6, Math.max(1, speed));
      data.bodies.forEach((b, i) => {
        dots[i]!.style.transform = at(b, years);
        const tr = trails[i];
        tr.forEach((dot, k) => {
          dot.style.transform = at(b, years - (win * (k + 1)) / tr.length);
        });
      });
    };

    let years = 0;
    let last = 0;
    let raf = 0;
    let onscreen = false;
    let speed = 1;
    let target = 1;
    let boostAt = 0;
    let seen = false;

    const tick = (now: number) => {
      raf = 0;
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      // a burst when the diagram first comes into view, settling to cruise
      const boost = boostAt ? 9 * Math.exp(-(now - boostAt) / 650) : 0;
      if (boost < 0.01) boostAt = 0;
      speed += (target - speed) * (1 - Math.exp(-dt * 3));
      const s = speed + boost;
      years += (dt / data.lap) * s;
      place(years, s);
      schedule();
    };

    const running = () => onscreen && !document.hidden && !isReduced();

    function schedule(): void {
      if (running()) {
        if (!raf) raf = requestAnimationFrame(tick);
      } else {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        last = 0;
      }
    }

    place(0, 1);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          onscreen = entries.some((e) => e.isIntersecting);
          if (onscreen && !seen && !isReduced()) {
            seen = true;
            boostAt = performance.now();
          }
          schedule();
        },
        { rootMargin: '0px 0px -10% 0px' }
      ).observe(fig);
    }
    // the pointer over the diagram speeds up the time-lapse
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      fig.addEventListener('pointerenter', () => (target = 3.2));
      fig.addEventListener('pointerleave', () => (target = 1));
    }
    document.addEventListener('visibilitychange', schedule);
    document.addEventListener('vesta:motion', schedule);
  }
</script>
