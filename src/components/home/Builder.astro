---
/**
 * §5.10 #builder (void) — the founder profile. Round 2: colour portrait,
 * a bolder reveal, half the visible text.
 *
 * Desktop: portrait in columns 1–5 (4:5 colour crop of
 * src/assets/vinicius-magno.jpg, 2px violet bar on its left edge), copy in
 * 7–12: H2, one lead paragraph, the facts as a 2×2 grid, the rest of the
 * story inside an Expand box, then WhatsApp · Email · LinkedIn.
 *
 * 3D entrances: the copy column and the portrait's inner stage carry
 * data-scene (scroll-scrubbed rise out of a tilted, deeper plane). The
 * scene sits INSIDE the sticky figure, never around it.
 *
 * The portrait:
 *  - Reveal: the plate swings in out of depth (rotateY −38° → 0, a long
 *    even curve) while an observatory dome opens: a lilac slit draws down
 *    the centre, its two edges travel outward while the frame opens from
 *    the slit (clip-path inset on media) and the photo settles 1.35 → 1;
 *    then the violet bar grows up the left edge and the ring draws. The
 *    reveal waits for the (lazy) photo, 2.5s at most once it is due.
 *  - The orbit (from 768px) is a ring around the portrait, not a line
 *    behind it: the far half passes behind the photo, the near half in
 *    front of it; both draw out of the planet's vertex at once and close at
 *    the far one, then a planet travels the ring (≈ 48s a turn, transform
 *    only, paused offscreen / hidden tab / motion off). The ring tilts ±4°
 *    with the scroll.
 *  - Pointer tilt (data-tilt="5", fine pointers): the plate turns in 3D,
 *    the two halves of the ring sit at different depths (the ring moves
 *    against the photo), the photo drifts against the tilt inside its frame
 *    and a soft starlight radial follows the pointer inside the photo.
 *  - Scroll parallax: the photo pans inside its frame (±3.5%).
 * Copy: H2, one lead paragraph, the facts, "More about Vinícius" (Expand),
 * WhatsApp + Email buttons, LinkedIn as a text link under them.
 * 390px: label, full-width portrait with the bar on its bottom edge, copy.
 *
 * Gate: the portrait renders only when `founder.portrait.confirmed`; the
 * fallback is typographic (the facts take the portrait's columns).
 * No clocks (owner decision): the hours fact is static text.
 */
import { Picture } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import WaGlyph from '../ui/WaGlyph.astro';
import MailGlyph from '../ui/MailGlyph.astro';
import Expand from '../ui/Expand.astro';
import { builder, founder, brand, contact, wa, mail } from '../../data/site';
import portrait from '../../assets/vinicius-magno.jpg';

const showPortrait = founder.portrait.confirmed;
/* contact channels render only while the owner has them confirmed */
const showWa = contact.whatsapp.confirmed;
const showEmail = contact.email.confirmed;
const showLinkedin = contact.linkedin.confirmed;
/* Ranges like "Mon–Fri" or "9:00–18:00" never break at the en dash: word
   joiners (U+2060) around it, in the paragraphs and the fact values. */
const WJ = String.fromCharCode(0x2060);
const keepRange = (s: string) => s.replace(/(\w)–(\w)/g, `$1${WJ}–${WJ}$2`);
const [lead, ...more] = builder.paragraphs.map(keepRange);
/* the ↗ in the label is drawn by <Arrow dir="up-right"> as a hairline glyph */
const linkedinText = builder.linkedin.label.replace(/\s*↗\s*$/, '');
const role = `${founder.role}, ${brand.name}`;
/* Fact values break only between their " · " segments, never in a range. */
const facts = builder.facts.map((f) => ({
  label: f.label,
  parts: f.value.split(' · ').map(keepRange),
}));

/* Orbit geometry, in the portrait's own 400×500 box (the plate is 4:5).
   Same proportions as the .stripe orbit mark: rx : ry ≈ 2.45, tilt −24°.
   The planet rests on the right-hand vertex. */
const O = { cx: 215, cy: 250, rx: 264, ry: 108 };
/* The ring is drawn as two halves, so under the pointer tilt (where the
   halves sit at different depths) no stretch of it is ever drawn twice.
   The far half: right vertex → the highest point → left vertex. */
const ringPath = `M${O.cx + O.rx} ${O.cy}A${O.rx} ${O.ry} 0 0 0 ${O.cx - O.rx} ${O.cy}`;
/* the near half: right vertex → the lowest point → left vertex */
const nearPath = `M${O.cx + O.rx} ${O.cy}A${O.rx} ${O.ry} 0 0 1 ${O.cx - O.rx} ${O.cy}`;
/* The SVG box holds the whole ring (tilted −20°…−28° it spans x −40…470).
   The CSS box (left −11%, width 129.5%) matches this viewBox exactly. */
const VB = { x: -44, w: 518 };
const ringData = JSON.stringify(O);
---

<section id={builder.id} class="builder s-void section" data-nav-theme="dark" aria-labelledby="builder-title">
  <div class:list={['wrap', 'g', 'grid', { solo: !showPortrait }]}>
    <header class="head">
      <SectionLabel n={builder.label.index ?? undefined} name={builder.label.name} />
    </header>

    {
      showPortrait ? (
        <figure class="portrait">
          <div class="stage" data-scene>
          <div class="swing">
          <div class="plate" data-tilt="5" data-builder-plate data-ring={ringData}>
            <svg class="ring ring-far" data-inview data-builder-ring viewBox={`${VB.x} 0 ${VB.w} 500`} aria-hidden="true" focusable="false">
              <g class="ring-tilt" style={`transform-origin:${O.cx}px ${O.cy}px`}>
                <path class="ring-path" d={ringPath} pathLength="100" />
                <circle class="planet planet-far" cx="0" cy="0" r="3.2" style={`transform:translate(${O.cx + O.rx}px,${O.cy}px)`} data-planet />
              </g>
            </svg>

            <div class="frame" data-inview data-builder-frame>
              <div class="pan">
                <Picture
                  src={portrait}
                  alt={founder.portrait.alt}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1440px) 546px, (min-width: 1100px) calc((100vw - 96px - 264px) * 5 / 12 + 96px), (min-width: 768px) calc((100vw - 64px - 140px) / 2 + 60px), calc(100vw - 40px)"
                  width={560}
                  height={700}
                  fit="cover"
                  position="centre"
                  quality={72}
                  loading="lazy"
                  decoding="async"
                  class="photo"
                />
              </div>
              <span class="glint" aria-hidden="true" />
            </div>

            <svg class="ring ring-near" viewBox={`${VB.x} 0 ${VB.w} 500`} aria-hidden="true" focusable="false">
              <g class="ring-tilt" style={`transform-origin:${O.cx}px ${O.cy}px`}>
                <path class="ring-path" d={nearPath} pathLength="100" />
                <circle class="planet planet-near" cx="0" cy="0" r="3.2" style={`transform:translate(${O.cx + O.rx}px,${O.cy}px)`} data-planet />
              </g>
            </svg>

            <span class="edge edge-l" aria-hidden="true" />
            <span class="edge edge-r" aria-hidden="true" />
            <span class="bar" aria-hidden="true" />
          </div>
          </div>
          </div>
          <figcaption class="cap" data-reveal style="--d:900ms">
            <span class="cap-name">{founder.name}</span>
            <span class="cap-role label">{role}</span>
          </figcaption>
        </figure>
      ) : (
        <dl class="facts facts-solo">
          {facts.map((f, r) => (
            <div class="fact" data-inview style={`--r:${r}`}>
              <dt class="label">{f.label}</dt>
              <dd>
                {f.parts.map((p, k) => (
                  <Fragment>
                    {k > 0 && ' · '}
                    <span class:list={['seg', { nw: f.parts.length > 1 }]}>{p}</span>
                  </Fragment>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="copy" data-scene>
      <SplitText as="h2" id="builder-title" class="d2 title" text={builder.h2} />
      <p class="lead intro" data-reveal style="--d:240ms">{lead}</p>

      {/* In the fallback this copy serves phones only (display: none from
          768px, where the left-column copy above takes over). */}
      <dl class="facts facts-copy">
        {facts.map((f, r) => (
          <div class="fact" data-inview style={`--r:${r}`}>
            <dt class="label">{f.label}</dt>
            <dd>
              {f.parts.map((p, k) => (
                <Fragment>
                  {k > 0 && ' · '}
                  <span class:list={['seg', { nw: f.parts.length > 1 }]}>{p}</span>
                </Fragment>
              ))}
            </dd>
          </div>
        ))}
      </dl>

      {
        more.length > 0 && (
          <Expand title={builder.more.title} keywords={builder.more.keywords} class="more" i={1}>
            {more.map((p) => (
              <p class="body more-p">{p}</p>
            ))}
          </Expand>
        )
      }

      {
        (showWa || showEmail) && (
          <div class="btn-row cta" data-reveal style="--d:120ms">
            {showWa && (
              <a class="btn wa" href={wa(builder.cta.text)} target="_blank" rel="noopener" data-wa-intent="builder" data-magnetic=".25">
                <WaGlyph size={16} />
                <span class="btn-text">{builder.cta.label}</span>
                <Arrow />
              </a>
            )}
            {showEmail && (
              <a class="btn btn-line mail" href={mail(builder.email.subject)} data-magnetic=".2">
                <MailGlyph size={16} />
                <span class="btn-text">{builder.email.label}</span>
                <Arrow />
              </a>
            )}
          </div>
        )
      }

      {
        showLinkedin && (
          <p class="li-row" data-reveal style="--d:220ms">
            <a class="tlink li" href={builder.linkedin.href} target="_blank" rel="noopener">
              <span>{linkedinText}</span>
              <Arrow dir="up-right" />
            </a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  /* ---- section --------------------------------------------------------- */
  /* One soft nebula light behind the portrait (≤10% violet, SPEC_COSMOS §2).
     overflow: clip trims the ring where it runs past the page edge; clip,
     not hidden, so the sticky portrait still pins. */
  .builder {
    overflow: clip;
    background-image: radial-gradient(60% 34% at 50% 24%, rgb(98 54 232 / 0.09), transparent 72%);
  }

  @media (min-width: 768px) {
    .builder {
      background-image: radial-gradient(34% 46% at 24% 44%, rgb(98 54 232 / 0.1), transparent 72%);
    }
  }

  /* ---- grid ------------------------------------------------------------ */
  .grid {
    grid-template-rows: auto 1fr;
    align-items: start;
  }

  .portrait {
    margin: 32px 0 0;
  }

  .copy {
    margin-top: 56px;
  }

  @media (min-width: 768px) {
    .head {
      grid-column: 5 / -1;
      grid-row: 1;
      margin-bottom: 40px;
    }

    .portrait {
      grid-column: 1 / 5;
      grid-row: 1 / span 2;
      margin: 0;
    }

    .copy {
      grid-column: 5 / -1;
      grid-row: 2;
      margin: 0;
    }

    .solo .facts-solo {
      grid-column: 1 / 5;
      grid-row: 1 / span 2;
    }
  }

  @media (min-width: 1100px) {
    .head {
      grid-column: 7 / 13;
      margin-bottom: 48px;
    }

    .portrait,
    .solo .facts-solo {
      grid-column: 1 / 6;
    }

    .copy {
      grid-column: 7 / 13;
    }
  }

  /* The portrait holds while the copy scrolls, where the whole figure fits
     under the nav (figure ≈ 1.25 × width + 56px caption, plus nav + 32px). */
  @media (min-width: 768px) and (max-width: 1024px) and (min-height: 740px),
    (min-width: 768px) and (max-width: 1099.98px) and (min-height: 800px),
    (min-width: 1100px) and (min-height: 880px),
    (min-width: 1100px) and (max-aspect-ratio: 16/10) {
    .portrait {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
  }

  /* ---- portrait -------------------------------------------------------- */
  /* .stage carries the scroll-scrubbed scene entrance (data-scene, inside
     the sticky figure, never around it). .swing is the one-shot reveal: the
     plate turns in out of depth, like a door swinging to face you, while the
     dome slit opens the photo. */
  /* a long, even swing (not front-loaded like expo), so the turn is still
     under way while the dome opens and the photo comes into view */
  .swing {
    transform-origin: 12% 50%;
    transition: transform 2600ms cubic-bezier(0.3, 0.1, 0.1, 1) 160ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .portrait:has(.frame:is(:not(.is-in), .is-wait)) .swing {
    transform: perspective(1400px) translate3d(0, 48px, -320px) rotateY(-38deg) rotateX(6deg);
    transition: none;
  }

  .plate {
    position: relative;
    --pw: 400px;
  }

  .frame {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: clip;
    background-color: var(--plate);
    clip-path: inset(0 0 0 0);
    transition: clip-path 1500ms var(--ease-quint) 420ms;
  }

  /* The photo pans with the scroll (script: --pan) inside a 1.08 overscan,
     and drifts against the pointer tilt (--bpx/--bpy, −0.5…0.5), so the
     frame reads as a window with the portrait set behind it. */
  .pan {
    width: 100%;
    height: 100%;
    transform: translate3d(calc(var(--bpx, 0) * -16px), calc(var(--pan, 0%) + var(--bpy, 0) * -16px), 0) scale(1.08);
    transition: transform 900ms var(--ease-expo);
  }

  /* the pointer light: a soft radial INSIDE the photo that follows the
     pointer while the plate tilts (≤10% starlight, never around the frame) */
  .glint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: radial-gradient(circle at var(--lx, 50%) var(--ly, 32%), rgb(243 240 250 / 0.1), rgb(243 240 250 / 0.03) 30%, transparent 58%);
    opacity: 0;
    transition: opacity 700ms linear;
  }

  .plate.is-tilting .glint {
    opacity: 1;
  }

  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame :global(picture) {
    transform: none;
    transition: transform 2600ms var(--ease-expo) 420ms;
  }

  .frame :global(img) {
    object-fit: cover;
    object-position: 50% 30%;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:is(:not(.is-in), .is-wait) {
    clip-path: inset(0 50% 0 50%);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:is(:not(.is-in), .is-wait) :global(picture) {
    transform: scale(1.35);
  }

  /* The dome slit: two lilac hairlines draw down the centre together, ride
     the opening edges out to the frame's sides, then fade. Their resting
     state is invisible (decorative), so nothing depends on them. */
  .edge {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--lilac);
    pointer-events: none;
    opacity: 0;
    translate: 0 0;
    scale: 1 1;
    transition:
      scale 620ms var(--ease-quint),
      translate 1500ms var(--ease-quint) 420ms,
      opacity 600ms linear 1700ms;
  }

  .edge-l {
    left: 0;
  }

  .edge-r {
    right: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .plate:has(.frame:is(:not(.is-in), .is-wait)) .edge {
    opacity: 1;
    scale: 1 0;
    transition: none;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .plate:has(.frame:is(:not(.is-in), .is-wait)) .edge-l {
    translate: calc(var(--pw) / 2) 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .plate:has(.frame:is(:not(.is-in), .is-wait)) .edge-r {
    translate: calc(var(--pw) / -2) 0;
  }

  /* 2px violet bar: bottom edge on mobile (draws left to right), left edge
     from 768px (grows bottom to top), once the frame has opened. */
  .bar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--violet);
    transform-origin: left center;
    pointer-events: none;
    transition:
      transform var(--t-line) var(--ease-quint) 1500ms,
      opacity 200ms linear 1500ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:is(:not(.is-in), .is-wait) ~ .bar {
    opacity: 0;
    transform: scaleX(0);
  }

  @media (min-width: 768px) {
    .bar {
      top: 0;
      right: auto;
      width: 2px;
      height: auto;
      transform-origin: center bottom;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:is(:not(.is-in), .is-wait) ~ .bar {
      transform: scaleY(0);
    }
  }

  /* ---- the ring -------------------------------------------------------- */
  /* Far half under the frame (z 0), near half over it (z 2). Under the
     pointer tilt the two sit at different depths: translateZ, with a scale
     that cancels the perspective at rest, about the plate's centre (47.1%
     of the ring box), so the halves meet exactly when the plate is flat. */
  .ring {
    display: none;
  }

  @media (min-width: 768px) {
    /* the box spans viewBox x −44…474 over the portrait's 0…400 */
    .ring {
      position: absolute;
      top: 0;
      left: -11%;
      display: block;
      width: 129.5%;
      height: 100%;
      max-width: none;
      overflow: visible;
      pointer-events: none;
      transform-origin: 47.1% 50%;
    }

    .ring-far {
      z-index: 0;
      transform: translateZ(-60px) scale(1.0545);
    }

    .ring-near {
      z-index: 2;
      transform: translateZ(70px) scale(0.9364);
    }
  }

  .ring-tilt {
    transform: rotate(calc(-24deg + var(--orb, 0deg)));
    transition: transform 700ms var(--ease-expo);
  }

  .ring-path {
    fill: none;
    stroke: var(--lilac);
    stroke-opacity: 0.5;
    stroke-width: 0.9;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0;
    /* both halves draw out of the planet's vertex at once, one over the
       top and one under the bottom, and close at the far vertex */
    transition:
      stroke-dashoffset 1900ms var(--ease-quint) 1300ms,
      opacity 300ms linear 1300ms;
  }

  .ring-near .ring-path {
    stroke-opacity: 0.62;
  }

  .planet {
    fill: var(--starlight);
    transition: opacity 600ms linear 3200ms;
  }

  /* each planet shows only on its own half (script toggles .is-behind on
     the near one and .is-front on the far one) */
  .planet-near {
    transition: opacity 160ms linear;
  }

  .planet-near.is-behind,
  .planet-far.is-front {
    opacity: 0;
    transition: opacity 160ms linear;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .plate:has(.ring-far:not(.is-in)) .ring-path {
    opacity: 0;
    stroke-dashoffset: 100;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .plate:has(.ring-far:not(.is-in)) .planet {
    opacity: 0;
  }

  :global(html.motion-reduced) .ring-tilt,
  :global(html.motion-failed) .ring-tilt {
    transform: rotate(-24deg);
  }

  /* ---- caption --------------------------------------------------------- */
  .cap {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding-top: 16px;
  }

  .cap-name {
    font-stretch: var(--wd-display);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.005em;
    color: var(--fg);
  }

  .cap-role {
    color: var(--fg-3);
  }

  /* ---- copy ------------------------------------------------------------ */
  .title {
    max-width: 16ch;
    margin-bottom: 32px;
  }

  @media (min-width: 1100px) {
    .title {
      margin-bottom: 40px;
    }
  }

  .intro {
    max-width: 36ch;
    color: var(--fg);
  }

  /* ---- facts: 2 × 2 hairline cells ------------------------------------- */
  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--gap);
    margin-top: 48px;
  }

  @media (min-width: 560px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .fact {
    position: relative;
    display: grid;
    align-content: start;
    row-gap: 8px;
    padding-block: 16px 20px;
  }

  .fact::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: var(--line-strong);
    transform-origin: left center;
    transition:
      transform var(--t-line) var(--ease-quint),
      opacity 200ms linear;
    transition-delay: calc(var(--r, 0) * 90ms);
  }

  .fact dt,
  .fact dd {
    transition:
      opacity 500ms linear,
      transform 1100ms var(--ease-expo);
    transition-delay: calc(var(--r, 0) * 90ms + 180ms);
  }

  .fact dd {
    transition-delay: calc(var(--r, 0) * 90ms + 260ms);
  }

  .fact dt {
    color: var(--fg-3);
  }

  /* proportional lining figures on purpose: the tabular zero reads as
     monospace inside running text like a CNPJ or an hours range */
  .fact dd {
    margin: 0;
    font-stretch: var(--wd-display);
    font-size: 0.9375rem;
    font-weight: 480;
    line-height: 1.45;
    letter-spacing: 0.005em;
    color: var(--fg);
    text-wrap: pretty;
  }

  .nw {
    white-space: nowrap;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .fact:not(.is-in)::before {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .fact:not(.is-in) dt,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .fact:not(.is-in) dd {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
  }

  .facts-solo {
    display: none;
  }

  @media (min-width: 768px) {
    .solo .facts-solo {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }

    .solo .facts-copy {
      display: none;
    }
  }

  /* ---- more (Expand) ----------------------------------------------------- */
  .copy :global(.more) {
    margin-top: 28px;
  }

  /* Expand without an index: two tracks, so the icon sits on the right
     edge (the shared box assumes an index in the first track) */
  .copy :global(.more > .xp-sum) {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .more-p {
    max-width: 52ch;
  }

  .more-p + .more-p {
    margin-top: 14px;
  }

  /* ---- CTAs ------------------------------------------------------------ */
  .cta {
    margin-top: 40px;
    gap: 12px 12px;
  }

  .li-row {
    margin: 20px 0 0;
  }

  @media (max-width: 767.98px) {
    .li-row {
      margin-top: 12px;
    }

    .cta {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .wa,
    .mail {
      justify-content: flex-start;
      padding-inline: 20px;
      white-space: normal;
      line-height: 1.25;
    }

    .wa .btn-text,
    .mail .btn-text {
      flex: 1 1 auto;
    }

    /* secondary becomes a 48px outline on touch widths (§4) */
    .li {
      display: flex;
      justify-content: space-between;
      min-height: 48px;
      padding: 0 20px;
      border: 1px solid var(--line-strong);
    }

    .li::after {
      display: none;
    }
  }
</style>

<script>
  /* The ring: scroll tilt (±4° around −24°), the planet's orbit, the photo's
     pan, and the aperture's width. Scroll-linked writes run inside the
     shared loop; the orbit is its own rAF loop that runs only while the
     section is near the viewport, the tab is visible and motion is on. */
  import { addFrame, requestFrame, vestibular, isReduced } from '../../scripts/motion';

  const plate = document.querySelector<HTMLElement>('[data-builder-plate]');
  const section = plate?.closest<HTMLElement>('section');

  if (plate && section) {
    const frame = plate.querySelector<HTMLElement>('[data-builder-frame]');
    const ring = plate.querySelector<SVGSVGElement>('[data-builder-ring]');
    const planets = Array.from(plate.querySelectorAll<SVGCircleElement>('[data-planet]'));
    const near = plate.querySelector<SVGCircleElement>('.planet-near');
    const far = plate.querySelector<SVGCircleElement>('.planet-far');
    let O = { cx: 215, cy: 250, rx: 264, ry: 108 };
    try {
      O = { ...O, ...JSON.parse(plate.dataset.ring || '{}') };
    } catch {
      /* keep the defaults */
    }

    /* aperture width for the slit edges */
    const setWidth = () => plate.style.setProperty('--pw', `${plate.offsetWidth}px`);
    setWidth();
    if ('ResizeObserver' in window) new ResizeObserver(setWidth).observe(plate);

    /* The dome never opens onto an empty plate: while the (lazy) photo is
       still loading the reveal waits, for 2.5s at most once it is due. */
    const img = frame?.querySelector('img');
    if (frame && img && !(img.complete && img.naturalWidth > 0)) {
      frame.classList.add('is-wait');
      const go = () => frame.classList.remove('is-wait');
      img.addEventListener('load', go, { once: true });
      img.addEventListener('error', go, { once: true });
      frame.addEventListener('vesta:reveal', () => window.setTimeout(go, 2500), { once: true });
      window.setTimeout(go, 9000);
    }

    /* Pointer light + photo drift (fine pointers): --lx/--ly place the soft
       radial inside the photo, --bpx/--bpy (−0.5…0.5) move the photo
       against the tilt. One write per frame. */
    if (frame && window.matchMedia('(pointer: fine)').matches) {
      let nx = 0;
      let ny = 0;
      let queued = 0;
      const write = () => {
        queued = 0;
        frame.style.setProperty('--lx', `${((nx + 0.5) * 100).toFixed(1)}%`);
        frame.style.setProperty('--ly', `${((ny + 0.5) * 100).toFixed(1)}%`);
        frame.style.setProperty('--bpx', nx.toFixed(3));
        frame.style.setProperty('--bpy', ny.toFixed(3));
      };
      plate.addEventListener('pointermove', (e) => {
        if (isReduced()) return;
        const r = plate.getBoundingClientRect();
        nx = Math.min(0.5, Math.max(-0.5, (e.clientX - r.left) / r.width - 0.5));
        ny = Math.min(0.5, Math.max(-0.5, (e.clientY - r.top) / r.height - 0.5));
        if (!queued) queued = requestAnimationFrame(write);
      });
      plate.addEventListener('pointerleave', () => {
        nx = 0;
        ny = 0;
        if (!queued) queued = requestAnimationFrame(write);
      });
    }

    /* ---- scroll: ring tilt + photo pan ---- */
    let nearView = false;
    let tilt = 0;
    let pan = 0;
    let wTilt = NaN;
    let wPan = NaN;

    addFrame({
      read(_y, vh) {
        if (!nearView || vestibular()) {
          tilt = 0;
          pan = 0;
          return;
        }
        const r = section.getBoundingClientRect();
        /* p: 0 when the section's top meets the viewport bottom, 1 when its
           bottom meets the viewport top */
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
        tilt = (0.5 - p) * 8;
        pan = (0.5 - p) * 7;
      },
      write() {
        if (tilt !== wTilt) {
          wTilt = tilt;
          plate.style.setProperty('--orb', `${tilt.toFixed(2)}deg`);
        }
        if (pan !== wPan && frame) {
          wPan = pan;
          frame.style.setProperty('--pan', `${pan.toFixed(2)}%`);
        }
      },
    });

    /* ---- the orbit ---- */
    const PERIOD = 48000;
    let raf = 0;
    let startAt = 0;
    let phase = 0;
    let last = 0;
    let drawn = false;

    const place = (a: number) => {
      const x = O.cx + O.rx * Math.cos(a);
      const y = O.cy + O.ry * Math.sin(a);
      const t = `translate(${x.toFixed(2)}px,${y.toFixed(2)}px)`;
      planets.forEach((p) => (p.style.transform = t));
      near?.classList.toggle('is-behind', Math.sin(a) <= 0);
      far?.classList.toggle('is-front', Math.sin(a) > 0);
    };
    place(0);

    const running = () =>
      drawn && nearView && document.visibilityState === 'visible' && !isReduced() && ring !== null && ring.getBoundingClientRect().width > 0;

    const tick = (now: number) => {
      raf = 0;
      if (!running()) return;
      if (last) phase += (now - last) / PERIOD;
      last = now;
      /* counter-clockwise on screen: up behind the photo, down in front */
      place(-phase * Math.PI * 2);
      raf = requestAnimationFrame(tick);
    };

    const sync = () => {
      if (running()) {
        if (!raf) {
          last = 0;
          raf = requestAnimationFrame(tick);
        }
      } else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      if (isReduced()) place(0);
    };

    ring?.addEventListener('vesta:reveal', () => {
      /* start travelling once the ring has drawn and the planet is lit */
      window.clearTimeout(startAt);
      startAt = window.setTimeout(() => {
        drawn = true;
        sync();
      }, 3400);
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          nearView = entries.some((e) => e.isIntersecting);
          if (nearView) requestFrame();
          sync();
        },
        { rootMargin: '15% 0px' }
      ).observe(section);
    } else {
      nearView = true;
    }

    document.addEventListener('visibilitychange', sync);
    document.addEventListener('vesta:motion', sync);
    window.addEventListener('resize', sync, { passive: true });
  }
</script>
