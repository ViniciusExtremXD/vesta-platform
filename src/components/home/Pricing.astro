      background-color: var(--paper-2);
      opacity: 0;
      transition: opacity var(--t-ui) var(--ease-expo);
      pointer-events: none;
    }

    /* the hover plate ends on the same line as the Complete plate's facet */
    .m-landing .m-card::before {
      inset: 0 -8px calc(-1 * var(--oh)) -24px;
    }

    .m-google .m-card::before {
