  /* the dial */
  .dial-wrap {
    margin-block: 20px 12px;
  }

  .dial {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 640 / 300;
  }

  /* phones: the scale only uses the middle ~75% of its box, so the dial runs
     wider than the column (the band clips) and the arc spans the screen */
  @media (max-width: 767px) {
    .dial-wrap {
      margin-top: -4px;
    }

    .dial {
      width: 126%;
      max-width: none;
      margin-inline: -13%;
    }
  }

  .dial-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .d-inner {
    stroke: rgb(243 240 250 / 0.14);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 2 5;
  }

  .d-track {
    stroke: rgb(243 240 250 / 0.14);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .d-inner,
  .d-track {
    transition: opacity 900ms linear 200ms;
  }

  .d-ring {
    stroke: rgb(243 240 250 / 0.42);
    stroke-width: 1.4;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1500ms var(--ease-quint);
  }

  .tk {
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: opacity 420ms linear;
    transition-delay: calc(var(--k, 0) * 18ms + 240ms);
  }

  .tk-minor {
    stroke: rgb(243 240 250 / 0.3);
  }

  .tk-mid {
    stroke: rgb(243 240 250 / 0.5);
  }

  .tk-major {
    stroke: rgb(243 240 250 / 0.7);
  }

  .tk-in {
    stroke: rgb(185 162 255 / 0.85);
  }

  .d-range {
    stroke: var(--violet);
    stroke-width: 8;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1100ms var(--ease-quint) 620ms;
  }

  .d-mark {
    stroke: var(--lilac);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition:
      opacity 300ms linear,
      transform 700ms var(--ease-expo);
    transition-delay: calc(var(--k, 0) * 1000ms + 620ms);
  }

  .d-label {
    position: absolute;
    translate: -50% -50%;
    color: var(--fg);
    white-space: nowrap;
    font-variant-numeric: lining-nums proportional-nums;
    transition:
      opacity 500ms linear,
      transform 800ms var(--ease-expo);
    transition-delay: calc(var(--k, 0) * 1000ms + 760ms);
  }

  /* the pointer swings in from the top of the scale and settles, with an
     overshoot, on the middle of the range; then breathes while on screen */
  .ptr,
  .ptr-idle {
    transform-box: view-box;
    transform-origin: 320px 392px;
  }

  .ptr {
    transition:
      transform 1900ms var(--ease-settle),
      opacity 300ms linear;
    transition-delay: 900ms;
  }

  .dial.is-armed .ptr {
    transition-delay: 0ms;
    transition-duration: 1100ms, 300ms;
  }

  .dial.is-nudge .ptr {
    transform: rotate(-11deg);
  }

  .ptr-line {
    stroke: var(--starlight);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .ptr-dot {
    fill: var(--lilac);
  }

  .dial.is-in .ptr-idle {
    animation: ptr-idle 6.4s ease-in-out 3s infinite;
    animation-play-state: paused;
  }

  .dial.is-in.is-live .ptr-idle {
    animation-play-state: running;
  }

  @keyframes ptr-idle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(1.1deg);
    }
    70% {
      transform: rotate(-1.1deg);
    }
  }

  .dial-fig {
    position: absolute;
    left: 50%;
    top: 81%;
    translate: -50% -50%;
    margin: 0;
    font-stretch: var(--wd-display);
    font-size: clamp(2.5rem, 1.2rem + 3.4vw, 4.25rem);
    font-weight: 540;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: lining-nums proportional-nums;
    color: var(--fg);
  }

  .dial-fig :global(.w) {
    transition-delay: calc(var(--i, 0) * 150ms + var(--d, 0ms));
  }

  .dial-fig :global(.wm:nth-child(2)) {
    color: var(--lilac);
    padding-inline: 0.04em;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .d-ring {
    stroke-dashoffset: var(--len);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .d-range {
    stroke-dashoffset: var(--len);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) :is(.tk, .d-inner, .d-track) {
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .d-mark {
    opacity: 0;
    transform: scaleY(0.2);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .d-label {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .ptr {
    opacity: 0;
    transform: rotate(56deg);
  }

  @media (min-width: 768px) {
    .range {
      margin-top: 144px;
