  /* ---------------------------------------------------------- details */
  .more {
    margin-top: 96px;
  }

  .more :global(.xp:last-child) {
    border-bottom: 1px solid var(--line-strong);
  }

  /* keywords that wrap on a phone: the separator trails its word instead
     of opening the next line */
  @media (max-width: 767px) {
    .more :global(.xp-key + .xp-key::before) {
      content: none;
    }

    .more :global(.xp-key:not(:last-child)::after) {
