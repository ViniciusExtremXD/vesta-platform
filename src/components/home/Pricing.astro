<script>
  import { isReduced } from '../../scripts/motion';

  const section = document.getElementById('pricing');

  if (section) {
    /* compare table: always open from 768px up; a collapsed <details> on phones */
    const details = section.querySelector<HTMLDetailsElement>('[data-cmp]');
    const table = details?.querySelector<HTMLElement>('.cmp-t') ?? null;
    const scroller = section.querySelector<HTMLElement>('[data-cmp-scroll]');
    const wide = window.matchMedia('(min-width: 768px)');

    const syncScroller = () => {
      if (!scroller) return;
      const scrollable = scroller.scrollWidth > scroller.clientWidth + 1;
      if (scrollable) scroller.setAttribute('tabindex', '0');
      else scroller.removeAttribute('tabindex');
    };

    if (details) {
      if (!wide.matches) details.open = false;
      const onWide = () => {
        if (wide.matches) details.open = true;
        syncScroller();
      };
      wide.addEventListener?.('change', onWide);

      /* replay the row draw when a phone user opens it */
      details.addEventListener('toggle', () => {
        syncScroller();
        if (!details.open || wide.matches || !table || isReduced()) return;
        table.classList.remove('is-in');
        void table.offsetWidth;
        requestAnimationFrame(() => requestAnimationFrame(() => table.classList.add('is-in')));
      });
    }
    syncScroller();

    /* "Configure" hands the package to #configure through the hash; make sure
       the configurator is actually brought into view. */
    section.querySelectorAll<HTMLAnchorElement>('[data-configure]').forEach((a) => {
      a.addEventListener('click', () => {
        const target = document.getElementById('configure');
        if (!target) return;
        requestAnimationFrame(() =>
          target.scrollIntoView({ behavior: isReduced() ? 'auto' : 'smooth', block: 'start' })
        );
      });
    });
  }
</script>
