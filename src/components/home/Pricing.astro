---
/**
 * #pricing (§5.7 + SPEC_COSMOS + ROUND2 §6/§10), white paper.
 *
 * Three packages that differ in surface — plain · a 2px violet bar · a
 * faceted --void plate cut out of the night sky — condensed to what sells:
 * name, tagline, "Price on analysis", the lead time as a dimension line,
 * three keywords and the analysis CTA. The full list of inclusions lives in
 * an Expand box per package (on desktop the three open together, so the
 * rows stay aligned through subgrid).
 *
 * Then the owner's observation, once: a full-width void band with an
 * observatory-style dial — the $750–$1,000 range drawn on a scale, a pointer
 * that swings in and settles — next to the analysis CTA and the email
 * alternative. Compare, Care, Founding clients and Paperwork follow as
 * Expand boxes with their keywords visible.
 *
 * Motion: the wrappers rise out of depth (data-scene), columns flip up in
 * 3D (staggered), the recommended bar sweeps, the dial powers on tick by
 * tick and the pointer settles with an overshoot, then breathes while on
 * screen. Pointer tilt on each column with its name, price and actions
 * floating off the plate; on the Complete plate a soft light follows the
 * pointer and a planet travels its orbit. Every word comes from site.ts.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import WaGlyph from '../ui/WaGlyph.astro';
import Expand from '../ui/Expand.astro';
import DimensionLine from '../DimensionLine.astro';
import Cosmos from '../Cosmos.astro';
import MailGlyph from '../ui/MailGlyph.astro';
import {
  packages,
  pricing,
  compare,
  care,
  founding,
  paperwork,
  terms,
  contact,
  waMessages,
  wa,
  mail,
  confirmedOnly,
} from '../../data/site';

/* CTA labels carry a trailing "→" in site.ts; the arrow is drawn as a hairline SVG so it can nudge on hover. */
const bare = (s: string) => s.replace(/\s*→\s*$/, '');

const h2Lines = pricing.h2.split(/(?<=\.)\s+/).filter(Boolean);

const COL_STEP = 140; /* ms between columns */
const models = packages.map((p, i) => ({
  ...p,
  includesOn: confirmedOnly(p.includes),
  keys: pricing.keys[p.id],
  ratio: p.dayRange[1] / pricing.dayScaleMax,
  t: i * COL_STEP,
}));

const ctaClass: Record<string, string> = {
  landing: 'btn btn-line',
  google: 'btn',
  complete: 'btn btn-line',
};

const compareRows = confirmedOnly(compare.rows);
const slots = founding.slots;
const openSlots = slots.filter((s) => s.status === 'open').length;
const foundingKeys = [`${openSlots} ${founding.statusLabels.open.toLowerCase()}`, ...pricing.keys.founding];

/* ------------------------------------------------------------------ dial */
/* An arc scale from $500 to $1,250 across ±52°, the package range drawn on
   it. Centre below the viewBox, so only the limb of the dial shows. */
const lo = Math.min(...packages.map((p) => p.price.min));
const hi = Math.max(...packages.map((p) => p.price.max ?? p.price.min));
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const DW = 640;
const DH = 300;
const CX = 320;
const CY = 392;
const R = 300;
const A = 52;
const V0 = 500;
const V1 = 1250;
const STEP = 25;
const rad = (deg: number) => (deg * Math.PI) / 180;
const ang = (v: number) => -A + ((v - V0) / (V1 - V0)) * (2 * A);
const pt = (deg: number, r: number) => [CX + r * Math.sin(rad(deg)), CY - r * Math.cos(rad(deg))];
const f = (n: number) => n.toFixed(2);
const arc = (d0: number, d1: number, r: number) => {
  const [x0, y0] = pt(d0, r);
  const [x1, y1] = pt(d1, r);
  return `M${f(x0)} ${f(y0)}A${r} ${r} 0 0 1 ${f(x1)} ${f(y1)}`;
};
const arcLen = (d0: number, d1: number, r: number) => Math.ceil(r * rad(d1 - d0)) + 2;

const ticks: { x1: string; y1: string; x2: string; y2: string; k: number; cls: string }[] = [];
for (let v = V0, k = 0; v <= V1; v += STEP, k++) {
  if (v === lo || v === hi) continue; /* the range ends get their own markers */
  const major = v % 250 === 0;
  const mid = !major && v % 125 === 0;
  const len = major ? 24 : mid ? 15 : 8;
  const a = ang(v);
  const [x1, y1] = pt(a, R - len);
  const [x2, y2] = pt(a, R);
  const inRange = v > lo && v < hi;
  ticks.push({
    x1: f(x1),
    y1: f(y1),
    x2: f(x2),
    y2: f(y2),
    k,
    cls: ['tk', major ? 'tk-major' : mid ? 'tk-mid' : 'tk-minor', inRange ? 'tk-in' : ''].join(' ').trim(),
  });
}

const aLo = ang(lo);
const aHi = ang(hi);
const marks = [aLo, aHi].map((a) => {
  const [x1, y1] = pt(a, R - 30);
  const [x2, y2] = pt(a, R + 24);
  return { x1: f(x1), y1: f(y1), x2: f(x2), y2: f(y2) };
});
/* HTML labels over the SVG (they keep their size when the dial scales down) */
const labels = [
  { text: usd(lo), a: aLo },
  { text: usd(hi), a: aHi },
].map(({ text, a }) => {
  const [x, y] = pt(a, R + 44);
  return { text, left: ((x / DW) * 100).toFixed(3), top: ((y / DH) * 100).toFixed(3) };
});

const ring = { d: arc(-A, A, R), len: arcLen(-A, A, R) };
const track = arc(-A, A, R + 12);
const range = { d: arc(aLo, aHi, R + 12), len: arcLen(aLo, aHi, R + 12) };
const inner = arc(-30, 30, R - 64);
const ptr = { x: CX, y1: CY - (R - 64), y2: CY - (R + 26) };
---

<section id="pricing" class="s-paper section pricing" data-nav-theme="light" aria-labelledby="pricing-title">
  <div class="wrap" data-scene>
    <!-- head -->
    <header class="head g">
      <SectionLabel n={pricing.label.index ?? undefined} name={pricing.label.name} class="head-label" />
      <SplitText as="h2" id="pricing-title" class="d2 head-h" lines={h2Lines} />
      <p class="lead head-lead" data-reveal style="--d:160ms">{pricing.lead}</p>
    </header>

    <!-- the three models -->
    <div class="models">
      {
        models.map((m) => (
          <article class={`model m-${m.id}`} aria-labelledby={`pk-${m.id}`} data-inview style={`--t:${m.t}ms`}>
            <div class:list={['m-card', { 's-void': m.id === 'complete' }]} data-tilt="4">
              {m.id === 'complete' && (
                <div class="m-sky" aria-hidden="true">
                  <Cosmos variant="stars" />
                  {/* a soft light that follows the pointer across the plate */}
                  <span class="m-light" />
                  {/* one inclined circular orbit seen obliquely: star at the
                      centre, a planet travelling the near ellipse (two
                      phase-shifted sine translations = an ellipse). */}
                  <svg class="m-orbit" viewBox="0 0 640 640" fill="none" focusable="false" data-parallax="0.08">
                    <g transform="rotate(-24 320 320)">
                      <ellipse class="orb orb-far" cx="320" cy="320" rx="300" ry="92" data-draw-path />
                      <ellipse class="orb orb-near" cx="320" cy="320" rx="196" ry="60" data-draw-path />
                      <circle class="orb-star" cx="320" cy="320" r="2" />
                      <g class="orb-run">
                        <g class="orb-rx">
                          <g class="orb-ry">
                            <circle class="orb-planet" cx="320" cy="320" r="3.5" />
                          </g>
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>
              )}
              {m.id !== 'complete' && (
                <span
                  class:list={['m-top', { 'm-bar': m.id === 'google', 'm-rule': m.id !== 'google' }]}
                  data-reveal="draw"
                  style={`--d:${m.t + 260}ms`}
                  aria-hidden="true"
                >
                  {m.id === 'google' && <span class="m-sweep" />}
                </span>
              )}
              {m.recommended && m.recommended.confirmed && (
                <p class="m-flag label" data-reveal style={`--d:${m.t + 900}ms`}>
                  <span class="orbit" aria-hidden="true" />
                  <span>{m.recommended.text}</span>
                </p>
              )}

              <h3 id={`pk-${m.id}`} class="m-name d3" data-reveal style={`--d:${m.t + 180}ms`}>
                {m.name}
              </h3>
              <p class="m-tag" data-reveal style={`--d:${m.t + 260}ms`}>
                {m.tagline}
              </p>
              <p class="m-price" data-reveal style={`--d:${m.t + 340}ms`}>
                <span class="node is-on" aria-hidden="true" />
                <span>{pricing.priceLabel}</span>
              </p>
              <div class="m-dim">
                <DimensionLine label={m.daysLabel} ratio={m.ratio} delay={m.t + 420} />
              </div>
              <ul class="m-keys" aria-label={m.name}>
                {m.keys.map((k, n) => (
                  <li class="m-key" data-reveal style={`--d:${m.t + 520 + n * 70}ms`}>
                    {k}
                  </li>
                ))}
              </ul>
              <div class="m-cta" data-reveal style={`--d:${m.t + 640}ms`}>
                <a
                  class={ctaClass[m.id]}
                  href={wa(m.waText)}
                  target="_blank"
                  rel="noopener"
                  data-wa-intent={`pricing-${m.id}`}
                  data-magnetic=".2"
                >
                  <WaGlyph size={16} />
                  <span class="btn-t">{bare(m.cta)}</span>
                  <Arrow />
                </a>
                <a class="tlink m-conf" href={m.configure.href} data-configure={m.id}>
                  <span>{m.configure.label}</span>
                  <Arrow />
                </a>
              </div>
              <div class="m-x" data-reveal style={`--d:${m.t + 720}ms`}>
                <Expand title={pricing.labels.includes} class="m-xp" reveal={false}>
                  <p class="m-best">
                    <span class="label m-best-l">{pricing.labels.bestFor}</span>
                    <span class="m-best-t">{m.bestFor}</span>
                  </p>
                  <ul class="m-inc">
                    {m.includesOn.map((it, k) => (
                      <li style={`--k:${k}`}>{it.text}</li>
                    ))}
                  </ul>
                </Expand>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- the owner's observation, once: an instrument band -->
  <div class="range s-void" data-nav-theme="dark">
    <Cosmos variant="stars" />
    <div class="wrap range-in g" data-scene="soft">
      <SplitText as="h3" class="d2 range-t" text={pricing.rangeNote.title} />

      <div class="dial-wrap" data-parallax="0.05">
        <div class="dial" data-inview data-dial data-tilt="5">
          <svg class="dial-svg" viewBox={`0 0 ${DW} ${DH}`} fill="none" aria-hidden="true" focusable="false">
            <path class="d-inner" d={inner} />
            <path class="d-track" d={track} />
            <path class="d-ring" d={ring.d} style={`--len:${ring.len}`} />
            {ticks.map((t) => <line class={t.cls} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} style={`--k:${t.k}`} />)}
            <path class="d-range" d={range.d} style={`--len:${range.len}`} />
            {marks.map((mk, i) => <line class="d-mark" x1={mk.x1} y1={mk.y1} x2={mk.x2} y2={mk.y2} style={`--k:${i}`} />)}
            <g class="ptr">
              <g class="ptr-idle">
                <line class="ptr-line" x1={ptr.x} y1={ptr.y1} x2={ptr.x} y2={ptr.y2} />
                <circle class="ptr-dot" cx={ptr.x} cy={ptr.y1} r="4.5" />
              </g>
            </g>
          </svg>
          {
            labels.map((l, i) => (
              <span class="d-label label" style={`left:${l.left}%;top:${l.top}%;--k:${i}`} aria-hidden="true">
                {l.text}
              </span>
            ))
          }
          <p class="dial-fig" data-split data-split-done style="--d:760ms">
            <span class="wm"><span class="w" style="--i:0">{usd(lo)}</span></span><span class="wm"
              ><span class="w" style="--i:1">–</span></span
            ><span class="wm"><span class="w" style="--i:2">{usd(hi)}</span></span>
          </p>
        </div>
      </div>

      <p class="lead range-p" data-reveal style="--d:120ms">{pricing.rangeNote.text}</p>

      <div class="range-cta" data-reveal style="--d:220ms">
        <a
          class="btn btn-lg"
          href={wa(waMessages.hero)}
          target="_blank"
          rel="noopener"
          data-wa-intent="pricing-analysis"
          data-magnetic=".25"
          data-nudge
        >
          <WaGlyph size={16} />
          <span>{pricing.analysisCta}</span>
          <Arrow />
        </a>
        {
          contact.email.confirmed && (
            <a class="tlink range-mail" href={mail()} data-mail-intent="pricing" data-nudge>
              <MailGlyph size={16} />
              <span>{contact.email.address}</span>
              <Arrow />
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- the detail, on demand -->
  <div class="wrap more" data-scene="soft">
    <Expand title={compare.summary} keywords={pricing.keys.compare} index="01" class="x-cmp" i={0}>
      <div class="cmp-scroll" role="region" aria-labelledby="cmp-cap" data-cmp-scroll>
        <table class="cmp-t" data-inview>
          <caption id="cmp-cap" class="cmp-cap label">{compare.caption}</caption>
          <colgroup>
            <col class="cmp-col-l" />
            <col class="cmp-col-v" />
            <col class="cmp-col-v" />
            <col class="cmp-col-v" />
          </colgroup>
          <thead>
            <tr style="--r:0">
              <th scope="col" class="cmp-corner">
                <span class="visually-hidden">{compare.rowHeader}</span>
              </th>
              {
                compare.columns.map((c, i) => (
                  <th scope="col" class:list={['cmp-h', { 'cmp-h-rec': i === 1 }]}>
                    <span class="cmp-h-t">{c}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              compareRows.map((row, r) => (
                <tr style={`--r:${r + 1}`}>
                  <th scope="row" style="--c:0">
                    <span class="cmp-l">{row.label}</span>
                  </th>
                  {row.values.map((v, c) => (
                    <td class:list={{ 'cmp-rec': c === 1 }} style={`--c:${c + 1}`}>
                      {v === true ? (
                        <Fragment>
                          <span class="mk mk-y" aria-hidden="true" />
                          <span class="visually-hidden">{compare.included.label}</span>
                        </Fragment>
                      ) : v === false ? (
                        <Fragment>
                          <span class="mk mk-n" aria-hidden="true" />
                          <span class="visually-hidden">{compare.notIncluded.label}</span>
                        </Fragment>
                      ) : (
                        <span class="cv">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </Expand>

    <Expand title={care.title} keywords={pricing.keys.care} index="02" class="x-care" i={1}>
      <p class="x-body">{care.body}</p>
      <p class="x-cta">
        <a class="tlink" href={wa(care.cta.text)} target="_blank" rel="noopener" data-wa-intent="pricing-care">
          <WaGlyph size={14} />
          <span>{bare(care.cta.label)}</span>
          <Arrow />
        </a>
      </p>
    </Expand>

    {
      founding.confirmed && (
        <Expand title={founding.title} keywords={foundingKeys} index="03" class="x-found" i={2}>
          <p class="x-body">{founding.body}</p>
          <ol class="slots">
            {slots.map((s, k) => (
              <li class:list={['slot', `is-${s.status}`]} style={`--k:${k}`}>
                <span class:list={['node', { 'is-on': s.status === 'taken' }]} aria-hidden="true" />
                <span class="slot-n">{String(s.n).padStart(2, '0')}</span>
                <span class="slot-s">{founding.statusLabels[s.status]}</span>
              </li>
            ))}
          </ol>
          <p class="x-cta">
            <a class="tlink" href={wa(founding.cta.text)} target="_blank" rel="noopener" data-wa-intent="pricing-founding">
              <WaGlyph size={14} />
              <span>{bare(founding.cta.label)}</span>
              <Arrow />
            </a>
          </p>
        </Expand>
      )
    }

    <Expand title={paperwork.title} keywords={pricing.keys.paperwork} index="04" class="x-pw" i={3}>
      <dl class="pw-cells">
        {
          paperwork.cells.map((c, k) => (
            <div class="pw-cell" style={`--k:${k}`}>
              <dt class="pw-v">{c.value}</dt>
              <dd class="pw-c">{c.caption}</dd>
            </div>
          ))
        }
      </dl>
      {
        terms.assurance.confirmed && (
          <p class="pw-assure">
            <span class="node is-on" aria-hidden="true" />
            <span>{terms.assurance.text}</span>
          </p>
        )
      }
    </Expand>
  </div>
</section>

<style>
  /* ------------------------------------------------------------ section */
  .pricing {
    /* plate overhangs, the flip-in and the hover plates never push the page sideways */
    overflow: clip;
    --oh: 12px; /* Complete plate overhang */
  }

  @media (min-width: 768px) {
    .pricing {
      --oh: 16px;
    }
  }

  @media (min-width: 1100px) {
    .pricing {
      --oh: 24px;
    }
  }

  /* --------------------------------------------------------------- head */
  .head {
    row-gap: 24px;
  }

  .head-h {
    max-width: 18ch;
  }

  .head-lead {
    color: var(--fg);
    max-width: 38ch;
  }

  @media (min-width: 1100px) {
    .head {
      row-gap: 32px;
    }

    .head-label {
      margin-bottom: 8px;
    }

    .head-h {
      grid-column: 1 / span 7;
    }

    .head-lead {
      grid-column: 9 / span 4;
      align-self: end;
    }
  }

  /* ------------------------------------------------------------- models */
  .models {
    display: grid;
    row-gap: 104px;
    margin-top: 104px;
  }

  /* the column rises out of the page and flips up into place */
  .model {
    position: relative;
    transform-origin: 50% 100%;
    transition:
      transform 1500ms var(--ease-expo),
      opacity 600ms linear;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .model:not(.is-in) {
    opacity: 0;
    transform: perspective(1400px) translate3d(0, 96px, 0) rotateX(34deg);
  }

  /* z-index (not isolation) keeps the plate's z-index:-1 layers inside the
     card without flattening the tilt's 3D context */
  .m-card {
    position: relative;
    z-index: 0;
    height: 100%;
    padding-top: 32px;
  }

  /* depth under the tilt (fine pointers): while the pointer is over a
     column, its name, price, flag and actions float off the plate at
     different heights. The individual "translate" property composes with
     the reveal's "transform", so the two never fight. */
  @media (hover: hover) and (pointer: fine) {
    .m-card > :is(.m-name, .m-price, .m-cta, .m-flag, .m-tag) {
      --rd: calc(var(--i, 0) * 90ms + var(--d, 0ms));
      transition:
        opacity var(--t-reveal) var(--ease-expo),
        transform var(--t-reveal) var(--ease-expo),
        translate 800ms var(--ease-expo);
      transition-delay: var(--rd), var(--rd), 0ms;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card.is-tilting > .m-name {
      translate: 0 0 34px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card.is-tilting > .m-flag {
      translate: 0 0 40px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card.is-tilting > .m-tag {
      translate: 0 0 16px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card.is-tilting > .m-price {
      translate: 0 0 24px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card.is-tilting > .m-cta {
      translate: 0 0 28px;
    }
  }

  /* top edge: a hairline on Landing, the 2px violet bar on + Google */
  .m-top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: block;
    overflow: clip;
  }

  .m-rule {
    height: 1px;
    background-color: var(--line-strong);
  }

  .m-bar {
    height: 2px;
    background-color: var(--violet);
  }

  /* a lilac light runs along the bar once it has drawn, and again on hover */
  .m-sweep {
    position: absolute;
    inset: 0;
    transform: translate3d(-100%, 0, 0);
  }

  .m-sweep::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 34%;
    background-color: var(--lilac);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-bar.is-in .m-sweep {
    animation: bar-sweep 1300ms var(--ease-quint) calc(var(--d, 0ms) + 1150ms) both;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .m-card:hover .m-bar.is-in .m-sweep {
      animation: bar-sweep-again 1100ms var(--ease-quint) both;
    }
  }

  @keyframes bar-sweep {
    from {
      transform: translate3d(-100%, 0, 0);
    }
    to {
      transform: translate3d(134%, 0, 0);
    }
  }

  @keyframes bar-sweep-again {
    from {
      transform: translate3d(-100%, 0, 0);
    }
    to {
      transform: translate3d(134%, 0, 0);
    }
  }

  /* sits above the column's top edge; wraps upward on the narrowest phones */
  .m-flag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 14px);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent-text);
    text-wrap: balance;
  }

  /* the Complete plate: a facet of night sky standing proud of the row. The
     card paints the rectangle (so the contrast gate sees --void behind the
     text); ::before adds the overhang with the 45° facet cuts, and .m-sky
     carries the stars and the orbit inside the same facet. */
  .m-complete .m-card {
    margin-block: var(--oh);
    padding-block: 20px 8px;
    background-color: var(--void);
  }

  .m-complete .m-card::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--oh)) 0;
    z-index: -1;
    background-color: var(--void);
    clip-path: var(--chamfer);
  }

  /* below desktop the plate runs edge to edge; its padding equals the page
     gutter, so its text keeps the same left edge as every other block */
  @media (max-width: 1099px) {
    .m-complete .m-card {
      margin-inline: calc(-1 * var(--gut));
      padding-inline: var(--gut);
    }
  }

  .m-sky {
    position: absolute;
    inset: calc(-1 * var(--oh)) 0;
    z-index: -1;
    overflow: clip;
    clip-path: var(--chamfer);
    pointer-events: none;
    /* one faint nebula pool in the far corner (≤10%, cosmos imagery only) */
    background-image: radial-gradient(70% 38% at 100% 100%, rgb(98 54 232 / 0.1), transparent 72%);
  }

  .m-sky :global(.cosmos) {
    opacity: 0.75;
  }

  /* the pointer light: a soft lilac pool inside the plate that follows the
     pointer (transform only; the script writes --lx / --ly in px) */
  .m-light {
    position: absolute;
    left: 0;
    top: 0;
    width: 620px;
    height: 620px;
    margin: -310px 0 0 -310px;
    border-radius: 50%;
    background-image: radial-gradient(
      closest-side,
      rgb(185 162 255 / 0.12),
      rgb(98 54 232 / 0.07) 42%,
      rgb(98 54 232 / 0) 100%
    );
    opacity: 0;
    transform: translate3d(var(--lx, 70%), var(--ly, 30%), 0);
    transition: opacity 900ms var(--ease-expo);
    pointer-events: none;
  }

  .m-card.is-lit .m-light {
    opacity: 1;
  }

  .m-orbit {
    position: absolute;
    right: -230px;
    bottom: -286px;
    width: 640px;
    height: 640px;
    max-width: none;
    overflow: visible;
  }

  @media (max-width: 767px) {
    .orb-far {
      display: none;
    }
  }

  .orb {
    stroke-width: 1;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 2400ms var(--ease-quint),
      opacity 400ms linear;
  }

  .orb-far {
    stroke: rgb(243 240 250 / 0.12);
    transition-delay: 900ms;
  }

  .orb-near {
    stroke: rgb(185 162 255 / 0.42);
    transition-delay: 700ms;
  }

  .orb-star {
    fill: var(--starlight);
  }

  .orb-planet {
    fill: var(--lilac);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 900ms var(--ease-settle),
      opacity 300ms linear;
    transition-delay: 1900ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orb:not(.is-in) {
    stroke-dashoffset: var(--len);
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orb-near:not(.is-in) ~ .orb-run .orb-planet {
    opacity: 0;
    transform: scale(0);
  }

  /* the planet's year: 56 s. x = a·cos, y = b·sin — ease-in-out halves
     approximate the sine; the y track runs a quarter period behind */
  .orb-rx {
    animation: orb-x 28s cubic-bezier(0.37, 0, 0.63, 1) -14s infinite alternate;
  }

  .orb-ry {
    animation: orb-y 28s cubic-bezier(0.37, 0, 0.63, 1) -28s infinite alternate;
  }

  .m-card:not(.is-live) :is(.orb-rx, .orb-ry) {
    animation-play-state: paused;
  }

  :global(html.motion-reduced) :is(.orb-rx, .orb-ry) {
    animation: none;
  }

  @keyframes orb-x {
    from {
      transform: translate(-196px, 0);
    }
    to {
      transform: translate(196px, 0);
    }
  }

  @keyframes orb-y {
    from {
      transform: translate(0, -60px);
    }
    to {
      transform: translate(0, 60px);
    }
  }

  .m-name {
