  /* one faint nebula pool behind the dial (≤10%, imagery only) */
  .range::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(46% 60% at 72% 62%, rgb(98 54 232 / 0.1), transparent 72%);
  }

