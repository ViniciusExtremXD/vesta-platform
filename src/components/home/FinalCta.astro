---
import { finalCta, primaryCta, contact } from '../../data/site';
import { url } from '../../lib/url';
import Icon from '../Icon.astro';
---

<section class="cta section on-void" id="book">
  <div class="cta-orb" aria-hidden="true">
    <span class="cta-ring cta-ring-1"></span>
    <span class="cta-ring cta-ring-2"></span>
    <span class="cta-ring cta-ring-3"></span>
  </div>

  <div class="wrap wrap-narrow cta-inner">
    <p class="kicker" data-reveal="up">{finalCta.kicker}</p>
    <h2 data-split set:html={finalCta.title} />
    <p class="lead" data-reveal="up" style="--i:2">{finalCta.body}</p>
    <div class="btn-row cta-actions" data-reveal="up" style="--i:3">
      <a class="btn btn-primary btn-lg" href={url(primaryCta.href)} data-magnetic>
        {primaryCta.label}
        <Icon name="arrow" class="arrow" />
      </a>
      {
        contact.whatsapp.confirmed && (
          <a class="btn btn-ghost btn-lg" href={contact.whatsapp.url} target="_blank" rel="noopener" data-magnetic="0.18">
            <Icon name="whatsapp" /> Message on WhatsApp
          </a>
        )
      }
    </div>
    <p class="cta-hours hud" data-reveal="fade" style="--i:4">
      <span class="pulse" aria-hidden="true"></span>
      <b>{contact.hours.label}</b> · replies inside your business day
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    border-top: 1px solid var(--line-dark);
  }

  .cta-orb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1px;
    height: 1px;
    z-index: 0;
    pointer-events: none;
  }

  .cta-orb::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60rem;
    height: 60rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(124 58 237 / 0.32), rgb(124 58 237 / 0.08) 45%, transparent 70%);
    animation: orb 6s var(--ease-in-out) infinite alternate;
  }

  @keyframes orb {
    from {
      transform: translate(-50%, -50%) scale(0.92);
      opacity: 0.8;
    }
    to {
      transform: translate(-50%, -50%) scale(1.06);
      opacity: 1;
    }
  }

  .cta-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22rem;
    height: 22rem;
    border: 1px solid rgb(182 156 255 / 0.35);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 0;
    animation: ring 7s var(--ease-out) infinite;
  }

  .cta-ring-2 {
    animation-delay: 2.3s;
  }

  .cta-ring-3 {
    animation-delay: 4.6s;
  }

  @keyframes ring {
    0% {
      transform: translate(-50%, -50%) scale(0.3);
      opacity: 0;
    }
    15% {
      opacity: 0.7;
    }
    100% {
      transform: translate(-50%, -50%) scale(2.6);
      opacity: 0;
    }
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-m);
  }

  .cta h2 {
    max-width: 16ch;
  }

  .cta .lead {
    max-width: 50ch;
  }

  .cta-actions {
    justify-content: center;
    margin-top: var(--space-s);
  }

  .cta-hours {
    justify-content: center;
    margin-top: var(--space-s);
  }

  html.motion-reduced .cta-orb::before,
  html.motion-reduced .cta-ring {
    animation: none;
  }

  html.motion-reduced .cta-ring {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1.4);
  }
</style>
