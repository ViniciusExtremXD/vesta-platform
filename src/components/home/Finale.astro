---
/**
 * §5.12 #finale (violet) — the close. SPEC.md §5.12, re-skinned by
 * SPEC_COSMOS.md §2 and made bolder in rounds 2–3: the violet field with a
 * living star field behind it (<Cosmos variant="stars">), the ECLIPSE
 * REVEAL, and WhatsApp + Email side by side.
 *
 * The eclipse.
 *  - The cover: a --void disc (section::after, [data-cover]) with a lilac
 *    atmospheric limb covers the whole section and shrinks, scale 1 → 0, into
 *    the eclipsed body in the upper right; the night opens. The disc exists
 *    only in the armed state (html.js, motion on, engine alive) and ends at
 *    scale 0 + opacity 0 + visibility hidden, so it is never left over
 *    content.
 *  - The body: a starlight sun behind a --void moon with a hairline limb, a
 *    breathing corona, slow coronal streamers and one bead of light on the
 *    −24° diagonal. As the section scrolls up the moon slides along that
 *    diagonal into totality (the crescent and the bead thin out: a "diamond
 *    ring"); transform-only, written from the shared scroll loop. The body
 *    also sits at its own depth (data-parallax). Loops pause offscreen.
 *  - The content plane swings up out of depth as the disc opens (rotateX +
 *    translateZ on the grid), the H2 words flip up on a hinge, the four
 *    intent chips fall into place one after another (rotateX from the top
 *    edge), then the buttons and the number rise.
 *   Trigger: the engine's .is-in on the section (data-inview). Because the
 *   engine marks sections as soon as a sliver shows (and marks everything
 *   after 6s), the script below HOLDS the open (.is-held) until half of the
 *   viewport is violet, then releases it: the content in view plays the
 *   choreography, timed to the moment the disc uncovers it; content below
 *   the fold is handed back to the engine and rises on entry.
 *   The hold is only ever added by this script, so if it fails the disc
 *   simply opens on .is-in; once the section is on screen it is released
 *   within 2.4s whatever happens.
 *
 * Desktop: H2 (D1) in columns 1–10, one sentence per line block; body in
 * columns 1–5 closed by a hairline and the secondary links; the console
 * (intent chips 2×2, the 64px starlight WhatsApp button with the starlight
 * outline Email button beside it, the number line) in 7–12. The WhatsApp
 * button is sized for its longest label, so choosing a chip moves nothing.
 * Choosing a chip also sets the email: subject = the chip's label, body =
 * the same prefill as the WhatsApp message. When the console is narrower
 * than 540px (phones, tablets, small laptops) Email sits under WhatsApp,
 * so the WhatsApp label never breaks mid-phrase.
 *
 * No live clock line (owner decision). Root carries data-sticky-hide so the
 * mobile WhatsApp bar steps aside here.
 */
import Cosmos from '../Cosmos.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import WaGlyph from '../ui/WaGlyph.astro';
import MailGlyph from '../ui/MailGlyph.astro';
import { finale, contact, wa, mail } from '../../data/site';
import { url } from '../../lib/url';

/* "Send your current website." / "Get a free price analysis." — one
   sentence per line block, each balanced on its own. */
const lines = finale.h2.split(/(?<=\.)\s+/);

const showEmail = contact.email.confirmed;

const intents = finale.intents.map((it) => ({
  id: it.id,
  label: it.label,
  href: wa(it.text),
  cta: finale.button.withIntent(it.label),
  /* the same request by email: the chip's label as the subject */
  mail: mail(it.label, it.text),
}));

const mailDefault = mail(contact.email.subject, finale.button.text);
const mailAria = `${finale.email.aria} ${finale.email.address}`;

/* The button is sized once for its longest label, so choosing a chip never
   moves anything (the sizer is aria-hidden and visibility: hidden). */
const longest = intents.reduce((a, b) => (b.cta.length > a.length ? b.cta : a), finale.button.label);

const [linkedin, prices] = finale.secondary;
/* the ↗ in the label is drawn by <Arrow dir="up-right"> as a hairline glyph */
const linkedinText = linkedin.label.replace(/\s*↗\s*$/, '');
/* E.164 with the plus: pastes cleanly into WhatsApp, a dialer or a contact */
const copyValue = `+${contact.whatsapp.e164}`;

/* Choreography offsets (ms after the eclipse opens), used only for content
   that is on screen at that moment. Everything else rises on entry with the
   small default delays in its style attribute. */
const STAGE = { h2: 240, body: 520, legend: 560, chip: 620, chipStep: 90, button: 1000, number: 1120, rule: 900, links: 1040 };
---

<section
  id={finale.id}
  class="finale s-violet section"
  data-nav-theme="dark"
  data-inview
  data-cover
  data-sticky-hide
  data-finale
  aria-labelledby="finale-title"
>
  <Cosmos variant="stars" />

  <div class="eclipse" data-eclipse aria-hidden="true">
    <div class="ecl-body" data-parallax="0.08">
      <span class="streamers"></span>
      <span class="corona"></span>
      <span class="sun"></span>
      <span class="flare"></span>
      <span class="moon"></span>
      <span class="bead"></span>
    </div>
  </div>

  <div class="wrap g grid">
    <SplitText as="h2" id="finale-title" class="d1 title" lines={lines} data-stage={STAGE.h2} />

    <p class="lead intro" data-reveal data-stage={STAGE.body}>{finale.body}</p>

    <div class="console">
      <fieldset class="intents" data-wa-intent="finale-intents">
        <legend class="label legend" data-reveal data-stage={STAGE.legend}>{finale.intentsLabel}</legend>
        <div class="chips">
          {
            intents.map((it, k) => (
              <label class="chip" data-reveal style={`--d:${k * STAGE.chipStep}ms`} data-stage={STAGE.chip + k * STAGE.chipStep}>
                <input
                  class="visually-hidden"
                  type="radio"
                  name="finale-intent"
                  value={it.id}
                  data-href={it.href}
                  data-cta={it.cta}
                  data-mail={it.mail}
                />
                <span class="chip-face">
                  <span class="chip-node" aria-hidden="true" />
                  <span class="chip-text">{it.label}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class:list={['cta-wrap', { 'has-mail': showEmail }]} data-reveal style="--d:120ms" data-stage={STAGE.button}>
        <a
          class="btn btn-star btn-lg cta"
          href={wa(finale.button.text)}
          target="_blank"
          rel="noopener"
          data-magnetic=".25"
          data-wa-intent="finale"
          data-finale-cta
        >
          <WaGlyph size={18} />
          <span class="cta-text">
            <span class="cta-label" data-finale-label>{finale.button.label}</span>
            <span class="cta-sizer" aria-hidden="true">{longest}</span>
          </span>
          <Arrow />
        </a>
        {
          showEmail && (
            <a class="btn btn-line btn-lg mail" href={mailDefault} aria-label={mailAria} data-magnetic=".2" data-finale-mail>
              <MailGlyph size={18} />
              <span class="mail-text">{finale.email.label}</span>
              <Arrow />
            </a>
          )
        }
      </div>

      <div class="numline" data-reveal style="--d:200ms" data-stage={STAGE.number}>
        <p class="number">
          <span class="num-value" data-number>{finale.number.display}</span>
          <button type="button" class="copy" data-copy={copyValue} data-copied={finale.number.copied} data-copied-ms={finale.number.copiedMs}>
            <span class="copy-label" data-copy-label>{finale.number.copy}</span>
          </button>
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
        </p>
        <p class="small reassure">{finale.reassurance}</p>
      </div>
    </div>

    <div class="foot">
      <span class="rule foot-rule" data-reveal="draw" data-stage={STAGE.rule} aria-hidden="true"></span>
      <ul class="links" data-reveal style="--d:80ms" data-stage={STAGE.links}>
        <li>
          <a class="tlink" href={linkedin.href} target="_blank" rel="noopener">
            <span>{linkedinText}</span>
            <Arrow dir="up-right" />
          </a>
        </li>
        <li>
          <a class="tlink" href={url(prices.href)}>
            <span>{prices.label}</span>
            <Arrow dir="up" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { addFrame, isReduced, observeReveals, requestFrame, vestibular } from '../../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-finale]');
  if (root) {
    initIntents(root);
    initCopy(root);
    initEclipse(root);
    initSky(root);
  }

  /* ---- intent chips: prefill + labels ---------------------------------- */
  function initIntents(section: HTMLElement): void {
    const cta = section.querySelector<HTMLAnchorElement>('[data-finale-cta]');
    const label = section.querySelector<HTMLElement>('[data-finale-label]');
    const mailBtn = section.querySelector<HTMLAnchorElement>('[data-finale-mail]');
    const radios = Array.from(section.querySelectorAll<HTMLInputElement>('input[name="finale-intent"]'));
    if (!cta || !label || !radios.length) return;

    const sync = (animate: boolean) => {
      const on = radios.find((r) => r.checked);
      if (!on) return;
      if (on.dataset.href) cta.href = on.dataset.href;
      if (mailBtn && on.dataset.mail) mailBtn.href = on.dataset.mail;
      cta.dataset.waIntent = on.value;
      if (on.dataset.cta && label.textContent !== on.dataset.cta) {
        label.textContent = on.dataset.cta;
        // the new label flips in on its baseline
        if (animate && !isReduced()) {
          label.classList.remove('is-flip');
          void label.offsetWidth;
          label.classList.add('is-flip');
        }
      }
    };
    radios.forEach((r) => r.addEventListener('change', () => sync(true)));
    // a selection restored by back/forward navigation
    sync(false);
    window.addEventListener('pageshow', () => sync(false));
  }

  /* ---- copy number ------------------------------------------------------ */
  function initCopy(section: HTMLElement): void {
    const btn = section.querySelector<HTMLButtonElement>('[data-copy]');
    const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
    const status = section.querySelector<HTMLElement>('[data-copy-status]');
    const number = section.querySelector<HTMLElement>('[data-number]');
    if (!btn || !label) return;

    const idle = label.textContent ?? '';
    const done = btn.dataset.copied || 'Copied';
    const ms = Number(btn.dataset.copiedMs) || 1600;
    let timer = 0;

    const selectNumber = () => {
      if (!number) return;
      const range = document.createRange();
      range.selectNodeContents(number);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    };

    btn.addEventListener('click', async () => {
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          ok = true;
        }
      } catch {
        ok = false;
      }
      // No clipboard access: select the number so Ctrl/Cmd+C works.
      if (!ok) return selectNumber();

      label.textContent = done;
      btn.classList.add('is-copied');
      if (status) status.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = idle;
        btn.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, ms);
    });
  }

  /* ---- the eclipse cover -------------------------------------------------
     Geometry: the disc is centred on the eclipsed body; its diameter is
     measured so it covers the farthest corner of the section.
     Timing: see the component header (hold until half the viewport is
     violet, then stage what is on screen). */
  function initEclipse(section: HTMLElement): void {
    const html = document.documentElement;
    const body = section.querySelector<HTMLElement>('[data-eclipse]');

    const measure = () => {
      const s = section.getBoundingClientRect();
      let cx = s.width - 160;
      let cy = 200;
      if (body && body.offsetWidth) {
        const b = body.getBoundingClientRect();
        cx = b.left - s.left + b.width / 2;
        cy = b.top - s.top + b.height / 2;
      }
      const d = 2 * Math.hypot(Math.max(cx, s.width - cx), Math.max(cy, s.height - cy)) + 8;
      section.style.setProperty('--ecl-d', `${Math.ceil(d)}px`);
    };
    measure();
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(section);

    const armed = () => html.classList.contains('js') && !html.classList.contains('motion-failed') && !isReduced();
    const openAt = (r: DOMRect, vh: number) => r.top <= vh * 0.5 || r.bottom <= vh;
    const staged = Array.from(section.querySelectorAll<HTMLElement>('[data-stage]'));
    const reveals = Array.from(section.querySelectorAll<HTMLElement>('[data-reveal], [data-split]'));

    let held = false;
    let deadline = 0;
    let release = false;
    const onScreen: HTMLElement[] = [];
    const offScreen: HTMLElement[] = [];

    /* layout reads: who is on screen right now */
    const survey = (vh: number) => {
      onScreen.length = 0;
      offScreen.length = 0;
      for (const el of staged) {
        const r = el.getBoundingClientRect();
        if (r.top < vh && r.bottom > 0) onScreen.push(el);
      }
      for (const el of reveals) {
        const r = el.getBoundingClientRect();
        if (r.top >= vh || r.bottom <= 0) offScreen.push(el);
      }
    };

    /* Content that scrolls into view while the night is still opening keeps
       its place in the choreography: its delay is what is left of its
       stage offset (the engine adds .is-in and dispatches vesta:reveal in
       the same task, so the delay lands before the style change). */
    let openedAt = 0;
    section.addEventListener('vesta:reveal', (e) => {
      const el = e.target as HTMLElement;
      if (el === section || !openedAt || !el.dataset || !el.dataset.stage) return;
      const since = performance.now() - openedAt;
      if (since > 1600) return;
      el.style.setProperty('--d', `${Math.round(Math.max(0, Number(el.dataset.stage) - since))}ms`);
    });

    /* style writes: stage the visible, hand the rest back to the engine */
    const open = () => {
      openedAt = performance.now();
      for (const el of onScreen) el.style.setProperty('--d', `${el.dataset.stage}ms`);
      const rearm = offScreen.filter((el) => el.classList.contains('is-in'));
      rearm.forEach((el) => el.classList.remove('is-in'));
      held = false;
      window.clearTimeout(deadline);
      section.classList.remove('is-held');
      if (rearm.length) observeReveals(section);
    };

    const forceOpen = () => {
      if (!held) return;
      survey(window.innerHeight);
      open();
    };

    section.addEventListener('vesta:reveal', (e) => {
      if (e.target !== section || !armed()) return;
      const vh = window.innerHeight;
      survey(vh);
      if (openAt(section.getBoundingClientRect(), vh)) {
        // already half on screen (anchor jump, reload): open right away
        openedAt = performance.now();
        for (const el of onScreen) el.style.setProperty('--d', `${el.dataset.stage}ms`);
        return;
      }
      held = true;
      section.classList.add('is-held');
      // Already partly on screen (e.g. a restored scroll position) and the
      // visitor may not scroll again: start the clock now, not on a frame.
      const r = section.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) deadline = window.setTimeout(forceOpen, 2400);
    });

    addFrame({
      read(_y, vh) {
        if (!held) return;
        const r = section.getBoundingClientRect();
        if (openAt(r, vh)) {
          survey(vh);
          release = true;
        } else if (!deadline && r.top < vh && r.bottom > 0) {
          // on screen but parked short of half: never hold longer than this
          deadline = window.setTimeout(forceOpen, 2400);
        }
      },
      write() {
        if (!release) return;
        release = false;
        if (held) open();
      },
    });

    // Motion switched off: nothing may stay held.
    document.addEventListener('vesta:motion', () => {
      if (isReduced()) forceOpen();
    });
  }

  /* ---- the eclipsed body: totality on scroll + loops on/offscreen -------
     --m (0 … 1) is how far the moon has slid off the sun along the −24°
     diagonal: 1 while the section is low in the viewport, about 0.4 when
     its top reaches the top edge (a thin crescent and the bead: the
     diamond ring while the content is read), 0 (totality) once it has
     scrolled a little over half a viewport further. */
  function initSky(section: HTMLElement): void {
    const body = section.querySelector<HTMLElement>('[data-eclipse]');
    if (!body) return;
    let near = false;
    let m = 0;
    let wm = NaN;

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          near = entries.some((e) => e.isIntersecting);
          section.classList.toggle('is-live', near && document.visibilityState === 'visible');
          if (near) requestFrame();
        },
        { rootMargin: '10% 0px' }
      ).observe(section);
    } else {
      near = true;
      section.classList.add('is-live');
    }
    document.addEventListener('visibilitychange', () => {
      section.classList.toggle('is-live', near && document.visibilityState === 'visible');
    });

    addFrame({
      read(_y, vh) {
        if (!near) return;
        if (vestibular()) {
          m = 0.35;
          return;
        }
        const t = section.getBoundingClientRect().top / vh;
        m = Math.min(1, Math.max(0, (t + 0.55) / 1.25));
      },
      write() {
        if (m === wm) return;
        wm = m;
        body.style.setProperty('--m', m.toFixed(4));
      },
    });
  }
</script>

<style>
  /* ---- section ------------------------------------------------------------
     The field is --violet-deep (starlight 10.2:1). --ecl-* place the eclipsed
     body; the covering disc (::after) is centred on the same point, and its
     diameter (--ecl-d) is measured by the script (400vmax until then). */
  .finale {
    --ecl-size: clamp(84px, 15vw, 224px);
    --ecl-edge: max(var(--gut), (100% - var(--content-max)) / 2);
    --ecl-cx: calc(100% - var(--ecl-edge) - var(--ecl-size) / 2);
    --ecl-cy: calc(var(--section-y) * 0.4 + var(--ecl-size) / 2);
    --ecl-d: 400vmax;
    display: flex;
    flex-direction: column;
    min-height: 80svh;
    overflow: clip;
    isolation: isolate;
  }

  @media (min-width: 768px) {
    .finale {
      min-height: 88svh;
    }
  }

  @media (min-width: 1100px) {
    .finale {
      --ecl-cy: calc(var(--section-y) + var(--ecl-size) * 0.42);
    }
  }

  /* ---- the eclipse cover (data-cover) ------------------------------------ */
  /* The night: a void disc with a lilac atmospheric limb (a planet's rim
     catching the light) that sweeps across the field as it shrinks. */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .finale::after {
    content: '';
    position: absolute;
    z-index: 5;
    left: calc(var(--ecl-cx) - var(--ecl-d) / 2);
    top: calc(var(--ecl-cy) - var(--ecl-d) / 2);
    width: var(--ecl-d);
    height: var(--ecl-d);
    box-sizing: border-box;
    border: 2px solid rgb(185 162 255 / 0.7);
    border-radius: 50%;
    background-color: var(--void);
    pointer-events: none;
    transform: scale(1);
    /* 1400ms quint entered 200ms in: the curve's flat first stretch (no
       visible change) is skipped, so the sky answers the scroll at once.
       Ends at 1200ms, then opacity 0 + visibility hidden. */
    transition:
      transform 1400ms var(--ease-quint) -200ms,
      opacity 0s linear 1200ms,
      visibility 0s linear 1200ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .finale.is-in:not(.is-held)::after {
    transform: scale(0);
    opacity: 0;
    visibility: hidden;
  }

  /* While the open is held, content already marked in stays down with it. */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .finale.is-held [data-reveal] {
    opacity: 0;
    transform: translate3d(0, var(--rise), 0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .finale.is-held [data-reveal='draw'] {
    transform: scaleX(0);
  }

  /* ---- the content plane: swings up out of depth as the night opens ---- */
  .grid {
    transform-origin: 50% 0;
    transition: transform 1900ms var(--ease-expo) 60ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .finale:is(:not(.is-in), .is-held) .grid {
    transform: perspective(1400px) translate3d(0, 64px, -200px) rotateX(10deg);
    transition: none;
  }

  /* ---- the eclipsed body (decorative) ------------------------------------ */
  .eclipse {
    --m: 0.35;
    position: absolute;
    z-index: 1;
    left: calc(var(--ecl-cx) - var(--ecl-size) / 2);
    top: calc(var(--ecl-cy) - var(--ecl-size) / 2);
    width: var(--ecl-size);
    height: var(--ecl-size);
    pointer-events: none;
  }

  .ecl-body {
    position: absolute;
    inset: 0;
  }

  .ecl-body > span {
    position: absolute;
    border-radius: 50%;
  }

  /* coronal streamers: faint starlight rays from the limb, turning very
     slowly; masked so they start at the limb and fade out */
  .streamers {
    inset: -120%;
    background-image: repeating-conic-gradient(
      from 8deg,
      rgb(243 240 250 / 0) 0deg 9deg,
      rgb(243 240 250 / 0.07) 11deg,
      rgb(243 240 250 / 0) 14deg 23deg,
      rgb(243 240 250 / 0.045) 26deg,
      rgb(243 240 250 / 0) 31deg 41deg
    );
    -webkit-mask-image: radial-gradient(closest-side, transparent 20%, #000 22%, rgb(0 0 0 / 0.35) 45%, transparent 92%);
    mask-image: radial-gradient(closest-side, transparent 20%, #000 22%, rgb(0 0 0 / 0.35) 45%, transparent 92%);
    animation: streamers 180s linear infinite;
  }

  /* corona: one radial, ≤10% starlight at the limb, fading out to 2.6× the
     disc (the moon is 38.5% of its radius); it breathes */
  .corona {
    inset: -80%;
    background-image: radial-gradient(
      closest-side,
      rgb(243 240 250 / 0.1) 38%,
      rgb(243 240 250 / 0.066) 43%,
      rgb(243 240 250 / 0.036) 52%,
      rgb(243 240 250 / 0.016) 66%,
      rgb(243 240 250 / 0.005) 82%,
      transparent 100%
    );
    animation: corona 7s ease-in-out infinite alternate;
  }

  .sun {
    inset: 0;
    background-color: var(--starlight);
  }

  /* the moon slides along the −24° diagonal: crescent at m = 1, totality
     (only the hairline limb left) at m = 0 */
  .moon {
    inset: 0;
    border: 1px solid rgb(243 240 250 / 0.9);
    background-color: var(--void);
    transform: translate3d(calc(var(--m) * 7.5%), calc(var(--m) * -3.3%), 0);
  }

  /* the bead of light on the limb (lower left, where the sun shows) and
     its thin flare, which passes behind the moon, so only its outer half
     shows as a ray: both shrink toward totality */
  .bead,
  .flare {
    left: 50%;
    top: 50%;
  }

  .bead {
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background-color: var(--starlight);
    transform: rotate(156deg) translateX(calc(var(--ecl-size) / 2 - 1px)) scale(calc(0.4 + var(--m) * 0.8));
  }

  .flare {
    width: calc(var(--ecl-size) * 0.9);
    height: 1px;
    margin: -0.5px 0 0 calc(var(--ecl-size) * -0.45);
    border-radius: 0;
    background-image: linear-gradient(90deg, transparent, rgb(243 240 250 / 0.55) 50%, transparent);
    transform: rotate(156deg) translateX(calc(var(--ecl-size) / 2)) rotate(-156deg) rotate(-24deg) scaleX(calc(0.15 + var(--m) * 0.85));
  }

  /* entrance: once the night has opened, the bead flares once */
