---
import { hero, brand } from '../../data/site';
import measurementsJson from '../../data/measurements.json';
import { url, formatDate } from '../../lib/url';
import Icon from '../Icon.astro';

interface Measurements {
  performance: number | null;
  lcpMs: number | null;
  requests: number | null;
  transferKb: number | null;
  tool: string | null;
  date: string | null;
}
const measurements = measurementsJson as unknown as Measurements;
const measured = typeof measurements.performance === 'number' && typeof measurements.date === 'string';
const score = measurements.performance ?? 0;
const date = measurements.date ?? '';
---

<section class="hero on-void" id="top">
  <div class="field" data-particles aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>

  <div class="wrap wrap-wide hero-inner" data-hero-exit>
    <div class="hero-copy">
      <p class="kicker" data-reveal="up">{hero.kicker}</p>
      <h1 data-split set:html={hero.headline} />
      <p class="lead" data-reveal="up" style="--i:2">{hero.lead}</p>

      <div class="btn-row hero-actions" data-reveal="up" style="--i:3">
        <a class="btn btn-primary btn-lg" href={url(hero.primary.href)} data-magnetic>
          {hero.primary.label}
          <Icon name="arrow" class="arrow" />
        </a>
        <a class="btn btn-ghost btn-lg" href={url(hero.secondary.href)} data-magnetic="0.18">
          {hero.secondary.label}
        </a>
      </div>

      <ul class="hero-facts" data-reveal="fade" style="--i:5">
        {
          hero.facts.map((f) => (
            <li>
              <span class="hero-fact-value mono">{f.value}</span>
              <span class="hero-fact-label">
                {f.label} <span class="muted">· {f.note}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-side">
      <div data-reveal="right" style="--i:2">
        <div class="card hero-widget hero-funnel-card" data-tilt="5" data-glow>
          <p class="hud hero-widget-head">
            <span class="pulse" aria-hidden="true"></span>
            <b>Growth Architecture</b> · Paid Ads to Clients
          </p>
          <div class="hero-funnel">
            <div class="funnel-step">
              <span class="funnel-icon"><Icon name="bolt" size={16} /></span>
              <div class="funnel-body">
                <span class="funnel-title">Sub-Second Mobile Speed (&lt;1s)</span>
                <span class="funnel-desc">Stops ad traffic bounce before the click is lost</span>
              </div>
            </div>
            <div class="funnel-step">
              <span class="funnel-icon"><Icon name="check" size={16} /></span>
              <div class="funnel-body">
                <span class="funnel-title">High-Converting Layout &amp; Copy</span>
                <span class="funnel-desc">Single-offer focus, instant WhatsApp &amp; CRM lead delivery</span>
              </div>
            </div>
            <div class="funnel-step">
              <span class="funnel-icon"><Icon name="shield" size={16} /></span>
              <div class="funnel-body">
                <span class="funnel-title">Google SEO &amp; Fast Indexing</span>
                <span class="funnel-desc">Search Console setup, sitemaps &amp; Schema JSON-LD</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal="right" style="--i:3">
        <div class="card hero-widget hero-trust" data-tilt="5" data-glow>
          <p class="hud"><b>{brand.legalName}</b> · Official Entity</p>
          <div class="trust-content">
            <div class="trust-tags">
              <span class="badge badge-violet">CNPJ {brand.cnpj}</span>
              <span class="badge badge-paper">Mackenzie CS Graduate</span>
            </div>
            <p class="hero-note-text">
              Direct execution by <b>Vinícius Magno</b>. Formal contracts, Stripe USD invoicing or Brazilian Nota Fiscal, and 100% code ownership.
            </p>
            <div class="trust-pricing-pill">
              <span>Landing pages from <b>$500 – $700</b></span>
              <span class="muted">· Ready in 5–7 days</span>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal="right" style="--i:4">
        <div class="card hero-widget hero-celestial" data-tilt="5" data-glow>
          <p class="hud hero-widget-head">
            <span class="pulse" aria-hidden="true"></span>
            <b>✦ Celestial Alignment</b> · Live Project Slots
          </p>
          <div class="celestial-status-body">
            <p class="hero-note-text">
              Direct founder execution. Booking dedicated landing page builds for ambitious brands running Google &amp; Meta Ads worldwide.
            </p>
            <div class="trust-pricing-pill">
              <span>⚶ Vesta Focus: <b>Zero Agency Fluff</b></span>
              <span class="muted">· Direct WhatsApp &amp; Stripe</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: calc(var(--nav-h) + clamp(3rem, 2rem + 5vw, 6.5rem)) clamp(3.5rem, 2.5rem + 5vw, 7rem);
    min-height: 92svh;
    display: flex;
    align-items: center;
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 90%;
    z-index: 0;
    background:
      radial-gradient(60rem 36rem at 22% 12%, rgb(124 58 237 / 0.28), transparent 60%),
      radial-gradient(40rem 30rem at 92% 80%, rgb(168 85 247 / 0.14), transparent 60%);
    pointer-events: none;
    animation: breathe 9s var(--ease-in-out) infinite alternate;
  }

  @keyframes breathe {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.85;
    }
    to {
      transform: translate3d(0, 1.5%, 0) scale(1.04);
      opacity: 1;
    }
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 96px 96px;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000 30%, transparent 100%);
    mask-image: radial-gradient(70% 60% at 50% 40%, #000 30%, transparent 100%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-2xl) var(--space-xl);
    align-items: center;
  }

  .hero-copy > * + * {
    margin-top: var(--space-m);
  }

  .hero h1 {
    max-width: 15ch;
  }

  .hero .lead {
    max-width: 52ch;
  }

  .hero-actions {
    margin-top: var(--space-l);
  }

  .hero-facts {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line-dark);
  }

  .hero-facts li {
    display: grid;
    grid-template-columns: 4em 1fr;
    align-items: baseline;
    gap: 0.4em 0.9em;
    font-size: var(--step--1);
  }

  .hero-fact-value {
    font-weight: 700;
    color: var(--violet-ink-dark);
  }

  .hero-fact-label {
    color: var(--text-dark-muted);
  }

  /* ---- widgets ---- */

  .hero-side {
    display: grid;
    gap: var(--space-s);
    align-content: center;
  }

  .hero-widget {
    background: rgb(14 12 21 / 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-l);
  }

  .hero-widget-head {
    margin-bottom: var(--space-s);
  }

  .hero-funnel {
    display: grid;
    gap: 0.85rem;
    margin-top: var(--space-xs);
  }

  .funnel-step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .funnel-icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: var(--radius-s);
    background: var(--violet-soft);
    color: var(--violet-ink-dark);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .funnel-body {
    display: grid;
    gap: 0.2rem;
  }

  .funnel-title {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-dark);
  }

  .funnel-desc {
    font-size: var(--step--2);
    color: var(--text-dark-muted);
    line-height: 1.4;
  }

  .trust-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-xs);
  }

  .hero-note-text {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-dark-muted);
    max-width: 40ch;
  }

  .trust-pricing-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-s);
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(124, 58, 237, 0.12);
    border: 1px solid rgba(124, 58, 237, 0.25);
    font-size: var(--step--2);
    color: var(--text-dark);
  }

  @media (min-width: 64rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.9fr);
    }

    .hero h1 {
      max-width: 15ch;
    }
  }

  html.motion-reduced .hero-glow {
    animation: none;
  }
</style>
