---
/**
 * #hero (§5.1, §3.4, §6.1, SPEC_COSMOS, ROUND2/3). Deep space: the galaxy
 * behind everything, the H1 on near-black at the left, a deck of five
 * concept studies floating in perspective at the right. The spec band
 * closes the section.
 *
 * Layers: section.s-void (opaque, position:relative, overflow:clip)
 *   0  <Cosmos variant="galaxy" />      first child, absolutely positioned
 *   1  .hero__main, .sb                  transparent content above it
 *
 * The showcase ([data-showcase], driven by src/scripts/compare.ts):
 *   .hs-deck[data-tilt]            the deck: five ghost cards (one per
 *                                  concept, --slot 0–4) + ONE live card
 *   .hs-card[data-x-host]          the live plate; --x lives here so the
 *                                  tags riding the URL bar follow the blade
 *   template[data-card]            the other four plates, cloned on demand
 *   .hs-sw[data-switcher]          ROUND4: "See 5 example sites" + counter,
 *                                  then [‹] tabs [›]. Tabs (role=tab):
 *                                  Roofing · Dental · Restaurant · Law ·
 *                                  Fitness, each with a progress bar (a CSS
 *                                  animation of --hs-dwell; its end advances).
 *                                  Every switch is interruptible (compare.ts).
 *   .hs-cap                        "Concept NN · A study by Vesta" /
 *                                  "Fictional business, not client work"
 *
 * Motion on load (CSS, no JS gate — the H1 is the LCP):
 *   0     meta hairline draws            520   lead rises
 *   120+  H1 words flip up (3D)          620+  WhatsApp, Email, packages rise
 *   300   deck enters (48px, −10°)       900   WhatsApp fills violet
 *   700   rebuild blade 0 → 1 (1300ms)   1100+ ghost cards deal in behind
 *   2000+ compare.ts eases to .56, arms, the niche clock starts (7s)
 *
 * The dive (scroll): motion.ts writes --hx (0 → 1) on [data-hero-exit];
 * compare.ts drives the galaxy's --dive with the same progress. The H1,
 * the copy and the deck come toward the camera at different depths while
 * the galaxy swells and swings face-on; the spec band rises out of depth
 * (data-scene). Transform-only.
 */
import SplitText from '../ui/SplitText.astro';
import WaGlyph from '../ui/WaGlyph.astro';
import MailGlyph from '../ui/MailGlyph.astro';
import Arrow from '../ui/Arrow.astro';
import Cosmos from '../Cosmos.astro';
import ConceptPlate from '../ConceptPlate.astro';
import SpecBand from './SpecBand.astro';
import { concepts } from '../../data/concepts';
import { hero, wa, mail } from '../../data/site';
import { url } from '../../lib/url';

/* "Concept 01 · A study by Vesta" / "Fictional business, not client work" */
const split = (caption: string): [string, string] => {
  const cut = caption.lastIndexOf(' · ');
  return cut > 0 ? [caption.slice(0, cut), caption.slice(cut + 3)] : [caption, ''];
};
const first = concepts[0];
const [capA, capB] = split(first.caption);
const tabName = (id: string) => (hero.showcase.tabs as Record<string, string>)[id] ?? id;
const total = String(concepts.length).padStart(2, '0');
---

<section id={hero.id} class="s-void hero" data-nav-theme="dark" data-hero-exit>
  <Cosmos variant="galaxy" />

  <div class="hero__main">
    <div class="wrap">
      <div class="hero__meta">
        <p class="label hero__meta-l" data-load style="--d:80ms">
          <span class="hm-d">{hero.meta.left}</span><span class="hm-m">{hero.meta.mobile}</span>
        </p>
        <span class="hero__meta-rule" data-load="draw" aria-hidden="true"></span>
      </div>

      <div class="g hero__grid">
        <SplitText as="h1" load delay={120} class="hero__h1" text={hero.h1} />

        <div class="hero__copy">
          <p class="lead hero__lead" data-load style="--d:520ms">{hero.lead}</p>
          <div class="hero__ctas">
            <span class="hero__ctaw hero__ctaw--wa" data-load style="--d:620ms">
              <a class="btn hero__cta" href={wa(hero.primary.text)} data-sticky-anchor data-wa-intent="hero" data-magnetic=".22">
                <span class="hero__cta-edge" aria-hidden="true"></span>
                <WaGlyph size={16} />
                <span>{hero.primary.label}</span>
                <Arrow />
              </a>
            </span>
            <span class="hero__ctaw hero__ctaw--mail" data-load style="--d:700ms">
              <a class="btn btn-line hero__mail" href={mail(hero.email.subject)} data-magnetic=".22">
                <MailGlyph size={16} />
                <span>{hero.email.label}</span>
              </a>
            </span>
            <span class="hero__ctaw hero__ctaw--sec" data-load style="--d:780ms">
              <a class="tlink hero__sec" href={url(hero.secondary.href)}>
                <span>{hero.secondary.label}</span>
                <Arrow />
              </a>
            </span>
          </div>
          <p class="small hero__micro" data-load style="--d:1000ms">{hero.micro}</p>
        </div>

        <div class="hero__stage" data-showcase>
          <p class="label hs-cap" data-cap aria-live="off">
            <span class="hs-cap-a" data-cap-a>{capA}</span><span class="visually-hidden"> · </span><span
              class="hs-cap-b"
              data-cap-b>{capB}</span
            >
          </p>

          <div class="hs-deck" id="hs-deck" role="tabpanel" aria-labelledby={`hs-tab-${first.id}`} data-deck data-tilt="3">
            {
              concepts.map((c, k) => (
                <div class="hs-ghost" data-ghost={c.id} style={`--g-bg:${c.palette.base};--slot:${k}`} aria-hidden="true">
                  <div class="hs-gpose">
                    <i class="hs-gbar" />
                    <i class="hs-gscreen" />
                  </div>
                </div>
              ))
            }
            {
              concepts.map((c, k) => {
                const [a, b] = split(c.caption);
                const card = (
                  <div class:list={['hs-card', k === 0 && 'hs-card--first']} data-card={c.id} data-x-host data-cap-a={a} data-cap-b={b}>
                    <div class="hs-pose">
                      <div class="hs-rail" aria-hidden="true">
                        <span class="hs-rail-move">
                          <span class="hs-tag hs-tag--after label">
                            <span class="hs-t-l">{hero.plate.tags.after}</span>
                            <span class="hs-t-s">{hero.plate.tagsShort.after}</span>
                          </span>
                          <i class="hs-tick" />
                          <span class="hs-tag hs-tag--before label">
                            <span class="hs-t-l">{hero.plate.tags.before}</span>
                            <span class="hs-t-s">{hero.plate.tagsShort.before}</span>
                          </span>
                        </span>
                      </div>
                      <ConceptPlate concept={c.id} mode="hero" caption={false} class="hero__plate" />
                    </div>
                  </div>
                );
                return k === 0 ? card : <template data-card={c.id}>{card}</template>;
              })
            }
          </div>

          <div class="hs-sw" data-switcher>
            <div class="hs-sw-head">
              <p class="label hs-sw-title"><i class="hs-sw-node" aria-hidden="true"></i>{hero.showcase.title}</p>
              <p class="label hs-sw-count" aria-hidden="true">
                <span class="hs-sw-name" data-sw-name>{tabName(first.id)}</span>
                <span class="hs-sw-n"><span data-sw-n>{first.number}</span><span class="hs-sw-of"> / {total}</span></span>
              </p>
            </div>
            <div class="hs-bar">
              <button class="hs-arrow hs-arrow--prev" type="button" data-step="-1" aria-label={hero.showcase.prev} aria-controls="hs-deck">
                <Arrow size={20} />
              </button>
              <div class="hs-tabs" role="tablist" aria-label={hero.showcase.label}>
                {
                  concepts.map((c, k) => (
                    <button
                      class:list={['hs-tab', k === 0 && 'is-current']}
                      type="button"
                      role="tab"
                      id={`hs-tab-${c.id}`}
                      data-concept={c.id}
                      aria-selected={k === 0 ? 'true' : 'false'}
                      aria-controls="hs-deck"
                      tabindex={k === 0 ? 0 : -1}
                      style={`--k:${k}`}
                    >
                      <span class="hs-track" aria-hidden="true">
                        <i class="hs-fill" />
                      </span>
                      <span class="hs-num">{c.number}</span>
                      <span class="hs-name">{tabName(c.id)}</span>
                    </button>
                  ))
                }
              </div>
              <button class="hs-arrow hs-arrow--next" type="button" data-step="1" aria-label={hero.showcase.next} aria-controls="hs-deck">
                <Arrow size={20} />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <SpecBand />
</section>

<script>
  import '../../scripts/compare';
</script>

<style>
  /* ---------- section ----------------------------------------------------- */
  /* A one-column grid so the galaxy can take the first row only: an
     absolutely positioned grid child uses its grid area as containing
     block. The sky fills the first screen and stops at the spec band. */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: clip;
    background-color: var(--void);
    /* galaxy composition (read by cosmos.ts; fractions of the sky box,
       y from the top; mask = dark at A → full at B).
       Phones: the galaxy opens at the right between the CTAs and the deck,
       above the fold; the text column above stays near-black. */
    --cosmos-x: 0.8;
    --cosmos-y: 0.52;
    --cosmos-r: 0.62;
    --cosmos-mask: 0.2 0.3 0.62 0.46;
    /* dwell per niche (the tab's progress bar) */
    --hs-dwell: 7s;
  }

  /* explicit end line: for an abspos grid child, "auto" means the
     container's edge, not the end of the row */
  .hero > :global(.cosmos) {
    grid-row: 1 / 2;
    grid-column: 1 / 2;
  }

  .hero__main {
    position: relative;
    z-index: 1;
    grid-row: 1;
    grid-column: 1;
    padding-top: calc(var(--nav-h) + 20px);
    padding-bottom: 56px;
  }

  /* ---------- meta row ---------------------------------------------------- */
  .hero__meta {
    position: relative;
    padding-bottom: 14px;
  }

  .hero__meta-l {
    color: var(--haze);
  }

  .hm-d {
    display: none;
  }

  .hero__meta-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background-color: var(--line-dark);
  }

  .hero__meta :global([data-load]:not([data-load='draw'])) {
    --rise: 8px;
  }

  :global(html:not(.motion-reduced)) .hero__meta p[data-load] {
    animation-duration: 600ms;
  }

  /* ---------- H1 + copy --------------------------------------------------- */
  .hero__grid {
    align-items: start;
  }

  /* the dive: each layer comes toward the camera at its own depth, away
     from the galaxy (transform-origin on the galaxy's side) */
  .hero__grid :global(.hero__h1) {
    margin-top: 32px;
    max-width: 14ch;
    /* phones: the three lines fill the column instead of stopping at 40px */
    font-size: max(var(--t-d1), min(12.6vw, 3.5rem));
    color: var(--starlight);
    transform-origin: 120% 30%;
    transform: perspective(1200px) translate3d(0, calc(var(--hx, 0) * -150px), calc(var(--hx, 0) * 240px));
  }

  .hero__copy {
    margin-top: 22px;
    transform-origin: 120% 0%;
    transform: perspective(1200px) translate3d(0, calc(var(--hx, 0) * -80px), calc(var(--hx, 0) * 130px));
  }

  .hero__lead {
    color: var(--starlight);
  }

  /* phones: WhatsApp full width, then Email + packages on one row */
  .hero__ctas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 16px;
    margin-top: 26px;
  }

  .hero__ctaw {
    display: block;
    min-width: 0;
  }

  .hero__ctaw--wa {
    grid-column: 1 / -1;
  }

  /* the smallest phones: Email gets its own full row, packages under it */
  @media (max-width: 359px) {
    .hero__ctaw--mail {
      grid-column: 1 / -1;
    }

    .hero__ctaw--sec {
      grid-column: 1 / -1;
      margin-top: -4px;
    }
  }

  .hero__micro {
    display: none;
    margin-top: 24px;
    max-width: 44ch;
    color: var(--haze);
  }

  /* primary CTA: arrives as a void button with a violet edge, then fills */
  .hero__cta {
    width: 100%;
    padding-inline: 20px;
  }

  .hero__cta-edge {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-color: var(--violet);
    clip-path: var(--chamfer);
  }

  .hero__cta-edge::after {
    content: '';
    position: absolute;
    inset: 1px;
    background-color: var(--void);
    clip-path: var(--chamfer);
  }

  .hero__cta::before {
    transform-origin: left center;
  }

  :global(html:not(.motion-reduced)) .hero__cta::before {
    animation: hero-cta-fill 700ms var(--ease-quint) 900ms both;
  }

  @keyframes hero-cta-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Email: the secondary, an outline on void (opaque for the contrast gate) */
  .hero__mail {
    width: 100%;
    padding-inline: 16px;
    background-color: var(--void);
    background-clip: padding-box;
  }

  .hero__sec {
    min-height: 48px;
    padding-block: 0;
    color: var(--starlight);
  }

  .hero__sec::after {
    bottom: 12px;
  }

  /* ---------- the showcase ------------------------------------------------ */
  .hero__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 72px;
    /* the card pose, shared by the live card and the ghosts */
    --pose: rotateX(calc(7deg - var(--hx, 0) * 7deg)) rotateY(-4deg);
    transform-origin: 50% 0%;
    transform: perspective(1600px) translate3d(0, calc(var(--hx, 0) * -70px), calc(var(--hx, 0) * 50px));
  }

  /* caption: on phones under the tabs; a void chip over any part of the sky */
  .hs-cap {
    order: 3;
    width: fit-content;
    max-width: 100%;
    margin-top: 14px;
    padding: 5px 10px 4px 0;
    background-color: var(--void);
    color: var(--dim);
    font-size: 11px;
    letter-spacing: 0.14em;
    line-height: 1.5;
    transform-origin: 50% 100%;
  }

  .hs-cap-a,
  .hs-cap-b {
    display: block;
  }

  :global(html:not(.motion-reduced)) .hs-cap {
    animation: rise-in 900ms var(--ease-expo) 1300ms both;
  }

  /* the deck: ghosts and the live card share one grid cell */
  .hs-deck {
    position: relative;
    display: grid;
    padding-top: 30px;
    perspective: 2400px;
  }

  .hs-deck > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  :global(html:not(.motion-reduced)) .hs-deck {
    animation: hs-deck-in 1600ms var(--ease-mech) 300ms both;
  }

  @keyframes hs-deck-in {
    from {
      opacity: 0;
      translate: 0 48px;
      rotate: y -10deg;
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      translate: 0 0;
      rotate: y 0deg;
    }
  }

  .hs-card,
  .hs-ghost {
    perspective: 2000px;
  }

  .hs-card {
    position: relative;
    z-index: 2;
    transform-origin: 50% 50%;
  }

  .hs-card.is-leaving {
    z-index: 3;
    pointer-events: none;
  }

  .hs-pose,
  .hs-gpose {
    --u: calc(100cqi / 760);
    position: relative;
    container-type: inline-size;
    transform: var(--pose);
    transform-origin: 50% 50%;
  }

  /* the load rebuild runs on the card (the host of --x), not the figure */
  .hs-card :global(.cp--hero) {
    animation: none !important;
  }

  :global(html:not(.motion-reduced)) .hs-card--first {
    animation: hs-rebuild 1300ms var(--ease-mech) 700ms both;
  }

  .hs-card.is-live {
    animation: none !important;
  }

  @keyframes hs-rebuild {
    from {
      --x: 0;
    }
    to {
      --x: 1;
    }
  }

  /* the plate's own tags sat on its content: they ride the URL bar now */
  .hs-card :global(.cp-tag) {
    display: none;
  }

  .hs-rail {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 7;
    height: max(18px, calc(28 * var(--u)));
    overflow: hidden;
    pointer-events: none;
  }

  .hs-rail-move {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--x, 1) * 100%), 0, 0);
  }

  /* the blade, continued through the URL bar */
  .hs-tick {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--starlight);
  }

  :global(html:not(.js)) .hs-tick {
    display: none;
  }

  .hs-tag {
    position: absolute;
    top: 50%;
    padding: 4px 7px 3px;
    background-color: var(--void);
    color: var(--starlight);
    font-size: 10.5px;
    line-height: 1.2;
    letter-spacing: 0.14em;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .hs-tag--after {
    right: calc(100% + 6px);
  }

  .hs-tag--before {
    left: 6px;
  }

  .hs-t-s {
    display: none;
  }

  @container (max-width: 520px) {
    .hs-t-l {
      display: none;
    }

    .hs-t-s {
      display: inline;
    }

    .hs-tag {
      padding: 3px 5px 2px;
      font-size: 10px;
      letter-spacing: 0.1em;
    }
  }

  /* ghost cards: the next studies waiting in the deck, up and to the right,
     each a step deeper and darker. Slot 0 sits under the live card. */
  .hs-ghost {
    --slot: 0;
    position: relative;
    z-index: 1;
    pointer-events: none;
    transform: translate3d(
      calc(var(--slot) * 2.6%),
      calc(var(--slot) * -5.2%),
      calc(var(--slot) * -70px - 4px)
    );
    opacity: calc(1 - max(0, var(--slot) - 2) * 1);
    transition:
      transform 1000ms var(--ease-expo),
      opacity 700ms linear;
  }

  :global(html:not(.motion-reduced)) .hs-ghost {
    animation: hs-deal 1100ms var(--ease-expo) calc(1100ms + var(--slot) * 160ms) backwards;
  }

  @keyframes hs-deal {
    from {
      opacity: 0;
      translate: -3% 6%;
    }
  }

  .hs-gpose {
    display: flex;
    flex-direction: column;
  }

  .hs-gpose::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(185 162 255 / 0.3);
  }

  .hs-gbar {
    display: block;
    height: max(18px, calc(28 * var(--u)));
    background-color: var(--plate);
    border-bottom: 1px solid var(--line-dark);
  }

  .hs-gscreen {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background-color: var(--g-bg, var(--night));
  }

  /* deeper = darker (a void veil, not a filter) */
  .hs-gscreen::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--void);
    opacity: calc(0.18 + var(--slot) * 0.2);
    transition: opacity 900ms linear;
  }

  /* ---------- the switcher ------------------------------------------------ */
  /* Round 4: a labelled instrument bar right under the plate — heading
     "See 5 example sites" + counter, then [‹] five niche tabs [›]. The
     current tab is a deep-violet key with a caret pointing at the plate.
     Wide container: every tab shows numeral + niche name. Narrow (phones,
     1100–1180px): numerals only, the current niche named in the head. */
  .hs-sw {
    order: 2;
    margin-top: 22px;
    container: hs-sw / inline-size;
  }

  :global(html:not(.js)) .hs-sw {
    display: none;
  }

  :global(html:not(.motion-reduced)) .hs-sw {
    --rise: 14px;
    animation: rise-in 900ms var(--ease-expo) 1250ms both;
  }

  .hs-sw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .hs-sw-title,
  .hs-sw-count {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 8px 3px 0;
    background-color: var(--void);
    color: var(--starlight);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    line-height: 1.3;
    white-space: nowrap;
  }

  .hs-sw-count {
    padding: 4px 0 3px 8px;
    color: var(--haze);
  }

  .hs-sw-node {
    display: block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    background-color: var(--violet);
  }

  :global(html:not(.motion-reduced)) .hs-sw-node {
    animation: hs-node 2.4s var(--ease-mech) 2.2s infinite;
  }

  @keyframes hs-node {
    0%,
    60%,
    100% {
      transform: none;
    }
    30% {
      transform: rotate(90deg) scale(1.3);
    }
  }

  .hs-sw-name {
    display: none;
    color: var(--starlight);
  }

  .hs-sw-n {
    font-variant-numeric: tabular-nums;
  }

  .hs-sw-n > span:first-child {
    color: var(--starlight);
  }

  /* the bar: one bordered strip, cells split by hairlines */
  .hs-bar {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line-dark-strong);
    background-color: var(--night);
  }

  .hs-arrow {
    position: relative;
    display: grid;
    flex: 0 0 56px;
    place-items: center;
    min-height: 56px;
    background-color: var(--night);
    color: var(--starlight);
    cursor: pointer;
    transition: background-color var(--t-micro) linear;
  }

  .hs-arrow--prev {
    border-right: 1px solid var(--line-dark-strong);
  }

  .hs-arrow--next {
    border-left: 1px solid var(--line-dark-strong);
  }

  .hs-arrow--prev :global(.arrow) {
    rotate: 180deg;
  }

  .hs-arrow :global(.arrow) {
    transition: transform var(--t-ui) var(--ease-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .hs-arrow:hover {
      background-color: var(--plate);
    }

    .hs-arrow--next:hover :global(.arrow) {
      transform: translateX(4px);
    }

    .hs-arrow--prev:hover :global(.arrow) {
      transform: translateX(-4px);
    }
  }

  .hs-arrow:active :global(.arrow) {
    transform: scale(0.86);
  }

  .hs-arrow:focus-visible,
  .hs-tab:focus-visible {
    outline: 2px solid var(--starlight);
    outline-offset: -4px;
  }

  .hs-tabs {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }

  .hs-tab {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
