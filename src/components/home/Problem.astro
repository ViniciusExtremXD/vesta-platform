---
/**
 * §5.2 #problem — paper. The first white surface after the deep-space hero.
 *
 * Round 2 (owner: "bolder, cleaner"):
 * - Label + H2 (word flip). The label sits on a slower parallax plane than
 *   the headline, so the head has depth as it scrolls.
 * - Three bold numbered Expand boxes: a giant numeral, the title and 2–3
 *   keywords visible; the explanation lives inside the box. Each row plays
 *   in as one sequence: its hairline draws from the left, the numeral flips
 *   up on a baseline hinge, the title rises, the keywords follow, the plus
 *   spins in. The numerals ride their own scroll plane (a small drift
 *   against the titles), so the table reads in depth.
 * - The verdict is the section's moment: a tally rail runs 01 → 02 → 03,
 *   each node filling as the line reaches it, into Vesta's orbit mark, whose
 *   planet laps once; then the verdict flips in at display size.
 *
 * - Round 3: the wrapper rises out of a tilted, deeper plane (data-scene);
 *   the verdict is set at display-1 on its own parallax plane, against the
 *   rail, so the closing reads as the section's climax.
 *
 * Default state (no JS, motion off, failed engine) = everything final:
 * lines drawn, nodes filled, numerals in place, the clean ellipse.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Expand from '../ui/Expand.astro';
import { problem } from '../../data/site';

/* Typesetting only: tie one-letter words to the next word so no line ends
   on a stranded "A" or "I". The words are unchanged. */
const NBSP = String.fromCharCode(160);
const tie = (t: string) => t.replace(/(^|\s)([AaI])\s+/g, (_m, pre: string, w: string) => pre + w + NBSP);

const rows = problem.rows as Array<(typeof problem.rows)[number] & { keywords?: string[] }>;
const last = rows.length - 1;

/* ---- the orbit mark (same anatomy as the wordmark's: ellipse, hearth,
   planet; tilted −24°). viewBox = rendered desktop size, so user units = px. */
const MW = 60;
const MH = 34;
const RX = 26;
const RY = 9.6;
const CX = MW / 2;
const CY = MH / 2;
/* Explicit path so the start point and direction are fixed: from the right
   end, sweeping through the near (lower) side. pathLength normalises the dash. */
const orbitD = `M ${CX + RX} ${CY} A ${RX} ${RY} 0 1 1 ${CX - RX} ${CY} A ${RX} ${RY} 0 1 1 ${CX + RX} ${CY}`;

/* Planet keyframes sampled at equal ARC LENGTH along that same path, so the
   planet sits exactly on the head of the stroke being drawn (the dash is
   measured in arc length too). Build-time; the page only reads the list. */
const DENSE = 720;
const dense: [number, number][] = [];
for (let i = 0; i <= DENSE; i++) {
  const t = (i / DENSE) * Math.PI * 2;
  dense.push([CX + RX * Math.cos(t), CY + RY * Math.sin(t)]);
}
const cum = [0];
for (let i = 1; i <= DENSE; i++) cum.push(cum[i - 1] + Math.hypot(dense[i][0] - dense[i - 1][0], dense[i][1] - dense[i - 1][1]));
const total = cum[DENSE];
const STEPS = 72;
const trace: string[] = [];
for (let k = 0, j = 1; k <= STEPS; k++) {
  const target = (total * k) / STEPS;
  while (j < DENSE && cum[j] < target) j++;
  const f = (target - cum[j - 1]) / (cum[j] - cum[j - 1] || 1);
  const x = dense[j - 1][0] + (dense[j][0] - dense[j - 1][0]) * f;
  const y = dense[j - 1][1] + (dense[j][1] - dense[j - 1][1]) * f;
  trace.push(`${x.toFixed(2)},${y.toFixed(2)}`);
}
---

<section id={problem.id} class="s-paper section problem" data-nav-theme="light" aria-labelledby="problem-title">
  <div class="wrap" data-scene>
    <header class="g p-head">
      <div class="p-label" data-parallax="0.04">
        <SectionLabel n={problem.label.index ?? undefined} name={problem.label.name} />
      </div>
      <SplitText as="h2" id="problem-title" class="d2 p-h2" text={problem.h2} />
    </header>

    <ol class="p-rows" role="list" data-p-rows>
      {
        rows.map((row, r) => (
          <li class="p-row" data-inview style={`--r:${r}`}>
            <span class="p-line" aria-hidden="true" />
            <Expand title={tie(row.title)} keywords={row.keywords ?? []} index={row.index} size="l" reveal={false} class="p-xp">
              <p class="body p-body">{tie(row.body)}</p>
            </Expand>
            {r === last && <span class="p-line p-line-end" aria-hidden="true" />}
          </li>
        ))
      }
    </ol>

    <div class="p-foot" data-inview>
      <div class="p-tally" aria-hidden="true">
        {
          rows.map((row, k) => (
            <span class="p-tick" style={`--k:${k}`}>
              <span class="p-node" />
              <span class="p-tick-n">{row.index}</span>
              <span class="p-seg" />
            </span>
          ))
        }
        <span class="p-mark" data-orbit-trace={trace.join(' ')}>
          <svg class="pm-svg" width={MW} height={MH} viewBox={`0 0 ${MW} ${MH}`} focusable="false">
            <g transform={`rotate(-24 ${CX} ${CY})`}>
              <path class="pm-path" d={orbitD} pathLength="100" />
              <circle class="pm-hearth" cx={CX} cy={CY} r="1.8" />
              <circle class="pm-planet" cx="0" cy="0" r="3.4" style={`transform: translate(${CX + RX}px, ${CY}px)`} />
            </g>
          </svg>
        </span>
      </div>
      {/* the words land while the rail runs; the last ones as the planet sets off */}
      <div class="p-verdict-plane" data-parallax="-0.05">
        <SplitText as="p" class="d1 p-verdict" text={tie(problem.closing)} delay={620} />
      </div>
    </div>
  </div>
</section>

<script>
  import { addFrame, requestFrame, isReduced, vestibular } from '../../scripts/motion';

  /* 1. The numerals' scroll plane: each row writes --rp (its centre's offset
     from the viewport centre, −1…1) and CSS turns it into a small `translate`
     on the numeral — a separate property from the entry `transform`, so the
     two never fight. Only while the table is near the viewport. */
  const list = document.querySelector<HTMLElement>('#problem [data-p-rows]');
  if (list) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.p-row'));
    const rp: number[] = rows.map(() => 0);
    let near = false;
    let wasStatic = false;

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([e]) => {
          near = e.isIntersecting;
          if (near) requestFrame();
        },
        { rootMargin: '20% 0px 20% 0px' }
      ).observe(list);
    } else {
      near = true;
    }

    addFrame({
      read(_y, vh) {
        if (!near) return;
        rows.forEach((row, i) => {
          const b = row.getBoundingClientRect();
          const c = (b.top + b.height / 2 - vh / 2) / (vh / 2);
          rp[i] = Math.max(-1.2, Math.min(1.2, c));
        });
      },
      write() {
        if (!near) return;
        if (vestibular()) {
          if (!wasStatic) rows.forEach((row) => row.style.setProperty('--rp', '0'));
          wasStatic = true;
          return;
        }
        wasStatic = false;
        rows.forEach((row, i) => row.style.setProperty('--rp', rp[i].toFixed(3)));
      },
    });
  }

  /* 2. The planet's one lap. CSS draws the stroke (a transition on
     stroke-dashoffset in arc-length units); this moves the planet along the
     same arc-length samples with the same easing and delay, so it rides the
     head of the line. Transform only; one shot; nothing to pause. */
  const mark = document.querySelector<HTMLElement>('#problem [data-orbit-trace]');
  const foot = mark?.closest<HTMLElement>('.p-foot');
  const planet = mark?.querySelector<SVGCircleElement>('.pm-planet');

  if (mark && foot && planet && typeof planet.animate === 'function' && !foot.classList.contains('is-in')) {
    const frames = (mark.dataset.orbitTrace || '')
      .split(' ')
      .filter(Boolean)
      .map((p) => {
        const [x, y] = p.split(',');
        return { transform: `translate(${x}px, ${y}px)` };
      });

    if (frames.length > 2) {
      foot.addEventListener(
        'vesta:reveal',
        (e) => {
          if (e.target !== foot || isReduced()) return;
          planet.animate(frames, {
            duration: 1600,
            delay: 1560,
            easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          });
        }
      );
    }
  }
</script>

<style>
  /* the scene entrance swings the wrapper's lower edge toward the viewer;
     keep that from ever widening the page */
  .problem {
    overflow-x: clip;
  }

  /* ---------------------------------------------------------------- head */

  .p-head {
    row-gap: 24px;
  }

  .p-head :global(.p-h2) {
    max-width: 18ch;
    color: var(--ink);
  }

  /* ---------------------------------------------------------------- rows */

  .p-rows {
    --numw: 3.2rem;
    --drift: 10px;
    margin-top: clamp(3.5rem, 2rem + 4vw, 6rem);
  }

  .p-row {
    position: relative;
  }

  /* the 1px strong top line; drawn from the left when the row arrives */
  .p-line {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background-color: var(--line-strong);
    transform-origin: left center;
    pointer-events: none;
  }

  /* the last row also closes the table */
  .p-line-end {
    top: auto;
    bottom: 0;
  }

  /* the Expand's own top border gives way to the drawn line */
  .p-row :global(.xp) {
    border-top-color: transparent;
  }

  .p-row :global(.xp-sum) {
    grid-template-columns: var(--numw) minmax(0, 1fr) auto;
    column-gap: 14px;
    padding-block: 26px 28px;
    /* the numerals and titles hinge in 3D */
    perspective: 700px;
  }

  /* the numeral: a bold display figure, not a label */
  .p-row :global(.xp-idx) {
    min-width: 0;
    padding-top: 0;
    margin-top: -0.04em;
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 6.75rem);
    font-weight: 660;
    line-height: 0.8;
    letter-spacing: -0.035em;
    text-transform: none;
    color: var(--ink);
    font-variant-numeric: lining-nums proportional-nums;
    transform-origin: 50% 100%;
    translate: 0 calc(var(--rp, 0) * var(--drift));
    transition:
      transform var(--t-ui) var(--ease-expo),
      color var(--t-ui) linear;
  }

  .p-row :global(.xp-title) {
    max-width: 24ch;
    font-size: clamp(1.3125rem, 1rem + 1.4vw, 2.375rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transform-origin: 0 100%;
  }

  .p-row :global(.xp-keys) {
    margin-top: 2px;
  }

  /* phones: the keywords stack as a short spec list (no separators at the
     start of wrapped lines) */
  @media (max-width: 767px) {
    .p-row :global(.xp-keys) {
      display: grid;
      gap: 5px;
    }

    .p-row :global(.xp-key + .xp-key::before) {
      content: none;
    }
  }

  .p-row :global(.xp-key) {
    color: var(--ink-2);
  }

  .p-row :global(.xp.is-open .xp-idx) {
    color: var(--violet-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .p-row :global(.xp-sum:hover .xp-idx) {
      color: var(--violet-ink);
    }
  }

  .p-body {
    max-width: 52ch;
    padding-left: calc(var(--numw) + 14px);
    color: var(--ink-2);
  }

  /* ------------------------------------------------------------- closing */

  .p-foot {
    margin-top: clamp(4rem, 2.5rem + 4vw, 7rem);
  }

  .p-tally {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    align-items: center;
  }

  .p-tick {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .p-node {
    position: relative;
    flex: 0 0 auto;
    width: 11px;
    height: 11px;
    border: 1px solid var(--ink);
    background-color: var(--violet);
    border-color: var(--violet);
    transition:
      background-color 200ms linear,
      border-color 200ms linear;
  }

  .p-tick-n {
    flex: 0 0 auto;
    margin-inline: 10px 12px;
    font-stretch: var(--wd-display);
    font-size: var(--t-label);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }

  /* the rail, one segment per tick, each drawn from the left */
  .p-seg {
    flex: 1 1 auto;
    min-width: 12px;
    height: 1px;
    margin-inline-end: 10px;
    background-color: var(--line-strong);
    transform-origin: left center;
  }

  .p-mark {
    display: block;
    line-height: 0;
  }

  .pm-svg {
    width: 48px;
    height: auto;
    overflow: visible;
    margin-inline-end: -4px;
  }

  .pm-path {
    fill: none;
    stroke: var(--mark, var(--violet));
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .pm-hearth {
    fill: var(--ink);
    transform-box: fill-box;
    transform-origin: center;
  }

  .pm-planet {
    fill: var(--mark, var(--violet));
  }

  .p-verdict-plane {
    margin-top: clamp(32px, 1rem + 3vw, 64px);
  }

  .p-foot :global(.p-verdict) {
    max-width: 13ch;
    color: var(--ink);
    text-wrap: balance;
  }

  /* -------------------------------------------------------------- tablet */

  @media (min-width: 768px) {
    .p-head {
      row-gap: 32px;
    }

    .p-rows {
      --numw: 5.5rem;
      --drift: 16px;
    }

    .p-row :global(.xp-sum) {
      column-gap: 20px;
      padding-block: 34px 36px;
    }

    .p-body {
      padding-left: calc(var(--numw) + 20px);
    }

    .pm-svg {
      width: 60px;
      margin-inline-end: -5px;
    }
  }

  /* ------------------------------------------------------------- desktop */

  @media (min-width: 1100px) {
    .p-head :global(.p-h2) {
      grid-column: 1 / span 9;
    }

    .p-rows {
      --drift: 26px;
    }

    /* the summary sits on the page grid: numeral 1–3, title 4–11, the plus
       in 12. The detail opens under the title column. */
    .p-row :global(.xp-sum) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      padding-block: 44px 46px;
    }

    .p-row :global(.xp-idx) {
      grid-column: 1 / span 3;
    }

    .p-row :global(.xp-head) {
      grid-column: 4 / span 8;
    }

    .p-row :global(.xp-icon) {
      grid-column: 12;
      justify-self: end;
      margin-top: 4px;
    }

    .p-row :global(.xp-inner) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .p-body {
      grid-column: 4 / span 6;
      padding-left: 0;
      font-size: var(--t-lead);
      line-height: 1.5;
    }

    .p-foot :global(.p-verdict) {
      max-width: 14ch;
    }
  }

  /* -------------------------------------------------------------- motion
     Default = final. Hidden starting states live only under the armed html
     state, keyed off .is-in (data-inview). The Expand's parts play in with
     CSS animations (fill: backwards), so the delays never leak into the
     box's own hover and open transitions afterwards. */

  @keyframes pb-flip {
    from {
      opacity: 0;
      transform: translate3d(0, 55%, 0) rotateX(-88deg);
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pb-hinge {
    from {
      opacity: 0;
      transform: translate3d(0, 0.5em, 0) rotateX(-52deg);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pb-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pb-spin {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-180deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pb-pop {
    from {
      transform: scale(0) rotate(45deg);
    }
    55% {
      transform: scale(1.5) rotate(0deg);
    }
    to {
      transform: none;
    }
  }

  .p-line {
    transition:
      opacity 200ms linear,
      transform 1100ms var(--ease-quint);
    transition-delay: calc(var(--r, 0) * 140ms);
  }

  .p-line-end {
    transition-delay: calc(var(--r, 0) * 140ms + 360ms);
  }

  .p-row.is-in :global(.xp-idx) {
    animation: pb-flip 1300ms var(--ease-expo) backwards;
    animation-delay: calc(var(--r, 0) * 140ms + 90ms);
  }

  .p-row.is-in :global(.xp-title) {
    animation: pb-hinge 1100ms var(--ease-expo) backwards;
    animation-delay: calc(var(--r, 0) * 140ms + 200ms);
  }

  .p-row.is-in :global(.xp-key) {
    animation: pb-rise 800ms var(--ease-expo) backwards;
    animation-delay: calc(var(--r, 0) * 140ms + 360ms);
  }

  .p-row.is-in :global(.xp-key:nth-child(2)) {
    animation-delay: calc(var(--r, 0) * 140ms + 440ms);
  }

  .p-row.is-in :global(.xp-key:nth-child(3)) {
    animation-delay: calc(var(--r, 0) * 140ms + 520ms);
  }

  .p-row.is-in :global(.xp-icon) {
    animation: pb-spin 1000ms var(--ease-expo) backwards;
    animation-delay: calc(var(--r, 0) * 140ms + 420ms);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-row:not(.is-in) .p-line {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-row:not(.is-in) :global(:is(.xp-idx, .xp-title, .xp-key, .xp-icon)) {
    opacity: 0;
  }

  /* the tally: segment k draws after node k lights; node k+1 lights as the
     line reaches it; the last segment runs into the mark */
  .p-seg {
    transition:
      opacity 150ms linear,
      transform 620ms var(--ease-expo);
    transition-delay: calc(220ms + var(--k, 0) * 420ms);
  }

  .p-tick-n {
    transition:
      opacity 400ms linear,
      transform 800ms var(--ease-expo);
    transition-delay: calc(120ms + var(--k, 0) * 420ms);
  }

  .p-foot.is-in .p-node {
    animation: pb-pop 700ms var(--ease-expo) backwards;
    animation-delay: calc(60ms + var(--k, 0) * 420ms);
    transition-delay: calc(60ms + var(--k, 0) * 420ms);
  }

  .pm-path {
    transition:
      opacity 200ms linear 1560ms,
      stroke-dashoffset 1600ms var(--ease-mech) 1560ms;
  }

  .pm-hearth {
    transition:
      opacity 300ms linear 1380ms,
      transform 700ms var(--ease-expo) 1380ms;
  }

  .pm-planet {
    transition: opacity 200ms linear 1560ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .p-node {
    background-color: var(--paper);
    border-color: var(--ink);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .p-seg {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .p-tick-n {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }

  /* the stroke is dashed only while armed, so the default is a clean ellipse */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .pm-path {
    stroke-dasharray: 100 100;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .pm-path {
    opacity: 0;
    stroke-dashoffset: 100;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .pm-hearth {
    opacity: 0;
    transform: scale(0);
  }

  /* opacity only: the planet's resting place is its inline transform */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .p-foot:not(.is-in) .pm-planet {
    opacity: 0;
  }

  /* motion switched off mid-page: land instantly, no late transitions, no drift */
  :global(html.motion-reduced) .p-row *,
  :global(html.motion-reduced) .p-foot * {
    transition: none;
  }

  :global(html.motion-reduced) .p-row :global(.xp-idx),
  :global(html.motion-failed) .p-row :global(.xp-idx) {
    translate: none;
  }
</style>
