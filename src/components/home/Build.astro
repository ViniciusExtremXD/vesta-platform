---
/**
 * §5.4 #build — "Take one apart." (SPEC §6.3, skinned per SPEC_COSMOS).
 * The rebuilt Concept 01 drifts apart into its six layers like a
 * spacecraft's exploded view, then docks again.
 *
 * Live (JS, motion on, capable device): a 320svh track (240svh below
 * 1100px) holds a sticky 100svh stage with perspective. src/scripts/scrub.ts
 * writes --e1 on .b-assembly (rotation/scale) and --lift on each layer
 * (translateZ by index × --z-step), lights one row of the legend, rolls the
 * counter and draws one lilac leader from the layer's corner to its row
 * (desktop), along a dashed assembly axis through the six corners.
 * Desktop sets the words left (heading, then the legend) and the plate
 * right — mirrored from SPEC so the rising stack never crosses the heading.
 * The legend mirrors the stack: layer 06 at the top, 01 at the bottom, so
 * every leader runs nearly level. Below 1100px the legend is one caption
 * cell; inactive captions are visibility:hidden (a visually-hidden full
 * list keeps all six for screen readers while live).
 *
 * Static (.build--static — set inline below for Save-Data and low-memory /
 * low-core Chromium devices; also no JS, motion off, failed engine): no
 * pin, the plate rendered exploded, every callout listed.
 *
 * Every text node sits on the section's opaque --void; callout colours
 * change by token (starlight / dim), never by opacity.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import ConceptPlate from '../ConceptPlate.astro';
import Cosmos from '../Cosmos.astro';
import { build } from '../../data/site';

/* the arrow is drawn as a hairline SVG; the text keeps its words */
const skipText = build.skip.label.replace(/\s*↓\s*$/, '');
const layers = build.layers;
---

<section id={build.id} class="s-void section build" data-nav-theme="dark" aria-labelledby="build-title" data-scrub>
  <script is:inline>
    (function () {
      var s = document.currentScript && document.currentScript.parentElement;
      if (!s) return;
      var n = navigator,
        c = n.connection,
        m = n.deviceMemory,
        h = n.hardwareConcurrency;
      /* deviceMemory only exists in Chromium, where core counts are real */
      if ((c && c.saveData) || (m && m <= 4) || (m && h && h <= 4)) s.classList.add('build--static');
    })();
  </script>

  <div class="b-track">
    <div class="b-stage">
      <Cosmos variant="stars" />

      <div class="wrap g b-grid">
        <header class="b-head">
          <SectionLabel n={build.label.index} name={build.label.name} />
          <SplitText as="h2" id="build-title" class="d2 b-h2" text={build.h2} />
          <p class="lead b-lead" data-reveal style="--i:2">{build.lead}</p>
        </header>

        <div class="b-view" data-reveal="fade">
          <div class="b-assembly">
            <ConceptPlate mode="build" />
          </div>
        </div>

        <p class="b-count" aria-hidden="true" data-reveal="fade" style="--i:3">
          <span class="label b-count-l">{build.counter.label}</span>
          <span class="b-count-win"><span class="b-count-n" data-count-n>1</span></span>
          <span class="label b-count-t">{build.counter.total}</span>
        </p>

        <div class="b-side" data-reveal style="--i:2">
          <ol class="b-callouts">
            {
              layers.map((l, k) => (
                <li class="b-co" style={`--k:${k}`}>
                  <p class="b-co-head">
                    <span class="b-co-i">{l.index}</span>
                    <span class="b-co-name label">{l.name}</span>
                  </p>
                  <p class="b-co-text">{l.text}</p>
                </li>
              ))
            }
          </ol>
          <ol class="b-sr visually-hidden">
            {
              layers.map((l) => (
                <li>
                  {l.index} {l.name}: {l.text}
                </li>
              ))
            }
          </ol>
          <p class="b-final">{build.final}</p>
        </div>

        <p class="b-cap">{build.caption}</p>
        <a class="tlink b-skip" href={build.skip.href}>
          {skipText}
          <Arrow dir="down" />
        </a>
      </div>

      <svg class="b-leaders" aria-hidden="true" focusable="false">
        <path class="b-axis" d="M0 0" />
        {layers.map((_, k) => <path class="b-ld" data-k={k} pathLength="1" d="M0 0" />)}
        {layers.map((_, k) => <rect class="b-term" data-k={k} x="-20" y="-20" width="5" height="5" />)}
      </svg>
    </div>
  </div>
</section>

<script>
  import { initScrub } from '../../scripts/scrub';
  initScrub();
</script>

<style>
  /* The live selector — html.js:not(.motion-reduced):not(.motion-failed)
     .build:not(.build--static) — is the armed teardown: JS on, motion on,
     engine alive, capable device. Everything else renders the static
     exploded view. */

  /* ======================================================================
     0. geometry tokens
     ====================================================================== */
  .build {
    --rx: 55deg;
    --rz: -32deg;
    --z-step: min(44px, 11vw);
    --tx: 0px;
    --ty: 9svh;
    --s0: 0.92;
    --s1: 0.18;
    --persp: 1400px;
    --plate-w: min(100%, 330px);
    isolation: isolate;
    /* the exploded stack may bleed sideways on narrow screens; clip, not
       hidden, so the sticky stage keeps working */
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .build {
      --rx: 57deg;
      --rz: -34deg;
      --z-step: min(56px, 5.6svh);
      --ty: 11svh;
      --s1: 0.2;
      --persp: 1800px;
      --plate-w: min(100%, 540px, calc((100svh - 500px) * 1.8));
    }
  }

  @media (min-width: 1100px) {
    .build {
      --rx: 58deg;
      --rz: -36deg;
      --z-step: min(70px, 7.8svh);
      --tx: 0px;
      --ty: 10svh;
      --s1: 0.26;
      --persp: 2200px;
      --plate-w: min(100%, 860px, calc((100svh - 380px) * 1.74));
    }
  }

  /* ======================================================================
     1. the stage and the 3D chain (all modes)
     ====================================================================== */
  .b-stage {
    position: relative;
  }

  .b-grid {
    position: relative;
    z-index: 1;
  }

  .b-head {
    position: relative;
    z-index: 3;
  }

  .b-view {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: var(--persp);
  }

  .b-assembly {
    --e1: 1;
    position: relative;
    width: var(--plate-w);
    transform-style: preserve-3d;
    transform: translate3d(calc(var(--e1) * var(--tx)), calc(var(--e1) * var(--ty)), 0) rotateX(calc(var(--e1) * var(--rx)))
      rotateZ(calc(var(--e1) * var(--rz))) scale(calc(var(--s0) - var(--e1) * var(--s1)));
  }

  @media (pointer: fine) {
    .b-assembly {
      cursor: crosshair;
    }
  }

  /* through ConceptPlate: build mode keeps frame + screen in preserve-3d;
     the figure joins the chain here */
  .b-assembly :global(.cp) {
    transform-style: preserve-3d;
  }

  .b-assembly :global(.cp-layer) {
    --lift: 1;
    transform: translate3d(0, 0, calc(var(--lift) * var(--i) * var(--z-step)));
  }

  /* each layer's plane: a lilac hairline, faint while apart, full on the
     layer being read. Opacity only. */
  .b-assembly :global(.cp-layer)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 20;
    border: 1px solid var(--lilac);
    opacity: 0.32;
    pointer-events: none;
    transition: opacity var(--t-ui) var(--ease-expo);
  }

  /* ======================================================================
     2. type and parts (all modes)
     ====================================================================== */
  .b-lead {
    margin-top: 20px;
    color: var(--haze);
  }

  .b-callouts {
    display: grid;
  }

  .b-co {
    position: relative;
    padding-block: 16px 18px;
    border-top: 1px solid var(--line-dark);
  }

  .b-co:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .b-co-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--starlight);
  }

  .b-co-i {
    min-width: 2.2ch;
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .b-co-name {
    color: inherit;
  }

  .b-co-text {
    max-width: 46ch;
    margin-top: 8px;
    padding-left: calc(2.2ch + 14px);
    color: var(--haze);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .b-final {
    margin-top: 32px;
    max-width: 26ch;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .b-cap {
    max-width: 50ch;
    color: var(--dim);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .b-skip {
    display: none;
    color: var(--haze);
    font-size: 0.8125rem;
  }

  .b-count {
    display: none;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .b-count-l,
  .b-count-t {
    color: var(--haze);
  }

  .b-count-win {
    display: inline-block;
    overflow: clip;
    padding-block: 0.1em;
    margin-block: -0.1em;
  }

  .b-count-n {
    display: inline-block;
    min-width: 0.62em;
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 1.75rem;
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .b-sr,
  .b-leaders {
    display: none;
  }

  /* ======================================================================
     3. static (the default): exploded, every callout listed, no pin.
        The !important vars beat whatever a live frame left inline.
     ====================================================================== */
  .b-grid {
    row-gap: 48px;
  }

  .b-view {
    /* room for the stack rising above the plate */
    padding-top: calc(var(--z-step) * 4.6);
  }

  @media (min-width: 1100px) {
    .b-head {
      grid-column: 1 / span 6;
    }

    .b-grid {
      row-gap: 24px;
    }

    .b-view {
      grid-column: 1 / span 8;
      grid-row: 2;
      align-self: start;
      padding-top: calc(var(--z-step) * 3);
    }

    .b-side {
      grid-column: 9 / -1;
      grid-row: 2;
      align-self: center;
    }

    .b-cap {
      grid-column: 1 / span 6;
    }
  }

  .build--static .b-assembly,
  :global(html:not(.js)) .b-assembly,
  :global(html.motion-reduced) .b-assembly,
  :global(html.motion-failed) .b-assembly {
    --e1: 1 !important;
  }

  .build--static .b-assembly :global(.cp-layer),
  :global(html:not(.js)) .b-assembly :global(.cp-layer),
  :global(html.motion-reduced) .b-assembly :global(.cp-layer),
  :global(html.motion-failed) .b-assembly :global(.cp-layer) {
    --lift: 1 !important;
  }

  /* ======================================================================
     4. live — phones first: plate in the middle, one caption cell
     ====================================================================== */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) {
    padding-block: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-track {
    height: 240svh;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-grid {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto auto;
    row-gap: 0;
    padding-block: calc(var(--nav-h) + 12px) 14px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-head {
    grid-row: 1;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-lead {
    margin-top: 12px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-view {
    grid-row: 2;
    align-self: stretch;
    min-height: 0;
    padding: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-count {
    display: flex;
    grid-row: 3;
    justify-self: end;
    align-self: end;
    z-index: 3;
    margin-bottom: 8px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-side {
    display: grid;
    grid-row: 4;
    min-height: 132px;
    align-content: start;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-callouts,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
    grid-area: 1 / 1;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co {
    grid-area: 1 / 1;
    padding-block: 14px 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co:last-child {
    border-bottom: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
    margin-top: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-dark);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-cap {
    grid-row: 5;
    margin-top: 10px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-skip {
    display: inline-flex;
    grid-row: 6;
    justify-self: start;
    margin-top: 6px;
  }

  /* states the script drives */
  .build.is-live.is-scrubbing .b-lead {
    color: var(--dim);
  }

  .build.is-live .b-sr {
    display: block;
  }

  .build.is-live .b-co:not(.is-active) {
    visibility: hidden;
  }

  .build.is-live .b-final {
    transition:
      opacity 600ms var(--ease-expo),
      transform 600ms var(--ease-expo),
      visibility 600ms;
  }

  .build.is-live .b-final:not(.is-in) {
    visibility: hidden;
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }

  .build.is-near .b-assembly,
  .build.is-near .b-assembly :global(.cp-layer) {
    will-change: transform;
  }

  .build.is-live .b-assembly :global(.cp-layer)::after {
    opacity: 0;
  }

  .build.is-live.is-open .b-assembly :global(.cp-layer)::after {
    opacity: 0.32;
  }

  .build.is-live.is-open .b-assembly :global(.cp-layer.is-on)::after {
    opacity: 1;
  }

  /* ---- tablet ---------------------------------------------------------- */
  @media (min-width: 768px) {
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-track {
      height: 280svh;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-grid {
      grid-template-rows: auto minmax(0, 1fr) auto auto auto;
      padding-block: calc(var(--nav-h) + 20px) 24px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-count {
      grid-column: 1 / span 5;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-head {
      grid-column: 1 / span 6;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-side {
      grid-column: 1 / span 5;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-cap {
      grid-column: 1 / span 5;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-skip {
      grid-column: 6 / -1;
      grid-row: 5;
      justify-self: end;
      align-self: end;
    }

    .b-count-n {
      font-size: 2.25rem;
    }
  }

  /* ======================================================================
     5. live desktop: words left (heading, then a legend that mirrors the
        stack, 06 on top), the plate right, lilac leaders between them.
        (SPEC puts the plate left; mirrored so the rising stack never
        crosses the heading.)
     ====================================================================== */
  @media (min-width: 1100px) {
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-track {
      height: 320svh;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-grid {
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      padding-block: calc(var(--nav-h) + 20px) 28px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-head {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-lead {
      max-width: 30ch;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-view {
      grid-column: 5 / -1;
      grid-row: 1 / -1;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-count {
      grid-column: 10 / -1;
      grid-row: 1;
      justify-self: end;
      align-self: start;
      margin: 0;
    }

    .b-count-n {
      font-size: 3rem;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-side {
      display: block;
      position: relative;
      grid-column: 1 / span 4;
      grid-row: 2;
      min-height: 0;
      margin-top: 44px;
      padding-bottom: 150px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-callouts {
      display: flex;
      flex-direction: column-reverse;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co {
      position: static;
      padding-block: 13px;
      border-top: 0;
      border-bottom: 1px solid var(--line-dark);
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co:last-child {
      border-top: 1px solid var(--line-dark);
      border-bottom: 1px solid var(--line-dark);
    }

    /* the active row's words sit in one cell under the legend */
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co-text,
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% - 150px);
      margin-top: 24px;
      padding: 0;
      border: 0;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co-text {
      color: var(--starlight);
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
      font-size: 1.5rem;
    }

    .build.is-live .b-co:not(.is-active) {
      visibility: visible;
    }

    .build.is-live .b-co:not(.is-active) .b-co-text {
      visibility: hidden;
    }

    .build.is-live .b-co-head {
      color: var(--dim);
      transition: transform var(--t-ui) var(--ease-expo);
    }

    .build.is-live .b-co-i {
      color: var(--dim);
    }

    .build.is-live .b-co.is-active .b-co-head {
      color: var(--starlight);
      transform: translate3d(8px, 0, 0);
    }

    .build.is-live .b-co.is-active .b-co-i {
      color: var(--lilac);
    }

    .build.is-live.is-done .b-co-head,
    .build.is-live.is-done .b-co-i {
      color: var(--haze);
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-cap {
      grid-column: 1 / span 4;
      grid-row: 4;
      align-self: end;
      margin: 0;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-skip {
      grid-column: 10 / -1;
      grid-row: 4;
      justify-self: end;
      align-self: end;
      margin: 0;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-leaders {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
  }

  /* short laptop screens (1280×720 and the like): tighten the legend */
  @media (min-width: 1100px) and (max-height: 820px) {
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-side {
      margin-top: 24px;
      padding-bottom: 124px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co {
      padding-block: 9px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-co-text,
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
      top: calc(100% - 124px);
      margin-top: 18px;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-final {
      font-size: 1.25rem;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .build:not(.build--static) .b-lead {
      margin-top: 12px;
    }
  }

  .b-ld {
    fill: none;
    stroke: var(--lilac);
    stroke-width: 1;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 420ms var(--ease-quint);
  }

  .b-ld.is-on {
    stroke-dashoffset: 0;
  }

  .b-term {
    fill: var(--lilac);
    opacity: 0;
    transition: opacity 200ms linear;
  }

