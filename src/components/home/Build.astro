---
/**
 * §5.4 #build — "Take one apart." (SPEC §6.3, skinned per SPEC_COSMOS).
 * The rebuilt concept drifts apart into its six layers like a spacecraft's
 * exploded view, then docks again.
 *
 * Live (JS, motion on, capable device): a 320svh track (240svh below
 * 1100px) holds a sticky 100svh stage with perspective. src/scripts/scrub.ts
 * writes --e1 on .b-assembly (tilt/scale), --lift on each layer (translateZ
 * by index × --z-step), --spread (how far the stack has opened, so it stays
 * centred on its own axis) and, on the section, --orb / --el: a slow camera
 * orbit (rotateZ sweep plus a small change of elevation) that runs through
 * the whole scrub. The faint star field behind (.b-sky) turns against the
 * orbit, so the depth reads. On fine pointers the stack and the sky lean
 * toward the pointer (eased, --ptx / --pty). Each lifted layer gets a part
 * number that flips out of its right-hand corner (.b-tag); the one being
 * read opens to its name. The legend lights one row, its words flip up, the
 * counter rolls
 * and (desktop) one lilac leader runs from the layer's corner to its row
 * along a dashed assembly axis through the six corners.
 * Round 3: deeper Z separation, the orbit, the part numbers, the sky.
 * Round 4: a niche switcher (.b-pick) takes apart any of the five concepts
 * (Concept 01 is live in the DOM, the other four wait in <template>s and
 * are cloned on first pick), and every layer is a button (.b-co-head on
 * the legend, .b-step on the phone/tablet rail): clicking one travels the
 * scroll to the point in the track where that layer is the lifted one.
 * No data-scene here: the stage is position:sticky.
 *
 * Desktop sets the words left (heading, then the legend) and the plate
 * right, mirrored from SPEC so the rising stack never crosses the heading.
 * The legend mirrors the stack: layer 06 at the top, 01 at the bottom.
 * Below 1100px the legend is one caption cell; inactive captions are
 * visibility:hidden (a visually-hidden full list keeps all six for screen
 * readers while live).
 *
 * Static (.build--static — set inline below for Save-Data and low-memory /
 * low-core Chromium devices; also no JS, motion off, failed engine): no
 * pin, the plate rendered exploded, every callout listed.
 *
 * Every text node sits on the section's opaque --void; callout colours
 * change by token (starlight / dim), never by opacity.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import ConceptPlate from '../ConceptPlate.astro';
import Cosmos from '../Cosmos.astro';
import { build, hero } from '../../data/site';
import { concepts } from '../../data/concepts';

/* the arrow is drawn as a hairline SVG; the text keeps its words */
const skipText = build.skip.label.replace(/\s*↓\s*$/, '');
const layers = build.layers;

/* TODO_SITE (round 4): strings for the niche switcher and the layer
   buttons, not in site.ts yet. */
const TODO_SITE = {
  pick: {
    label: 'Take apart another business',
    prev: 'Previous business',
    next: 'Next business',
  },
  hint: 'Scroll, or pick a layer',
  stepsLabel: 'Go to a layer',
};
const nicheName = (id: string) => (hero.showcase.tabs as Record<string, string>)[id] ?? id;
/* Concept 01 keeps the site.ts caption; the others follow its pattern */
const capFor = (c: (typeof concepts)[number]) =>
  c.id === 'halden' ? build.caption : `Concept ${c.number} is a study by Vesta for a fictional ${c.niche.toLowerCase()}. It is not client work.`;
const first = concepts[0];

/* The faint sky behind the stack: a seeded scatter (same every build), in a
   square that stays larger than the stage while it turns with the orbit. */
let seed = 0x5eed1807;
const rnd = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const stars = Array.from({ length: 140 }, (_, n) => {
  const m = rnd();
  return {
    x: (rnd() * 1000).toFixed(1),
    y: (rnd() * 1000).toFixed(1),
    /* magnitude-like: most faint and small, a few bright */
    r: (0.24 + Math.pow(m, 6) * 0.5).toFixed(2),
    o: (0.28 + Math.pow(m, 2) * 0.62).toFixed(2),
    lilac: rnd() < 0.22,
    tw: n % 17 === 3,
  };
});
---

<section id={build.id} class="s-void section build" data-nav-theme="dark" aria-labelledby="build-title" data-scrub>
  <script is:inline>
    (function () {
      var s = document.currentScript && document.currentScript.parentElement;
      if (!s) return;
      var n = navigator,
        c = n.connection,
        m = n.deviceMemory,
        h = n.hardwareConcurrency;
      /* deviceMemory only exists in Chromium, where core counts are real */
      if ((c && c.saveData) || (m && m <= 4) || (m && h && h <= 4)) s.classList.add('build--static');
    })();
  </script>

  <div class="b-track">
    <div class="b-stage">
      <Cosmos variant="stars" />

      <div class="b-sky" aria-hidden="true">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
          {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} class:list={[{ l: s.lilac, tw: s.tw }]} style={`opacity:${s.o}`} />)}
        </svg>
      </div>

      <div class="wrap g b-grid">
        <header class="b-head">
          <SectionLabel n={build.label.index} name={build.label.name} />
          <SplitText as="h2" id="build-title" class="d2 b-h2" text={build.h2} />
          <p class="lead b-lead" data-reveal style="--i:2">{build.lead}</p>
        </header>

        <div class="b-pick" data-reveal style="--i:3">
          <p class="label b-pick-l" id="b-pick-l">{TODO_SITE.pick.label}</p>
          <div class="b-pick-row">
            <button class="b-pick-arr b-pick-arr--prev" type="button" data-step="-1" aria-label={TODO_SITE.pick.prev}>
              <Arrow size={16} />
            </button>
            <div class="b-pick-list" role="group" aria-labelledby="b-pick-l">
              {
                concepts.map((c, k) => (
                  <button
                    class:list={['b-pick-b', k === 0 && 'is-on']}
                    type="button"
                    data-concept={c.id}
                    data-name={nicheName(c.id)}
                    data-num={c.number}
                    data-caption={capFor(c)}
                    aria-pressed={k === 0 ? 'true' : 'false'}
                    tabindex={k === 0 ? 0 : -1}
                  >
                    <span class="b-pick-n">{c.number}</span>
                    <span class="b-pick-name">{nicheName(c.id)}</span>
                  </button>
                ))
              }
            </div>
            <p class="b-pick-now" aria-live="polite">
              <span class="b-pick-now-in">
                <span class="b-pick-now-n">{first.number}</span>
                <span class="b-pick-now-t">{nicheName(first.id)}</span>
              </span>
              <span class="b-pick-dots" aria-hidden="true">
                {concepts.map((_, k) => <i class:list={['b-pick-dot', k === 0 && 'is-on']} />)}
              </span>
            </p>
            <button class="b-pick-arr b-pick-arr--next" type="button" data-step="1" aria-label={TODO_SITE.pick.next}>
              <Arrow size={16} />
            </button>
          </div>
        </div>

        <div class="b-view" data-reveal="fade">
          <div class="b-assembly">
            <ConceptPlate concept={first.id} mode="build" />
          </div>
          {
            concepts.slice(1).map((c) => (
              <template data-plate={c.id}>
                <ConceptPlate concept={c.id} mode="build" />
              </template>
            ))
          }
        </div>

        <p class="b-count" aria-hidden="true" data-reveal="fade" style="--i:3">
          <span class="label b-count-l">{build.counter.label}</span>
          <span class="b-count-win"><span class="b-count-n" data-count-n>1</span></span>
          <span class="label b-count-t">{build.counter.total}</span>
        </p>

        <div class="b-steps" role="group" aria-label={TODO_SITE.stepsLabel} data-reveal="fade" style="--i:3">
          {
            layers.map((l, k) => (
              <button class="b-step" type="button" data-layer={k} aria-label={`${l.index} ${l.name}`}>
                <span class="b-step-i">{l.index}</span>
              </button>
            ))
          }
        </div>

        <div class="b-side" data-reveal style="--i:2">
          <p class="label b-hint" aria-hidden="true">{TODO_SITE.hint}</p>
          <ol class="b-callouts">
            {
              layers.map((l, k) => (
                <li class="b-co" style={`--k:${k}`}>
                  <button class="b-co-head" type="button" data-layer={k}>
                    <span class="b-co-i">{l.index}</span>
                    <span class="b-co-name label">{l.name}</span>
                    <span class="b-co-go" aria-hidden="true">
                      <Arrow size={12} />
                    </span>
                  </button>
                  <p class="b-co-text">{l.text}</p>
                </li>
              ))
            }
          </ol>
          <ol class="b-sr visually-hidden">
            {
              layers.map((l) => (
                <li>
                  {l.index} {l.name}: {l.text}
                </li>
              ))
            }
          </ol>
          <p class="b-final">{build.final}</p>
        </div>

        <p class="b-cap" data-b-cap>{build.caption}</p>
        <a class="tlink b-skip" href={build.skip.href}>
          {skipText}
          <Arrow dir="down" />
        </a>
      </div>

      <svg class="b-leaders" aria-hidden="true" focusable="false">
        <path class="b-axis" d="M0 0" />
        {layers.map((_, k) => <path class="b-ld" data-k={k} pathLength="1" d="M0 0" />)}
        {layers.map((_, k) => <rect class="b-term" data-k={k} x="-20" y="-20" width="5" height="5" />)}
      </svg>

      <div class="b-tags" aria-hidden="true">
        {
          layers.map((l, k) => (
            <span class="b-tag" data-k={k}>
              <span class="b-tag-in">
                <span class="b-tag-tick" />
                <span class="b-tag-i">{l.index}</span>
                <span class="b-tag-n label">{l.name}</span>
              </span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initScrub } from '../../scripts/scrub';
  initScrub();
</script>

<style>
  /* The live selector — html.js:not(.motion-reduced):not(.motion-failed)
     .build:not(.build--static) — is the armed teardown: JS on, motion on,
     engine alive, capable device. Everything else renders the static
     exploded view. */

  /* ======================================================================
     0. geometry tokens
     ====================================================================== */
  .build {
    --rx: 55deg;
    --rz: -32deg;
    /* the camera orbit: --orb runs −1 → 1 through the scrub (scrub.ts), the
       plate turns --orbit either side of --rz; --el lifts the camera a
       little mid-way (0 → 1 → 0) */
    --orb: 0;
    --el: 0;
    --orbit: 14deg;
    --elev: 5deg;
    --z-step: min(62px, 15vw);
    /* how far the open stack slides back down its own axis, in steps, so
       its centre stays where the flat plate was */
    --z-centre: -2;
    --tx: -3vw;
    --ty: 6svh;
    --s0: 0.92;
    --s1: 0.2;
    --persp: 1200px;
    --plate-w: min(100%, 330px);
    isolation: isolate;
    /* the exploded stack may bleed sideways on narrow screens; clip, not
       hidden, so the sticky stage keeps working */
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .build {
      --rx: 57deg;
      --rz: -34deg;
      --z-step: min(78px, 7.6svh);
      --tx: -4vw;
      --ty: 3svh;
      --s1: 0.22;
      --persp: 1600px;
      --plate-w: min(100%, 540px, calc((100svh - 500px) * 1.8));
    }
  }

  @media (min-width: 1100px) {
    .build {
      --rx: 58deg;
      --rz: -36deg;
      --orbit: 16deg;
      --z-step: min(104px, 11svh);
      --tx: -5.5vw;
      --ty: 7svh;
      --s1: 0.28;
      --persp: 2000px;
      --plate-w: min(100%, 860px, calc((100svh - 380px) * 1.74));
    }
  }

  /* ======================================================================
     1. the stage and the 3D chain (all modes)
     ====================================================================== */
  .b-stage {
    position: relative;
    /* the sky square is larger than the stage: keep it inside */
    overflow: clip;
  }

  .b-grid {
    position: relative;
    z-index: 1;
  }

  .b-head {
    position: relative;
    z-index: 3;
  }

  .b-view {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    perspective: var(--persp);
  }

  .b-assembly {
    --e1: 1;
    --spread: 1;
    position: relative;
    width: var(--plate-w);
    transform-style: preserve-3d;
    transform: translate3d(calc(var(--e1) * var(--tx)), calc(var(--e1) * var(--ty)), 0)
      rotateX(calc(var(--e1) * (var(--rx) + var(--el) * var(--elev) - var(--pty, 0) * 7deg)))
      rotateZ(calc(var(--e1) * (var(--rz) + var(--orb) * var(--orbit) + var(--ptx, 0) * 9deg)))
      translate3d(0, 0, calc(var(--spread) * var(--z-centre) * var(--z-step)))
      scale(calc(var(--s0) - var(--e1) * var(--s1)));
  }

  @media (pointer: fine) {
    .b-assembly {
      cursor: crosshair;
    }
  }

  /* through ConceptPlate: build mode keeps frame + screen in preserve-3d;
     the figure joins the chain here */
  .b-assembly :global(.cp) {
    transform-style: preserve-3d;
  }

  .b-assembly :global(.cp-layer) {
    --lift: 1;
    transform: translate3d(0, 0, calc(var(--lift) * var(--i) * var(--z-step)));
  }

  /* each layer's plane: a lilac hairline, faint while apart, full on the
     layer being read. Opacity only. */
  .b-assembly :global(.cp-layer)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 20;
    border: 1px solid var(--lilac);
    opacity: 0.32;
    pointer-events: none;
    transition: opacity var(--t-ui) var(--ease-expo);
  }

  /* ======================================================================
     2. type and parts (all modes)
     ====================================================================== */
  .b-lead {
    margin-top: 20px;
    color: var(--haze);
  }

  .b-callouts {
    display: grid;
  }

  .b-co {
    position: relative;
    padding-block: 16px 18px;
    border-top: 1px solid var(--line-dark);
  }

  .b-co:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .b-co-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    min-height: 24px;
    padding: 0;
    color: var(--starlight);
    text-align: left;
  }

  /* the row's arrow: always there (it marks the row as a button), lilac
     and nudged on hover / focus */
  .b-co-go {
    display: inline-flex;
    align-self: center;
    margin-left: auto;
    color: var(--dim);
    transition:
      transform var(--t-ui) var(--ease-expo),
      color var(--t-micro) linear;
  }

  @media (hover: hover) and (pointer: fine) {
    .b-co-head:hover .b-co-go {
      color: var(--lilac);
      transform: translate3d(4px, 0, 0);
    }
  }

  .b-co-head:focus-visible .b-co-go {
    color: var(--lilac);
    transform: translate3d(4px, 0, 0);
  }

  /* static: the picked layer's row */
  .b-co.is-picked .b-co-i,
  .b-co.is-picked .b-co-go {
    color: var(--lilac);
  }

  .b-hint {
    display: none;
    margin-bottom: 14px;
    color: var(--dim);
  }

  .b-co-i {
    min-width: 2.2ch;
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .b-co-name {
    color: inherit;
  }

  .b-co-text {
    max-width: 46ch;
    margin-top: 8px;
    padding-left: calc(2.2ch + 14px);
    color: var(--haze);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .b-final {
    margin-top: 32px;
    max-width: 26ch;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .b-cap {
    max-width: 50ch;
    color: var(--dim);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .b-skip {
    display: none;
    color: var(--haze);
    font-size: 0.8125rem;
  }

  .b-count {
    display: none;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .b-count-l,
  .b-count-t {
    color: var(--haze);
  }

  .b-count-win {
    display: inline-block;
    overflow: clip;
    padding-block: 0.1em;
    margin-block: -0.1em;
  }

  .b-count-n {
    display: inline-block;
    min-width: 0.62em;
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 1.75rem;
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .b-sr,
  .b-leaders,
  .b-steps {
    display: none;
  }

  /* ======================================================================
     2b. the niche switcher (round 4) - every mode with JS.
         Phones: the current business + prev / next. From 768px: the five
         businesses as one segmented row.
     ====================================================================== */
  .b-pick {
    position: relative;
    z-index: 3;
    min-width: 0;
  }

  :global(html:not(.js)) .b-pick {
    display: none;
  }

  /* a void chip: the rising stack passes behind it */
  .b-pick-l {
    display: block;
    width: fit-content;
    margin-bottom: 6px;
    padding: 4px 10px 4px 0;
    background-color: var(--void);
    color: var(--haze);
  }

  .b-pick-row {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }

  .b-pick-list {
    display: none;
  }

  .b-pick-now {
    order: -1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--line-dark-strong);
    background-color: var(--void);
  }

  .b-pick-now-in {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  .b-pick-now-n,
  .b-pick-n {
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 0.75rem;
    font-weight: 620;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .b-pick-now-t,
  .b-pick-name {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .b-pick-now-t {
    display: inline-block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--starlight);
    transform-origin: 50% 100%;
  }

  .b-pick-dots {
    display: flex;
    gap: 4px;
  }

  .b-pick-dot {
    display: block;
    width: 14px;
    height: 2px;
    background-color: var(--line-dark-strong);
    transition: background-color var(--t-micro) linear;
  }

  .b-pick-dot.is-on {
    background-color: var(--violet);
  }

  .b-pick-arr {
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    width: 48px;
    min-height: 48px;
    border: 1px solid var(--line-dark-strong);
    background-color: var(--void);
    color: var(--starlight);
    transition:
      border-color var(--t-micro) linear,
      background-color var(--t-micro) linear;
  }

  .b-pick-arr :global(.arrow) {
    transition: transform var(--t-ui) var(--ease-expo);
  }

  .b-pick-arr--prev :global(.arrow) {
    transform: scaleX(-1);
  }

  @media (hover: hover) and (pointer: fine) {
    .b-pick-arr:hover {
      border-color: var(--lilac);
    }

    .b-pick-arr--next:hover :global(.arrow) {
      transform: translate3d(3px, 0, 0);
    }

    .b-pick-arr--prev:hover :global(.arrow) {
      transform: translate3d(-3px, 0, 0) scaleX(-1);
    }
  }

  .b-pick-arr:active {
    background-color: var(--night);
  }

  /* the name flips up when the business changes */
  .b-pick-now-t.is-flip {
    animation: b-flip 620ms var(--ease-expo) both;
  }

  @media (min-width: 768px) {
    .b-pick-arr,
    .b-pick-now {
      display: none;
    }

    .b-pick-list {
      display: flex;
      flex-wrap: wrap;
    }

    .b-pick-b {
      display: flex;
      align-items: baseline;
      gap: 9px;
      min-height: 46px;
      padding: 15px 18px 13px;
      margin-left: -1px;
      border: 1px solid var(--line-dark-strong);
      background-color: var(--void);
      color: var(--haze);
      transition:
        color var(--t-micro) linear,
        border-color var(--t-micro) linear,
        background-color var(--t-micro) linear;
    }

    .b-pick-b:first-child {
      margin-left: 0;
    }

    .b-pick-b.is-on {
      position: relative;
      z-index: 1;
      border-color: var(--violet);
      background-color: var(--violet);
      color: var(--starlight);
    }

    .b-pick-b.is-on .b-pick-n {
      color: var(--starlight);
    }

    .b-pick-b:focus-visible {
      position: relative;
      z-index: 2;
    }

    @media (hover: hover) and (pointer: fine) {
      .b-pick-b:not(.is-on):hover {
        position: relative;
        z-index: 1;
        border-color: var(--lilac);
        color: var(--starlight);
      }
    }
  }

  /* the layer rail (phones and tablets, live only): six numbered buttons */
  .b-step {
    display: grid;
    place-items: center;
    flex: 1 1 0;
    min-width: 0;
    max-width: 56px;
    height: 44px;
    border: 1px solid var(--line-dark-strong);
