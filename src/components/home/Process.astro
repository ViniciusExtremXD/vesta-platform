---
/**
 * #process · 08 PROCESS (spec §5.9).
 *
 * A proportional timing rail with plan tabs. Each milestone sits at the
 * midpoint of its business-day span, scaled so the first milestone is at the
 * rail's start and launch is at the end of the working stretch (0..S); a
 * post-launch milestone ("After") sits past it on the light tail.
 *
 * Desktop (≥1100px): the rail spans columns 1–12. Time labels above, titles
 * and bodies below in two alternating rows. The layout is a CSS subgrid, so
 * each row is as tall as its tallest block and every milestone column is one
 * element (FLIP target) positioned with `margin-inline-start: x · 100%`.
 * Below 1100px: a vertical rail at the left edge, milestones stacked.
 *
 * Motion: the rail fill is scroll-linked through the shared rAF loop
 * (`addFrame`, transform only); nodes fill as the fill passes them. A tab
 * change FLIPs nodes and labels to their new positions (600ms mech) and
 * collapses milestones a plan doesn't have (grid-template-rows 1fr→0fr, then
 * visibility hidden + inert).
 *
 * No-JS: the default plan (+ Google) renders statically, fully filled; the
 * other two plans render as one summary line each.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import { process as processData } from '../../data/site';
import type { Milestone, PackageId, ProcessPlan } from '../../data/site';

/* Missing from site.ts (aria-only). Report to the data owner. */
const TODO_SITE = {
  tabsLabel: 'Timeline by package',
};

/* Desktop geometry, in fractions of the rail width. BW is mirrored in CSS
   as --bw; keep them equal. */
const BW = 0.17; // one milestone column
const AFTER_ROOM = 0.1; // extra room between launch and the post-launch milestone
const GAP = 0.016; // minimum clear space between two blocks in the same row

const ORDER: PackageId[] = ['landing', 'google', 'complete'];
const def: PackageId = processData.defaultPlan;
const plans = processData.plans as Record<PackageId, ProcessPlan>;

const KNOWN = ['conversation', 'kickoff', 'design', 'build', 'google', 'content', 'launch', 'care'];
const keyOf = (m: Milestone): string => {
  const t = m.title.toLowerCase();
  return KNOWN.find((k) => t.startsWith(k) || (k === 'kickoff' && t.includes('kickoff'))) ?? t.replace(/[^a-z0-9]+/g, '-');
};

/* One slot per role across all plans, in chronological order. Roles shared
   by several plans (conversation, design, build, launch) move on a tab change
   instead of being replaced. */
const union: string[] = [];
for (const id of [def, ...ORDER.filter((i) => i !== def)]) {
  let prev = -1;
  for (const m of plans[id].milestones) {
    const k = keyOf(m);
    let at = union.indexOf(k);
    if (at === -1) {
      at = prev + 1;
      union.splice(at, 0, k);
    }
    prev = at;
  }
}

interface Slot {
  time: string;
  title: string;
  body: string;
  /** Left edge, fraction of the rail width. */
  x: number;
  /** 0 = first text row, 1 = second. */
  row: 0 | 1;
  /** Post-launch: off the working stretch, node never fills. */
  after: boolean;
  /** Fill progress (0..1 of the working stretch) at which the node fills. */
  t: number | null;
}
interface PlanLayout {
  id: PackageId;
  tab: string;
  total: string;
  /** Working stretch (Day 0 → launch), fraction of the rail width. */
  S: number;
  slots: Record<string, Slot | null>;
}

const r4 = (n: number) => Math.round(n * 10000) / 10000;

function layout(plan: ProcessPlan): PlanLayout {
  const scaled = plan.milestones.filter((m) => m.span);
  const mid = (m: Milestone) => (m.span![0] + m.span![1]) / 2;
  const m0 = mid(scaled[0]);
  const m1 = mid(scaled[scaled.length - 1]);
  const hasAfter = scaled.length < plan.milestones.length;
  const S = r4(1 - BW - (hasAfter ? AFTER_ROOM : 0));
  const slots: Record<string, Slot | null> = Object.fromEntries(union.map((k) => [k, null]));
  plan.milestones.forEach((m, i) => {
    const after = !m.span;
    const f = after ? 1 - BW : m1 > m0 ? ((mid(m) - m0) / (m1 - m0)) * S : 0;
    slots[keyOf(m)] = {
      time: m.time,
      title: m.title,
      body: m.body,
      x: r4(f),
      row: (i % 2) as 0 | 1,
      after,
      t: after ? null : r4(S > 0 ? f / S : 0),
    };
  });

  /* Build-time guard: blocks in the same row must not overlap. */
  const present = Object.values(slots).filter(Boolean) as Slot[];
  for (const row of [0, 1]) {
    const xs = present.filter((s) => s.row === row).map((s) => s.x);
    for (let i = 1; i < xs.length; i++) {
      if (xs[i] - xs[i - 1] < BW + GAP) console.warn(`[Process] ${plan.id}: milestones overlap in row ${row} (${xs[i - 1]} → ${xs[i]}).`);
    }
  }

  return { id: plan.id, tab: plan.tab, total: plan.total, S, slots };
}

const layouts = Object.fromEntries(ORDER.map((id) => [id, layout(plans[id])])) as Record<PackageId, PlanLayout>;
const cur = layouts[def];

/* Present slots of the default plan, for the reveal stagger. */
const order = union.filter((k) => cur.slots[k]);
const lastKey = order[order.length - 1];

const clientData = JSON.stringify({ def, plans: layouts }).replace(/</g, '\\u003c');

/* No-JS: "Landing Page: Day 0 Conversation · …" with the plan name set bold. */
const summaries = ORDER.filter((id) => id !== def).map((id) => {
  const s = plans[id].summary;
  const cut = s.indexOf(': ');
  return cut > 0 ? { name: s.slice(0, cut + 1), rest: s.slice(cut + 2) } : { name: '', rest: s };
});

const wyb = processData.whatYouBring;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id={processData.id} class="s-paper section process" data-nav-theme="light" data-process aria-labelledby="process-title">
  <script is:inline type="application/json" data-process-plans set:html={clientData} />
  <div class="wrap g">
    <SectionLabel n={processData.label.index} name={processData.label.name} class="p-label" />
    <SplitText as="h2" id="process-title" class="d2 p-h2" text={processData.h2} />
    <p class="lead p-sub" data-reveal style="--d:160ms">{processData.sub}</p>

    <div class="p-tabs" role="tablist" aria-label={TODO_SITE.tabsLabel} data-plan={def} data-reveal style="--d:240ms">
      {
        ORDER.map((id) => (
          <button
            type="button"
            class="p-tab"
            role="tab"
            id={`process-tab-${id}`}
            aria-selected={id === def ? 'true' : 'false'}
            aria-controls="process-panel"
            tabindex={id === def ? 0 : -1}
            data-plan-tab={id}
          >
            {layouts[id].tab}
          </button>
        ))
      }
    </div>
    <p class="p-static label" data-reveal>{cur.tab}</p>

    <div class="tl" id="process-panel" role="tabpanel" aria-labelledby={`process-tab-${def}`} data-timeline data-plan={def} style={`--S:${cur.S}`}>
      <div class="tl-dim">
        <span class="tl-dim-line" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-dim-tick" data-reveal="fade" aria-hidden="true"></span>
        <span class="tl-dim-tick tl-dim-end" data-flip aria-hidden="true"><span data-reveal="fade" style="--d:900ms"></span></span>
        <span class="tl-dim-at" data-flip>
          <span class="tl-dim-c"><span class="label tl-dim-label" data-reveal="fade" data-dim-label style="--d:700ms">{cur.total}</span></span>
        </span>
      </div>

      <div class="tl-track">
        <span class="tl-base" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-work" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-fill" aria-hidden="true"></span>

        <ol class="tl-list" role="list">
          {
            union.map((key) => {
              const s = cur.slots[key];
              const k = s ? order.indexOf(key) : 0;
              return (
                <li
                  class:list={['ms', { 'is-out': !s, 'is-after': s?.after, 'is-last': key === lastKey }]}
                  data-key={key}
                  data-row={s?.row ?? 0}
                  style={`--x:${s?.x ?? 0}`}
                  inert={!s}
                >
                  <div class="ms-wrap">
                    <span class="ms-time label" data-reveal style={`--d:${k * 80}ms`}>
                      {s?.time}
                    </span>
                    <span class="ms-node" data-reveal="fade" style={`--d:${Math.round(180 + (s?.x ?? 0) * 900)}ms`} aria-hidden="true" />
                    <div class="ms-text">
                      <div class="ms-clip">
                        <div class="ms-in" data-reveal style={`--d:${120 + k * 80}ms`}>
                          <h3 class="ms-title">{s?.title}</h3>
                          <p class="ms-body">{s?.body}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>

    <ul class="tl-alt" role="list" data-reveal>
      {
        summaries.map((s) => (
          <li class="small">
            {s.name && <strong>{s.name}</strong>} {s.rest}
          </li>
        ))
      }
    </ul>

    <p class="small p-note" data-reveal>{processData.note}</p>

    <div class="bring" data-reveal>
      <h3 class="bring-h" id="process-bring">{wyb.title}</h3>
      <ol class="bring-list" role="list" aria-labelledby="process-bring">
        {
          wyb.items.map((item, i) => (
            <li class="bring-row" data-reveal style={`--d:${140 + i * 60}ms`}>
              <span class="bring-i label" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ol>
      <p class="bring-close" data-reveal style="--d:480ms">{wyb.closing}</p>
    </div>
  </div>
</section>

<style>
  .process {
    overflow-x: clip;
  }

  /* ------------------------------------------------------------- heading */

  .p-h2 {
    margin-top: 28px;
    max-width: 18ch;
  }

  .p-sub {
    margin-top: 20px;
    color: var(--ink-2);
  }

  /* ------------------------------------------------------------------ tabs */

  .p-tabs {
    display: flex;
    gap: 1px;
    margin-top: 40px;
  }

  .p-tab {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    background-color: var(--paper-2);
    color: var(--ink);
    font-stretch: var(--wd-display);
    font-size: 0.75rem;
    font-weight: 620;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--t-micro) linear,
      color var(--t-micro) linear,
      transform 120ms var(--ease-expo);
  }

  .p-tab[aria-selected='true'] {
    background-color: var(--ink);
    color: var(--paper);
    cursor: default;
  }

  /* hover: a 2px ink bar draws along the bottom edge */
  .p-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-ui) var(--ease-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .p-tab[aria-selected='false']:hover::after {
      transform: scaleX(1);
    }
  }

  .p-tab:focus-visible {
    z-index: 1;
    outline-color: var(--ink);
  }

  .p-tab:active {
    transform: scale(0.98);
  }

  /* No-JS: tabs can't work, so the plan's name stands in their place and the
     other plans are summarised under the rail. */
  .p-static,
  .tl-alt {
    display: none;
  }

  :global(html:not(.js)) .p-tabs {
    display: none;
  }

  :global(html:not(.js)) .p-static {
    display: block;
    margin-top: 40px;
    color: var(--ink-2);
  }

  :global(html:not(.js)) .tl-alt {
    display: grid;
    gap: 8px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .tl-alt strong {
    color: var(--ink);
    font-weight: 640;
  }

  /* -------------------------------------------------------------- the rail */

  .tl {
    --bw: 17%;
    position: relative;
    margin-top: 56px;
  }

  /* dimension line: |———— 7–10 BUSINESS DAYS ————| over the working stretch */
  .tl-dim {
    position: relative;
    height: 9px;
    color: var(--ink-3);
  }

  .tl-dim-line {
    position: absolute;
    left: 0;
    top: 4px;
    width: 100%;
    height: 1px;
    background-color: var(--line-strong);
    transform: scaleX(var(--S));
    transform-origin: left center;
  }

  .tl-dim-tick {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 9px;
    background-color: var(--line-strong);
  }

  .tl-dim-end {
    left: calc(var(--S) * 100%);
    margin-left: -1px;
    background-color: transparent;
  }

  .tl-dim-end > span {
    display: block;
    width: 1px;
    height: 9px;
    background-color: var(--line-strong);
  }

  .tl-dim-at {
    position: absolute;
    left: calc(var(--S) * 50%);
    top: 4px;
    width: 0;
    height: 0;
  }

  .tl-dim-c {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0 14px;
    background-color: var(--paper);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .tl-dim-label {
    display: block;
    color: var(--ink-3);
  }

  .tl-track {
    position: relative;
  }

  .tl-base,
  .tl-work,
  .tl-fill {
    display: block;
    pointer-events: none;
  }

  /* After launch the rail goes on as a dotted trajectory: Care is optional
     and open-ended. The working stretch is an OPAQUE hairline (line-strong
     composed over paper) laid on top, so the dots only show past launch and
     the stretch can scale on a tab change without the two lines doubling. */
  .tl-base {
    border-top: 1px dashed var(--line-strong);
  }

  .tl-work {
    background-color: #b8b7bb;
  }

  .tl-fill {
    background-color: var(--violet);
  }

  .tl-list {
    margin: 0;
  }

  /* milestone node: 9px hairline square, hollow → violet when passed */
  .ms-node {
    position: relative;
    z-index: 1;
    display: block;
    width: 9px;
    height: 9px;
    border: 1px solid var(--ink-2);
    background-color: var(--paper);
    /* nodes arrive left to right as the rail draws (--d from x), then fill
       as the violet passes them */
    transition:
      opacity 600ms var(--ease-expo) var(--d, 0ms),
      background-color 240ms var(--ease-expo),
      border-color 240ms var(--ease-expo);
  }

  /* final state (no JS, engine not live): every working node filled */
  .tl:not(.is-live) .ms:not(.is-after) .ms-node,
  .ms.is-on:not(.is-after) .ms-node {
    background-color: var(--violet);
    border-color: var(--violet);
  }

  /* post-launch node: the site is in orbit. The orbit mark (hairline ellipse
     at −24° with one planet), centred on the 9px node box. */
  .ms.is-after .ms-node {
    border-color: transparent;
    background-color: transparent;
  }

  .ms.is-after .ms-node::before,
  .ms.is-after .ms-node::after {
    content: '';
    position: absolute;
  }

  .ms.is-after .ms-node::before {
    left: 0;
    top: 50%;
    width: 22px;
    height: 10px;
    margin-top: -5px;
    border: 1px solid var(--violet);
    border-radius: 50%;
    background-color: var(--paper);
    transform: rotate(var(--skew));
  }

  .ms.is-after .ms-node::after {
    left: 11px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background-color: var(--violet);
    /* sits on the ellipse's right vertex */
    transform: rotate(var(--skew)) translateX(11px);
  }

  /* upcoming milestones read ink-3; passed ones step up to full ink */
  .ms-time {
    display: block;
    color: var(--ink-3);
    white-space: nowrap;
    transition:
      opacity var(--t-reveal) var(--ease-expo) var(--d, 0ms),
      transform var(--t-reveal) var(--ease-expo) var(--d, 0ms),
      color 240ms var(--ease-expo) 0ms;
  }

  .ms.is-on .ms-time,
  .tl:not(.is-live) .ms:not(.is-after) .ms-time {
    color: var(--ink);
  }

  .ms-text {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 600ms var(--ease-mech);
  }

  .ms-clip {
    min-height: 0;
  }

  .tl.is-switching .ms-clip,
  .ms.is-out .ms-clip {
    overflow: hidden;
  }

  .ms.is-out .ms-text {
    grid-template-rows: 0fr;
  }

  .ms-in {
    max-width: 28ch;
    padding-right: 16px;
  }

  .ms-title {
    font-size: 1rem;
    font-weight: 640;
    line-height: 1.3;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .ms-body {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* absent from the current plan: fade, then hidden + inert (set by JS).
     Arriving milestones wait until the movers have nearly settled (FLIP is
     600ms), so nothing crosses a block that is still travelling. */
  .ms {
    transition:
      opacity 320ms linear 380ms,
      visibility 0s linear 0s;
  }

  .ms.is-out {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms linear,
      visibility 0s linear 200ms;
  }

  /* a changed label/text re-enters instead of popping */
  .is-swap {
    animation: ms-swap 520ms var(--ease-expo) both;
  }

  @keyframes ms-swap {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
    40% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------------------------ rail, below 1100px */

  @media (max-width: 1099.98px) {
    .tl-dim {
      --S: 1;
      margin-bottom: 40px;
    }

    .tl-base,
    .tl-work,
    .tl-fill {
      position: absolute;
      left: 4px;
      top: var(--rail-top, 5px);
      width: 1px;
      transform-origin: center top;
    }

    .tl-base {
      height: var(--rail-line, calc(100% - 5px));
      border-top: 0;
      border-left: 1px dashed var(--line-strong);
    }

    .tl-work {
      height: var(--rail-work, calc(100% - 5px));
    }

    .tl-fill {
      left: 3.5px;
      width: 2px;
      height: var(--rail-work, calc(100% - 5px));
      transform: scaleY(var(--p, 1));
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .tl-base:not(.is-in),
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .tl-work:not(.is-in) {
      transform: scaleY(0);
    }

    .ms {
      display: grid;
      grid-template-rows: 1fr;
      transition:
        grid-template-rows 600ms var(--ease-mech),
        opacity 360ms linear 200ms,
        visibility 0s linear 0s;
    }

    .ms.is-out {
      grid-template-rows: 0fr;
      transition:
        grid-template-rows 600ms var(--ease-mech),
        opacity 200ms linear,
        visibility 0s linear 600ms;
    }

    .ms-wrap {
      min-height: 0;
      display: grid;
      grid-template-columns: 9px minmax(0, 1fr);
      column-gap: 20px;
    }

    /* spacing sits inside the collapsing wrapper, so a collapsed slot is 0px */
    .ms-text {
      padding-bottom: 40px;
    }

    .ms.is-last .ms-text {
      padding-bottom: 0;
    }

    .tl.is-switching .ms-wrap,
    .ms.is-out .ms-wrap {
      overflow: hidden;
    }

    .ms-node {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    /* stacked, each milestone enters on its own as it scrolls in, so the
       left-to-right stagger of the horizontal rail would only add lag */
    .ms-node,
    .ms-time {
      --d: 0ms !important;
    }

    .ms-in {
      --d: 100ms !important;
    }

    /* No JS, nothing measures the vertical rail: draw it per milestone
       instead, node centre to next node centre (label line box is 14.4px,
       so the node centre sits at ~7px), dotted from launch to After. */
    .tl:not(.is-live) .tl-base,
    .tl:not(.is-live) .tl-work,
    .tl:not(.is-live) .tl-fill {
      display: none;
    }

    .tl:not(.is-live) .ms-wrap {
      position: relative;
    }

    .tl:not(.is-live) .ms:not(.is-last):not(.is-out) .ms-wrap::before {
      content: '';
      position: absolute;
      left: 3.5px;
      top: 7px;
      bottom: -7px;
      width: 2px;
      background-color: var(--violet);
    }

    .tl:not(.is-live) .ms:has(+ .ms.is-after) .ms-wrap::before {
      left: 4px;
      width: 1px;
      border-left: 1px dashed var(--line-strong);
      background-color: transparent;
    }

    /* on the vertical rail the orbit is centred on the line */
    .ms.is-after .ms-node::before {
      left: 50%;
      margin-left: -11px;
    }

    .ms.is-after .ms-node::after {
      left: 50%;
    }

    .ms-time {
      grid-column: 2;
      grid-row: 1;
    }

    .ms-text {
      grid-column: 2;
      grid-row: 2;
      margin-top: 12px;
    }

    .ms-in {
      max-width: 44ch;
      padding-right: 0;
    }

    .ms-title {
      font-size: 1.0625rem;
    }
  }

  /* Tablet: the same vertical rail, but each milestone is one schedule row,
     time in its own column beside the text, so the rail reads as a flight
     plan instead of a narrow column with the right half empty. The label and
     the node are centred on the title's first line box (17px × 1.3). */
  @media (min-width: 768px) and (max-width: 1099.98px) {
    /* the text column starts on grid column 3: node + gap + time + gap
       = two columns and two gaps */
    .ms-wrap {
      grid-template-columns: 9px calc((100% - 7 * var(--gap)) / 4 - 9px) minmax(0, 1fr);
      column-gap: var(--gap);
    }

    .ms-node {
      align-self: start;
      margin-top: 6.5px;
    }

    .ms-time {
      grid-column: 2;
      grid-row: 1;
      padding-top: 4px;
      white-space: normal;
      text-wrap: balance;
    }

    .ms-text {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
      padding-bottom: 36px;
    }

    .ms-in {
      max-width: 52ch;
    }

    .tl:not(.is-live) .ms:not(.is-last):not(.is-out) .ms-wrap::before {
      top: 11px;
      bottom: -11px;
    }
  }

  /* ------------------------------------------------ rail, 1100px and up */

  @media (min-width: 1100px) {
    .tl {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 9px auto auto;
    }

    .tl-dim {
      grid-row: 1;
      grid-column: 1;
      margin-bottom: 36px;
    }

    .tl-track {
      grid-row: 2 / 6;
      grid-column: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
    }

    .tl-base,
    .tl-work,
    .tl-fill {
      grid-row: 2;
      grid-column: 1;
      align-self: start;
      width: 100%;
      height: 1px;
      margin-top: 4px;
      transform-origin: left center;
    }

    .tl-work {
      transform: scaleX(var(--S));
    }

    .tl-fill {
      height: 2px;
      transform: scaleX(calc(var(--p, 1) * var(--S)));
    }

    .tl.is-switching .tl-work,
    .tl.is-switching .tl-fill,
    .tl.is-switching .tl-dim-line {
      transition: transform 600ms var(--ease-mech);
    }

    .tl-list {
      grid-row: 1 / -1;
      grid-column: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
    }

    .ms {
      grid-row: 1 / -1;
      grid-column: 1;
      display: grid;
      grid-template-rows: subgrid;
      width: var(--bw);
      margin-inline-start: calc(var(--x) * 100%);
    }

    .ms-wrap {
      display: contents;
    }

    .ms-time {
      grid-row: 1;
      margin-bottom: 18px;
    }

    .ms-node {
      grid-row: 2;
    }

    .ms-text {
      grid-row: 3;
      margin-top: 32px;
    }

    .ms[data-row='1'] .ms-text {
      grid-row: 4;
      margin-top: 44px;
    }
  }

  /* ------------------------------------------------------ what you bring */

  .p-note {
    margin-top: 40px;
    color: var(--ink-3);
    max-width: 40ch;
  }

  .bring {
    margin-top: 32px;
    padding: 32px 24px 36px;
    background-color: var(--paper-2);
    color: var(--ink);
    clip-path: var(--chamfer);
  }

  .bring-h {
    font-size: var(--t-d3);
  }

  .bring-list {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }

  .bring-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* proportional figures on purpose: this family's tabular zero is slashed,
     which reads as code */
  .bring-i {
    color: var(--ink-2);
    letter-spacing: 0.08em;
  }

  .bring-close {
    margin-top: 24px;
    font-stretch: var(--wd-display);
    font-size: 1.0625rem;
    font-weight: 640;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .bring {
      padding: 40px 40px 44px;
    }

    .p-tabs {
      max-width: 560px;
    }
  }

  /* ----------------------------------------------------------- placement */

  /* tablet: the note and the box share a row, as on desktop */
  @media (min-width: 768px) and (max-width: 1099.98px) {
    .p-note {
      grid-column: 1 / span 2;
      align-self: start;
      margin-top: 72px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    /* its left edge continues the milestone text column */
    .bring {
      grid-column: 3 / -1;
      margin-top: 72px;
    }
  }

  @media (min-width: 1100px) {
    .p-label {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .p-h2 {
      grid-column: 1 / span 7;
      grid-row: 2;
      margin-top: 32px;
    }

    .p-sub {
      grid-column: 1 / span 6;
      grid-row: 3;
      margin-top: 28px;
    }

    /* the right-hand column (tabs, and the box below) is columns 7–12 up to
       1379px, where the three tab labels need 480px, and 8–12 above */
    .p-tabs,
    .p-static {
      grid-column: 7 / -1;
      grid-row: 3;
      align-self: end;
      max-width: none;
      margin-top: 0;
    }

    :global(html:not(.js)) .p-static {
      margin-top: 0;
    }

    .p-tab {
      flex: 1 1 auto;
      padding-inline: 14px;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .tl {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-top: 112px;
    }

    .tl-alt {
      grid-row: 5;
    }

    /* the note is the rail's footnote (it says when the clock starts); its
       hairline shares the box's top edge */
    .p-note {
      grid-column: 1 / span 4;
      grid-row: 6;
      margin-top: 96px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
      align-self: start;
    }

    .bring {
      grid-column: 7 / -1;
      grid-row: 6;
      margin-top: 96px;
    }
  }

  @media (min-width: 1380px) {
    .p-tabs,
    .p-static,
    .bring {
      grid-column: 8 / -1;
    }

    .p-tab {
      padding-inline: 16px;
    }
  }
</style>

<script>
  import { addFrame, requestFrame, isReduced } from '../../scripts/motion';

  interface Slot {
    time: string;
    title: string;
    body: string;
    x: number;
    row: 0 | 1;
    after: boolean;
    t: number | null;
  }
  interface Plan {
    id: string;
    tab: string;
    total: string;
    S: number;
    slots: Record<string, Slot | null>;
  }
  interface Data {
    def: string;
    plans: Record<string, Plan>;
  }

  const FLIP_MS = 600;
  const MECH = 'cubic-bezier(0.65, 0, 0.35, 1)';

  function initProcess(section: HTMLElement): void {
    const raw = section.querySelector('[data-process-plans]')?.textContent;
    const tl = section.querySelector<HTMLElement>('[data-timeline]');
    const track = tl?.querySelector<HTMLElement>('.tl-track');
    const rail = tl?.querySelector<HTMLElement>('.tl-base');
    if (!raw || !tl || !track || !rail) return;

    let data: Data;
    try {
      data = JSON.parse(raw) as Data;
    } catch {
      return;
    }

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-plan-tab]'));
    const items = Array.from(tl.querySelectorAll<HTMLElement>('.ms[data-key]'));
    const dimLabel = tl.querySelector<HTMLElement>('[data-dim-label]');
    const flipDim = Array.from(tl.querySelectorAll<HTMLElement>('[data-flip]'));
    const desktop = window.matchMedia('(min-width: 1100px)');

    const q = (li: HTMLElement, sel: string) => li.querySelector<HTMLElement>(sel);
    const textOf = (li: HTMLElement) => q(li, '.ms-text');

    let current = tl.dataset.plan && data.plans[tl.dataset.plan] ? tl.dataset.plan : data.def;
    let p = 1;
    let written = -1;
    let active = true;
    let dirty = true;
    /* vertical rail geometry: [first node y, launch − first, last − first] */
    let railVals: [number, number, number] = [0, 0, 0];
    let railDirty = false;
    const thresholds = new Map<HTMLElement, number | null>();
    let timer = 0;

    tl.classList.add('is-live');

    /* ---- measuring (reads only) ---------------------------------------- */

    function measure(): void {
      const plan = data.plans[current];
      if (desktop.matches) {
        items.forEach((li) => {
          const s = plan.slots[li.dataset.key || ''];
          thresholds.set(li, s && !s.after ? s.t : null);
        });
        return;
      }
      /* vertical rail: from the first node to launch (work) and to the last node */
      const tr = track!.getBoundingClientRect();
      const ys = new Map<HTMLElement, number>();
      let first: number | null = null;
      let work: number | null = null;
      let last: number | null = null;
      items.forEach((li) => {
        const s = plan.slots[li.dataset.key || ''];
        const node = q(li, '.ms-node');
        if (!s || !node) return;
        const r = node.getBoundingClientRect();
        const cy = r.top + r.height / 2 - tr.top;
        ys.set(li, cy);
        if (first === null) first = cy;
        if (!s.after) work = cy;
        last = cy;
      });
      const top = first ?? 0;
      const workH = Math.max(0, (work ?? top) - top);
      const lineH = Math.max(0, (last ?? top) - top);
      items.forEach((li) => {
        const s = plan.slots[li.dataset.key || ''];
        const cy = ys.get(li);
        thresholds.set(li, !s || s.after || cy === undefined ? null : workH > 0 ? (cy - top) / workH : 0);
      });
      railVals = [top, workH, lineH];
      railDirty = true;
    }

    /* ---- the scroll-linked fill ------------------------------------------ */

    addFrame({
      read(_y, vh) {
        if (!active) return;
        if (dirty) {
          measure();
          dirty = false;
        }
        if (isReduced()) {
          p = 1;
          return;
        }
        /* starts when the rail is at 80% of the viewport, completes at 40% */
        let top: number;
        let h: number;
        if (desktop.matches) {
          top = rail.getBoundingClientRect().top;
          h = 0; // a horizontal rail is a line: 80% → 40% of the viewport
        } else {
          const r = track.getBoundingClientRect();
          top = r.top + railVals[0];
          h = railVals[1];
        }
        const span = 0.4 * vh + h;
        p = Math.min(1, Math.max(0, span > 0 ? (0.8 * vh - top) / span : 1));
      },
      write() {
        if (railDirty) {
          track.style.setProperty('--rail-top', `${railVals[0].toFixed(1)}px`);
          track.style.setProperty('--rail-work', `${railVals[1].toFixed(1)}px`);
          track.style.setProperty('--rail-line', `${railVals[2].toFixed(1)}px`);
          railDirty = false;
        }
        if (Math.abs(p - written) > 0.0005) {
          tl.style.setProperty('--p', p.toFixed(4));
          written = p;
        }
        items.forEach((li) => {
          const t = thresholds.get(li);
          li.classList.toggle('is-on', t != null && p > 0.001 && p >= t - 0.0005);
        });
      },
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) active = e.isIntersecting;
          requestFrame();
        },
        { rootMargin: '50% 0px 50% 0px' }
      ).observe(tl);
    }

    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        dirty = true;
        requestFrame();
      }).observe(track);
    }

    const remeasure = () => {
      dirty = true;
      requestFrame();
    };
    desktop.addEventListener?.('change', remeasure);
    document.addEventListener('vesta:motion', remeasure);

    /* ---- plan change ------------------------------------------------------ */

    function apply(plan: Plan): HTMLElement[] {
      const swaps: HTMLElement[] = [];
      const setText = (el: HTMLElement | null, text: string, animate: boolean, target?: HTMLElement | null) => {
        if (!el || el.textContent === text) return;
        el.textContent = text;
        const t = target ?? el;
        if (animate && !swaps.includes(t)) swaps.push(t);
      };

      tl.dataset.plan = plan.id;
      tl.style.setProperty('--S', String(plan.S));
      tl.setAttribute('aria-labelledby', `process-tab-${plan.id}`);
      tabs.forEach((t) => {
        const on = t.dataset.planTab === plan.id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      setText(dimLabel, plan.total, true);

      let lastPresent: HTMLElement | null = null;
      items.forEach((li) => {
        const s = plan.slots[li.dataset.key || ''];
        if (!s) {
          li.classList.add('is-out');
          li.classList.remove('is-on');
          li.setAttribute('inert', '');
          return;
        }
        const wasOut = li.classList.contains('is-out');
        li.style.setProperty('--x', String(s.x));
        li.dataset.row = String(s.row);
        li.classList.toggle('is-after', s.after);
        const inner = q(li, '.ms-in');
        setText(q(li, '.ms-time'), s.time, !wasOut);
        setText(q(li, '.ms-title'), s.title, !wasOut, inner);
        setText(q(li, '.ms-body'), s.body, !wasOut, inner);
        if (wasOut) {
          /* entering: make sure its reveals don't wait on the observer */
          li.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
        }
        li.classList.remove('is-out');
        li.removeAttribute('inert');
        lastPresent = li;
      });
      items.forEach((li) => li.classList.toggle('is-last', li === lastPresent));
      return swaps;
    }

    function select(id: string): void {
      if (id === current || !data.plans[id]) return;
      const prev = data.plans[current];
      const plan = data.plans[id];
      const animate = desktop.matches && !isReduced();

      /* First */
      const firsts = new Map<HTMLElement, DOMRect>();
      if (animate) {
        items.forEach((li) => {
          if (!prev.slots[li.dataset.key || '']) return;
          firsts.set(li, li.getBoundingClientRect());
          const t = textOf(li);
          if (t) firsts.set(t, t.getBoundingClientRect());
        });
        flipDim.forEach((el) => firsts.set(el, el.getBoundingClientRect()));
      }
      const flipEls = [...items, ...(items.map(textOf).filter(Boolean) as HTMLElement[]), ...flipDim];
      flipEls.forEach((el) => {
        el.style.transition = '';
        el.style.transform = '';
      });

      current = id;
      tl.classList.add('is-switching');
      const swaps = apply(plan);

      /* Last + Invert */
      const moved: HTMLElement[] = [];
      if (animate) {
        const plays: [HTMLElement, string][] = [];
        firsts.forEach((a, el) => {
          const li = el.closest<HTMLElement>('.ms');
          if (li && !plan.slots[li.dataset.key || '']) return;
          const b = el.getBoundingClientRect();
          const isText = el.classList.contains('ms-text');
          const d = isText ? a.top - b.top : a.left - b.left;
          if (Math.abs(d) < 0.5) return;
          plays.push([el, isText ? `translate3d(0, ${d.toFixed(1)}px, 0)` : `translate3d(${d.toFixed(1)}px, 0, 0)`]);
        });
        plays.forEach(([el, tf]) => {
          el.style.transition = 'none';
          el.style.transform = tf;
          moved.push(el);
        });
      }

      swaps.forEach((el) => el.classList.remove('is-swap'));
      void tl.offsetWidth;
      if (!isReduced()) swaps.forEach((el) => el.classList.add('is-swap'));

      /* Play */
      if (moved.length) {
        requestAnimationFrame(() => {
          moved.forEach((el) => {
            el.style.transition = `transform ${FLIP_MS}ms ${MECH}`;
            el.style.transform = '';
          });
        });
      }

      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        tl.classList.remove('is-switching');
        moved.forEach((el) => (el.style.transition = ''));
        swaps.forEach((el) => el.classList.remove('is-swap'));
        remeasure();
      }, FLIP_MS + 120);
      remeasure();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.planTab || ''));
      tab.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = tabs.length - 1;
        if (n < 0) return;
        e.preventDefault();
        tabs[n].focus();
        select(tabs[n].dataset.planTab || '');
      });
    });
  }

  const section = document.querySelector<HTMLElement>('[data-process]');
  if (section) initProcess(section);
</script>
