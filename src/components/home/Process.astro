    :global(html.js:not(.motion-reduced):not(.motion-failed)) .tl-base:not(.is-in),
    :global(html.js:not(.motion-reduced):not(.motion-failed)) .tl-work:not(.is-in) {
      transform: scaleY(0);
    }

    .ms {
      display: grid;
      grid-template-rows: 1fr;
      transition:
        grid-template-rows 600ms var(--ease-mech),
        opacity 360ms linear 200ms,
        visibility 0s linear 0s;
    }

    .ms.is-out {
      grid-template-rows: 0fr;
      transition:
        grid-template-rows 600ms var(--ease-mech),
        opacity 200ms linear,
        visibility 0s linear 600ms;
    }

    .ms-wrap {
      min-height: 0;
      display: grid;
      grid-template-columns: 9px minmax(0, 1fr);
      column-gap: 20px;
    }

    /* spacing sits inside the collapsing wrapper, so a collapsed slot is 0px */
    .ms-text {
      padding-bottom: 30px;
    }

    .ms.is-last .ms-text {
      padding-bottom: 0;
    }

    .tl.is-switching .ms-wrap,
    .ms.is-out .ms-wrap {
      overflow: hidden;
    }

    .ms-node {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    /* stacked, each milestone enters on its own as it scrolls in, so the
       left-to-right stagger of the horizontal rail would only add lag */
    .ms-node,
    .ms-time {
      --d: 0ms !important;
    }

    .ms-in {
      --d: 100ms !important;
    }

    /* No JS, nothing measures the vertical rail: draw it per milestone
       instead, node centre to next node centre (label line box is 14.4px,
       so the node centre sits at ~7px), dotted from launch to After. */
    .tl:not(.is-live) .tl-base,
    .tl:not(.is-live) .tl-work,
    .tl:not(.is-live) .tl-fill {
      display: none;
    }

    .tl:not(.is-live) .ms-wrap {
      position: relative;
    }

    .tl:not(.is-live) .ms:not(.is-last):not(.is-out) .ms-wrap::before {
      content: '';
      position: absolute;
      left: 3.5px;
      top: 7px;
      bottom: -7px;
      width: 2px;
      background-color: var(--violet);
    }

    .tl:not(.is-live) .ms:has(+ .ms.is-after) .ms-wrap::before {
      left: 4px;
      width: 1px;
      border-left: 1px dashed var(--line-strong);
      background-color: transparent;
    }

    /* on the vertical rail the orbit is centred on the line */
    .ms.is-after .ms-node::before {
      left: 50%;
      margin-left: -11px;
    }

    .ms.is-after .ms-node::after {
      left: 50%;
    }

    .ms-time {
      grid-column: 2;
      grid-row: 1;
    }

    .ms-text {
      grid-column: 2;
      grid-row: 2;
      margin-top: 10px;
    }

    .ms-in {
      max-width: 44ch;
      padding-right: 0;
    }

    .ms-title {
      font-size: 1.0625rem;
    }

    /* the whole title row is the target: 44px tall at least */
    .ms-btn {
