    }

    .tl-list {
      grid-row: 1 / -1;
      grid-column: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
    }

    .ms {
      grid-row: 1 / -1;
      grid-column: 1;
      display: grid;
      grid-template-rows: subgrid;
      width: var(--bw);
      margin-inline-start: calc(var(--x) * 100%);
    }

    .ms-wrap {
      display: contents;
    }

    .ms-time {
      grid-row: 1;
      margin-bottom: 18px;
    }

    .ms-node {
      grid-row: 2;
    }

    .ms-text {
      grid-row: 3;
      margin-top: 32px;
    }

    .ms[data-row='1'] .ms-text {
      grid-row: 4;
      margin-top: 44px;
    }

    /* with JS the rail carries titles only: tighter rows, no plus, the line
       goes to the readout */
    :global(html.js) .ms-text {
      margin-top: 26px;
    }

    :global(html.js) .ms[data-row='1'] .ms-text {
      margin-top: 20px;
    }

    :global(html.js) .ms-bw,
    :global(html.js) .ms-plus {
      display: none;
    }

    :global(html.js) .ms {
      cursor: pointer;
    }

    /* the milestone on show: its title steps in, a 2px violet bar draws
       under it */
    .ms-btn::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -8px;
      width: 32px;
      height: 2px;
      background-color: var(--violet);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 520ms var(--ease-expo);
    }

    .ms.is-cur .ms-btn::after {
