---
/**
 * #process · 08 PROCESS (spec §5.9; round 2/3: cleaner, bolder).
 *
 * A proportional timing rail with plan tabs. Each milestone sits at the
 * midpoint of its business-day span, scaled so the first milestone is at the
 * rail's start and launch is at the end of the working stretch (0..S); a
 * post-launch milestone ("After") sits past it on the dotted tail.
 *
 * The rail shows times and titles only. The detail lives behind them:
 *   ≥1100px  one readout under the rail. It follows the comet (the milestone
 *            the scroll-linked fill last reached), shows whatever milestone
 *            the pointer or focus is on, and stays on one that is clicked.
 *            It slides along the rail to sit under its milestone and its
 *            words flip in.
 *   <1100px  each title is a button that opens its own line in place (one at
 *            a time).
 *   no JS    every line is printed under its title, as before.
 * "What you bring" is an Expand box.
 *
 * Motion: data-scene on the wrapper (3D entrance). The rail fill is
 * scroll-linked through the shared rAF loop (`addFrame`, transform only);
 * a violet comet head rides its leading edge; nodes ignite (fill + a
 * hairline ring bursting out) as it passes them. A tab change slides the
 * ink indicator between tabs and FLIPs the milestones to their new places
 * on a 3D arc (they lift toward the viewer and swing as they travel);
 * changed labels flip over. Milestones a plan doesn't have collapse
 * (grid-template-rows 1fr→0fr, then visibility hidden + inert).
 *
 * Desktop (≥1100px): the rail spans columns 1–12, time labels above, titles
 * below in two alternating rows (a CSS subgrid, so each row is as tall as
 * its tallest block and every milestone column is one element positioned
 * with `margin-inline-start: x · 100%`). Below 1100px: a vertical rail at
 * the left edge, milestones stacked.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Expand from '../ui/Expand.astro';
import { process as processData } from '../../data/site';
import type { Milestone, PackageId, ProcessPlan } from '../../data/site';

/* Missing from site.ts (aria-only). Report to the data owner. */
const TODO_SITE = {
  tabsLabel: 'Timeline by package',
  readLabel: 'Milestone detail',
};

/* Desktop geometry, in fractions of the rail width. BW is mirrored in CSS
   as --bw; keep them equal. RW is the readout's width (CSS --rw). */
const BW = 0.17; // one milestone column
const RW = 0.44; // the readout under the rail
const AFTER_ROOM = 0.1; // extra room between launch and the post-launch milestone
const GAP = 0.016; // minimum clear space between two blocks in the same row

const ORDER: PackageId[] = ['landing', 'google', 'complete'];
const def: PackageId = processData.defaultPlan;
const plans = processData.plans as Record<PackageId, ProcessPlan>;

const KNOWN = ['conversation', 'kickoff', 'design', 'build', 'google', 'content', 'launch', 'care'];
const keyOf = (m: Milestone): string => {
  const t = m.title.toLowerCase();
  return KNOWN.find((k) => t.startsWith(k) || (k === 'kickoff' && t.includes('kickoff'))) ?? t.replace(/[^a-z0-9]+/g, '-');
};

/* One slot per role across all plans, in chronological order. Roles shared
   by several plans (conversation, design, build, launch) move on a tab change
   instead of being replaced. */
const union: string[] = [];
for (const id of [def, ...ORDER.filter((i) => i !== def)]) {
  let prev = -1;
  for (const m of plans[id].milestones) {
    const k = keyOf(m);
    let at = union.indexOf(k);
    if (at === -1) {
      at = prev + 1;
      union.splice(at, 0, k);
    }
    prev = at;
  }
}

interface Slot {
  time: string;
  title: string;
  body: string;
  /** Left edge, fraction of the rail width. */
  x: number;
  /** 0 = first text row, 1 = second. */
  row: 0 | 1;
  /** Post-launch: off the working stretch, node never fills. */
  after: boolean;
  /** Fill progress (0..1 of the working stretch) at which the node fills. */
  t: number | null;
}
interface PlanLayout {
  id: PackageId;
  tab: string;
  total: string;
  /** Working stretch (Day 0 → launch), fraction of the rail width. */
  S: number;
  slots: Record<string, Slot | null>;
}

const r4 = (n: number) => Math.round(n * 10000) / 10000;

function layout(plan: ProcessPlan): PlanLayout {
  const scaled = plan.milestones.filter((m) => m.span);
  const mid = (m: Milestone) => (m.span![0] + m.span![1]) / 2;
  const m0 = mid(scaled[0]);
  const m1 = mid(scaled[scaled.length - 1]);
  const hasAfter = scaled.length < plan.milestones.length;
  const S = r4(1 - BW - (hasAfter ? AFTER_ROOM : 0));
  const slots: Record<string, Slot | null> = Object.fromEntries(union.map((k) => [k, null]));
  plan.milestones.forEach((m, i) => {
    const after = !m.span;
    const f = after ? 1 - BW : m1 > m0 ? ((mid(m) - m0) / (m1 - m0)) * S : 0;
    slots[keyOf(m)] = {
      time: m.time,
      title: m.title,
      body: m.body,
      x: r4(f),
      row: (i % 2) as 0 | 1,
      after,
      t: after ? null : r4(S > 0 ? f / S : 0),
    };
  });

  /* Build-time guard: blocks in the same row must not overlap. */
  const present = Object.values(slots).filter(Boolean) as Slot[];
  for (const row of [0, 1]) {
    const xs = present.filter((s) => s.row === row).map((s) => s.x);
    for (let i = 1; i < xs.length; i++) {
      if (xs[i] - xs[i - 1] < BW + GAP) console.warn(`[Process] ${plan.id}: milestones overlap in row ${row} (${xs[i - 1]} → ${xs[i]}).`);
    }
  }

  return { id: plan.id, tab: plan.tab, total: plan.total, S, slots };
}

const layouts = Object.fromEntries(ORDER.map((id) => [id, layout(plans[id])])) as Record<PackageId, PlanLayout>;
const cur = layouts[def];

/* Present slots of the default plan, for the reveal stagger. */
const order = union.filter((k) => cur.slots[k]);
const lastKey = order[order.length - 1];
const firstSlot = cur.slots[order[0]]!;

const clientData = JSON.stringify({ def, plans: layouts, rw: RW }).replace(/</g, '\\u003c');

/* Every distinct readout text across the plans: stacked invisibly in one
   cell, they hold the readout at its tallest so nothing below it moves. */
const sizers = [
  ...new Map(
    ORDER.flatMap((id) => Object.values(layouts[id].slots).filter(Boolean) as Slot[]).map((s) => [`${s.time}|${s.title}|${s.body}`, s])
  ).values(),
];

/* No-JS: "Landing Page: Day 0 Conversation · …" with the plan name set bold. */
const summaries = ORDER.filter((id) => id !== def).map((id) => {
  const s = plans[id].summary;
  const cut = s.indexOf(': ');
  return cut > 0 ? { name: s.slice(0, cut + 1), rest: s.slice(cut + 2) } : { name: '', rest: s };
});

const wyb = processData.whatYouBring;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id={processData.id} class="s-paper section process" data-nav-theme="light" data-process aria-labelledby="process-title">
  <script is:inline type="application/json" data-process-plans set:html={clientData} />
  <div class="wrap g p-grid" data-scene>
    <SectionLabel n={processData.label.index} name={processData.label.name} class="p-label" />
    <SplitText as="h2" id="process-title" class="d2 p-h2" text={processData.h2} />
    <p class="lead p-sub" data-reveal style="--d:160ms">{processData.sub}</p>

    <div class="p-tabs" role="tablist" aria-label={TODO_SITE.tabsLabel} data-plan={def} data-reveal style="--d:240ms">
      <span class="p-ind" aria-hidden="true"></span>
      {
        ORDER.map((id) => (
          <button
            type="button"
            class="p-tab"
            role="tab"
            id={`process-tab-${id}`}
            aria-selected={id === def ? 'true' : 'false'}
            aria-controls="process-panel"
            tabindex={id === def ? 0 : -1}
            data-plan-tab={id}
          >
            <span class="p-tab-t">{layouts[id].tab}</span>
          </button>
        ))
      }
    </div>
    <p class="p-static label" data-reveal>{cur.tab}</p>

    <div class="tl" id="process-panel" role="tabpanel" aria-labelledby={`process-tab-${def}`} data-timeline data-plan={def} style={`--S:${cur.S}`}>
      <div class="tl-dim">
        <span class="tl-dim-line" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-dim-tick" data-reveal="fade" aria-hidden="true"></span>
        <span class="tl-dim-tick tl-dim-end" data-flip aria-hidden="true"><span data-reveal="fade" style="--d:900ms"></span></span>
        <span class="tl-dim-at" data-flip>
          <span class="tl-dim-c"><span class="label tl-dim-label" data-reveal="fade" data-dim-label style="--d:700ms">{cur.total}</span></span>
        </span>
      </div>

      <div class="tl-track">
        <span class="tl-base" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-work" data-reveal="draw" aria-hidden="true"></span>
        <span class="tl-fill" aria-hidden="true"></span>
        <span class="tl-comet" aria-hidden="true"><span class="tl-head"></span></span>

        <ol class="tl-list" role="list">
          {
            union.map((key) => {
              const s = cur.slots[key];
              const k = s ? order.indexOf(key) : 0;
              return (
                <li
                  class:list={['ms', { 'is-out': !s, 'is-after': s?.after, 'is-last': key === lastKey }]}
                  data-key={key}
                  data-row={s?.row ?? 0}
                  style={`--x:${s?.x ?? 0}`}
                  inert={!s}
                >
                  <div class="ms-wrap">
                    <span class="ms-time label" data-reveal style={`--d:${k * 80}ms`}>
                      {s?.time}
                    </span>
                    <span class="ms-node" data-reveal="fade" style={`--d:${Math.round(180 + (s?.x ?? 0) * 900)}ms`} aria-hidden="true">
                      <i class="ms-ring" />
                    </span>
                    <div class="ms-text">
                      <div class="ms-clip">
                        <div class="ms-in" data-reveal style={`--d:${120 + k * 80}ms`}>
                          <h3 class="ms-title">
                            <button type="button" class="ms-btn" aria-expanded="false" aria-controls={`ms-b-${key}`} data-ms-btn>
                              <span class="ms-t">{s?.title}</span>
                              <span class="ms-plus" aria-hidden="true" />
                            </button>
                          </h3>
                          <div class="ms-bw" id={`ms-b-${key}`}>
                            <div class="ms-bc">
                              <p class="ms-body">{s?.body}</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>

      <div class="tl-read" data-reveal style="--d:300ms">
        <span class="tl-read-rule" aria-hidden="true"><span class="tl-read-mk"></span></span>
        <div class="tl-read-box" id="process-read" role="region" aria-label={TODO_SITE.readLabel} aria-live="polite">
          <div class="tl-read-stack">
            {
              sizers.map((s) => (
                <div class="tl-read-in tl-read-sz" aria-hidden="true">
                  <span class="label tl-read-t">{s.time}</span>
                  <p class="tl-read-h">{s.title}</p>
                  <p class="tl-read-b">{s.body}</p>
                </div>
              ))
            }
            <div class="tl-read-in tl-read-live" data-read>
              <span class="label tl-read-t" data-read-time>{firstSlot.time}</span>
              <p class="tl-read-h" data-read-title>{firstSlot.title}</p>
              <p class="tl-read-b" data-read-body>{firstSlot.body}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ul class="tl-alt" role="list" data-reveal>
      {
        summaries.map((s) => (
          <li class="small">
            {s.name && <strong>{s.name}</strong>} {s.rest}
          </li>
        ))
      }
    </ul>

    <p class="small p-note" data-reveal>{processData.note}</p>

    <div class="p-bring">
      <Expand title={wyb.title} keywords={wyb.keywords} class="bring" i={1}>
        <ol class="bring-list" role="list">
          {
            wyb.items.map((item, i) => (
              <li class="bring-row">
                <span class="bring-i label" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
        <p class="bring-close">{wyb.closing}</p>
      </Expand>
    </div>
  </div>
</section>

<style>
  .process {
    overflow-x: clip;
  }

  /* ------------------------------------------------------------- heading */

  .p-h2 {
    margin-top: 28px;
    max-width: 18ch;
  }

  .p-sub {
    margin-top: 20px;
    color: var(--ink-2);
  }

  /* ------------------------------------------------------------------ tabs */

  /* The selected tab is an ink block that slides between tabs (transform
     only). Paint order inside the isolated tablist: tab surfaces, then the
     ink block (z 1), then every label (z 2). */
  .p-tabs {
    position: relative;
    isolation: isolate;
    display: flex;
    gap: 1px;
    margin-top: 40px;
  }

  .p-ind {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 100px;
    background-color: var(--ink);
    transform-origin: 0 50%;
    transform: translate3d(var(--ix, 0px), 0, 0) scaleX(var(--iw, 0));
    pointer-events: none;
  }

  .p-tabs.is-sliding .p-ind {
    transition: transform 620ms var(--ease-expo);
  }

  .p-tab {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    background-color: var(--paper-2);
    color: var(--ink);
    font-stretch: var(--wd-display);
    font-size: 0.75rem;
    font-weight: 620;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0s linear 0s;
  }

  /* the tab's own ink arrives with the sliding block, so at rest every label
     sits on its own opaque surface */
  .p-tab[aria-selected='true'] {
    background-color: var(--ink);
    cursor: default;
    transition-delay: 560ms;
  }

  .p-tab-t {
    position: relative;
    z-index: 2;
    display: block;
    transition:
      color 200ms linear 120ms,
      transform 120ms var(--ease-expo);
  }

  .p-tab[aria-selected='true'] .p-tab-t {
    color: var(--paper);
    transition-delay: 240ms;
  }

  /* hover: a 2px ink bar draws along the bottom edge */
  .p-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-ui) var(--ease-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .p-tab[aria-selected='false']:hover::after {
      transform: scaleX(1);
    }
  }

  .p-tab:focus-visible {
    outline-color: var(--ink);
  }

  .p-tab:active .p-tab-t {
    transform: scale(0.97);
  }

  /* No-JS: tabs can't work, so the plan's name stands in their place and the
     other plans are summarised under the rail. */
  .p-static,
  .tl-alt {
    display: none;
  }

  :global(html:not(.js)) .p-tabs {
    display: none;
  }

  :global(html:not(.js)) .p-static {
    display: block;
    margin-top: 40px;
    color: var(--ink-2);
  }

  :global(html:not(.js)) .tl-alt {
    display: grid;
    gap: 8px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .tl-alt strong {
    color: var(--ink);
    font-weight: 640;
  }

  /* -------------------------------------------------------------- the rail */

  .tl {
    --bw: 17%;
    --rw: 0.44;
    position: relative;
    margin-top: 56px;
  }

  /* dimension line: |———— 7–10 BUSINESS DAYS ————| over the working stretch */
  .tl-dim {
    position: relative;
    height: 9px;
    color: var(--ink-3);
  }

  .tl-dim-line {
    position: absolute;
    left: 0;
    top: 4px;
    width: 100%;
    height: 1px;
    background-color: var(--line-strong);
    transform: scaleX(var(--S));
    transform-origin: left center;
  }

  .tl-dim-tick {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 9px;
    background-color: var(--line-strong);
  }

  .tl-dim-end {
    left: calc(var(--S) * 100%);
    margin-left: -1px;
    background-color: transparent;
  }

  .tl-dim-end > span {
    display: block;
    width: 1px;
    height: 9px;
    background-color: var(--line-strong);
  }

  .tl-dim-at {
    position: absolute;
    left: calc(var(--S) * 50%);
    top: 4px;
    width: 0;
    height: 0;
  }

  .tl-dim-c {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0 14px;
    background-color: var(--paper);
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .tl-dim-label {
    display: block;
    color: var(--ink-3);
  }

  .tl-track {
    position: relative;
  }

  .tl-base,
  .tl-work,
  .tl-fill,
  .tl-comet {
    display: block;
    pointer-events: none;
  }

  /* After launch the rail goes on as a dotted trajectory: Care is optional
     and open-ended. The working stretch is an OPAQUE hairline (line-strong
     composed over paper) laid on top, so the dots only show past launch and
     the stretch can scale on a tab change without the two lines doubling. */
  .tl-base {
    border-top: 1px dashed var(--line-strong);
  }

  .tl-work {
    background-color: #b8b7bb;
  }

  .tl-fill {
    background-color: var(--violet);
  }

  /* the comet: a violet head on the fill's leading edge, a hairline ring
     breathing out of it while it travels. Live rail only. */
  .tl-comet {
    display: none;
  }

  .tl.is-live .tl-comet {
    display: block;
    position: relative;
    z-index: 2;
  }

  .tl-head {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--violet);
  }

  .tl-head::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--violet);
    border-radius: 50%;
    opacity: 0;
  }

  .tl.is-moving .tl-head::after {
    animation: tl-breathe 1600ms var(--ease-expo) infinite;
  }

  @keyframes tl-breathe {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }

  /* at rest on launch, the head folds into the node */
  .tl.is-landed .tl-head {
    transform: scale(0);
    transition: transform 500ms var(--ease-expo);
  }

  .tl-head {
    transition: transform 400ms var(--ease-settle);
  }

  .tl-list {
    margin: 0;
  }

  /* milestone node: 9px hairline square, hollow → violet when passed */
  .ms-node {
    position: relative;
    z-index: 1;
    display: block;
    width: 9px;
    height: 9px;
    border: 1px solid var(--ink-2);
    background-color: var(--paper);
    /* nodes arrive left to right as the rail draws (--d from x), then fill
       as the violet passes them */
    transition:
      opacity 600ms var(--ease-expo) var(--d, 0ms),
      background-color 240ms var(--ease-expo),
      border-color 240ms var(--ease-expo);
  }

  /* final state (no JS, engine not live): every working node filled */
  .tl:not(.is-live) .ms:not(.is-after) .ms-node,
  .ms.is-on:not(.is-after) .ms-node {
    background-color: var(--violet);
    border-color: var(--violet);
  }

  /* ignition: the node pops and a hairline ring bursts out of it, once, as
     the comet passes */
  .ms-ring {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--violet);
    opacity: 0;
    pointer-events: none;
  }

  .tl.is-live .ms.is-on:not(.is-after) .ms-node {
    animation: ms-pop 700ms var(--ease-settle) both;
  }

  .tl.is-live .ms.is-on:not(.is-after) .ms-ring {
    animation: ms-ignite 1100ms var(--ease-expo) both;
  }

  @keyframes ms-pop {
    from {
      transform: scale(1.9) rotate(45deg);
    }
    to {
      transform: none;
    }
  }

  @keyframes ms-ignite {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(4.2) rotate(45deg);
    }
  }

  /* post-launch node: the site is in orbit. The orbit mark (hairline ellipse
     at −24° with one planet), centred on the 9px node box. */
  .ms.is-after .ms-node {
    border-color: transparent;
    background-color: transparent;
  }

  .ms.is-after .ms-node::before,
  .ms.is-after .ms-node::after {
    content: '';
    position: absolute;
  }

  .ms.is-after .ms-node::before {
    left: 0;
    top: 50%;
    width: 22px;
    height: 10px;
    margin-top: -5px;
    border: 1px solid var(--violet);
    border-radius: 50%;
    background-color: var(--paper);
    transform: rotate(var(--skew));
  }

  .ms.is-after .ms-node::after {
    left: 11px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background-color: var(--violet);
    /* sits on the ellipse's right vertex */
    transform: rotate(var(--skew)) translateX(11px);
  }

  /* upcoming milestones read ink-3; passed ones step up to full ink */
  .ms-time {
    display: block;
    color: var(--ink-3);
    white-space: nowrap;
    transition:
      opacity var(--t-reveal) var(--ease-expo) var(--d, 0ms),
      transform var(--t-reveal) var(--ease-expo) var(--d, 0ms),
      color 240ms var(--ease-expo) 0ms;
  }

  .ms.is-on .ms-time,
  .tl:not(.is-live) .ms:not(.is-after) .ms-time {
    color: var(--ink);
  }

  .ms-text {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 600ms var(--ease-mech);
  }

  .ms-clip {
    min-height: 0;
  }

  .tl.is-switching .ms-clip,
  .ms.is-out .ms-clip {
    overflow: hidden;
  }

  .ms.is-out .ms-text {
    grid-template-rows: 0fr;
  }

  .ms-in {
    max-width: 28ch;
    padding-right: 16px;
  }

  .ms-title {
    font-size: 1rem;
    font-weight: 640;
    line-height: 1.3;
    letter-spacing: 0;
  }

  /* the title is the milestone's control */
  .ms-btn {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    padding: 0;
    background-color: var(--paper);
    color: var(--ink);
    font: inherit;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .ms-t {
    display: block;
    text-wrap: balance;
    transition: transform var(--t-ui) var(--ease-expo);
  }

  /* the plus (below 1100px): turns into a minus when the line is open */
  .ms-plus {
    position: relative;
    flex: none;
    width: 11px;
    height: 11px;
    margin-top: 5px;
  }

  .ms-plus::before,
  .ms-plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 11px;
    height: 1px;
    background-color: var(--ink);
    transition: transform 420ms var(--ease-expo);
  }

  .ms-plus::after {
    transform: rotate(90deg);
  }

  .ms.is-open .ms-plus::after {
    transform: rotate(0deg);
  }

  :global(html:not(.js)) .ms-plus {
    display: none;
  }

  .ms-body {
    padding-top: 8px;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* the line under a title: printed without JS; with JS it opens in place
     (below 1100px) or is shown by the readout (1100px and up) */
  .ms-bw {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 560ms var(--ease-expo);
  }

  .ms-bc {
    min-height: 0;
    overflow: hidden;
    perspective: 700px;
  }

  .ms-body {
    transform-origin: 50% 0;
    transition:
      opacity 360ms linear 120ms,
      transform 700ms var(--ease-expo) 60ms,
      visibility 0s linear 0s;
  }

  :global(html.js) .ms:not(.is-open) .ms-bw {
    grid-template-rows: 0fr;
  }

  :global(html.js) .ms:not(.is-open) .ms-body {
    visibility: hidden;
    opacity: 0;
    transform: rotateX(-70deg) translate3d(0, -6px, 0);
    transition:
      opacity 160ms linear,
      transform 300ms var(--ease-expo),
      visibility 0s linear 300ms;
  }

  /* absent from the current plan: fade, then hidden + inert (set by JS).
     Arriving milestones wait until the movers have nearly settled (FLIP is
     700ms), so nothing crosses a block that is still travelling. */
  .ms {
    transition:
      opacity 320ms linear 420ms,
      visibility 0s linear 0s;
  }

  .ms.is-out {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms linear,
      visibility 0s linear 200ms;
  }

  /* a changed label flips over instead of popping */
  .is-swap {
    transform-origin: 50% 100%;
    animation: ms-swap 640ms var(--ease-expo) both;
  }

  @keyframes ms-swap {
    from {
      opacity: 0;
      transform: perspective(500px) translate3d(0, 30%, 0) rotateX(-80deg);
    }
    35% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* the readout: desktop with JS only */
  .tl-read {
    display: none;
  }

  /* ------------------------------------------------ rail, below 1100px */

  @media (max-width: 1099.98px) {
    .tl-dim {
      --S: 1;
      margin-bottom: 40px;
    }

    .tl-base,
    .tl-work,
    .tl-fill,
    .tl-comet {
      position: absolute;
      left: 4px;
      top: var(--rail-top, 5px);
      width: 1px;
      transform-origin: center top;
    }

    .tl-base {
      height: var(--rail-line, calc(100% - 5px));
      border-top: 0;
      border-left: 1px dashed var(--line-strong);
    }

    .tl-work {
      height: var(--rail-work, calc(100% - 5px));
    }

    .tl-fill {
      left: 3.5px;
      width: 2px;
      height: var(--rail-work, calc(100% - 5px));
      transform: scaleY(var(--p, 1));
    }

    .tl.is-live .tl-comet {
      position: absolute;
      height: 1px;
      transform: translate3d(0, calc(var(--p, 1) * var(--rail-work, 0px)), 0);
    }

