     plan instead of a narrow column with the right half empty. The label and
     the node are centred on the title's first line box (17px × 1.3). */
  @media (min-width: 768px) and (max-width: 1099.98px) {
    /* the text column starts on grid column 3: node + gap + time + gap
       = two columns and two gaps */
    .ms-wrap {
      grid-template-columns: 9px calc((100% - 7 * var(--gap)) / 4 - 9px) minmax(0, 1fr);
      column-gap: var(--gap);
    }

    .ms-node {
      align-self: start;
      margin-top: 6.5px;
    }

    .ms-time {
      grid-column: 2;
      grid-row: 1;
      padding-top: 4px;
      white-space: normal;
      text-wrap: balance;
    }

    .ms-text {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
      padding-bottom: 30px;
    }

    .ms-in {
      max-width: 52ch;
    }

    .tl:not(.is-live) .ms:not(.is-last):not(.is-out) .ms-wrap::before {
      top: 11px;
      bottom: -11px;
    }
  }

  /* ------------------------------------------------ rail, 1100px and up */

  @media (min-width: 1100px) {
    .tl {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 9px auto auto auto;
    }

    .tl-dim {
      grid-row: 1;
      grid-column: 1;
      margin-bottom: 36px;
    }

    .tl-track {
      grid-row: 2 / 6;
      grid-column: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
    }

    .tl-base,
    .tl-work,
    .tl-fill,
    .tl-comet {
      grid-row: 2;
      grid-column: 1;
      align-self: start;
      width: 100%;
      height: 1px;
      margin-top: 4px;
      transform-origin: left center;
    }

    .tl-work {
      transform: scaleX(var(--S));
    }

    .tl-fill {
      height: 2px;
      transform: scaleX(calc(var(--p, 1) * var(--S)));
    }

    /* the comet spans the rail; its head sits at the left edge and the
       element travels with the fill (percent of its own width = the rail) */
    .tl.is-live .tl-comet {
      height: 2px;
      transform: translate3d(calc(var(--p, 1) * var(--S) * 100%), 0, 0);
    }

    .tl-head {
      left: -5.5px;
      top: -4.5px;
    }

    .tl.is-switching .tl-work,
    .tl.is-switching .tl-fill,
    .tl.is-switching .tl-comet,
    .tl.is-switching .tl-dim-line {
