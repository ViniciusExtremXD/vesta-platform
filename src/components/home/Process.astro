<script>
  import { addFrame, requestFrame, isReduced } from '../../scripts/motion';

  interface Slot {
    time: string;
    title: string;
    body: string;
    x: number;
    row: 0 | 1;
    after: boolean;
    t: number | null;
  }
  interface Plan {
    id: string;
    tab: string;
    total: string;
    S: number;
    slots: Record<string, Slot | null>;
  }
  interface Data {
    def: string;
    plans: Record<string, Plan>;
    rw: number;
  }

  const FLIP_MS = 700;
  const MECH = 'cubic-bezier(0.65, 0, 0.35, 1)';

  /** Layout offset of `el` inside `box` (ignores transforms: the section
      swings in on a 3D plane, and rects would read its projection). */
  function offsetTopIn(el: HTMLElement, box: HTMLElement): number {
    let y = 0;
    let n: HTMLElement | null = el;
    while (n && n !== box) {
      y += n.offsetTop;
      n = n.offsetParent as HTMLElement | null;
    }
    return n === box ? y : NaN;
  }

  function initProcess(section: HTMLElement): void {
    const raw = section.querySelector('[data-process-plans]')?.textContent;
    const tl = section.querySelector<HTMLElement>('[data-timeline]');
    const track = tl?.querySelector<HTMLElement>('.tl-track');
    const rail = tl?.querySelector<HTMLElement>('.tl-base');
    if (!raw || !tl || !track || !rail) return;

    let data: Data;
    try {
      data = JSON.parse(raw) as Data;
    } catch {
      return;
    }

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-plan-tab]'));
    const tablist = section.querySelector<HTMLElement>('.p-tabs');
    const items = Array.from(tl.querySelectorAll<HTMLElement>('.ms[data-key]'));
    const dimLabel = tl.querySelector<HTMLElement>('[data-dim-label]');
    const flipDim = Array.from(tl.querySelectorAll<HTMLElement>('[data-flip]'));
    const read = tl.querySelector<HTMLElement>('[data-read]');
    const readTime = tl.querySelector<HTMLElement>('[data-read-time]');
    const readTitle = tl.querySelector<HTMLElement>('[data-read-title]');
    const readBody = tl.querySelector<HTMLElement>('[data-read-body]');
    const readWrap = tl.querySelector<HTMLElement>('.tl-read');
    const desktop = window.matchMedia('(min-width: 1100px)');

    const q = (li: HTMLElement, sel: string) => li.querySelector<HTMLElement>(sel);
    const textOf = (li: HTMLElement) => q(li, '.ms-text');
    const keyOf = (li: HTMLElement) => li.dataset.key || '';

    let current = tl.dataset.plan && data.plans[tl.dataset.plan] ? tl.dataset.plan : data.def;
    let p = 1;
    let written = -1;
    let active = true;
    let dirty = true;
    /* vertical rail geometry: [first node y, launch − first, last − first] */
    let railVals: [number, number, number] = [0, 0, 0];
    let railDirty = false;
    const thresholds = new Map<HTMLElement, number | null>();
    let timer = 0;
    let moveTimer = 0;
    /* readout: the comet's milestone, unless the pointer/focus is on one
       (hover) or one was clicked (pinned) */
    let auto = '';
    let hover = '';
    let pinned = '';
    let shownKey = '';

    tl.classList.add('is-live');

    /* ---- readout (desktop) ---------------------------------------------- */

    function showRead(key: string): void {
      const plan = data.plans[current];
      const s = plan.slots[key];
      if (!s || !read) return;
      items.forEach((li) => li.classList.toggle('is-cur', keyOf(li) === key && desktop.matches));
      if (key === shownKey) return;
      const first = shownKey === '';
      shownKey = key;
      if (readTime) readTime.textContent = s.time;
      if (readTitle) readTitle.textContent = s.title;
      if (readBody) readBody.textContent = s.body;
      const rx = Math.max(0, Math.min(1 - data.rw, s.x));
      readWrap?.style.setProperty('--rx', String(rx));
      readWrap?.style.setProperty('--mx', String(s.x));
      items.forEach((li) => {
        const btn = q(li, '[data-ms-btn]');
        if (!btn || !desktop.matches) return;
        btn.setAttribute('aria-controls', 'process-read');
        btn.setAttribute('aria-expanded', String(keyOf(li) === key));
      });
      if (!first && !isReduced()) {
        read.classList.remove('is-flip');
        void read.offsetWidth;
        read.classList.add('is-flip');
      }
    }

    function syncRead(): void {
      if (!desktop.matches) return;
      const plan = data.plans[current];
      const want = [hover, pinned, auto].find((k) => k && plan.slots[k]);
      const firstKey = items.map(keyOf).find((k) => plan.slots[k]) || '';
      showRead(want || firstKey);
    }

    /* ---- in-place lines (below 1100px) --------------------------------- */

    function setOpen(li: HTMLElement | null): void {
      items.forEach((it) => {
        const on = it === li;
        it.classList.toggle('is-open', on);
        const btn = q(it, '[data-ms-btn]');
        if (btn) {
          btn.setAttribute('aria-controls', `ms-b-${keyOf(it)}`);
          btn.setAttribute('aria-expanded', String(on));
        }
      });
      dirty = true;
      requestFrame();
      /* the rail's geometry changes while the line opens: re-measure as it
         settles */
      window.setTimeout(remeasure, 600);
    }

    function applyMode(): void {
      if (desktop.matches) {
        items.forEach((it) => it.classList.remove('is-open'));
        shownKey = '';
        syncRead();
      } else {
        items.forEach((it) => it.classList.remove('is-cur'));
        setOpen(null);
      }
    }

    items.forEach((li) => {
      const btn = q(li, '[data-ms-btn]');
      const key = keyOf(li);
      btn?.addEventListener('click', () => {
        if (desktop.matches) {
          pinned = pinned === key ? '' : key;
          hover = '';
          syncRead();
          if (!pinned) showRead(key);
        } else {
          setOpen(li.classList.contains('is-open') ? null : li);
        }
      });
      btn?.addEventListener('focus', () => {
        if (!desktop.matches) return;
        hover = key;
        syncRead();
      });
      btn?.addEventListener('blur', () => {
        if (hover !== key) return;
        hover = '';
        syncRead();
      });
      li.addEventListener('pointerenter', (e) => {
        if (!desktop.matches || e.pointerType === 'touch') return;
        hover = key;
        syncRead();
      });
      /* a click anywhere on the column (time, node) is a click on the title */
      li.addEventListener('click', (e) => {
        if (!desktop.matches || !btn || (e.target as HTMLElement).closest('[data-ms-btn]')) return;
        btn.click();
      });
    });
    tl.querySelector('.tl-list')?.addEventListener('pointerleave', () => {
      if (!hover) return;
      hover = '';
      syncRead();
    });

    /* ---- tab indicator ---------------------------------------------------- */

    function placeInd(animate: boolean): void {
      if (!tablist) return;
      const sel = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      if (!sel) return;
      tablist.classList.toggle('is-sliding', animate && !isReduced());
      tablist.style.setProperty('--ix', `${sel.offsetLeft}px`);
      tablist.style.setProperty('--iw', String(sel.offsetWidth / 100));
      tablist.classList.add('is-live');
    }

    /* ---- measuring (reads only) ---------------------------------------- */

    function measure(): void {
      const plan = data.plans[current];
      if (desktop.matches) {
        items.forEach((li) => {
          const s = plan.slots[keyOf(li)];
          thresholds.set(li, s && !s.after ? s.t : null);
        });
        return;
      }
      /* vertical rail: from the first node to launch (work) and to the last
         node, in layout pixels */
      const ys = new Map<HTMLElement, number>();
      let first: number | null = null;
      let work: number | null = null;
      let last: number | null = null;
      items.forEach((li) => {
        const s = plan.slots[keyOf(li)];
        const node = q(li, '.ms-node');
        if (!s || !node) return;
        const cy = offsetTopIn(node, track!) + node.offsetHeight / 2;
        if (!Number.isFinite(cy)) return;
        ys.set(li, cy);
        if (first === null) first = cy;
        if (!s.after) work = cy;
        last = cy;
      });
      const top = first ?? 0;
      const workH = Math.max(0, (work ?? top) - top);
      const lineH = Math.max(0, (last ?? top) - top);
      items.forEach((li) => {
        const s = plan.slots[keyOf(li)];
        const cy = ys.get(li);
        thresholds.set(li, !s || s.after || cy === undefined ? null : workH > 0 ? (cy - top) / workH : 0);
      });
      railVals = [top, workH, lineH];
      railDirty = true;
    }

    /* ---- the scroll-linked fill ------------------------------------------ */

    let lastOn = '';

    addFrame({
      read(_y, vh) {
        if (!active) return;
        if (dirty) {
          measure();
          dirty = false;
        }
        if (isReduced()) {
          p = 1;
          return;
        }
        /* starts when the rail is at 80% of the viewport, completes at 40% */
        let top: number;
        let h: number;
        if (desktop.matches) {
          top = rail.getBoundingClientRect().top;
          h = 0; // a horizontal rail is a line: 80% → 40% of the viewport
        } else {
          const r = track.getBoundingClientRect();
          top = r.top + railVals[0];
          h = railVals[1];
        }
        const span = 0.4 * vh + h;
        p = Math.min(1, Math.max(0, span > 0 ? (0.8 * vh - top) / span : 1));
      },
      write() {
        if (railDirty) {
          track.style.setProperty('--rail-top', `${railVals[0].toFixed(1)}px`);
          track.style.setProperty('--rail-work', `${railVals[1].toFixed(1)}px`);
          track.style.setProperty('--rail-line', `${railVals[2].toFixed(1)}px`);
          railDirty = false;
        }
        if (Math.abs(p - written) > 0.0005) {
          tl.style.setProperty('--p', p.toFixed(4));
          /* the comet breathes while it travels */
          if (written >= 0 && !isReduced()) {
            tl.classList.add('is-moving');
            window.clearTimeout(moveTimer);
            moveTimer = window.setTimeout(() => tl.classList.remove('is-moving'), 900);
          }
          written = p;
          tl.classList.toggle('is-landed', p >= 0.999);
        }
        let reached = '';
        items.forEach((li) => {
          const t = thresholds.get(li);
          const on = t != null && p > 0.001 && p >= t - 0.0005;
          li.classList.toggle('is-on', on);
          if (on) reached = keyOf(li);
        });
        if (reached !== lastOn) {
          lastOn = reached;
          auto = reached;
          syncRead();
        }
      },
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) active = e.isIntersecting;
          requestFrame();
        },
        { rootMargin: '50% 0px 50% 0px' }
      ).observe(tl);
    }

    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        dirty = true;
        placeInd(false);
        requestFrame();
      }).observe(track);
    }

    function remeasure(): void {
      dirty = true;
      requestFrame();
    }
    desktop.addEventListener?.('change', () => {
      applyMode();
      placeInd(false);
      remeasure();
    });
    document.addEventListener('vesta:motion', remeasure);
    document.fonts?.ready.then(() => placeInd(false));

    /* ---- plan change ------------------------------------------------------ */

    function apply(plan: Plan): HTMLElement[] {
      const swaps: HTMLElement[] = [];
      const setText = (el: HTMLElement | null, text: string, animate: boolean) => {
        if (!el || el.textContent === text) return;
        el.textContent = text;
        if (animate && !swaps.includes(el)) swaps.push(el);
      };

      tl.dataset.plan = plan.id;
      tl.style.setProperty('--S', String(plan.S));
      tl.setAttribute('aria-labelledby', `process-tab-${plan.id}`);
      tabs.forEach((t) => {
        const on = t.dataset.planTab === plan.id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      setText(dimLabel, plan.total, true);

      let lastPresent: HTMLElement | null = null;
      items.forEach((li) => {
        const s = plan.slots[keyOf(li)];
        if (!s) {
          li.classList.add('is-out');
          li.classList.remove('is-on', 'is-open', 'is-cur');
          li.setAttribute('inert', '');
          return;
        }
        const wasOut = li.classList.contains('is-out');
        li.style.setProperty('--x', String(s.x));
        li.dataset.row = String(s.row);
        li.classList.toggle('is-after', s.after);
        setText(q(li, '.ms-time'), s.time, !wasOut);
        setText(q(li, '.ms-t'), s.title, !wasOut);
        const body = q(li, '.ms-body');
        if (body) body.textContent = s.body;
        if (wasOut) {
          /* entering: make sure its reveals don't wait on the observer */
          li.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
        }
        li.classList.remove('is-out');
        li.removeAttribute('inert');
        lastPresent = li;
      });
      items.forEach((li) => li.classList.toggle('is-last', li === lastPresent));
      return swaps;
    }

    function select(id: string): void {
      if (id === current || !data.plans[id]) return;
      const prev = data.plans[current];
      const plan = data.plans[id];
      const animate = desktop.matches && !isReduced();

      /* First */
      const firsts = new Map<HTMLElement, DOMRect>();
      if (animate) {
        items.forEach((li) => {
          if (!prev.slots[keyOf(li)]) return;
          firsts.set(li, li.getBoundingClientRect());
          const t = textOf(li);
          if (t) firsts.set(t, t.getBoundingClientRect());
        });
        flipDim.forEach((el) => firsts.set(el, el.getBoundingClientRect()));
      }
      const flipEls = [...items, ...(items.map(textOf).filter(Boolean) as HTMLElement[]), ...flipDim];
      flipEls.forEach((el) => el.getAnimations?.().forEach((a) => a.cancel()));

      current = id;
      tl.classList.add('is-switching');
      const swaps = apply(plan);
      placeInd(true);
      /* the readout follows: pinned/hovered keys may not exist in this plan */
      if (pinned && !plan.slots[pinned]) pinned = '';
      shownKey = '';
      syncRead();

      /* Last, Invert, Play: each mover travels on a 3D arc — it lifts toward
         the viewer and swings a little in the direction of travel */
      if (animate) {
        firsts.forEach((a, el) => {
          const li = el.closest<HTMLElement>('.ms');
          if (li && !plan.slots[keyOf(li)]) return;
          const b = el.getBoundingClientRect();
          const isText = el.classList.contains('ms-text');
          const d = isText ? a.top - b.top : a.left - b.left;
          if (Math.abs(d) < 0.5 || typeof el.animate !== 'function') return;
          const sign = d > 0 ? 1 : -1;
          const frames = isText
            ? [
                { transform: `translate3d(0, ${d.toFixed(1)}px, 0)` },
                { transform: `perspective(700px) translate3d(0, ${(d / 2).toFixed(1)}px, 40px) rotateX(${(-sign * 22).toFixed(0)}deg)`, offset: 0.45 },
                { transform: 'none' },
              ]
            : [
                { transform: `translate3d(${d.toFixed(1)}px, 0, 0)` },
                {
                  transform: `perspective(900px) translate3d(${(d / 2).toFixed(1)}px, -12px, 70px) rotateY(${(sign * 16).toFixed(0)}deg)`,
                  offset: 0.45,
                },
                { transform: 'none' },
              ];
          el.animate(frames, { duration: FLIP_MS, easing: MECH });
        });
      }

      swaps.forEach((el) => el.classList.remove('is-swap'));
      void tl.offsetWidth;
      if (!isReduced()) swaps.forEach((el) => el.classList.add('is-swap'));

      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        tl.classList.remove('is-switching');
        swaps.forEach((el) => el.classList.remove('is-swap'));
        remeasure();
      }, FLIP_MS + 120);
      remeasure();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.planTab || ''));
      tab.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = tabs.length - 1;
        if (n < 0) return;
        e.preventDefault();
        tabs[n].focus();
        select(tabs[n].dataset.planTab || '');
      });
    });

    placeInd(false);
    applyMode();
  }

  const section = document.querySelector<HTMLElement>('[data-process]');
  if (section) {
    try {
      initProcess(section);
    } catch (err) {
      /* never leave the rail half-armed: fall back to the printed layout */
      section.querySelector('[data-timeline]')?.classList.remove('is-live');
      section.classList.add('is-static');
      section.querySelectorAll('.ms').forEach((li) => li.classList.add('is-open'));
      console.warn('[process] timeline disabled; showing the printed layout.', err);
    }
  }
</script>
