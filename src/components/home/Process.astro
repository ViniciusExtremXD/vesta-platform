    }

    .tl-read-in {
      grid-area: 1 / 1;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 28px;
      align-content: start;
    }

    .tl-read-sz {
      visibility: hidden;
    }

    .tl-read-t {
      grid-row: 1 / span 2;
      padding-top: 7px;
      min-width: 9ch;
      color: var(--violet-ink);
    }

    .tl-read-h {
      font-stretch: var(--wd-display);
      font-size: var(--t-d3);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
      text-wrap: balance;
    }

    .tl-read-b {
      margin-top: 10px;
      max-width: 46ch;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--ink-2);
      text-wrap: pretty;
    }

    .tl-read-live {
      transform-origin: 50% 0;
    }

    .tl-read-live.is-flip {
      animation: tl-read-flip 720ms var(--ease-expo) both;
    }

    @keyframes tl-read-flip {
      from {
        opacity: 0;
        transform: translate3d(0, 18px, -40px) rotateX(-38deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* ------------------------------------------------------ what you bring */

  .p-note {
    margin-top: 40px;
    color: var(--ink-3);
    max-width: 40ch;
  }

  .p-bring {
    margin-top: 24px;
  }

  .bring-list {
    border-top: 1px solid var(--line);
  }

  .bring-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* proportional figures on purpose: this family's tabular zero is slashed,
     which reads as code */
  .bring-i {
    color: var(--ink-2);
    letter-spacing: 0.08em;
  }

  .bring-close {
    margin-top: 20px;
    font-stretch: var(--wd-display);
    font-size: 1.0625rem;
    font-weight: 640;
    line-height: 1.3;
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .p-tabs {
      max-width: 560px;
    }
  }

  /* ----------------------------------------------------------- placement */

  /* tablet: the note and the box share a row, as on desktop */
  @media (min-width: 768px) and (max-width: 1099.98px) {
    .p-note {
      grid-column: 1 / span 2;
      align-self: start;
      margin-top: 64px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    /* its left edge continues the milestone text column */
    .p-bring {
      grid-column: 3 / -1;
      margin-top: 64px;
    }
  }

  @media (min-width: 1100px) {
    .p-label {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .p-h2 {
