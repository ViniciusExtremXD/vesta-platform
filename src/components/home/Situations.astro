---
import { situations } from '../../data/site';
---

<section class="situ section on-void" id="situations">
  <div class="wrap wrap-wide">
    <div class="section-head">
      <p class="kicker" data-reveal="up">{situations.kicker}</p>
      <h2 data-split set:html={situations.title} />
    </div>

    <ul class="situ-grid">
      {
        situations.items.map((s, i) => (
          <li data-reveal="up" style={`--i:${i + 1}`}>
            <article class="card situ-card" data-tilt="5" data-glow>
              <span class="situ-index mono">{s.index}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .situ-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .situ-card {
    height: 100%;
    gap: var(--space-s);
    background: linear-gradient(160deg, var(--card-2), var(--card) 60%);
  }

  .situ-index {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--violet-ink-dark);
  }

  .situ-card h3 {
    font-size: var(--step-2);
    letter-spacing: var(--tracking-snug);
    text-wrap: balance;
  }

  .situ-card p {
    color: var(--text-dark-muted);
  }
</style>
