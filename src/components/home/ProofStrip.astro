---
/**
 * The proof strip. Every figure here is a fact about the offer or about this
 * page — not a claim about clients. Client numbers live in case studies,
 * and only once they are measured and authorised.
 */
type Item = { count: number; prefix?: string; suffix?: string; label: string } | { text: string; label: string };

const items: Item[] = [
  { count: 1500, prefix: '$', label: 'Fixed public price for a campaign landing page' },
  { text: '7–10', label: 'Business days to ship it, measured before launch' },
  { text: '1–2 h', label: 'Ahead of New York — same business day, every day' },
  { count: 100, suffix: '%', label: 'Code ownership, delivered to your own accounts' },
];
---

<section class="proof on-void-2" aria-label="Facts about the offer">
  <div class="wrap wrap-wide">
    <ul class="proof-list">
      {
        items.map((it, i) => (
          <li data-reveal="up" style={`--i:${i}`}>
            <span class="proof-value display">
              {'count' in it ? (
                <span data-count={it.count} data-count-prefix={it.prefix ?? ''} data-count-suffix={it.suffix ?? ''}>
                  {it.prefix ?? ''}
                  {it.count.toLocaleString('en-US')}
                  {it.suffix ?? ''}
                </span>
              ) : (
                it.text
              )}
            </span>
            <span class="proof-label">{it.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    border-block: 1px solid var(--line-dark);
    padding-block: var(--space-l);
  }

  .proof-list {
    display: grid;
    gap: var(--space-m) var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .proof-list li {
    display: grid;
    gap: 0.35rem;
    padding-left: var(--space-s);
    border-left: 1px solid var(--line-dark-strong);
  }

  .proof-value {
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-dark);
  }

  .proof-label {
    font-size: var(--step--1);
    color: var(--text-dark-muted);
    max-width: 24ch;
  }
</style>
