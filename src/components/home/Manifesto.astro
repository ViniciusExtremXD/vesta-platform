---
import { manifesto } from '../../data/site';
import Icon from '../Icon.astro';
---

<section class="man section on-paper" id="why">
  <div class="wrap wrap-wide">
    <div class="man-head">
      <p class="kicker" data-reveal="up">{manifesto.kicker}</p>
      <h2 class="man-title" data-split set:html={manifesto.title} />
    </div>

    <div class="man-grid">
      <div class="man-copy">
        {manifesto.paragraphs.map((p, i) => <p class="lead" data-reveal="up" style={`--i:${i + 1}`}>{p}</p>)}

        <div class="man-check" data-reveal="up" style="--i:3">
          <p class="kicker">Do this now</p>
          <h3>{manifesto.check.title}</h3>
          <p>{manifesto.check.body}</p>
          <a class="btn btn-ink" href={manifesto.check.url} target="_blank" rel="noopener" data-magnetic="0.2">
            {manifesto.check.label}
            <Icon name="external" class="arrow" />
          </a>
        </div>
      </div>

      <ol class="ledger" aria-label="Published research on page speed">
        {
          manifesto.research.map((r, i) => (
            <li class="ledger-row" data-reveal="left" style={`--i:${i + 1}`}>
              <span class="ledger-value display">{r.value}</span>
              <div class="ledger-body">
                <p>{r.text}</p>
                <a class="ledger-src mono" href={r.url} target="_blank" rel="noopener">
                  {r.source}, {r.year}
                  <Icon name="external" size={11} />
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="compare">
      <h3 class="compare-title" data-reveal="up">{manifesto.comparison.title}</h3>

      <div class="compare-table" role="table" aria-label="How Vesta differs from the usual agency pattern">
        <div class="compare-row compare-head" role="row" data-reveal="fade">
          <span role="columnheader" class="mono"></span>
          <span role="columnheader" class="mono">{manifesto.comparison.usualLabel}</span>
          <span role="columnheader" class="mono is-vesta">{manifesto.comparison.vestaLabel}</span>
        </div>
        {
          manifesto.comparison.rows.map((row, i) => (
            <div class="compare-row" role="row" data-reveal="fade" style={`--i:${i + 1}`}>
              <span role="rowheader" class="compare-dim">{row.dimension}</span>
              <span role="cell" class="compare-usual">
                <span class="compare-cell-label mono" aria-hidden="true">{manifesto.comparison.usualLabel}</span>
                {row.usual}
              </span>
              <span role="cell" class="compare-vesta">
                <span class="compare-cell-label mono" aria-hidden="true">{manifesto.comparison.vestaLabel}</span>
                {row.vesta}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .man {
    border-block: 1px solid var(--line);
  }

  .man-head {
    max-width: 60rem;
    margin-bottom: clamp(2.5rem, 1.6rem + 4vw, 5rem);
  }

  .man-head > * + * {
    margin-top: var(--space-m);
  }

  .man-title {
    font-size: var(--step-6);
    max-width: 16ch;
  }

  .man-grid {
    display: grid;
    gap: var(--space-2xl) var(--space-3xl);
    align-items: start;
    margin-bottom: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .man-copy > * + * {
    margin-top: var(--space-m);
  }

  .man-copy .lead {
    color: var(--ink-muted);
    max-width: 48ch;
  }

  .man-check {
    margin-top: var(--space-xl);
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--violet);
    background: var(--paper-2);
  }

  .man-check > * + * {
    margin-top: var(--space-s);
  }

  .man-check h3 {
    font-size: var(--step-2);
  }

  .man-check p:not(.kicker) {
    color: var(--ink-muted);
  }

  /* ---- the ledger ---- */

  .ledger {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) 1fr;
    gap: var(--space-s) var(--space-m);
    align-items: start;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line-strong);
  }

  .ledger-value {
    font-size: var(--step-5);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .ledger-body p {
    font-size: var(--step-0);
    color: var(--ink);
    max-width: 34ch;
  }

  .ledger-src {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.5rem;
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .ledger-src:hover {
    color: var(--violet-ink);
    border-color: currentColor;
  }

  /* ---- the comparison ---- */

  .compare-title {
    font-size: var(--step-3);
    max-width: 30ch;
    margin-bottom: var(--space-l);
  }

  .compare-table {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .compare-row {
    display: grid;
    gap: 0.5rem var(--space-l);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--line-strong);
  }

  .compare-head {
    display: none;
    padding-block: var(--space-xs);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .compare-head .is-vesta {
    color: var(--violet-ink);
  }

  .compare-dim {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  .compare-usual {
    color: var(--ink-muted);
  }

  .compare-vesta {
    color: var(--ink);
    font-weight: 500;
  }

  .compare-cell-label {
    display: block;
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.15rem;
  }

  .compare-vesta .compare-cell-label {
    color: var(--violet-ink);
  }

  @media (min-width: 56rem) {
    .man-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }

    .compare-head {
      display: grid;
    }

    .compare-row {
      grid-template-columns: 9rem 1fr 1fr;
    }

    .compare-cell-label {
      display: none;
    }
  }
</style>
