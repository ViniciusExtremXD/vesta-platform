---
/**
 * Site navigation (SPEC §4 Nav, Mobile menu; §3.5 hover; §3.7 nav behaviour;
 * SPEC_COSMOS §5 orbit progress; ROUND2 §1, §5; ROUND3 brand).
 *
 * Desktop >=1100 (76px): owner's logo | orbit · Services Pricing Process
 * About · Email (hairline) + WhatsApp (violet). Tablet 768-1099: logo ·
 * Email · WhatsApp · Menu. Mobile (60px): logo · two 40px icon buttons · Menu.
 *
 * ALWAYS DARK: the owner's logo is white + violet on transparent, so the bar
 * is transparent only at the top of a dark section and solid void (with a
 * hairline) everywhere else, including over paper sections. There is no
 * light theme; the engine's data-theme="light" only forces the solid bar.
 *
 * The engine (motion.ts) owns the scroll states on [data-nav]: .is-solid after
 * 12px, .is-hidden on the way down past 60vh, data-theme from the
 * [data-nav-theme] section underneath. This file runs, inside the shared
 * rAF loop:
 *   - the orbit progress planet — a small separate mark beside the logo,
 *     never drawn over the artwork — with a short fading trail whose length
 *     follows the scroll speed (one full lap on load and on logo hover);
 *   - the active bar: an elastic underline on two springs (the leading edge
 *     runs ahead, the trailing edge catches up) that leans toward the pointer;
 *   - letter-roll labels on the links and buttons (CSS, hover/focus only);
 *     magnetic Email / WhatsApp buttons whose contents travel further (depth);
 *   - the full-screen menu: an iris opening from the Menu button, the list
 *     plane swinging up out of depth while each word flips up on its
 *     baseline, one after another, and a planet circling the big orbit.
 *
 * Progress: the orbit planet replaces the 2px [data-progress] line from
 * Base.astro, which is hidden below (one indicator, not two).
 */
import { nav, navUi, mobileMenu, primaryCta, contact, mail } from '../data/site';
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Cosmos from './Cosmos.astro';
import WaGlyph from './ui/WaGlyph.astro';
import MailGlyph from './ui/MailGlyph.astro';
import Arrow from './ui/Arrow.astro';

const path = Astro.url.pathname;
/** Page links only; home-section anchors are tracked live by the script. */
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  const full = url(href);
  return path === full || (href !== '/' && path.startsWith(full));
};

/** Letters for the roll: each one carries its twin in ::after (data-c). */
const letters = (s: string) => Array.from(s);
const mailHref = mail();
const linkedinLabel = mobileMenu.linkedin.label.replace(/\s*↗\s*$/, '');

/* The orbit progress indicator: a small separate mark beside the owner's
   logo (never drawn over the artwork). Geometry in px = viewBox units. */
const OW = 30;
const OH = 20;
const ORX = 12.5;
const ORY = 4.6;
---

<header class="nav" data-nav data-theme="dark">
  <div class="nav-in wrap">
    <a class="nav-home" href={url('/')} aria-label={navUi.homeAria} data-nav-home>
      <span class="nav-logo">
        <Logo eager alt="" height={36} />
      </span>
      <span class="nav-sep" aria-hidden="true"></span>
      <svg
        class="nav-orbit"
        width={OW}
        height={OH}
        viewBox={`0 0 ${OW} ${OH}`}
        aria-hidden="true"
        focusable="false"
        data-orbit-mark
        data-rx={ORX}
        data-ry={ORY}
      >
        <g transform={`rotate(-24 ${OW / 2} ${OH / 2})`}>
          <ellipse class="nav-orbit-path" cx={OW / 2} cy={OH / 2} rx={ORX} ry={ORY}></ellipse>
          <circle class="nav-orbit-hearth" cx={OW / 2} cy={OH / 2} r="1.1"></circle>
          {
            [1, 2, 3, 4, 5].map((k) => (
              <circle
                class="nav-orbit-dot"
                cx="0"
                cy="0"
                r={(2.3 * (1 - k * 0.14)).toFixed(2)}
                style={`transform: translate(${OW / 2 + ORX}px, ${OH / 2}px); opacity: 0`}
                data-orbit-trail={k}
              />
            ))
          }
          <circle
            class="nav-orbit-dot"
            cx="0"
            cy="0"
            r="2.3"
            style={`transform: translate(${OW / 2 + ORX}px, ${OH / 2}px)`}
            data-orbit-planet></circle>
        </g>
      </svg>
    </a>

    <nav class="nav-primary" aria-label="Primary">
      <ul class="nav-links">
        {
          nav.map((item, n) => (
            <li style={`--n:${n}`}>
              <a
                class="nav-link"
                href={url(item.href)}
                data-section={item.section ?? undefined}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="nav-label label roll" aria-hidden="true">
                  {letters(item.label).map((c, i) => (
                    <span class="rc" style={`--c:${i}`} data-c={c}>
                      {c}
                    </span>
                  ))}
                </span>
                <span class="visually-hidden">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-bar" data-nav-bar aria-hidden="true"></span>
    </nav>

    <div class="nav-actions">
      <a class="btn btn-sm btn-line nav-btn nav-mail" href={mailHref} aria-label={navUi.emailAria} data-magnetic=".3">
        <span class="nav-btn-in">
          <MailGlyph size={16} />
          <span class="nav-btn-text roll" aria-hidden="true">
            {
              letters(navUi.email).map((c, i) => (
                <span class="rc" style={`--c:${i}`} data-c={c}>
                  {c}
                </span>
              ))
            }
          </span>
        </span>
      </a>

      <a
        class="btn btn-sm nav-btn nav-wa"
        href={primaryCta.href}
        target="_blank"
        rel="noopener"
        aria-label={navUi.whatsappAria}
        data-wa-intent="nav"
        data-magnetic=".3"
      >
        <span class="nav-btn-in">
          <WaGlyph size={16} />
          <span class="nav-btn-text roll" aria-hidden="true">
            {
              letters(navUi.whatsapp).map((c, i) => (
                <span class="rc" style={`--c:${i}`} data-c={c}>
                  {c}
                </span>
              ))
            }
          </span>
        </span>
      </a>

      <button class="nav-menu label" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="nav-menu-mask">
          <span class="nav-menu-a" data-menu-open-label>{navUi.menu}</span>
          <span class="nav-menu-b" data-menu-close-label aria-hidden="true">{navUi.close}</span>
        </span>
      </button>
    </div>
  </div>

  <div class="menu" id="site-menu" data-menu inert>
    <div class="menu-bg" aria-hidden="true" data-menu-bg>
      <Cosmos variant="stars" class="menu-cosmos" />
      <svg class="menu-orbit" viewBox="0 0 640 640" focusable="false">
        <ellipse class="menu-orbit-path" cx="320" cy="320" rx="312" ry="116"></ellipse>
        <ellipse class="menu-orbit-path is-inner" cx="320" cy="320" rx="200" ry="74"></ellipse>
        <circle class="menu-orbit-hearth" cx="320" cy="320" r="2.5"></circle>
        {
          [4, 3, 2, 1].map((k) => (
            <circle
              class="menu-orbit-trail"
              cx="0"
              cy="0"
              r={(5 * (1 - k * 0.16)).toFixed(2)}
              style={`transform: translate(164px, 420.5px); opacity: ${(0.5 - k * 0.1).toFixed(2)}`}
              data-menu-trail={k}
            />
          ))
        }
        <circle class="menu-orbit-planet" cx="0" cy="0" r="5" style="transform: translate(164px, 420.5px)" data-menu-planet></circle>
      </svg>
    </div>

    <div class="menu-in wrap">
      <nav class="menu-nav" aria-label="Menu">
        <ul class="menu-list">
          {
            mobileMenu.links.map((l, i) => (
              <li class="menu-item" style={`--i:${i}`}>
                <a class="menu-link" href={url(l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  <span class="menu-idx-mask" aria-hidden="true">
                    <span class="menu-idx label num">{l.index}</span>
                  </span>
                  <span class="menu-mask">
                    <span class="menu-txt">{l.label}</span>
                  </span>
                  <span class="menu-arrow" aria-hidden="true">
                    <Arrow size={16} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="menu-foot">
        <div class="menu-ctas">
          <a class="btn menu-cta" href={mobileMenu.cta.href} target="_blank" rel="noopener" data-wa-intent="menu">
            <WaGlyph size={16} />
            <span>{mobileMenu.cta.label}</span>
            <Arrow />
          </a>
          <a class="btn btn-line menu-mail" href={mailHref}>
            <MailGlyph size={16} />
            <span class="menu-mail-addr">{contact.email.address}</span>
            <Arrow />
          </a>
        </div>
        <div class="menu-meta">
          <a class="tlink menu-li" href={mobileMenu.linkedin.href} target="_blank" rel="noopener">
            {linkedinLabel}
            <Arrow dir="up-right" size={12} />
          </a>
          <p class="menu-hours small">{mobileMenu.hours}</p>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* One indicator: the orbit planet beside the wordmark replaces the 2px
     progress line that Base.astro renders. */
  :global(.progress[data-progress]) {
    display: none;
  }

  /* ------------------------------------------------------------ the bar */

  .nav {
    --fg: var(--starlight);
    --fg-2: var(--haze);
    --fg-3: var(--dim);
    --line: var(--line-dark);
    --line-strong: var(--line-dark-strong);
    --nav-bg: var(--void);
    --bar: var(--lilac);

    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    color: var(--fg);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      transform 480ms var(--ease-expo),
      background-color 240ms linear,
      border-color 240ms linear,
      color 240ms linear;
  }

  /* The owner's logo is white + violet: the bar is ALWAYS dark. It is
     transparent only at the very top of a dark section (the hero); once the
     page scrolls, or whenever a paper section sits underneath (the engine
     still reports data-theme="light"), it is solid void with a hairline.
     There is no light theme. */
  .nav.is-solid,
  .nav[data-theme='light'] {
    background-color: var(--void);
    border-bottom-color: var(--line-dark);
  }

  .nav.is-hidden {
    transform: translate3d(0, -100%, 0);
    transition-duration: 380ms, 240ms, 240ms, 240ms;
    transition-timing-function: var(--ease-quint), linear, linear, linear;
  }

  /* a keyboard user tabbing into a hidden bar gets it back */
  .nav:focus-within {
    transform: none;
  }

  /* open menu: the bar joins the void sheet, above it */
  :global(html.menu-open) .nav {
    --fg: var(--starlight);
    --fg-2: var(--haze);
    --fg-3: var(--dim);
    --line: var(--line-dark);
    --line-strong: var(--line-dark-strong);
    --bar: var(--lilac);
    z-index: var(--z-menu);
    transform: none;
    background-color: var(--void);
    border-bottom-color: var(--line-dark);
  }

  .nav-in {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-12);
    height: 100%;
  }

  .nav-home {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex: 0 0 auto;
    min-height: 44px;
    color: var(--fg);
    text-decoration: none;
  }

  /* the owner's lockup: 30px tall on phones, 36px from tablet up. It lifts
     a little toward the viewer on hover (the orbit beside it runs a lap). */
  .nav-logo {
    display: block;
    perspective: 600px;
  }

  .nav-logo :global(.brand-logo) {
    height: 30px;
    transform-origin: 30% 50%;
    transition: transform 900ms var(--ease-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-home:hover .nav-logo :global(.brand-logo) {
      transform: translate3d(0, -1px, 24px) rotateY(-10deg);
    }
  }

  /* hairline between the artwork and the progress orbit */
  .nav-sep {
    width: 1px;
    height: 18px;
    background-color: var(--line-dark-strong);
    transform-origin: 50% 50%;
  }

  .nav-orbit {
    flex: 0 0 auto;
    overflow: visible;
  }

  .nav-orbit-path {
    fill: none;
    stroke: var(--haze);
    stroke-width: 1;
    stroke-opacity: 0.7;
  }

  .nav-orbit-hearth {
    fill: var(--haze);
  }

  .nav-orbit-dot {
    fill: var(--lilac);
    transform-origin: 0 0;
  }

  /* phones under 360: the lockup and the actions need the room */
  @media (max-width: 359px) {
    .nav-sep,
    .nav-orbit {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .nav-home {
      gap: 16px;
    }

    .nav-logo :global(.brand-logo) {
      height: 36px;
    }
  }

  /* --------------------------------------------------- the letter roll */
  /* Each letter carries its twin one line below (::after). On hover or
     keyboard focus the pair rolls up, one letter after the next. */

  .roll {
    display: inline-flex;
    overflow: clip;
    padding-block: 0.3em;
    margin-block: -0.3em;
  }

  .rc {
    position: relative;
    display: inline-block;
    white-space: pre;
    transition: transform 620ms var(--ease-expo);
    transition-delay: calc(var(--c, 0) * 22ms);
  }

  .rc::after {
    content: attr(data-c);
    position: absolute;
    left: 0;
    top: calc(100% + 0.3em);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover .rc,
    .nav-btn:hover .rc {
      transform: translate3d(0, calc(-100% - 0.3em), 0);
    }
  }

  .nav-link:focus-visible .rc,
  .nav-btn:focus-visible .rc {
    transform: translate3d(0, calc(-100% - 0.3em), 0);
  }

  /* ------------------------------------------------------ desktop links */

  .nav-primary {
    position: relative;
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    height: var(--nav-h);
    padding-inline: 18px;
    color: var(--fg-2);
    text-decoration: none;
    transition: color var(--t-micro) linear;
  }

  .nav-links li:first-child .nav-link {
    padding-inline-start: 0;
  }

  .nav-link.is-active,
  .nav-link[aria-current='page'] {
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--fg);
    }
  }

  .nav-link:focus-visible {
    color: var(--fg);
    outline-offset: -6px;
  }

  /* the one shared active bar: 100px wide; the script places and stretches
     it every frame on two springs (transform only) */
  .nav-bar {
    position: absolute;
    left: 0;
    top: calc(50% + 13px);
    width: 100px;
    height: 2px;
    background-color: var(--bar);
    transform-origin: left center;
    transform: scaleX(0);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 260ms linear,
      background-color 240ms linear;
  }

  .nav-bar.is-on {
    opacity: 1;
  }

  /* ------------------------------------------------------------ actions */

  .nav-actions {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 8px;
  }

  .nav-btn {
    width: 40px;
    min-height: 40px;
    padding: 0;
    /* magnetic (global [data-magnetic]) replaces .btn's transition; keep
       the fill fade alongside the pull */
    transition:
      transform 520ms var(--ease-expo),
      background-color var(--t-micro) linear,
      border-color var(--t-micro) linear;
  }

  .nav-btn:global(.is-pulling) {
    transition-duration: 160ms, var(--t-micro), var(--t-micro);
  }

  /* the contents travel half again as far as the button: depth */
  .nav-btn-in {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transform: translate3d(calc(var(--mag-x, 0px) * 0.5), calc(var(--mag-y, 0px) * 0.5), 0);
    transition: transform 520ms var(--ease-expo);
  }

  .nav-btn:global(.is-pulling) .nav-btn-in {
    transition-duration: 200ms;
  }

  .nav-btn-text {
    display: none;
  }

  .nav-mail {
    min-height: 40px;
  }

  .nav-menu {
    display: inline-flex;
    align-items: center;
    height: 44px;
    margin-inline-start: 6px;
    padding-inline: 4px 0;
    color: var(--fg);
    transition: color 240ms linear;
  }

  /* Menu / Close swap: two words in one clipped line */
  .nav-menu-mask {
    display: grid;
    overflow: clip;
    margin-inline-end: -0.18em;
  }

  .nav-menu-a,
  .nav-menu-b {
    grid-area: 1 / 1;
    transition:
      transform 520ms var(--ease-expo),
      opacity 200ms linear;
  }

  /* the parked label is also visibility:hidden once it has left, so it is
     never invisible text sitting in the page */
  .nav-menu-b {
    transform: translate3d(0, 110%, 0);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 520ms var(--ease-expo),
      opacity 200ms linear,
      visibility 0s linear 520ms;
  }

  .nav.is-open .nav-menu-a {
    transform: translate3d(0, -110%, 0);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 520ms var(--ease-expo),
      opacity 200ms linear,
      visibility 0s linear 520ms;
  }

  .nav.is-open .nav-menu-b {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (max-width: 359px) {
    .nav-actions {
      gap: 6px;
    }

    .nav-menu {
      margin-inline-start: 2px;
    }
  }

  @media (min-width: 768px) {
    .nav-actions {
      gap: 12px;
    }

    .nav-btn {
      width: auto;
      padding: 0 18px 0 16px;
    }

    .nav-btn-text {
      display: inline-flex;
    }

    .nav-menu {
      margin-inline-start: 12px;
    }
  }

  @media (min-width: 1100px) {
    .nav-in {
      display: grid;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .nav-home {
      grid-column: 1 / span 3;
      justify-self: start;
    }

    .nav-primary {
      display: block;
      grid-column: 5 / span 5;
    }

    .nav-actions {
      grid-column: 10 / -1;
      justify-self: end;
    }

    .nav-menu {
      display: none;
    }
  }

  /* ------------------------------------------------------ load entrance */
  /* The bar settles in after the page head starts: wordmark, links one by
     one, then the two buttons. Fill mode "backwards" only, so the magnetic
     transform owns the buttons once the entrance has played. */

  @keyframes nav-drop {
    from {
      opacity: 0;
      transform: translate3d(0, -16px, 0);
    }
  }

  :global(html:not(.motion-reduced)) .nav-home,
  :global(html:not(.motion-reduced)) .nav-links > li,
  :global(html:not(.motion-reduced)) .nav-actions > * {
    animation: nav-drop 1000ms var(--ease-expo) backwards;
  }

  :global(html:not(.motion-reduced)) .nav-home {
    animation-delay: 80ms;
  }

  /* the artwork wipes on from the V, the hairline draws, the orbit swings in */
  @keyframes nav-logo-wipe {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translate3d(-10px, 0, 0);
    }
  }

  @keyframes nav-sep-draw {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes nav-orbit-in {
    from {
      opacity: 0;
      transform: rotate(-120deg) scale(0.4);
    }
  }

  :global(html:not(.motion-reduced)) .nav-logo {
    animation: nav-logo-wipe 1400ms var(--ease-expo) 160ms backwards;
  }

  :global(html:not(.motion-reduced)) .nav-sep {
    animation: nav-sep-draw 700ms var(--ease-expo) 620ms backwards;
  }

  :global(html:not(.motion-reduced)) .nav-orbit {
    animation: nav-orbit-in 1300ms var(--ease-expo) 700ms backwards;
  }

  :global(html:not(.motion-reduced)) .nav-links > li {
    animation-delay: calc(200ms + var(--n, 0) * 70ms);
  }

  :global(html:not(.motion-reduced)) .nav-actions > .nav-mail {
    animation-delay: 420ms;
  }

  :global(html:not(.motion-reduced)) .nav-actions > .nav-wa {
    animation-delay: 500ms;
  }

  :global(html:not(.motion-reduced)) .nav-actions > .nav-menu {
    animation-delay: 580ms;
  }

  /* -------------------------------------------------------- mobile menu */

  .menu {
    --fg: var(--starlight);
    --fg-2: var(--haze);
    --fg-3: var(--dim);
    --line: var(--line-dark);
    --line-strong: var(--line-dark-strong);

    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-top: var(--nav-h);
    overflow-x: clip;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--starlight);
    background-color: transparent;
    visibility: hidden;
    transition:
      visibility 0s linear 760ms,
      background-color 0s linear 0s;
  }

  /* The void layer opens as an iris from the Menu button (the script sets
     --mx/--my to the button's centre) and closes back into it. While closed
     it is parked above the viewport, so the star field inside it pauses. */
  .menu-bg {
    --mx: calc(100% - 44px);
    --my: 30px;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--void);
    clip-path: circle(0% at var(--mx) var(--my));
    transform: translate3d(0, calc(-100% - 200px), 0);
    transition:
      clip-path 620ms var(--ease-quint) 140ms,
      transform 0s linear 780ms;
  }

  .nav.is-open .menu {
    visibility: visible;
    /* opaque once the iris has landed, so text always sits on void */
    background-color: var(--void);
    transition:
      visibility 0s linear 0s,
      background-color 0s linear 620ms;
  }

  .nav.is-open .menu-bg {
    clip-path: circle(145% at var(--mx) var(--my));
    transform: none;
    transition:
      clip-path 1000ms var(--ease-expo) 0ms,
      transform 0s linear 0s;
  }

  /* the star field, a touch brighter than a section backdrop: the sheet is
     mostly empty sky */
  .menu-bg :global(.menu-cosmos) {
    opacity: 0.8;
  }

  /* a large tilted orbit, low right, swinging into its −24° rest on open */
  .menu-orbit {
    position: absolute;
    right: -70%;
    bottom: 8%;
    width: 150%;
    max-width: 980px;
    height: auto;
    overflow: visible;
    transform: rotate(-44deg) scale(0.8);
    opacity: 0;
    transition:
      transform 300ms var(--ease-quint),
      opacity 200ms linear;
  }

  .nav.is-open .menu-orbit {
    transform: rotate(-24deg);
    opacity: 1;
    transition:
      transform 2000ms var(--ease-expo) 160ms,
      opacity 900ms linear 160ms;
  }

  .menu-orbit-path {
    fill: none;
    stroke: var(--line-dark);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .menu-orbit-path.is-inner {
    stroke: rgb(243 240 250 / 0.08);
  }

  .menu-orbit-hearth {
    fill: var(--haze);
  }

  .menu-orbit-planet,
  .menu-orbit-trail {
    fill: var(--lilac);
    transform-origin: 0 0;
  }

  .menu-in {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-48);
    flex: 1 0 auto;
    padding-block: var(--s-16) calc(var(--s-24) + env(safe-area-inset-bottom));
  }

  /* The list is one plane in depth: closed, it lies tilted back and far
     away (rotateX + rotateY + translateZ); on open it swings up to face the
     visitor while each word flips up on its own baseline, one after another. */
  .menu-nav {
    perspective: 1100px;
    perspective-origin: 20% 0%;
  }

  .menu-list {
    margin: 0;
    border-top: 1px solid transparent;
    transform-origin: 0% 0%;
    transform-style: preserve-3d;
    transform: translate3d(0, 80px, -320px) rotateX(38deg) rotateY(-20deg);
    transition: transform 320ms var(--ease-quint);
  }

  .nav.is-open .menu-list {
    transform: none;
    transition: transform 1700ms var(--ease-expo) 140ms;
  }

  .menu-item {
    position: relative;
  }

  /* row hairline, drawn from the left */
  .menu-item::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background-color: var(--line-dark);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 300ms var(--ease-quint);
  }

  .menu-link {
    display: flex;
    align-items: baseline;
    gap: var(--s-16);
    padding-block: 16px 14px;
    color: var(--starlight);
    text-decoration: none;
  }

  .menu-idx-mask {
    flex: 0 0 2.5rem;
    display: block;
    perspective: 400px;
  }

  .menu-idx {
    display: block;
    color: var(--dim);
    transform-origin: 50% 0;
    transition:
      transform var(--t-ui) var(--ease-expo),
      color var(--t-micro) linear,
      opacity 200ms linear;
  }

  .menu-link[aria-current='page'] .menu-idx {
    color: var(--lilac);
  }

  /* each word hinges on its baseline and swings up out of the floor */
  .menu-mask {
    display: block;
    flex: 1 1 auto;
    perspective: 760px;
    perspective-origin: 30% 100%;
  }

  .menu-txt {
    display: block;
    font-stretch: var(--wd-display);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    transform-origin: 50% 100%;
    backface-visibility: hidden;
    transition:
      transform 380ms var(--ease-quint),
      opacity 200ms linear;
  }

  .menu-arrow {
    flex: 0 0 auto;
    align-self: center;
    color: var(--dim);
    opacity: 0;
    transform: translate3d(-12px, 0, 0);
    transition:
      transform var(--t-ui) var(--ease-expo),
      opacity 200ms linear,
      color var(--t-micro) linear;
  }

  /* closed: words lie flat below the line, indices hang above theirs (the
     sheet is visibility:hidden, so nothing is ever on screen in this state) */
  .menu .menu-txt {
    transform: translate3d(0, 60%, -140px) rotateX(-104deg);
    opacity: 0;
  }

  .menu .menu-idx {
    transform: translate3d(0, -30%, 0) rotateX(95deg);
    opacity: 0;
  }

  .nav.is-open .menu-txt {
    transform: none;
    opacity: 1;
    transition:
      transform 1300ms var(--ease-expo),
      opacity 420ms linear;
    transition-delay: calc(240ms + var(--i, 0) * 85ms);
  }

  .nav.is-open .menu-idx {
    transform: none;
    opacity: 1;
    transition:
      transform 1100ms var(--ease-expo),
      color var(--t-micro) linear,
      opacity 300ms linear;
    transition-delay: calc(360ms + var(--i, 0) * 85ms), 0ms, calc(360ms + var(--i, 0) * 85ms);
  }

  .nav.is-open .menu-arrow {
    opacity: 1;
    transform: none;
    transition:
      transform 900ms var(--ease-expo),
      opacity 300ms linear,
      color var(--t-micro) linear;
    transition-delay: calc(520ms + var(--i, 0) * 85ms), calc(520ms + var(--i, 0) * 85ms), 0ms;
  }

  .nav.is-open .menu-item::after {
    transform: scaleX(1);
    transition: transform var(--t-line) var(--ease-quint);
    transition-delay: calc(160ms + var(--i, 0) * 85ms);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu-link:hover .menu-idx {
      transform: translateX(4px);
      color: var(--haze);
      transition-delay: 0ms;
    }

    .menu-link:hover .menu-arrow {
      color: var(--starlight);
      transform: translateX(4px);
      transition-delay: 0ms;
    }
  }

  .menu-link:focus-visible {
    outline-offset: -2px;
  }

  .menu-link:focus-visible .menu-idx {
    transform: translateX(4px);
    transition-delay: 0ms;
  }

  .menu-foot {
    display: grid;
    gap: var(--s-24);
    transition:
      transform 240ms var(--ease-quint),
      opacity 200ms linear;
    transform: translate3d(0, 24px, 0);
    opacity: 0;
  }

  .nav.is-open .menu-foot {
    transform: none;
    opacity: 1;
    transition:
      transform 1100ms var(--ease-expo) 640ms,
      opacity 500ms linear 640ms;
  }

  .menu-ctas {
    display: grid;
    gap: 12px;
  }

  .menu-cta,
  .menu-mail {
    width: 100%;
    justify-content: flex-start;
  }

  .menu-mail {
    min-height: 52px;
    letter-spacing: 0.02em;
  }

  .menu-cta :global(.arrow),
  .menu-mail :global(.arrow) {
    margin-inline-start: auto;
  }

  .menu-mail-addr {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-8) var(--s-24);
  }

  /* the hours line sits on void (the sheet is opaque behind it) */
  .menu-hours {
    color: var(--haze);
    background-color: var(--void);
  }

  @media (min-width: 768px) {
    .menu-in {
      padding-block: var(--s-48) calc(var(--s-48) + env(safe-area-inset-bottom));
    }

    .menu-txt {
      font-size: clamp(3rem, 1.4rem + 3.4vw, 4rem);
    }

    .menu-link {
      gap: var(--s-24);
      padding-block: 20px 18px;
    }

    .menu-idx-mask {
      flex-basis: 4rem;
    }

    .menu-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .menu-cta,
    .menu-mail {
      width: auto;
    }

    .menu-mail {
      min-height: 56px;
    }

    .menu-cta :global(.arrow),
    .menu-mail :global(.arrow) {
      margin-inline-start: 0;
    }

    .menu-meta {
      justify-content: flex-start;
    }

    .menu-orbit {
      right: -30%;
      bottom: -12%;
      width: 100%;
    }
  }

  @media (min-width: 1100px) {
    .menu {
      display: none;
    }
  }

  /* -------------------------------------------------------- motion off */

  :global(html.motion-reduced) .nav,
  :global(html.motion-reduced) .nav-bar,
  :global(html.motion-reduced) .nav-btn-in,
  :global(html.motion-reduced) .rc,
  :global(html.motion-reduced) .nav-menu-a,
  :global(html.motion-reduced) .nav-menu-b,
  :global(html.motion-reduced) .menu,
  :global(html.motion-reduced) .menu-bg,
  :global(html.motion-reduced) .menu-orbit,
  :global(html.motion-reduced) .menu-txt,
  :global(html.motion-reduced) .menu-list,
  :global(html.motion-reduced) .nav-logo :global(.brand-logo),
  :global(html.motion-reduced) .menu-idx,
  :global(html.motion-reduced) .menu-arrow,
  :global(html.motion-reduced) .menu-item::after,
  :global(html.motion-reduced) .menu-foot {
    transition: none !important;
  }
</style>

<script>
  import { addFrame, requestFrame, isReduced } from '../scripts/motion';

  const root = document.documentElement;
  const TAU = Math.PI * 2;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    initOrbit(nav);
    initBar(nav);
    initMenu(nav);
  }

  /* ------------------------------------------------------------------ */
  /* the orbit progress planet beside the wordmark, with its trail      */
  /* ------------------------------------------------------------------ */

  function initOrbit(nav: HTMLElement): void {
    const svg = nav.querySelector<SVGSVGElement>('[data-orbit-mark]');
    const planet = svg?.querySelector<SVGCircleElement>('[data-orbit-planet]');
    if (!svg || !planet) return;
    const trail = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-orbit-trail]'));
    const vb = svg.viewBox.baseVal;
    const cx = vb.width / 2;
    const cy = vb.height / 2;
    const rx = Number(svg.dataset.rx) || 12.5;
    const ry = Number(svg.dataset.ry) || 4.6;

    let target = 0;
    let shown = -1;
    let lastTh: number | null = null;
    let speed = 0;
    /** one extra lap on load and on hover: start time, or 0 when idle */
    let spinAt = 0;
    const SPIN_MS = 1500;

    const pos = (th: number) => {
      // the far half of the orbit reads smaller, the near half larger
      const s = 1 + 0.2 * Math.sin(th);
      return `translate(${(cx + rx * Math.cos(th)).toFixed(2)}px, ${(cy + ry * Math.sin(th)).toFixed(2)}px) scale(${s.toFixed(3)})`;
    };

    /** −1 → 0 laps on an expo-out curve: fast start, long settle. */
    const spin = (now: number): number => {
      if (!spinAt) return 0;
      const t = Math.min(1, (now - spinAt) / SPIN_MS);
      if (t >= 1) {
        spinAt = 0;
        return 0;
      }
      return -Math.pow(2, -10 * t);
    };

    addFrame({
      read(y, vh) {
        const docH = root.scrollHeight - vh;
        target = docH > 0 ? Math.min(1, Math.max(0, y / docH)) : 0;
      },
      write() {
        const reduced = isReduced();
        if (shown < 0 || reduced) shown = target;
        else shown += (target - shown) * 0.2;
        if (Math.abs(target - shown) < 0.0004) shown = target;
        if (reduced) spinAt = 0;

        const th = -TAU * (shown + spin(performance.now()));
        const v = lastTh === null ? 0 : th - lastTh;
        lastTh = th;
        speed = speed * 0.55 + Math.abs(v) * 0.45;
        planet.style.transform = pos(th);

        // the trail: five dots behind the planet, spaced by its speed
        const moving = !reduced && speed > 0.0005;
        const gap = Math.min(0.26, speed * 6) * (v >= 0 ? -1 : 1);
        const alpha = Math.min(1, speed * 32);
        trail.forEach((dot, i) => {
          const k = i + 1;
          dot.style.transform = pos(th + gap * k);
          dot.style.opacity = moving ? (alpha * (1 - k / 6) * 0.85).toFixed(3) : '0';
        });

        // keep drawing while the planet eases, spins or the trail fades
        if (shown !== target || spinAt || moving) requestFrame();
      },
    });

    const lap = () => {
      if (isReduced() || spinAt) return;
      spinAt = performance.now();
      requestFrame();
    };
    // one lap as the page arrives, and one whenever the wordmark is hovered
    window.setTimeout(lap, 380);
    if (fine.matches) nav.querySelector('[data-nav-home]')?.addEventListener('pointerenter', lap);
  }

  /* ------------------------------------------------------------------ */
  /* the active bar: an elastic underline on two springs                */
  /* ------------------------------------------------------------------ */

  function initBar(nav: HTMLElement): void {
    const primary = nav.querySelector<HTMLElement>('.nav-primary');
    const bar = nav.querySelector<HTMLElement>('[data-nav-bar]');
    if (!primary || !bar) return;
    const links = Array.from(primary.querySelectorAll<HTMLAnchorElement>('a.nav-link'));
    if (!links.length) return;
    const labels = links.map((a) => a.querySelector<HTMLElement>('.nav-label') ?? a);
    const pageIndex = links.findIndex((a) => a.getAttribute('aria-current') === 'page');

    let geo: { x: number; w: number }[] = [];
    let measuredAt = -1;
    let visible = false;
    let sectionIndex = -1;
    let hoverIndex = -1;
    let activeClass = -2;
    let pointerX: number | null = null;

    // spring state: the two edges of the bar, in px from the nav's left
    let L = 0;
    let R = 0;
    let vL = 0;
    let vR = 0;
    let on = false;
    let last = 0;

    /** The home section a link points at, only when it's on this page. */
    const sectionOf = (a: HTMLAnchorElement): HTMLElement | null => {
      const id = a.dataset.section;
      if (!id || a.pathname !== location.pathname) return null;
      return document.getElementById(id);
    };

    const measure = () => {
      const base = primary.getBoundingClientRect();
      geo = labels.map((l) => {
        const r = l.getBoundingClientRect();
        // the tracking trails the last letter: keep the bar on the ink
        const trail = parseFloat(getComputedStyle(l).letterSpacing) || 0;
        return { x: r.left - base.left, w: Math.max(0, r.width - trail) };
      });
    };

    addFrame({
      read(_y, vh, vw) {
        visible = primary.offsetParent !== null;
        if (!visible) return;
        if (vw !== measuredAt || !geo.length) {
          measure();
          measuredAt = vw;
        }
        const probe = vh * 0.4;
        sectionIndex = -1;
        links.forEach((a, i) => {
          const s = sectionOf(a);
          if (!s) return;
          const r = s.getBoundingClientRect();
          if (r.top <= probe && r.bottom > probe) sectionIndex = i;
        });
      },
      write() {
        if (!visible) return;
        const active = sectionIndex >= 0 ? sectionIndex : pageIndex;
        if (active !== activeClass) {
          links.forEach((a, i) => a.classList.toggle('is-active', i === active));
          activeClass = active;
        }
        const t = hoverIndex >= 0 ? hoverIndex : active;
        const g = t >= 0 ? geo[t] : undefined;

        let tl: number;
        let tr: number;
        if (g) {
          tl = g.x;
          tr = g.x + g.w;
          // lean: the edge on the pointer's side reaches toward it
          if (t === hoverIndex && pointerX !== null) {
            const lean = Math.max(-12, Math.min(12, (pointerX - (g.x + g.w / 2)) * 0.16));
            if (lean < 0) tl += lean;
            else tr += lean;
          }
          if (!on) {
            // appear: grow out of the word's centre
            L = R = g.x + g.w / 2;
            vL = vR = 0;
            on = true;
            bar.classList.add('is-on');
          }
        } else {
          // no target: collapse to the middle and fade
          const mid = (L + R) / 2;
          tl = tr = mid;
          if (on) {
            on = false;
            bar.classList.remove('is-on');
          }
        }

        const now = performance.now();
        const dt = last ? Math.min(2, Math.max(0.5, (now - last) / 16.667)) : 1;
        last = now;

        if (isReduced()) {
          L = tl;
          R = tr;
          vL = vR = 0;
        } else {
          // the edge moving in the direction of travel is stiffer: it leads,
          // overshoots a touch, and the other edge stretches after it
          const dir = Math.sign(tl + tr - (L + R));
          const kL = dir < 0 ? 0.22 : 0.1;
          const kR = dir > 0 ? 0.22 : 0.1;
          const damp = Math.pow(0.56, dt);
          vL = (vL + (tl - L) * kL * dt) * damp;
          vR = (vR + (tr - R) * kR * dt) * damp;
          L += vL * dt;
          R += vR * dt;
          if (R < L) R = L;
        }

        const settled = Math.abs(tl - L) < 0.1 && Math.abs(tr - R) < 0.1 && Math.abs(vL) < 0.05 && Math.abs(vR) < 0.05;
        if (settled) {
          L = tl;
          R = tr;
          vL = vR = 0;
          last = 0;
        }
        bar.style.transform = `translate3d(${L.toFixed(2)}px,0,0) scaleX(${((R - L) / 100).toFixed(4)})`;
        if (!settled) requestFrame();
      },
    });

    const point = (i: number) => {
      hoverIndex = i;
      requestFrame();
    };
    if (fine.matches) {
      links.forEach((a, i) => a.addEventListener('pointerenter', () => point(i)));
      primary.addEventListener('pointermove', (e) => {
        pointerX = e.clientX - primary.getBoundingClientRect().left;
        requestFrame();
      });
      primary.addEventListener('pointerleave', () => {
        pointerX = null;
        point(-1);
      });
    }
    links.forEach((a, i) => {
      a.addEventListener('focus', () => point(i));
      a.addEventListener('blur', () => point(-1));
    });

    // web font swap changes the word widths
    document.fonts?.ready.then(() => {
      measuredAt = -1;
      requestFrame();
    });
  }

  /* ------------------------------------------------------------------ */
  /* the mobile menu                                                    */
  /* ------------------------------------------------------------------ */

  function initMenu(nav: HTMLElement): void {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = nav.querySelector<HTMLElement>('[data-menu]');
    if (!toggle || !menu) return;
    const bg = menu.querySelector<HTMLElement>('[data-menu-bg]');
    const openLabel = toggle.querySelector<HTMLElement>('[data-menu-open-label]');
    const closeLabel = toggle.querySelector<HTMLElement>('[data-menu-close-label]');
    const planet = menu.querySelector<SVGCircleElement>('[data-menu-planet]');
    const trail = Array.from(menu.querySelectorAll<SVGCircleElement>('[data-menu-trail]'));

    let open = false;
    let inerted: HTMLElement[] = [];

    /* the planet on the big orbit circles while the sheet is open */
    let raf = 0;
    let t0 = 0;
    const A0 = 2.06; // the resting position, low left on the ellipse
    const orbitAt = (a: number) => {
      const s = 1 + 0.35 * Math.sin(a);
      return `translate(${(320 + 312 * Math.cos(a)).toFixed(1)}px, ${(320 + 116 * Math.sin(a)).toFixed(1)}px) scale(${s.toFixed(3)})`;
    };
    const spinOrbit = (now: number) => {
      raf = 0;
      if (!open || !planet) return;
      if (!t0) t0 = now;
      const secs = (now - t0) / 1000;
      // a quick first sweep that settles into a slow cruise (one lap ≈ 40 s)
      const a = A0 + 1.9 * (1 - Math.exp(-secs / 0.9)) + (secs * TAU) / 40;
      planet.style.transform = orbitAt(a);
      const lagSpeed = 0.05 + 0.3 * Math.exp(-secs / 0.9);
      trail.forEach((dot) => {
        const k = Number(dot.dataset.menuTrail) || 1;
        dot.style.transform = orbitAt(a - k * lagSpeed);
      });
      if (!document.hidden) raf = requestAnimationFrame(spinOrbit);
    };
    const startOrbit = () => {
      if (raf || isReduced() || !planet) return;
      t0 = 0;
      raf = requestAnimationFrame(spinOrbit);
    };
    const stopOrbit = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };
    document.addEventListener('visibilitychange', () => (document.hidden ? stopOrbit() : open && startOrbit()));

    const focusables = () =>
      Array.from(nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.getClientRects().length > 0 && !el.closest('[inert]')
      );

    const lock = () => {
      const sbw = window.innerWidth - root.clientWidth;
      root.style.overflow = 'hidden';
      if (sbw > 0) {
        document.body.style.paddingRight = `${sbw}px`;
        nav.style.paddingRight = `${sbw}px`;
      }
    };

    const unlock = () => {
      root.style.overflow = '';
      document.body.style.paddingRight = '';
      nav.style.paddingRight = '';
    };

    const setInert = (on: boolean) => {
      if (on) {
        inerted = Array.from(document.body.children).filter(
          (el): el is HTMLElement => el instanceof HTMLElement && el !== nav && el.tagName !== 'SCRIPT' && !el.hasAttribute('inert')
        );
        inerted.forEach((el) => el.setAttribute('inert', ''));
      } else {
        inerted.forEach((el) => el.removeAttribute('inert'));
        inerted = [];
      }
    };

    /** The iris opens from (and closes into) the centre of the Menu button. */
    const aimIris = () => {
      if (!bg) return;
      const r = toggle.getBoundingClientRect();
      bg.style.setProperty('--mx', `${(r.left + r.width / 2).toFixed(1)}px`);
      bg.style.setProperty('--my', `${(r.top + r.height / 2).toFixed(1)}px`);
    };

    const setOpen = (next: boolean, restoreFocus = true) => {
      if (next === open) return;
      open = next;
      aimIris();
      nav.classList.toggle('is-open', open);
      root.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      openLabel?.toggleAttribute('aria-hidden', open);
      closeLabel?.toggleAttribute('aria-hidden', !open);
      menu.toggleAttribute('inert', !open);
      if (open) {
        lock();
        setInert(true);
        startOrbit();
      } else {
        unlock();
        setInert(false);
        window.setTimeout(() => !open && stopOrbit(), 800);
        if (restoreFocus) toggle.focus({ preventScroll: true });
      }
      requestFrame();
    };

    toggle.addEventListener('click', () => setOpen(!open, false));

    // any link in the sheet closes it first, so an anchor can travel the page
    menu.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement | null)?.closest('a');
      if (a) setOpen(false, false);
    });

    document.addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      const current = document.activeElement as HTMLElement | null;
      if (!current || !nav.contains(current)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && current === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && current === last) {
        e.preventDefault();
        first.focus();
      }
    });

    const wide = window.matchMedia('(min-width: 1100px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) setOpen(false, false);
    });
    window.addEventListener('pagehide', () => setOpen(false, false));
  }
</script>
