---
/**
 * Hairline envelope, currentColor — the Email companion to WaGlyph (same
 * 16-unit grid, same 1.3 stroke, so the pair reads as one family).
 *
 * The flap is its own path: when the link or button that holds the glyph is
 * hovered or focused, the flap swings open (a flip on its top edge). The
 * resting state is the closed envelope; nothing here hides content.
 */
export interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: cls = '' } = Astro.props;
---

<svg class={`mail-glyph ${cls}`} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" focusable="false"
  ><rect class="mail-body" x="1.65" y="3.65" width="12.7" height="8.7" fill="none" stroke="currentColor" stroke-width="1.3"
  ></rect><path class="mail-flap" d="M1.9 4.05 8 8.75l6.1-4.7" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"
  ></path></svg
>

<style>
  .mail-glyph {
    overflow: visible;
  }

  .mail-flap {
    transform-box: fill-box;
    transform-origin: 50% 0;
    transition: transform 460ms var(--ease-expo, cubic-bezier(0.16, 1, 0.3, 1));
  }

  @media (hover: hover) and (pointer: fine) {
    :global(:is(a, button):hover) .mail-flap {
      transform: scaleY(-1);
    }
  }

  :global(:is(a, button):focus-visible) .mail-flap {
    transform: scaleY(-1);
  }

  :global(html.motion-reduced) .mail-flap {
    transition: none;
  }
</style>
