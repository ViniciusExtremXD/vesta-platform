export interface Props {
  dir?: 'right' | 'up-right' | 'down' | 'up';
  size?: number;
}
const { dir = 'right', size = 14 } = Astro.props;
const d = {
  right: 'M2 8h11M9 4l4 4-4 4',
  'up-right': 'M4 12 12 4M5.5 4H12v6.5',
  down: 'M8 2v11M4 9l4 4 4-4',
