---
/**
 * ConceptPlate — one of the five concept studies (FICTIONAL businesses),
 * picked by `concept` (default 'halden' = Concept 01, Halden Roofing), drawn
 * in DOM + inline SVG. Zero image bytes. Everything inside scales with the plate
 * width through container query units (cqi), so the plate renders the same
 * drawing at 880px (build), 760px (hero), 420px (configurator) or 350px.
 *
 * ── Concepts ───────────────────────────────────────────────────────────────
 *   concept="halden|dental|restaurant|law|fitness". Data: src/data/concepts/
 *   (getConcept). Drawings: src/components/concepts/<id>/Before.astro +
 *   Layers.astro, picked through concepts/registry.ts. The contract every
 *   drawing follows is src/components/concepts/README.md. The root figure
 *   carries data-concept="<id>" and --cp-bg / --cp-fg (the concept's base
 *   surface and text colour) for hosts that theme around the plate.
 *
 * ── Modes ──────────────────────────────────────────────────────────────────
 *   mode="hero"    BEFORE + AFTER + rebuild blade + draggable handle +
 *                  caption. Carries data-compare; driven by
 *                  src/scripts/compare.ts (import it where hero mode is used).
 *   mode="build"   AFTER only, no URL bar, no handle. The six layers are
 *                  absolutely-positioned, full-size, DIRECT children of
 *                  .cp-screen, which has transform-style: preserve-3d and no
 *                  clipping, so another script can translateZ them.
 *   mode="mini"    AFTER only, URL bar, no handle (configurator preview).
 *   mode="static"  AFTER only — or the BEFORE with state="before" — URL bar,
 *                  no handle (work pages).
 *   Extra attributes (data-reveal, data-inview, id, style, aria-*) are spread
 *   onto the root <figure>. Non-hero modes add no entrance motion of their
 *   own: give the figure (or an ancestor) a reveal attribute.
 *
 * ── DOM contract (stable class names other units may target) ───────────────
 *   figure.cp.cp--{mode}                 container-type: inline-size
 *     .cp-frame
 *       .cp-bar > .cp-url[data-cp-url]   URL text only (no browser dots)
 *       .cp-screen                       16:10 drawing surface
 *         hero:   .cp-view[role=img] > .cp-before
 *                                    > .cp-after-wrap > .cp-after > layers
 *                                    > .cp-tag--after .cp-tag--before
 *                                      (flank the blade, move with --x)
 *                 .cp-sheen .cp-blade .cp-handle[role=slider]
 *         others: .cp-layer.cp-l1 … .cp-l6 directly (role=img on .cp-screen)
 *     figcaption.cp-cap                  hero only
 *
 *   The six layers (concepts/<id>/Layers.astro; each position:absolute;
 *   inset:0; style="--i:0…5"):
 *     .cp-l1  wireframe hairlines + box tags NAV / H1 / CTA / SERVICES
 *     .cp-l2  surfaces, brand, headline, art — the only OPAQUE layer
 *     .cp-l3  image frames + load-waterfall bars (no text)
 *     .cp-l4  JSON-LD card + sitemap tree
 *     .cp-l5  buttons: primary / Call / WhatsApp
 *     .cp-l6  event pins: one per button
 *   Flat z-order: l1, l4, l6 (z 0) sit UNDER the opaque l2 (z 1) — they are
 *   the parts of a real site nobody sees — then l3 (z 2), then l5 (z 3).
 *   Stacked flat, the plate reads as one finished website; lifted in 3D each
 *   layer shows. All text outside l2 passes AA on slate AND on --void, so the
 *   layers stay legible when lifted over a dark stage.
 *
 *   Personalisation (configurator): [data-cp-name] = business name in the
 *   logo (ellipsises when long), [data-cp-url] = the domain. Set textContent.
 *
 *   Frame: --plate URL bar, a faint lilac 1px rim (::after), no shadow.
 *   Build mode drops the rim and every background above .cp-screen, so
 *   only the layers themselves float.
 *
 *   --x (registered <number>; 0 = old site, 1 = rebuilt) lives on the hero
 *   figure. The rebuilt site covers [0, x] from the LEFT; the blade sits at
 *   x. No JS ⇒ --x stays 1 and a 140px BEFORE thumbnail appears.
 */
import { getDrawing } from './concepts/registry';
import { getConcept, type ConceptId } from '../data/concepts';
import { hero } from '../data/site';

export interface Props {
  /** Which study to draw. Default 'halden' (Concept 01). */
  concept?: ConceptId;
  mode?: 'hero' | 'build' | 'mini' | 'static';
  /** static mode only: which site to draw. */
  state?: 'after' | 'before';
  /** URL bar; defaults to true except in build mode. */
  bar?: boolean;
  /** hero only: render the figcaption. */
  caption?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { concept: id = 'halden', mode = 'hero', state = 'after', bar, caption = true, class: cls = '', style: hostStyle, ...rest } = Astro.props;

const c = getConcept(id);
const { Before, Layers } = getDrawing(c.id);

const isHero = mode === 'hero';
const showBar = bar ?? mode !== 'build';
const beforeOnly = mode === 'static' && state === 'before';
/* the caption splits into its two halves (study · fictional) so the hero
   can set it as two balanced lines on the leader; the separator stays in
   the text for screen readers */
const capCut = c.caption.lastIndexOf(' · ');
const capA = capCut > 0 ? c.caption.slice(0, capCut) : c.caption;
const capB = capCut > 0 ? c.caption.slice(capCut + 3) : '';
const aria = beforeOnly ? c.aria.before : c.aria[mode];
/* the concept's own surface + text colour, for the screen fill and for
   hosts; a host's inline style is kept after it */
const style = [`--cp-bg:${c.palette.base};--cp-fg:${c.palette.text}`, typeof hostStyle === 'string' ? hostStyle : '']
  .filter(Boolean)
  .join(';');
---

<figure
  class:list={['cp', `cp--${mode}`, cls]}
  data-compare={isHero ? '' : undefined}
  data-concept={c.id}
  style={style}
  {...rest}
>
  <div class="cp-frame">
    {
      showBar && (
        <div class="cp-bar">
          <span class="cp-url" data-cp-url>
            {c.domain}
          </span>
        </div>
      )
    }
    {
      isHero ? (
        <div class="cp-screen">
          <div class="cp-view" role="img" aria-label={aria}>
            <div class="cp-before">
              <Before />
            </div>
            <div class="cp-after-wrap">
              <div class="cp-after">
                <Layers />
              </div>
            </div>
            <span class="cp-tag cp-tag--after label" aria-hidden="true">
              {hero.plate.tags.after}
            </span>
            <span class="cp-tag cp-tag--before label" aria-hidden="true">
              {hero.plate.tags.before}
            </span>
            <div class="cp-inset" aria-hidden="true">
              <Before />
              <span class="cp-inset-cap label">{hero.plate.insetCaption}</span>
            </div>
          </div>
          <i class="cp-sheen" aria-hidden="true" />
          <i class="cp-blade" aria-hidden="true" />
          <button
            class="cp-handle"
            type="button"
            role="slider"
            tabindex="-1"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="100"
            aria-orientation="horizontal"
            aria-label={hero.plate.handleAria}
          >
            <span class="cp-grip" aria-hidden="true">
              <svg viewBox="0 0 20 10" aria-hidden="true">
                <path d="M5 1 1 5l4 4M15 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </span>
          </button>
        </div>
      ) : (
        <div class="cp-screen" role="img" aria-label={aria}>
          {beforeOnly ? <Before /> : <Layers />}
        </div>
      )
    }
  </div>
  {
    isHero && caption && (
      <figcaption class="cp-cap label">
        <span class="cp-cap-a">{capA}</span>
        {capB && <span class="cp-cap-sep"> · </span>}
        {capB && <span class="cp-cap-b">{capB}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  /* the compare variable: 0 = old site, 1 = rebuilt */
  @property --x {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .cp {
    container-type: inline-size;
    position: relative;
    margin: 0;
    min-width: 0;
  }

  .cp-frame {
    --u: calc(100cqi / 760);
    position: relative;
    background-color: var(--plate);
  }

  /* the rim: one faint lilac hairline, no shadow — an object floating in
     space, lit only by what is behind it */
  .cp-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    border: 1px solid rgb(185 162 255 / 0.34);
    pointer-events: none;
  }

  .cp-bar {
    display: flex;
    align-items: center;
    height: max(18px, calc(28 * var(--u)));
    padding-inline: max(10px, calc(16 * var(--u)));
    background-color: var(--plate);
    border-bottom: 1px solid var(--line-dark);
  }

  .cp-url {
    overflow: hidden;
    color: var(--dim);
    font-stretch: 100%;
    font-size: max(9px, calc(11 * var(--u)));
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cp-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--cp-bg, #1f2a30);
    color: var(--cp-fg, #f2ece1);
    user-select: none;
    -webkit-user-select: none;
  }

  .cp-view,
  .cp-before,
  .cp-after-wrap,
  .cp-after {
    position: absolute;
    inset: 0;
  }

  /* ---------- compare mechanics ---------------------------------------- */
  .cp-before {
    z-index: 1;
  }

  .cp-after-wrap {
    z-index: 2;
    overflow: hidden;
    transform: translate3d(calc((var(--x) - 1) * 100%), 0, 0);
  }

  .cp-after {
    background-color: var(--cp-bg, #1f2a30);
    transform: translate3d(calc((1 - var(--x)) * 100%), 0, 0);
  }

  .cp-tag {
    position: absolute;
    bottom: max(8px, calc(14 * var(--u)));
    padding: 5px 8px 4px;
    background-color: var(--void);
    color: var(--starlight);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  /* the tags flank the blade and travel with it */
  .cp-tag--after {
    left: 0;
    z-index: 4;
    transform: translate3d(calc(var(--x) * 100cqi - 100% - max(8px, calc(14 * var(--u)))), 0, 0);
  }

  .cp-tag--before {
    left: 0;
    z-index: 4;
    transform: translate3d(calc(var(--x) * 100cqi + max(8px, calc(14 * var(--u)))), 0, 0);
  }

  @container (max-width: 480px) {
    .cp-tag {
      padding: 4px 6px 3px;
      letter-spacing: 0.08em;
    }
  }

  /* the rebuild blade: one starlight hairline, a soft falloff trailing it */
  .cp-blade {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 4;
    width: 1px;
    background-color: var(--starlight);
    transform: translate3d(calc(var(--x) * 100cqi), 0, 0);
    pointer-events: none;
  }

  .cp-blade::before {
    content: '';
    position: absolute;
    inset-block: 0;
    right: 1px;
    width: calc(64 * var(--u));
    background: linear-gradient(to left, rgb(243 240 250 / 0.12), rgb(243 240 250 / 0));
  }

  :global(html:not(.js)) .cp-blade {
    display: none;
  }

  /* idle sheen: one pass every 9s; paused offscreen and in hidden tabs */
  .cp-sheen {
    position: absolute;
    inset-block: -10%;
    left: 0;
    z-index: 4;
    width: 22%;
    background: linear-gradient(90deg, rgb(243 240 250 / 0), rgb(243 240 250 / 0.07) 50%, rgb(243 240 250 / 0));
    transform: translate3d(-160%, 0, 0) skewX(-24deg);
    pointer-events: none;
  }

  :global(html:not(.motion-reduced)) .cp--hero .cp-sheen {
    animation: cp-sheen 9s linear 3.4s infinite;
  }

  .cp.is-offscreen .cp-sheen,
  .cp.is-paused .cp-sheen,
  .cp.is-dragging .cp-sheen {
    animation-play-state: paused;
  }

  @keyframes cp-sheen {
    0% {
      transform: translate3d(-160%, 0, 0) skewX(-24deg);
      animation-timing-function: var(--ease-quint);
    }
    15.5%,
    100% {
      transform: translate3d(620%, 0, 0) skewX(-24deg);
    }
  }

  /* the handle: absent until compare.ts arms it (no JS ⇒ no dead control) */
  .cp-handle {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 5;
    display: none;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    color: var(--white);
    cursor: ew-resize;
    touch-action: pan-y;
    transform: translate3d(calc(var(--x) * 100cqi), 0, 0);
  }

  .cp.is-armed .cp-handle {
    display: block;
    animation: cp-grip-in 300ms var(--ease-expo) both;
  }

  @keyframes cp-grip-in {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  /* a violet facet: the one accent on the plate, the one thing to grab */
  .cp-grip {
    position: absolute;
    inset: 6px;
    display: grid;
    place-items: center;
    background-color: var(--violet);
    clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
    transition: background-color var(--t-micro) linear;
  }

  .cp-grip svg {
    width: 16px;
    height: 8px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cp-handle:hover .cp-grip {
      background-color: var(--violet-deep);
    }
  }

  .cp-handle:focus-visible {
    outline: 2px solid var(--starlight);
    outline-offset: 1px;
  }

  .cp.is-dragging .cp-grip {
    background-color: var(--violet-deep);
  }

  .cp.is-armed .cp-screen {
    touch-action: pan-y;
  }

  @media (pointer: fine) {
    .cp.is-armed .cp-screen {
      cursor: ew-resize;
    }
  }

  /* no-JS: the BEFORE as a 140px thumbnail in the bottom-left corner */
  .cp-inset {
    position: absolute;
    left: max(8px, calc(14 * var(--u)));
    bottom: calc(max(8px, calc(14 * var(--u))) + 34px);
    z-index: 5;
    display: none;
    width: 140px;
    aspect-ratio: 16 / 10;
    container-type: inline-size;
    outline: 1px solid var(--starlight);
  }

  .cp-inset-cap {
    position: absolute;
    left: -1px;
    top: 100%;
    margin-top: 5px;
    padding: 5px 8px 4px;
    background-color: var(--void);
    color: var(--starlight);
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  :global(html:not(.js)) .cp-inset {
    display: block;
  }

  /* no-JS: --x stays 1, so the after tag would sit past the plate's right
     edge (the hero plate bleeds off-screen). Park it beside the thumbnail. */
  :global(html:not(.js)) .cp-tag--after {
    left: calc(max(8px, calc(14 * var(--u))) + 152px);
    /* on the same row as the thumbnail's "Before" caption */
    bottom: calc(max(8px, calc(14 * var(--u))) + 7px);
    transform: none;
  }

  /* ---------- the rebuild on page load (CSS; compare.ts takes over) ---- */
  :global(html:not(.motion-reduced)) .cp--hero {
    animation: cp-rebuild 1300ms var(--ease-mech) 700ms both;
  }

  .cp--hero.is-live {
    animation: none !important;
  }

  @keyframes cp-rebuild {
    from {
      --x: 0;
    }
    to {
      --x: 1;
    }
  }

  /* ---------- caption ---------------------------------------------------- */
  .cp-cap {
    color: var(--dim);
    font-size: 12px;
    letter-spacing: 0.16em;
    line-height: 1.5;
  }

  /* two lines when the host adds .cp--cap-split to the figure: the halves
     stack, the separator is kept for assistive tech only */
  .cp--cap-split .cp-cap-a,
  .cp--cap-split .cp-cap-b {
    display: block;
  }

  .cp--cap-split .cp-cap-sep {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- build mode: the layers float free ------------------------- */
  .cp--build .cp-frame,
  .cp--build .cp-screen {
    background-color: transparent;
    transform-style: preserve-3d;
  }

  .cp--build .cp-screen {
    overflow: visible;
  }

  .cp--build .cp-frame::after {
    display: none;
  }
</style>
