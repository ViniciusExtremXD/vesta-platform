---
/**
 * #method (paper) — six steps from the first call to the monthly report.
 * Desktop: one rail across the page, a node per step, the rail draws left
 * to right and each node fills as its step rises. Tablet: three by two.
 * Phones: a vertical rail down the left edge.
 */
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import { method } from '../../data/site';
---

<section id={method.id} class="s-paper section me" data-nav-theme="light" aria-labelledby="method-title">
  <div class="wrap" data-scene>
    <header class="g me-head">
      <div class="me-label">
        <SectionLabel n={method.label.index ?? undefined} name={method.label.name} />
      </div>
      <SplitText as="h2" id="method-title" class="d2 me-h2" text={method.h2} />
      <p class="lead me-sub" data-reveal style="--d:200ms">{method.sub}</p>
    </header>

    <div class="me-track" data-inview>
      <span class="me-rail" aria-hidden="true"><span class="me-fill"></span></span>
      <ol class="me-steps" role="list">
        {
          method.steps.map((s, k) => (
            <li class="me-step" data-reveal style={`--i:${k}`}>
              <span class="me-node" aria-hidden="true" />
              <p class="label me-idx">{s.index}</p>
              <h3 class="me-title">{s.title}</h3>
              <p class="me-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="small me-note" data-reveal>{method.note}</p>
  </div>
</section>

<style>
  .me {
    overflow-x: clip;
  }

  .me-head {
    row-gap: 18px;
  }

  .me-h2 {
    margin-top: 8px;
    max-width: 16ch;
  }

  .me-sub {
    color: var(--ink-2);
  }

  /* ---------- the track ----------------------------------------------------
     Phones: rail down the left, steps indented. */
  .me-track {
    position: relative;
    margin-top: clamp(48px, 3rem + 2vw, 96px);
    --node: 11px;
  }

  .me-rail {
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background-color: var(--line-light-strong);
  }

  .me-fill {
    position: absolute;
    inset: 0;
    background-color: var(--violet);
    transform-origin: 50% 0%;
    transition: transform 1800ms var(--ease-quint) 200ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .me-track:not(.is-in) .me-fill {
    transform: scaleY(0);
  }

  .me-steps {
    display: grid;
    gap: 36px;
  }

  .me-step {
    position: relative;
    padding-left: 32px;
  }

  .me-node {
    position: absolute;
    left: 0;
    top: 2px;
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--violet);
    background-color: var(--paper);
    transition: background-color 320ms linear;
    transition-delay: calc(400ms + var(--i, 0) * 120ms);
  }

  .me-step.is-in .me-node {
    background-color: var(--violet);
  }

  .me-idx {
    color: var(--violet-ink);
  }

  .me-title {
    margin-top: 10px;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 620;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .me-body {
    margin-top: 10px;
    max-width: 44ch;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .me-note {
    margin-top: clamp(40px, 2.5rem + 1vw, 64px);
    color: var(--ink-3);
  }

  /* ---------- tablet: three by two, rail across each row ------------------- */
  @media (min-width: 768px) {
    .me-rail {
      display: none;
    }

    .me-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px var(--gap);
    }

    .me-step {
      padding-left: 0;
      padding-top: 28px;
      border-top: 1px solid var(--line-light-strong);
    }

    .me-node {
      top: -6px;
    }
  }

  /* ---------- desktop: one rail, six across -------------------------------- */
  @media (min-width: 1100px) {
    .me-label {
      grid-column: 1 / 4;
    }

    .me-h2 {
      grid-column: 1 / 8;
      grid-row: 2;
    }

    .me-sub {
      grid-column: 8 / -1;
      grid-row: 2;
      align-self: end;
    }

    .me-rail {
      display: block;
      left: 0;
      right: 0;
      top: 5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .me-fill {
      transform-origin: 0% 50%;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .me-track:not(.is-in) .me-fill {
      transform: scaleX(0);
    }

    .me-steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--gap);
    }

    .me-step {
      padding-top: 36px;
      border-top: 0;
    }

    .me-node {
      top: 0;
    }

    .me-body {
      font-size: 0.9375rem;
    }
  }
</style>
