---
/**
 * #start (void) — the home page's doors: one card per page (doors in
 * site.ts). The whole card is the link. Each door carries data-door, so the
 * page-transition script (Base.astro) can name the one being opened: the
 * card then grows into the destination's page head, and shrinks back into
 * it on the way home.
 *
 * Also used at the end of an inner page with a single door (`items`) as the
 * "next page" link, without the section head (`head={false}`).
 *
 * Phones: one column. From 768px: two. Hover (fine pointers): the card
 * lifts to the plate surface, a violet edge draws across the top and the
 * arrow moves on.
 */
import { Picture } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import SplitText from '../ui/SplitText.astro';
import Arrow from '../ui/Arrow.astro';
import { doors as homeDoors } from '../../data/site';
import type { Door, SectionLabel as Label } from '../../data/site';
import { url } from '../../lib/url';
import portrait from '../../assets/vinicius-magno-mono.jpg';

export interface Props {
  id?: string;
  label?: Label;
  h2?: string;
  items?: Door[];
  /** false: no label and no H2 (the "next page" door at the end of a page). */
  head?: boolean;
  /** Surface class; the next-page door sits on paper. */
  surface?: 's-void' | 's-paper';
}

const {
  id = homeDoors.id,
  label = homeDoors.label,
  h2 = homeDoors.h2,
  items = homeDoors.items,
  head = true,
  surface = 's-void',
} = Astro.props;
const titleId = `${id}-title`;
const theme = surface === 's-void' ? 'dark' : 'light';
---

<section id={id} class:list={[surface, 'section dr', { 'dr--single': items.length === 1 }]} data-nav-theme={theme} aria-labelledby={head ? titleId : undefined} aria-label={head ? undefined : items[0]?.title}>
  <div class="wrap" data-scene="soft">
    {
      head && (
        <header class="dr-head">
          <SectionLabel n={label.index ?? undefined} name={label.name} />
          <SplitText as="h2" id={titleId} class="d2 dr-h2" text={h2} />
        </header>
      )
    }

    <ul class="dr-grid" role="list">
      {
        items.map((d, k) => (
          <li class="dr-cell" data-reveal style={`--i:${k}`}>
            <a class="dr-door" href={url(d.href)} data-door data-tilt="2">
              <span class="dr-edge" aria-hidden="true" />
              <span class="dr-top">
                <span class="label dr-idx">{d.index}</span>
                <span class="dr-glyph" aria-hidden="true">
                  {d.glyph === 'cost' && (
                    <svg viewBox="0 0 64 40" width="64" height="40" focusable="false">
                      <path class="g-line" d="M0 39.5h64" />
                      <rect class="g-was" x="2" y="22" width="7" height="17" />
                      <rect class="g-was" x="12" y="17" width="7" height="22" />
                      <rect class="g-was" x="22" y="10" width="7" height="29" />
                      <rect class="g-was" x="32" y="3" width="7" height="36" />
                      <path class="g-mark" d="M42.5 0v40" />
                      <rect class="g-now" x="46" y="15" width="7" height="24" />
                      <rect class="g-now" x="56" y="19" width="7" height="20" />
                    </svg>
                  )}
                  {d.glyph === 'steps' && (
                    <svg viewBox="0 0 64 40" width="64" height="40" focusable="false">
                      <path class="g-line" d="M9 20h46" />
                      <rect class="g-now" x="2" y="13" width="14" height="14" />
                      <rect class="g-box" x="25.5" y="13.5" width="13" height="13" />
                      <rect class="g-box" x="48.5" y="13.5" width="13" height="13" />
                    </svg>
                  )}
                  {d.glyph === 'browser' && (
                    <svg viewBox="0 0 64 40" width="64" height="40" focusable="false">
                      <rect class="g-box" x="0.5" y="0.5" width="63" height="39" />
                      <path class="g-line" d="M0.5 8.5h63" />
                      <rect class="g-now" x="6" y="15" width="24" height="5" />
                      <path class="g-line" d="M6 25.5h30M6 30.5h20" />
                      <rect class="g-box" x="42.5" y="14.5" width="15" height="19" />
                    </svg>
                  )}
                  {d.glyph === 'portrait' && (
                    <Picture
                      src={portrait}
                      alt=""
                      widths={[56, 112]}
                      sizes="56px"
                      formats={['avif', 'webp']}
                      class="dr-face"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
              </span>
              <h3 class="dr-title">{d.title}</h3>
              <span class="dr-text">{d.text}</span>
              <span class="dr-keys">
                {d.keys.map((key) => (
                  <span class="label dr-key">{key}</span>
                ))}
              </span>
              <span class="dr-cta">
                <span>{d.cta}</span>
                <Arrow />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dr {
    overflow-x: clip;
  }

  /* on the home page the doors follow a one-screen hero: no second gap */
  .dr:not(.dr--single) {
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .dr-h2 {
    margin-top: 20px;
    max-width: 14ch;
  }

  /* ---------- grid -------------------------------------------------------- */
  .dr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
    margin-top: clamp(40px, 2.5rem + 2vw, 72px);
  }

  .dr--single .dr-grid {
    margin-top: 0;
  }

  .dr-cell {
    min-width: 0;
  }

  /* ---------- the door ---------------------------------------------------- */
  .dr-door {
    --door-bg: var(--night);
    --door-line: var(--line-dark);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 280px;
    padding: 24px 22px 22px;
    background-color: var(--door-bg);
    border: 1px solid var(--door-line);
    color: var(--starlight);
    text-decoration: none;
    transition:
      background-color var(--t-ui) linear,
      border-color var(--t-ui) linear,
      transform 700ms var(--ease-expo);
  }

  .s-paper .dr-door {
    --door-bg: var(--void);
  }

  /* the violet edge: drawn across the top on hover and focus */
  .dr-edge {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background-color: var(--violet);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 520ms var(--ease-quint);
  }

  .dr-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .dr-idx {
    color: var(--lilac);
  }

  .dr-glyph {
    display: block;
    flex: none;
    color: var(--lilac);
  }

  .dr-glyph svg {
    overflow: visible;
  }

  .dr-glyph .g-line,
  .dr-glyph .g-mark,
  .dr-glyph .g-box {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .dr-glyph .g-mark {
    stroke-dasharray: 2 2;
  }

  .dr-glyph .g-was {
    fill: rgb(243 240 250 / 0.26);
  }

  .dr-glyph .g-now {
    fill: var(--violet);
  }

  .dr-glyph :global(.dr-face) {
    display: block;
    width: 56px;
    height: 56px;
    border: 1px solid var(--line-dark-strong);
  }

  .dr-glyph :global(.dr-face img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dr-title {
    margin-top: auto;
    padding-top: 40px;
    font-size: clamp(1.75rem, 1.35rem + 1.3vw, 2.625rem);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .dr-text {
    margin-top: 12px;
    max-width: 44ch;
    color: var(--haze);
    line-height: 1.5;
  }

  .dr-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 18px;
  }

  .dr-key {
    color: var(--haze);
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .dr-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    color: var(--lilac);
    font-stretch: var(--wd-display);
    font-size: 0.875rem;
    font-weight: 620;
    letter-spacing: 0.02em;
  }

  .dr-cta :global(.arrow) {
    transition: transform var(--t-ui) var(--ease-expo);
  }

  .dr-door:focus-visible .dr-edge {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .dr-door:hover {
      --door-bg: var(--plate);
      border-color: var(--line-dark-strong);
    }

    .dr-door:hover .dr-edge {
      transform: scaleX(1);
    }

    .dr-door:hover .dr-cta :global(.arrow) {
      transform: translateX(6px);
    }
  }

  @media (min-width: 768px) {
    .dr-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dr--single .dr-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .dr-door {
      min-height: 320px;
      padding: 28px 28px 26px;
    }

    .dr--single .dr-door {
      min-height: 240px;
    }
  }

  @media (min-width: 1100px) {
    .dr-head {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: end;
    }

    .dr-head > :global(.sec-label) {
      grid-column: 1 / -1;
    }

    .dr-h2 {
      grid-column: 1 / 8;
    }

    .dr-door {
      min-height: 340px;
      padding: 32px 32px 28px;
    }

    .dr--single .dr-door {
      min-height: 260px;
    }
  }
</style>
