---
/**
 * Gauge — an observatory instrument / watch complication (§4 "Gauge",
 * §6.5 Ignition sweep, SPEC_COSMOS §2 "instruments").
 *
 *   <Gauge metric="performance" label="Speed" i={0} />
 *   <Gauge value={95} size={150} />
 *
 * Geometry is computed at build time; each instrument ships well under 2 KB
 * of SVG and no JavaScript beyond the motion engine.
 *
 * Anatomy (viewBox 240 × 240, pivot 120,120; 0 at −120°, 100 at +120°):
 *   - a full hairline bezel ring (the dial is a disc, not a speedometer)
 *   - a 240° railway minute track: two hairline rails with a fine tick at
 *     every point and a longer graduation every ten; the 90–100 band is lilac
 *   - scale numerals 20–80 inside the track, 0 and 100 set under the two
 *     ends of the scale (hidden when the dial is under 200px wide)
 *   - a plate track with a starlight value arc (pathLength 100)
 *   - a lilac index hand riding the outer track (it never crosses the
 *     readout), with a hollow bead where it meets the value arc
 *   - an HTML readout (real text, so it can count) in starlight
 *
 * Numerals use the font's proportional figures on purpose: Mona Sans's
 * tabular set is its code-style monospace set (slashed zero, serifed one).
 *
 * Motion (only under .is-in, set by the engine through data-inview):
 *   the bezel draws, the hand runs the full scale and settles on the value
 *   (1600ms), the arc fills (900ms expo from 700ms) and the readout counts
 *   from 700ms. Stagger 120ms × i. The default CSS is the final state, so
 *   no JS, a failed engine and "Motion: off" show the reading.
 */
import measurements from '../data/measurements.json';

type ScoreKey = 'performance' | 'accessibility' | 'seo' | 'bestPractices';

export interface Props {
  /** Read the score from measurements.json … */
  metric?: ScoreKey;
  /** … or pass it directly (0–100). */
  value?: number;
  /** Caption under the dial (LABEL style). Omit for a bare instrument. */
  label?: string;
  /** Stagger index: 120ms steps. */
  i?: number;
  /** Maximum rendered width in px (the dial is fluid below it). */
  size?: number;
  /** Suffix under the numeral. */
  of?: string;
  class?: string;
}

const { metric, value, label, i = 0, size = 240, of = '/100', class: cls = '' } = Astro.props;

const raw = value ?? (metric ? Number(measurements[metric]) : 0);
const v = Math.max(0, Math.min(100, Math.round(raw)));

/* ---- geometry ---------------------------------------------------------- */
const C = 120;
const SWEEP = 2.4; // degrees per point (240° / 100)
const r2 = (n: number) => Math.round(n * 100) / 100;
const theta = (val: number) => ((-120 + SWEEP * val) * Math.PI) / 180;
const pt = (val: number, r: number) => [r2(C + r * Math.sin(theta(val))), r2(C - r * Math.cos(theta(val)))];

/** Clockwise arc between two scale values at radius r. */
function arc(r: number, a: number, b: number): string {
  const [x1, y1] = pt(a, r);
  const [x2, y2] = pt(b, r);
  const large = (b - a) * SWEEP > 180 ? 1 : 0;
  return `M${x1} ${y1}A${r} ${r} 0 ${large} 1 ${x2} ${y2}`;
}

/**
 * A band of graduations drawn as ONE dashed arc (instead of 100 lines): the
 * stroke width is the tick length, each dash is a tick `w` wide. The arc
 * runs half a point past each end so the end ticks are never cut.
 */
function ticks(r: number, from: number, to: number, step: number, w: number) {
  const unit = ((SWEEP * Math.PI) / 180) * r; // px of arc per scale point
  return {
    d: arc(r, from - 0.5, to + 0.5),
    dash: `${w} ${r2(step * unit - w)}`,
    offset: r2(-(0.5 * unit - w / 2)),
  };
}

/* radii, outside in */
const R_BEZEL = 118.5;
const R_RAIL_OUT = 110;
const R_RAIL_IN = 103;
const R_VALUE = 95;
const R_SCALE = 79;

const minor = ticks((R_RAIL_OUT + R_RAIL_IN) / 2, 0, 89, 1, 0.7);
const minorHi = ticks((R_RAIL_OUT + R_RAIL_IN) / 2, 90, 100, 1, 0.7);
const major = ticks((R_RAIL_OUT + R_RAIL_IN - 4) / 2, 0, 80, 10, 1.3);
const majorHi = ticks((R_RAIL_OUT + R_RAIL_IN - 4) / 2, 90, 100, 10, 1.3);

/* 20–80 sit inside the track; 0 and 100 sit in the open sector, under the
   two ends of the scale, where no hand or bead can ever reach them. */
const numerals = [20, 40, 60, 80].map((n) => {
  const [x, y] = pt(n, R_SCALE);
  return { n, x, y };
});
const ends = [
  { n: 0, x: r2(C - 100 * Math.sin((136 * Math.PI) / 180)), y: r2(C - 100 * Math.cos((136 * Math.PI) / 180)) },
  { n: 100, x: r2(C + 100 * Math.sin((136 * Math.PI) / 180)), y: r2(C - 100 * Math.cos((136 * Math.PI) / 180)) },
];

/* the index hand: a tapered blade from just outside the numerals to the
   bezel, drawn pointing at 12 o'clock and rotated to the reading */
const HAND_IN = 90;
const HAND_OUT = 117.5;
const hand = `M${C - 1.3} ${C - HAND_IN} L${C + 1.3} ${C - HAND_IN} L${C + 0.45} ${C - HAND_OUT} L${C - 0.45} ${C - HAND_OUT} Z`;
const [bx, by] = [C, C - R_VALUE];

const deg = r2(-120 + SWEEP * v);
const style = `--v:${v};--deg:${deg}deg;--i:${i};--size:${size}px`;
---

<figure class:list={['gauge', cls]} style={style}>
  <div class="dial" data-gauge data-inview>
    <svg viewBox="0 0 240 240" fill="none" aria-hidden="true" focusable="false">
      <circle class="bezel" cx="120" cy="120" r={R_BEZEL} pathLength="100" />
      <path class="rail" d={arc(R_RAIL_OUT, 0, 90)} />
      <path class="rail" d={arc(R_RAIL_IN, 0, 100)} />
      <path class="rail-hi" d={arc(R_RAIL_OUT, 90, 100)} />
      <g class="grad">
        <path class="t-minor" d={minor.d} stroke-dasharray={minor.dash} stroke-dashoffset={minor.offset} />
        <path class="t-major" d={major.d} stroke-dasharray={major.dash} stroke-dashoffset={major.offset} />
      </g>
      <g class="grad-hi">
        <path class="t-minor" d={minorHi.d} stroke-dasharray={minorHi.dash} stroke-dashoffset={minorHi.offset} />
        <path class="t-major" d={majorHi.d} stroke-dasharray={majorHi.dash} stroke-dashoffset={majorHi.offset} />
      </g>
      <g class="scale">
        {numerals.map((s) => <text x={s.x} y={s.y}>{s.n}</text>)}
        {ends.map((s) => <text x={s.x} y={s.y}>{s.n}</text>)}
      </g>
      <path class="track" d={arc(R_VALUE, 0, 100)} />
      <path class="val" d={arc(R_VALUE, 0, 100)} pathLength="100" />
      <g class="needle">
        <path class="hand" d={hand} />
        <circle class="bead" cx={bx} cy={by} r="3.2" />
      </g>
    </svg>
    <span class="n" aria-hidden="true" data-count={String(v)} data-count-delay={String(680 + i * 120)} data-count-dur="900">{v}</span>
    <span class="of" aria-hidden="true">{of}</span>
  </div>
  {
    label ? (
      <figcaption class="cap">
        <span class="label cap-name" data-reveal="fade">{label}</span>
        <span class="visually-hidden">
          {v}
          {of}
        </span>
      </figcaption>
    ) : (
      <figcaption class="visually-hidden">
        {v}
        {of}
      </figcaption>
    )
  }
</figure>

<style>
  .gauge {
    width: 100%;
    max-width: var(--size);
  }

  /* ---------------------------------------------------------------- dial */

  .dial {
    position: relative;
    container-type: inline-size;
    width: 100%;
  }

  .dial svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans, Arial, sans-serif);
    font-stretch: var(--wd-display);
  }

  /* fill="none" is a presentation attribute on the <svg> (zero weight,
     inherited), so the hand, bead and numerals below set their own fills.
     A scoped CSS reset here would outrank them. */

  .bezel {
    stroke: var(--line-dark);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0px;
    /* start the draw at 6 o'clock, inside the open sector */
    transform-box: view-box;
    transform-origin: 120px 120px;
    rotate: 90deg;
  }

  .rail {
    stroke: var(--line-dark-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .rail-hi {
    stroke: var(--lilac);
    stroke-width: 1.6;
  }

  .t-minor {
    stroke-width: 7;
  }

  .t-major {
    stroke-width: 11;
  }

  .grad .t-minor {
    stroke: var(--line-dark-strong);
  }

  .grad .t-major {
    stroke: var(--haze);
  }

  .grad-hi path {
    stroke: var(--lilac);
  }

  .scale text {
    fill: var(--dim);
    font-size: 12px;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-anchor: middle;
    dominant-baseline: central;
    font-variant-numeric: proportional-nums;
  }

  .track {
    stroke: var(--plate);
    stroke-width: 5;
  }

  .val {
    stroke: var(--starlight);
    stroke-width: 1.6;
    stroke-dasharray: 100 100;
    stroke-dashoffset: calc((100 - var(--v)) * 1px);
  }

  .needle {
    transform-box: view-box;
    transform-origin: 120px 120px;
    rotate: var(--deg);
  }

  .hand {
    fill: var(--lilac);
  }

  .bead {
    fill: var(--night);
    stroke: var(--lilac);
    stroke-width: 1.4;
  }

  /* ------------------------------------------------------------- readout */
  /* .n covers the whole dial on purpose: its box equals the [data-inview]
     box, so the engine starts the counter in the same frame the hand
     ignites. The digits sit on the pivot through padding. */
  .n {
    position: absolute;
    inset: 0;
    padding-top: 38.5cqi;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 22cqi; /* ≈53px at 240 */
    font-weight: 480;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
  }

  .n[data-count] {
    font-variant-numeric: proportional-nums;
  }

  .of {
    position: absolute;
    inset-inline: 0;
    top: 66cqi;
    color: var(--dim);
    font-stretch: var(--wd-display);
    font-size: max(12px, 5cqi);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    text-align: center;
  }

  /* compact instruments: fewer marks, same reading */
  @container (max-width: 199.98px) {
    .scale {
      display: none;
    }

    .n {
      padding-top: 37cqi;
      font-size: 24cqi;
    }
  }

  /* ------------------------------------------------------------- caption */

  .cap {
    margin-top: 20px;
  }

  .cap-name {
    display: block;
    color: var(--starlight);
    transition-delay: calc(var(--i, 0) * 120ms + 900ms);
  }

  /* ------------------------------------------------------------- ignition */
  /* Armed (hidden) start: bezel undrawn, hand at zero, arc empty, readout
     dark. Only with the engine running and motion on; everything else
     renders the final reading. */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .bezel {
    stroke-dashoffset: 100px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) :is(.grad, .grad-hi, .rail, .rail-hi, .scale) {
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .needle {
    rotate: -120deg;
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) .val {
    stroke-dashoffset: 100px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .dial:not(.is-in) :is(.n, .of) {
    opacity: 0;
  }

  .dial :is(.grad, .grad-hi, .rail, .rail-hi, .scale) {
    transition: opacity 600ms linear;
    transition-delay: calc(var(--i, 0) * 120ms + 120ms);
  }

  .dial.is-in .bezel {
    animation: gauge-bezel 1100ms var(--ease-quint) both;
    animation-delay: calc(var(--i, 0) * 120ms);
  }

  .dial .needle {
    transition: opacity 200ms linear;
    transition-delay: calc(var(--i, 0) * 120ms + 200ms);
  }

  .dial.is-in .needle {
    animation: gauge-ignition 1600ms var(--ease-mech) both;
    animation-delay: calc(var(--i, 0) * 120ms + 200ms);
  }

  .dial.is-in .val {
    animation: gauge-arc 900ms var(--ease-expo) both;
    animation-delay: calc(700ms + var(--i, 0) * 120ms);
  }

  /* the readout powers on as the arc starts to fill (a transition, not a
     fill-mode animation: Chrome can leave a finished opacity keyframe
     painted at its first frame on a static text node) */
  .dial :is(.n, .of) {
    transition: opacity 320ms linear;
    transition-delay: calc(700ms + var(--i, 0) * 120ms);
  }

  @keyframes gauge-bezel {
    from {
      stroke-dashoffset: 100px;
    }
    to {
      stroke-dashoffset: 0px;
    }
  }

  @keyframes gauge-ignition {
    0% {
      rotate: -120deg;
    }
    45% {
      rotate: 120deg;
      animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    100% {
      rotate: var(--deg);
    }
  }

  @keyframes gauge-arc {
    from {
      stroke-dashoffset: 100px;
    }
    to {
      stroke-dashoffset: calc((100 - var(--v)) * 1px);
    }
  }
</style>
