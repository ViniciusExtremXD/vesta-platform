---
/**
 * Study pages, "The six layers": an exploded view of one concept's rebuild.
 *
 * Scroll-scrubbed: as the stage rises through the viewport the six layers of
 * ConceptPlate mode="build" part along Z (--ex 0 → 1, written by the shared
 * frame loop, transform-only) while the whole assembly turns a few degrees.
 * The pointer tilts the stage (data-tilt). Default CSS = fully exploded, so
 * no-JS, motion off and a failed engine all render the final state.
 *
 * Legend: index + name visible; the descriptions live in one <Expand>.
 * Pointer hover on a legend row lifts its layer and rims it in lilac.
 *
 * Classes are prefixed `ex-` (Expand.astro owns `.xp`).
 */
import ConceptPlate from '../ConceptPlate.astro';
import Expand from '../ui/Expand.astro';
import { build, conceptPage } from '../../data/site';
import type { ConceptId } from '../../data/concepts';

export interface Props {
  concept?: ConceptId;
}

const { concept = 'halden' } = Astro.props;
const S = conceptPage.study.layers;
---

<div class="g ex" data-ex>
  <div class="ex-stage" data-ex-stage data-tilt="5">
    <div class="ex-asm">
      <ConceptPlate concept={concept} mode="build" />
    </div>
  </div>

  <div class="ex-side">
    <ol class="ex-list">
      {
        build.layers.map((l, i) => (
          <li class="ex-row" data-layer={i} data-inview style={`--r:${i}`}>
            <span class="label ex-idx">{l.index}</span>
            <span class="ex-name">{l.name}</span>
          </li>
        ))
      }
    </ol>
    <Expand title={S.more} class="ex-more" i={2}>
      <dl class="ex-dl">
        {
          build.layers.map((l) => (
            <div class="ex-dl-row">
              <dt class="label">{l.name}</dt>
              <dd class="small">{l.text}</dd>
            </div>
          ))
        }
      </dl>
    </Expand>
  </div>
</div>

<script>
  import { addFrame, isReduced, vestibular } from '../../scripts/motion';

  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-ex]'));

  roots.forEach((root) => {
    /* legend row → its layer (fine pointers only) */
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const layers = Array.from(root.querySelectorAll<HTMLElement>('.cp-layer'));
      root.querySelectorAll<HTMLElement>('[data-layer]').forEach((row) => {
        const i = Number(row.dataset.layer);
        const layer = layers.find((l) => l.classList.contains(`cp-l${i + 1}`));
        if (!layer) return;
        const set = (on: boolean) => {
          row.classList.toggle('is-hot', on);
          layer.classList.toggle('is-hot', on);
          root.classList.toggle('has-hot', on);
        };
        row.addEventListener('pointerenter', () => set(true));
        row.addEventListener('pointerleave', () => set(false));
      });
    }

    /* scroll-scrubbed explode */
    const stage = root.querySelector<HTMLElement>('[data-ex-stage]');
    if (!stage) return;
    if (vestibular()) return;
    stage.classList.add('is-scrubbed');
    let top = 0;
    let h = 0;
    let vhh = 1;
    let last = -1;
    addFrame({
      read(_y, vh) {
        const r = stage.getBoundingClientRect();
        top = r.top;
        h = r.height;
        vhh = vh;
      },
      write() {
        if (isReduced()) {
          if (last !== 1) stage.style.setProperty('--ex', '1');
          last = 1;
          return;
        }
        /* 0 while the stage's middle is at the bottom edge, 1 once it
           reaches 45% of the viewport */
        const mid = top + h / 2;
        let p = (vhh * 1.02 - mid) / (vhh * 0.57);
        p = Math.min(1, Math.max(0, p));
        const e = 1 - Math.pow(1 - p, 3);
        const v = Math.round(e * 1000) / 1000;
        if (v === last) return;
        last = v;
        stage.style.setProperty('--ex', String(v));
      },
    });
  });
</script>

<style>
  .ex {
    --zs: 40px;
    row-gap: 40px;
    align-items: center;
  }

  /* ------------------------------------------------------------ stage */

  .ex-stage {
    --ex: 1;
    position: relative;
    padding-block: calc(var(--zs) * 4.2) calc(var(--zs) * 0.6);
    perspective: 2000px;
    perspective-origin: 50% 30%;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .ex-stage:not(.is-scrubbed) {
    --ex: 0;
  }

  .ex-asm {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transform: rotateX(calc(40deg + var(--ex) * 15deg)) rotateZ(calc(-14deg - var(--ex) * 18deg)) scale(0.86);
    transform-origin: 50% 50%;
  }

  .ex-asm :global(.cp) {
    transform-style: preserve-3d;
  }

  .ex-asm :global(.cp-layer) {
    transform: translate3d(0, 0, calc(var(--i) * var(--zs) * var(--ex)));
    outline: 1px solid transparent;
    transition:
      transform 520ms var(--ease-expo),
      outline-color var(--t-micro) linear;
  }

  .ex-stage.is-scrubbed :global(.cp-layer:not(.is-hot)) {
    transition: outline-color var(--t-micro) linear;
  }

  /* every layer gets a faint lilac edge so the stack reads as sheets */
  .ex-asm :global(.cp-layer:not(.cp-l2)) {
    outline-color: rgb(185 162 255 / 0.22);
  }

  .ex-asm :global(.cp-layer.is-hot) {
    transform: translate3d(0, 0, calc(var(--i) * var(--zs) * var(--ex) + var(--zs) * 0.8));
    outline-color: var(--lilac);
  }

  /* ------------------------------------------------------------ legend */

  .ex-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .ex-list {
      display: block;
    }
  }

  .ex-row {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: baseline;
    column-gap: 12px;
    padding-block: 14px 15px;
    cursor: default;
  }

  .ex-row::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: var(--line);
    transform-origin: left center;
    transition:
      transform 1000ms var(--ease-quint),
      opacity 200ms linear;
    transition-delay: calc(var(--r, 0) * 70ms);
  }

  .ex-idx,
  .ex-name {
    display: inline-block;
    transform-origin: 50% 100%;
    transition:
      opacity var(--t-reveal) var(--ease-expo),
      transform var(--t-reveal) var(--ease-expo),
      color var(--t-micro) linear;
    transition-delay: calc(var(--r, 0) * 70ms + 120ms), calc(var(--r, 0) * 70ms + 120ms), 0ms;
  }

  .ex-idx {
    color: var(--lilac);
  }

  @media (min-width: 768px) {
    .ex-row {
      grid-template-columns: 44px minmax(0, 1fr);
    }
  }

  .ex-name {
    color: var(--starlight);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* hovering one row: the others step back to dim (colour, never opacity) */
  .ex.has-hot .ex-row:not(.is-hot) .ex-name {
    color: var(--dim);
  }

  .ex-row.is-hot .ex-name {
    transform: translateX(8px);
    transition-delay: 0ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .ex-row:not(.is-in)::before {
    transform: scaleX(0);
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .ex-row:not(.is-in) :is(.ex-idx, .ex-name) {
    opacity: 0;
    transform: perspective(600px) rotateX(-80deg) translate3d(0, 10px, 0);
  }

  .ex-side :global(.ex-more) {
    margin-top: 28px;
  }

  .ex-dl {
    display: grid;
    gap: 16px;
  }

  .ex-dl-row {
    display: grid;
    gap: 6px;
  }

  .ex-dl-row dt {
    color: var(--lilac);
  }

  .ex-dl-row dd {
    margin: 0;
    color: var(--haze);
    max-width: 46ch;
  }

  @media (min-width: 768px) {
    .ex {
      --zs: 64px;
    }

    .ex-stage {
      grid-column: 1 / span 7;
    }

    .ex-side {
      grid-column: 1 / span 6;
    }
  }

  @media (min-width: 1100px) {
    .ex {
      --zs: 58px;
      row-gap: 0;
    }

    .ex-stage {
      grid-column: 1 / span 8;
      perspective: 2600px;
      padding-block: calc(var(--zs) * 3.6) 0;
    }

    .ex-asm {
      transform: translate3d(4%, 0, 0) rotateX(calc(40deg + var(--ex) * 16deg)) rotateZ(calc(-14deg - var(--ex) * 20deg)) scale(0.7);
    }

    .ex-side {
      grid-column: 9 / -1;
    }
  }
</style>
