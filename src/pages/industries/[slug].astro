---
/**
 * /industries/[slug]/ — one page per industry, and ONLY when at least one
 * confirmed case study exists for it. A vertical page without proof is the
 * trap the old site fell into; this route refuses to build it.
 *
 *   head (void)     industry label · H1 · lead
 *   cases (paper)   the confirmed case studies for this industry (rows)
 *   prices (void)   the three packages, name / price / lead time, → #pricing
 *
 * Copy for this route is not in site.ts yet (TODO_SITE_INDUSTRY in
 * components/work/verticals.ts).
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/work/PageHead.astro';
import CaseRow from '../../components/work/CaseRow.astro';
import SplitText from '../../components/ui/SplitText.astro';
import Arrow from '../../components/ui/Arrow.astro';
import { verticalLabel, TODO_SITE_INDUSTRY as T } from '../../components/work/verticals';
import { packages } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).filter((c) => c.data.confirmed);
  const slugs = Array.from(new Set(cases.map((c) => c.data.vertical)));
  return slugs.map((slug) => ({
    params: { slug },
    props: {
      slug,
      cases: cases
        .filter((c) => c.data.vertical === slug)
        .sort((a, b) => b.data.launched.getTime() - a.data.launched.getTime()),
    },
  }));
}

const { slug, cases } = Astro.props;
const label = verticalLabel(slug);
---

<Base title={T.seoTitle(label)} description={T.seoDescription(label)} canonical={`/industries/${slug}/`}>
  <PageHead label={label} h1={T.h1(label)} lead={T.lead} />

  <section class="s-paper section ind-cases" data-nav-theme="light" aria-labelledby="ind-cases-title">
    <div class="wrap">
      <SplitText as="h2" id="ind-cases-title" class="d2" text={T.casesTitle} />
      <ol class="ind-list">
        {cases.map((c, i) => <CaseRow index={i} slug={c.id} data={c.data} />)}
      </ol>
    </div>
  </section>

  <section class="s-void section ind-prices" data-nav-theme="dark" aria-labelledby="ind-prices-title">
    <div class="wrap g">
      <SplitText as="h2" id="ind-prices-title" class="d2 ind-prices-title" text={T.pricesTitle} />
      <ul class="ind-pk">
        {
          packages.map((p, i) => (
            <li class="ind-pk-row" data-reveal style={`--i:${i}`}>
              <span class="d3 ind-pk-name">{p.name}</span>
              <span class="small ind-pk-days">{p.daysLabel}</span>
              <span class="ind-pk-price">{p.price.display}</span>
            </li>
          ))
        }
      </ul>
      <p class="ind-pk-go" data-reveal style="--i:3">
        <a class="tlink" href={url(T.pricesLink.href)}>
          <span>{T.pricesLink.label}</span>
          <Arrow />
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ind-list {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .ind-pk {
    margin-top: 40px;
    border-bottom: 1px solid var(--line);
  }

  .ind-pk-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 24px;
    padding-block: 22px;
    border-top: 1px solid var(--line);
  }

  .ind-pk-name {
    color: var(--starlight);
  }

  .ind-pk-days {
    grid-row: 2;
    color: var(--dim);
  }

  .ind-pk-price {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    color: var(--starlight);
    font-size: var(--t-d3);
    font-weight: 520;
    font-variant-numeric: lining-nums proportional-nums;
  }

  .ind-pk-go {
    margin-top: 32px;
  }

  @media (min-width: 1100px) {
    .ind-prices-title {
      grid-column: 1 / span 4;
    }

    .ind-pk {
      grid-column: 6 / -1;
      margin-top: 0;
    }

    .ind-pk-go {
      grid-column: 6 / -1;
    }
  }
</style>
