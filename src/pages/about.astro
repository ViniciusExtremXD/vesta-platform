  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-dim,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-planet,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-vesta {
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-sun,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-sun-ring {
    opacity: 0;
    transform: scale(0.3);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .orbit-stage:not(.is-in) .o-label {
    opacity: 0;
  }

  .orbit-cap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    color: var(--haze);
  }

  @media (min-width: 768px) {
    .o-path,
    .o-dim,
    .o-sun-ring {
