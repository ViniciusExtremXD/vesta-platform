<script>
  /* Vesta's one lap in the orbit diagram. CSS draws the stroke (a transition
     on stroke-dashoffset in arc-length units); this moves the planet along
     arc-length samples of the same path with the same easing, duration and
     delay, so it rides the head of the line. Transform only, one shot,
     nothing to pause. Default state (no JS, motion off) = the planet at rest. */
  import { isReduced } from '../scripts/motion';

  const stage = document.querySelector<HTMLElement>('[data-name-orbit]');
  const planet = stage?.querySelector<SVGCircleElement>('[data-vesta-planet]');

  if (stage && planet && typeof planet.animate === 'function' && !stage.classList.contains('is-in')) {
    const frames = (stage.dataset.trace || '')
      .split(' ')
      .filter(Boolean)
      .map((p) => {
        const [x, y] = p.split(',');
        return { transform: `translate(${x}px, ${y}px)` };
      });

    if (frames.length > 2) {
      const run = () => {
        if (isReduced() || document.visibilityState === 'hidden') return;
        planet.animate(frames, {
          duration: 2600,
          delay: 700,
          easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          fill: 'backwards',
        });
      };
      stage.addEventListener('vesta:reveal', run, { once: true });
    }
  }
</script>
