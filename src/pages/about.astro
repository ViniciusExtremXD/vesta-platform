---
/**
 * /about/ (SPEC §7 /about/, SPEC_COSMOS §4, ROUND2 points 5, 8, 10).
 *
 * 1. Intro (void, living star field): label, H1 (3D word flip on load), one
 *    line of lead. The founder portrait, in colour, swings in from the right
 *    and is revealed by a wipe; a hairline orbit is drawn around it — the
 *    back half passes behind the photo, the front half across it — and one
 *    planet rides the orbit (transform-only, paused offscreen). Pointer tilt
 *    on fine pointers separates the two halves in depth. The bio lives in two
 *    expandable boxes under the lead (keywords visible, detail on demand).
 * 2. How Vesta works (paper): five statements set large. A violet rail fills
 *    as the list scrolls and each statement lights up as it crosses the
 *    reading line (scroll-linked, discrete classes; static when motion is
 *    off).
 * 3. Company facts (paper-2): the facts in two expandable boxes; the working
 *    hours as a numeral whose figures roll like drums, one full turn each.
 * 4. The name (night, stars): the 4 Vesta story — the first sentence set
 *    large, the rest in a box — beside a to-scale, face-on diagram of the
 *    orbits of Mars, 4 Vesta and Jupiter. The diagram swings up to face the
 *    reader as it scrolls in, draws once, then the three bodies keep moving
 *    at their true relative periods (Kepler timing), paused offscreen.
 * 5. Closing (violet): the finale, compact — WhatsApp and email side by side.
 */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cosmos from '../components/Cosmos.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import SplitText from '../components/ui/SplitText.astro';
import Expand from '../components/ui/Expand.astro';
import Arrow from '../components/ui/Arrow.astro';
import WaGlyph from '../components/ui/WaGlyph.astro';
import MailGlyph from '../components/ui/MailGlyph.astro';
import Asteroid from '../components/Asteroid.astro';
import portrait from '../assets/vinicius-magno.jpg';
import { about, brand, contact, contactPage, finale, footer, founder, mail, wa } from '../data/site';
import { absolute } from '../lib/url';

const showPortrait = founder.portrait.confirmed;

/* ---- typesetting helpers (the words are unchanged) --------------------- */
const WJ = String.fromCharCode(0x2060);
const NBSP = String.fromCharCode(160);
/** ranges like "Mon–Fri" or "9:00–18:00" never break at the en dash */
const keepRange = (s: string) => s.replace(/(\w)–(\w)/g, `$1${WJ}–${WJ}$2`);
/** no line ends on a stranded one-letter word; dates and measures stay whole
    ("29 March 1807", "3.63 years") */
const tie = (t: string) =>
  t
    .replace(/(^|\s)([AaI])\s+/g, (_m, pre: string, w: string) => pre + w + NBSP)
    .replace(/\b(\d{1,2}) ([A-Z][a-z]+) (\d{4})\b/g, `$1${NBSP}$2${NBSP}$3`)
    .replace(/\b(\d+(?:\.\d+)?) (years?|km|AU)\b/g, `$1${NBSP}$2`);

/* H1: one sentence per line block, each balanced on its own */
const h1Lines = about.h1.split(/(?<=\.)\s+/);
const role = `${founder.role}, ${brand.name}`;
const linkedinText = contact.linkedin.name;

/* Hours as a numeral: "Mon–Fri, 9:00–18:00" → days + range */
const [hoursDays, hoursRange] = contact.hours.short.split(/,\s*/);
const hoursMeta = [hoursDays, `${brand.city} time`, contact.hours.utcOffset];
/* the numeral as drums: digits roll one full turn, right to left */
const hoursChars = [...hoursRange].map((ch) => (/\d/.test(ch) ? { d: Number(ch) } : { s: ch }));
const digitCount = hoursChars.filter((c) => 'd' in c).length;
let seen = 0;
const hoursDrums = hoursChars.map((c) => ('d' in c ? { ...c, k: digitCount - 1 - seen++ } : c));
const strip = Array.from({ length: 20 }, (_, i) => i % 10);

/* Company facts: split into the entity and the paperwork */
const factRows = about.companyFacts.rows;
const entityRows = factRows.slice(0, 3);
const paperRows = factRows.slice(3);

/* The name: the first sentence carries the story, the rest follows */
const [nameFirst, ...nameRest] = about.theName.text.split(/(?<=\.)\s+(?=[A-Z])/);
const source = about.theName.source;

/* ======================================================================
   The orbit diagram — face-on (from above the ecliptic), to scale.
   Semi-major axes and eccentricities from site.ts (footer.orbit.bodies);
   longitudes of perihelion from JPL mean elements. Each orbit is a Kepler
   ellipse with the Sun at one focus. Planets move counter-clockwise, as
   seen from the north. viewBox units; the Sun sits where Jupiter's orbit
   is centred in the frame.
   ====================================================================== */
const VB = { w: 600, h: 560 };
const PAD = 16;
const ELEMENTS: Record<string, { peri: number; at: number; period: number }> = {
  /* peri: longitude of perihelion ϖ (deg). at: where the planet rests in
     the drawing, as a heliocentric longitude (deg) — composition only.
     period: sidereal period in years (NASA fact sheets). */
  Mars: { peri: 336.0, at: 146, period: 1.88 },
  '4 Vesta': { peri: 255.0, at: 18, period: 3.63 },
  Jupiter: { peri: 14.7, at: 232, period: 11.86 },
};
/** one lap of 4 Vesta on screen, in ms; the others keep true ratios */
const VESTA_LAP_MS = 36000;
const rad = (d: number) => (d * Math.PI) / 180;
const deg = (r: number) => (r * 180) / Math.PI;

/** orbital-plane position (AU, x toward the vernal equinox, y 90° ahead) */
const planePos = (a: number, e: number, peri: number, E: number): [number, number] => {
  const b = a * Math.sqrt(1 - e * e);
  const X = a * (Math.cos(E) - e);
  const Y = b * Math.sin(E);
  const c = Math.cos(rad(peri));
  const s = Math.sin(rad(peri));
  return [X * c - Y * s, X * s + Y * c];
};

const jup = footer.orbit.bodies.find((b) => b.name === 'Jupiter') ?? { a: 5.2, e: 0.049 };
let jMin = [Infinity, Infinity];
let jMax = [-Infinity, -Infinity];
for (let i = 0; i < 360; i++) {
  const [x, y] = planePos(jup.a, jup.e, ELEMENTS.Jupiter.peri, rad(i));
  jMin = [Math.min(jMin[0], x), Math.min(jMin[1], y)];
  jMax = [Math.max(jMax[0], x), Math.max(jMax[1], y)];
}
const S = Math.min((VB.w - 2 * PAD) / (jMax[0] - jMin[0]), (VB.h - 2 * PAD) / (jMax[1] - jMin[1]));
/* the Sun, placed so Jupiter's orbit is centred in the frame (y flips: screen y is down) */
const SUN = {
  x: VB.w / 2 - ((jMin[0] + jMax[0]) / 2) * S,
  y: VB.h / 2 + ((jMin[1] + jMax[1]) / 2) * S,
};
const toScreen = ([x, y]: [number, number]): [number, number] => [SUN.x + x * S, SUN.y - y * S];
const f2 = (n: number) => Number(n.toFixed(2));

/** eccentric anomaly whose heliocentric longitude is closest to `lon` */
const anomalyAt = (a: number, e: number, peri: number, lon: number) => {
  let best = 0;
  let bestD = Infinity;
  for (let i = 0; i < 3600; i++) {
    const E = rad(i / 10);
    const [x, y] = planePos(a, e, peri, E);
    const d = Math.abs(((deg(Math.atan2(y, x)) - lon + 540) % 360) - 180);
    if (d < bestD) {
      bestD = d;
      best = E;
    }
  }
  return best;
};

/** one lap sampled at equal TIME (uniform mean anomaly, Kepler's equation
    solved per sample), so the planet speeds up near perihelion */
const keplerLap = (a: number, e: number, peri: number, E0: number, n = 144) => {
  const M0 = E0 - e * Math.sin(E0);
  const pts: string[] = [];
  for (let k = 0; k <= n; k++) {
    const M = M0 + (k / n) * Math.PI * 2;
    let E = M;
    for (let it = 0; it < 8; it++) E -= (E - e * Math.sin(E) - M) / (1 - e * Math.cos(E));
    const [x, y] = toScreen(planePos(a, e, peri, E));
    pts.push(`${x.toFixed(2)},${y.toFixed(2)}`);
  }
  return pts.join(' ');
};

const vestaPeriod = ELEMENTS['4 Vesta'].period;
const orbits = footer.orbit.bodies.map((body, k) => {
  const el = ELEMENTS[body.name] ?? { peri: 0, at: 0, period: vestaPeriod };
  const { a, e } = body;
  const b = a * Math.sqrt(1 - e * e);
  const E0 = anomalyAt(a, e, el.peri, el.at);
  /* three 120° arcs from the resting planet, counter-clockwise on screen
     (SVG sweep-flag 0), so the stroke draws the way the planet travels */
  const pts = [0, 1, 2, 3].map((q) => toScreen(planePos(a, e, el.peri, E0 + (q * 2 * Math.PI) / 3)));
  const rot = f2(-el.peri);
  const rx = f2(a * S);
  const ry = f2(b * S);
  const d =
    `M${f2(pts[0][0])} ${f2(pts[0][1])}` +
    pts
      .slice(1)
      .map(([x, y]) => `A${rx} ${ry} ${rot} 0 0 ${f2(x)} ${f2(y)}`)
      .join('');
  const [px, py] = pts[0];
  return {
    name: body.name,
    a,
    e,
    k,
    d,
    px: f2(px),
    py: f2(py),
    vesta: body.name === '4 Vesta',
    peri: el.peri,
    E0,
    b,
    lap: keplerLap(a, e, el.peri, E0),
    lapMs: Math.round((VESTA_LAP_MS * el.period) / vestaPeriod),
  };
});

const vesta = orbits.find((o) => o.vesta)!;

/* Vesta's first lap: the planet sampled at equal ARC LENGTH along the same
   path, so with the same easing it sits exactly on the head of the stroke
   being drawn (the dash is measured in arc length too). */
const DENSE = 1440;
const dense: [number, number][] = [];
for (let i = 0; i <= DENSE; i++) dense.push(toScreen(planePos(vesta.a, vesta.e, vesta.peri, vesta.E0 + (i / DENSE) * Math.PI * 2)));
const cum = [0];
for (let i = 1; i <= DENSE; i++) cum.push(cum[i - 1] + Math.hypot(dense[i][0] - dense[i - 1][0], dense[i][1] - dense[i - 1][1]));
const total = cum[DENSE];
const STEPS = 90;
const trace: string[] = [];
for (let k = 0, j = 1; k <= STEPS; k++) {
  const target = (total * k) / STEPS;
  while (j < DENSE && cum[j] < target) j++;
  const f = (target - cum[j - 1]) / (cum[j] - cum[j - 1] || 1);
  const x = dense[j - 1][0] + (dense[j][0] - dense[j - 1][0]) * f;
  const y = dense[j - 1][1] + (dense[j][1] - dense[j - 1][1]) * f;
  trace.push(`${x.toFixed(2)},${y.toFixed(2)}`);
}

/* Dimension line: the semi-major axis, from the centre of Vesta's ellipse
   to aphelion (the centre sits a·e from the Sun, toward aphelion). */
const u: [number, number] = [Math.cos(rad(vesta.peri)), Math.sin(rad(vesta.peri))];
const C = toScreen([-vesta.a * vesta.e * u[0], -vesta.a * vesta.e * u[1]]);
const A = toScreen([-vesta.a * (1 + vesta.e) * u[0], -vesta.a * (1 + vesta.e) * u[1]]);
const dimLen = Math.hypot(A[0] - C[0], A[1] - C[1]);
const n: [number, number] = [-(A[1] - C[1]) / dimLen, (A[0] - C[0]) / dimLen];
const TICK = 5;
const dim = {
  d:
    `M${f2(C[0])} ${f2(C[1])}L${f2(A[0])} ${f2(A[1])}` +
    `M${f2(C[0] - n[0] * TICK)} ${f2(C[1] - n[1] * TICK)}L${f2(C[0] + n[0] * TICK)} ${f2(C[1] + n[1] * TICK)}` +
    `M${f2(A[0] - n[0] * TICK)} ${f2(A[1] - n[1] * TICK)}L${f2(A[0] + n[0] * TICK)} ${f2(A[1] + n[1] * TICK)}`,
  lx: f2(C[0] + (A[0] - C[0]) * 0.62),
  ly: f2(C[1] + (A[1] - C[1]) * 0.62),
  text: `a ${vesta.a} AU`,
};

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
/* HTML labels (fixed type size at every width): anchor + which side */
const labels = [
  { text: about.sun, x: SUN.x, y: SUN.y, side: 'below', cls: 'is-sun' },
  ...orbits.map((o) => ({
    text: o.name,
    x: o.px,
    y: o.py,
    /* Vesta's name always sits outside its orbit, to the right of the planet */
    side: o.vesta || o.px < VB.w * 0.62 ? 'right' : 'left',
    cls: o.vesta ? 'is-vesta' : '',
  })),
  { text: dim.text, x: dim.lx, y: dim.ly, side: 'right', cls: 'is-dim' },
];

/* ---- the portrait orbit: one ellipse, tilted like the orbit mark ------- */
const RING = { rx: 96, ry: 27, tilt: -24 };

/* the closing: "Send your current website." / "Get a free price analysis." */
const closeLines = finale.h2.split(/(?<=\.)\s+/);
/* first and last sentence of the finale body: the ask and the promise */
const closeSentences = finale.body.split(/(?<=[.?])\s+/);
const closeBody = closeSentences.length > 2 ? `${closeSentences[0]} ${closeSentences[closeSentences.length - 1]}` : finale.body;
const mailHref = mail(contact.email.subject);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.seo.title,
  url: absolute('/about/', Astro.site),
  description: about.seo.description,
  about: { '@id': `${absolute('/', Astro.site).replace(/\/$/, '')}/#organization` },
};
---

<Base title={about.seo.title} description={about.seo.description} canonical="/about/" jsonLd={jsonLd}>
  {/* ---------------------------------------------------------------- intro */}
  <section class="intro s-void" data-nav-theme="dark" aria-labelledby="about-title">
    <div class="sky" aria-hidden="true"><Cosmos variant="stars" /></div>

    <div class:list={['wrap', 'g', 'intro-grid', { solo: !showPortrait }]}>
      <header class="intro-head">
        <div data-load>
          <SectionLabel name={about.label.name} reveal={false} />
        </div>
        <SplitText as="h1" id="about-title" class="h1" lines={h1Lines} load delay={80} />
        <p class="lead intro-lead" data-load style="--d:420ms">{about.lead}</p>
      </header>

      {
        showPortrait && (
          <figure class="portrait" data-parallax="0.05">
            <div class="enter" data-inview data-ringed>
              <div class="tilt" data-tilt="6" data-light>
                <div class="ring ring-back" aria-hidden="true">
                  <svg class="ring-svg" viewBox="-100 -100 200 200" focusable="false">
                    <g transform={`rotate(${RING.tilt})`}>
                      <ellipse class="ring-path" rx={RING.rx} ry={RING.ry} pathLength="100" />
                      <g class="orb-x">
                        <g class="orb-y">
                          <circle class="orb" r="2" />
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>

                <div class="frame" data-reveal="wipe" style="--d:180ms">
                  <Picture
                    src={portrait}
                    alt={founder.portrait.alt}
                    formats={['avif', 'webp']}
                    widths={[560, 1120]}
                    sizes="(min-width: 1440px) 546px, (min-width: 1100px) calc((100vw - 96px - 264px) * 5 / 12 + 96px), (min-width: 768px) calc((100vw - 64px - 140px) / 2 + 60px), calc(100vw - 40px)"
                    width={560}
                    height={700}
                    quality={74}
                    loading="eager"
                    decoding="async"
                    class="photo"
                  />
                  <span class="light" aria-hidden="true"></span>
                </div>
                <span class="bar" aria-hidden="true" />

                <div class="ring ring-front" aria-hidden="true">
                  <svg class="ring-svg" viewBox="-100 -100 200 200" focusable="false">
                    <defs>
                      <clipPath id="ring-front-half">
                        <rect x="-110" y="0" width="220" height="60" />
                      </clipPath>
                    </defs>
                    <g transform={`rotate(${RING.tilt})`}>
                      <g clip-path="url(#ring-front-half)">
                        <ellipse class="ring-path" rx={RING.rx} ry={RING.ry} pathLength="100" />
                        <g class="orb-x">
                          <g class="orb-y">
                            <circle class="orb" r="2" />
                          </g>
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>
              </div>
            </div>
            <figcaption class="cap" data-reveal style="--d:640ms">
              <span class="cap-name">{founder.name}</span>
              <span class="cap-role label">{role}</span>
              <span class="cap-loc small">{founder.location}</span>
            </figcaption>
          </figure>
        )
      }

      <div class="intro-more">
        <Expand title={about.more.builder.title} keywords={about.more.builder.keywords} index="01" i={0}>
          {about.bio[0] && <p class="body">{tie(about.bio[0])}</p>}
          {about.bio[2] && <p class="body">{tie(about.bio[2])}</p>}
        </Expand>
        <Expand title={about.more.background.title} keywords={about.more.background.keywords} index="02" i={1}>
          {about.bio[1] && <p class="body">{tie(about.bio[1])}</p>}
          {
            contact.linkedin.confirmed && (
              <p>
                <a class="tlink" href={contact.linkedin.url} target="_blank" rel="noopener">
                  <span>{linkedinText}</span>
                  <Arrow dir="up-right" />
                </a>
              </p>
            )
          }
        </Expand>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ how vesta works */}
  <section class="how s-paper section" data-nav-theme="light" aria-labelledby="how-title">
    <div class="wrap g">
      <header class="how-head">
        <SplitText as="h2" id="how-title" class="d2 how-title" text={about.howVestaWorks.title} />
      </header>
      <div class="how-list" data-how>
        <span class="how-rail" aria-hidden="true"><span class="how-rail-fill"></span></span>
        <ol>
        {
          about.howVestaWorks.items.map((item, r) => (
            <li class="how-row" data-inview style={`--r:${r}`}>
              <span class="how-line" aria-hidden="true" />
              <span class="how-idx" aria-hidden="true">
                <span class="how-node" />
                <span class="label how-n">{String(r + 1).padStart(2, '0')}</span>
              </span>
              <p class="how-text">{tie(item)}</p>
              {r === about.howVestaWorks.items.length - 1 && <span class="how-line how-line-end" aria-hidden="true" />}
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------ company facts + hours */}
  <section class="facts s-paper-2 section" data-nav-theme="light" aria-labelledby="facts-title">
    <div class="wrap g" data-scene>
      <div class="facts-main">
        <SplitText as="h2" id="facts-title" class="d2 facts-title" text={about.companyFacts.title} />
        <div class="facts-boxes">
          <Expand title={about.more.entity.title} keywords={about.more.entity.keywords} index="01" i={0}>
            <dl class="table">
              {
                entityRows.map((row) => (
                  <div class="t-row">
                    <dt class="label">{row.label}</dt>
                    <dd>{keepRange(row.value)}</dd>
                  </div>
                ))
              }
            </dl>
          </Expand>
          <Expand title={about.more.paperwork.title} keywords={about.more.paperwork.keywords} index="02" i={1}>
            <dl class="table">
              {
                paperRows.map((row) => (
                  <div class="t-row">
                    <dt class="label">{row.label}</dt>
                    <dd>{keepRange(row.value)}</dd>
                  </div>
                ))
              }
            </dl>
          </Expand>
        </div>
      </div>

      <aside class="hours" aria-labelledby="hours-title">
        <h3 class="label hours-title" id="hours-title" data-reveal>{contactPage.hours.title}</h3>
        <p class="n1 hours-n" data-inview>
          <span class="visually-hidden">{hoursRange}</span>
          <span class="drums" aria-hidden="true">
            {
              hoursDrums.map((c) =>
                'd' in c ? (
                  <span class="drum" style={`--v:${c.d};--k:${c.k}`}>
                    <span class="strip">
                      {strip.map((s, i) => (
                        <Fragment>
                          {i > 0 && <br />}
                          {s}
                        </Fragment>
                      ))}
                    </span>
                  </span>
                ) : (
                  <span class:list={['glyph', { dash: c.s === '–' }]}>{c.s}</span>
                )
              )
            }
          </span>
        </p>
        <p class="label hours-meta" data-reveal style="--i:2">
          {
            hoursMeta.map((m, k) => (
              <Fragment>
                {k > 0 && <span class="sep" aria-hidden="true"> · </span>}
                <span class="nw">{keepRange(m)}</span>
              </Fragment>
            ))
          }
        </p>
        <div class="hours-box">
          <Expand title={about.hours.title} keywords={about.more.overlap.keywords} i={3}>
            <p class="body">{about.hours.body}</p>
          </Expand>
        </div>
      </aside>
    </div>
  </section>

  {/* ------------------------------------------------------------ the name */}
  <section class="name s-night section" data-nav-theme="dark" aria-labelledby="name-title">
    <Cosmos variant="stars" />
    <div class="wrap g name-grid" data-scene>
      <div class="name-head">
        <h2 class="sec-label label name-label" id="name-title" data-reveal>
          <span class="stripe" aria-hidden="true"></span>
          <span>{about.theName.title}</span>
        </h2>
        <SplitText as="p" class="name-first" text={tie(nameFirst)} />
      </div>

      <figure class="vesta-fig">
        <div class="vesta-body" data-inview data-ringed>
          <div class="ring ring-back" aria-hidden="true">
            <svg class="ring-svg" viewBox="-100 -100 200 200" focusable="false">
              <g transform={`rotate(${RING.tilt})`}>
                <ellipse class="ring-path" rx={RING.rx} ry={RING.ry} pathLength="100" />
                <g class="orb-x">
                  <g class="orb-y">
                    <circle class="orb" r="1.6" />
                  </g>
                </g>
              </g>
            </svg>
          </div>
          <div class="vesta-rock">
            <Asteroid size={420} drag />
          </div>
          <div class="ring ring-front" aria-hidden="true">
            <svg class="ring-svg" viewBox="-100 -100 200 200" focusable="false">
              <defs>
                <clipPath id="vesta-front-half">
                  <rect x="-110" y="0" width="220" height="60" />
                </clipPath>
              </defs>
              <g transform={`rotate(${RING.tilt})`}>
                <g clip-path="url(#vesta-front-half)">
                  <ellipse class="ring-path" rx={RING.rx} ry={RING.ry} pathLength="100" />
                  <g class="orb-x">
                    <g class="orb-y">
                      <circle class="orb" r="1.6" />
                    </g>
                  </g>
                </g>
              </g>
            </svg>
          </div>
          <span class="vesta-dim" aria-hidden="true">
            <span class="vesta-dim-line"></span>
            <span class="label vesta-dim-label">{about.asteroid.mean}</span>
          </span>
        </div>
        <figcaption class="vesta-cap" data-reveal style="--d:200ms">
          <span class="vesta-name">{about.asteroid.name}</span>
          <span class="label vesta-dims">{about.asteroid.dims}</span>
          <span class="small vesta-hint" aria-hidden="true">{about.asteroid.hint}</span>
          <a class="small src vesta-src" href={source.url} target="_blank" rel="noopener">{source.citation}<Arrow dir="up-right" size={12} /></a>
        </figcaption>
      </figure>

      <div class="name-boxes">
        <Expand title={about.more.story.title} keywords={about.more.story.keywords} index="01" i={1}>
          {nameRest.length > 0 && <p class="body">{tie(nameRest.join(' '))}</p>}
          {about.theName.closing.confirmed && <p class="body">{tie(about.theName.closing.text)}</p>}
        </Expand>
        <Expand title={about.more.orbit.title} keywords={about.more.orbit.keywords} index="02" i={2}>
          <figure class="orbit-fig">
            <div class="orbit-tilt" data-inview>
              <div class="orbit-stage" data-inview data-name-orbit data-trace={trace.join(' ')}>
                <svg class="orbit-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} aria-hidden="true" focusable="false">
                  <path class="o-dim" d={dim.d} />
                  {
                    orbits.map((o) => (
                      <path class:list={['o-path', { 'is-vesta': o.vesta }]} d={o.d} pathLength="100" style={`--k:${o.k}`} />
                    ))
                  }
                  <circle class="o-sun-ring" cx={f2(SUN.x)} cy={f2(SUN.y)} r="9" />
                  <circle class="o-sun" cx={f2(SUN.x)} cy={f2(SUN.y)} r="3.6" />
                  {
                    orbits
                      .filter((o) => !o.vesta)
                      .map((o) => (
                        <circle
                          class="o-planet"
                          cx="0"
                          cy="0"
                          r="3.2"
                          style={`--k:${o.k};transform:translate(${o.px}px, ${o.py}px)`}
                          data-kepler={o.lap}
                          data-kepler-ms={o.lapMs}
                        />
                      ))
                  }
                  <circle
                    class="o-vesta"
                    cx="0"
                    cy="0"
                    r="4.6"
                    style={`transform: translate(${vesta.px}px, ${vesta.py}px)`}
                    data-vesta-planet
                    data-kepler={vesta.lap}
                    data-kepler-ms={vesta.lapMs}
                  />
                </svg>
                {
                  labels.map((l, k) => (
                    <span
                      class:list={['o-label', 'label', `to-${l.side}`, l.cls]}
                      style={`left:${pct(l.x, VB.w)};top:${pct(l.y, VB.h)};--k:${k}`}
                      aria-hidden="true"
                    >
                      {l.text}
                    </span>
                  ))
                }
              </div>
            </div>
            <figcaption class="orbit-cap small">
              <span class="stripe" aria-hidden="true"></span>
              <span>{footer.orbit.caption}</span>
            </figcaption>
          </figure>
        </Expand>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- closing */}
  <section class="close s-violet section" data-nav-theme="dark" data-sticky-hide aria-labelledby="close-title">
    <div class="wrap g close-grid" data-scene="soft">
      <SplitText as="h2" id="close-title" class="d2 close-title" lines={closeLines} />
      <p class="lead close-body" data-reveal style="--i:1">{tie(closeBody)}</p>
      <div class="close-act">
        <div class="close-btns">
          <div class="close-cell" data-reveal style="--i:2">
            <a
              class="btn btn-star btn-lg close-btn"
              href={wa(finale.button.text)}
              target="_blank"
              rel="noopener"
              data-wa-intent="about-close"
              data-magnetic=".22"
            >
              <WaGlyph size={18} />
              <span class="b-lbl">{finale.button.label}</span>
              <Arrow />
            </a>
          </div>
          {
            contact.email.confirmed && (
              <div class="close-cell" data-reveal style="--i:3">
                <a class="btn btn-line btn-lg close-mail" href={mailHref} data-mail-intent="about-close" data-magnetic=".22">
                  <MailGlyph size={18} />
                  <span>{about.emailButton}</span>
                  <Arrow />
                </a>
              </div>
            )
          }
        </div>
        <ul class="close-lines" data-reveal style="--i:4">
          <li>
            <span class="label close-k">{contactPage.panel.label}</span>
            <a class="close-v" href={contact.whatsapp.url} target="_blank" rel="noopener">{contact.whatsapp.display}</a>
          </li>
          {
            contact.email.confirmed && (
              <li>
                <span class="label close-k">{contact.email.label}</span>
                <a class="close-v" href={mailHref}>{contact.email.address}</a>
              </li>
            )
          }
        </ul>
        <p class="small close-reassure" data-reveal style="--i:5">{finale.reassurance}</p>
        {
          contact.linkedin.confirmed && (
            <p class="close-links" data-reveal style="--i:6">
              <a class="tlink" href={contact.linkedin.url} target="_blank" rel="noopener">
                <span>{contact.linkedin.label.replace(/\s*↗\s*$/, '')}</span>
                <Arrow dir="up-right" />
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* =====================================================================
     1. intro
     ===================================================================== */
  .intro {
    position: relative;
    overflow: clip;
    padding-block: calc(var(--nav-h) + clamp(3rem, 1.6rem + 5.4vw, 7rem)) clamp(5rem, 3.2rem + 6vw, 9rem);
  }

  /* the star field covers the first screen and thins out under the boxes */
  .sky {
    position: absolute;
    inset: 0 0 auto;
    height: min(100%, max(100svh, 820px));
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .intro-grid {
    position: relative;
    z-index: 1;
    align-items: start;
  }

  .h1 {
    max-width: 11.5ch;
    margin-top: 28px;
    font-size: clamp(2.5rem, 1.1rem + 5vw, 5.5rem);
    line-height: 0.98;
  }

  .intro-lead {
    max-width: 30ch;
    margin-top: 32px;
    color: var(--haze);
  }

  .intro-more {
    margin-top: 64px;
  }

  .intro-more :global(.xp:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .intro-more :global(.xp-inner) > :global(p + p) {
    margin-top: 14px;
  }

  /* ---- portrait ---- */
  .portrait {
    position: relative;
    margin: 72px 0 0;
  }

  /* the whole plate swings in from the right, hinged on its right edge */
  .enter {
    transform-origin: 100% 50%;
    transition:
      transform 1800ms var(--ease-expo),
      opacity 700ms linear;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .enter:not(.is-in) {
    opacity: 0;
    transform: perspective(1400px) rotateY(-26deg) translate3d(72px, 0, 0) scale(0.94);
  }

  .tilt {
    position: relative;
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: clip;
    background-color: var(--plate);
  }

  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame :global(img) {
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* a soft light inside the photo that follows the pointer (fine pointers;
     transform + opacity only, the gradient itself never moves) */
  .light {
    position: absolute;
    inset: -50%;
    background: radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0) 34%);
    opacity: 0;
    transform: translate3d(calc((var(--lx, 0.5) - 0.5) * 50%), calc((var(--ly, 0.5) - 0.5) * 50%), 0);
    transition: opacity 600ms var(--ease-expo);
    pointer-events: none;
  }

  .is-lit .light {
    opacity: 1;
  }

  /* ---- the orbit around the portrait ----
     Two copies of one ellipse share the plate's box: the back copy sits
     behind the photo (only its ends show), the front copy is clipped to the
     near half and sits over it. In the tilt's 3D space they are 24px apart;
     the scale compensates the perspective so at rest they meet exactly. */
  .ring {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ring-back {
    transform: translate3d(0, 0, -24px) scale(1.0218);
  }

  .ring-front {
    transform: translate3d(0, 0, 24px) scale(0.9782);
  }

  .ring-svg {
    position: absolute;
    left: 50%;
    top: var(--ring-top, 47%);
    width: var(--ring-w, 150%);
    aspect-ratio: 1;
    overflow: visible;
    transform: translate(-50%, -50%);
  }

  /* stroke widths in viewBox units (1 unit ≈ 2.2px on phones, ≈ 4px on
     desktop): non-scaling-stroke would break the pathLength dash */
  .ring-path {
    fill: none;
    stroke: var(--lilac);
    stroke-width: 0.5;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2000ms var(--ease-quint) 700ms;
  }

  .ring-front .ring-path {
    stroke: var(--starlight);
    stroke-width: 0.55;
  }

  @media (min-width: 768px) {
    .ring-path {
      stroke-width: 0.32;
    }

    .ring-front .ring-path {
      stroke-width: 0.36;
    }
  }

  .orb {
    fill: var(--starlight);
    transition: opacity 700ms linear;
  }

  /* at rest (no JS, motion off): the planet waits on the near side */
  .orb-x {
    transform: translateX(48px);
  }

  .orb-y {
    transform: translateY(23.4px);
  }

  /* one lap = 2 × --orb-t; x and y run a quarter lap apart (sine-eased), so
     the planet traces the ellipse with transforms only */
  .ring {
    --orb-t: 9s;
  }

  .ring.is-live .orb-x {
    animation: orb-x var(--orb-t) cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
  }

  .ring.is-live .orb-y {
    animation: orb-y var(--orb-t) cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
    animation-delay: calc(var(--orb-t) / -2);
  }

  .ring.is-paused .orb-x,
  .ring.is-paused .orb-y {
    animation-play-state: paused;
  }

  @keyframes orb-x {
    from {
      transform: translateX(96px);
    }
    to {
      transform: translateX(-96px);
    }
  }

  @keyframes orb-y {
    from {
      transform: translateY(-27px);
    }
    to {
      transform: translateY(27px);
    }
  }

  :global(html.motion-reduced) .orb-x,
  :global(html.motion-reduced) .orb-y,
  :global(html.motion-failed) .orb-x,
  :global(html.motion-failed) .orb-y {
    animation: none !important;
  }

  /* armed: nothing drawn, no planet, until the plate is in */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) [data-ringed]:not(.is-in) .ring-path {
    stroke-dashoffset: 100;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .ring:not(.is-live) .orb {
    opacity: 0;
  }

  /* 2px violet bar: bottom edge on phones (draws left → right), right edge
     from 768px (grows bottom → top), after the wipe starts */
  .bar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--violet);
    transform-origin: left center;
    pointer-events: none;
    transition:
      transform var(--t-line) var(--ease-quint) 520ms,
      opacity 200ms linear 520ms;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:not(.is-in) + .bar {
    opacity: 0;
    transform: scaleX(0);
  }

  @media (min-width: 768px) {
    .bar {
      top: 0;
      left: auto;
      width: 2px;
      height: auto;
      transform-origin: center bottom;
    }

    :global(html.js:not(.motion-reduced):not(.motion-failed)) .frame:not(.is-in) + .bar {
      transform: scaleY(0);
    }
  }

  .cap {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 16px;
    padding-top: 18px;
  }

  .cap-name {
    font-stretch: var(--wd-display);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.005em;
    color: var(--starlight);
  }

  .cap-role {
    color: var(--dim);
  }

  .cap-loc {
    grid-column: 1 / -1;
    color: var(--dim);
  }

  /* phones: the orbit is a little tighter so the planet stays in frame */
  @media (max-width: 767.98px) {
    .ring-svg {
      width: 128%;
    }
  }

  @media (min-width: 768px) {
    .intro-head {
      grid-column: 1 / 5;
    }

    .portrait {
      grid-column: 5 / 9;
      grid-row: 1 / span 2;
      margin-top: 24px;
    }

    .intro-more {
      grid-column: 1 / 5;
      grid-row: 2;
      margin-top: 72px;
    }

    .solo .intro-head,
    .solo .intro-more {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .intro-head {
      grid-column: 1 / 8;
    }

    .portrait {
      grid-column: 8 / 13;
      margin-top: 36px;
    }

    .intro-more {
      grid-column: 1 / 7;
      margin-top: 88px;
    }

    .solo .intro-more {
      grid-column: 1 / 8;
    }
  }

  /* =====================================================================
     2. how vesta works
     ===================================================================== */
  .how-title {
    max-width: 9ch;
  }

  .how-list {
    position: relative;
    margin-top: 48px;
  }

  /* the rail through the nodes; the violet fill follows the reading line */
  .how-rail {
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--line);
  }

  .how-rail-fill {
    position: absolute;
    inset: 0 -0.5px;
    background-color: var(--violet);
    transform-origin: center top;
    transform: scaleY(1);
  }

  .how-list.is-scrub .how-rail-fill {
    transform: scaleY(var(--hp, 0));
  }

  .how-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-items: baseline;
    padding-block: 26px 28px;
  }

  .how-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: var(--line-strong);
    transform-origin: left center;
    transition:
      transform 1100ms var(--ease-quint),
      opacity 200ms linear;
    transition-delay: calc(var(--r, 0) * 70ms);
  }

  .how-line-end {
    top: auto;
    bottom: 0;
    background-color: var(--line);
  }

  .how-idx {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition:
      transform var(--t-reveal) var(--ease-expo),
      opacity var(--t-reveal) var(--ease-expo);
    transition-delay: calc(var(--r, 0) * 70ms + 100ms);
  }

  .how-node {
    display: inline-block;
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border: 1px solid var(--violet);
    background-color: var(--violet);
    transition:
      background-color 360ms var(--ease-expo),
      transform 600ms var(--ease-settle);
  }

  .how-n {
    color: var(--violet-ink);
  }

  .how-text {
    font-stretch: var(--wd-display);
    font-size: clamp(1.375rem, 1.02rem + 1.3vw, 2.375rem);
    font-weight: 580;
    line-height: 1.12;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
    transform-origin: 0 100%;
    transition:
      transform 1200ms var(--ease-expo),
      opacity 700ms var(--ease-expo),
      color 500ms linear;
    transition-delay: calc(var(--r, 0) * 70ms + 160ms), calc(var(--r, 0) * 70ms + 160ms), 0ms;
  }

  /* scroll-lit: statements below the reading line wait in ink-3 (5.7:1),
     the one on the line fills its node and scales the node up once */
  .how-list.is-scrub .how-row:not(.is-lit) .how-text {
    color: var(--ink-3);
  }

  .how-list.is-scrub .how-row:not(.is-lit) .how-node {
    background-color: var(--paper);
  }

  .how-list.is-scrub .how-row.is-now .how-node {
    transform: scale(1.45);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .how-row:not(.is-in) .how-line {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .how-row:not(.is-in) .how-idx {
    opacity: 0;
    transform: translate3d(-12px, 0, 0);
  }

  /* each statement flips up from its baseline, like the headlines */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .how-row:not(.is-in) .how-text {
    opacity: 0;
    transform: perspective(700px) translate3d(0, 28px, 0) rotateX(-38deg);
  }

  @media (min-width: 768px) {
    .how-row {
      grid-template-columns: 88px minmax(0, 1fr);
      padding-block: 34px 36px;
    }
  }

  @media (min-width: 1100px) {
    .how-head {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--nav-h) + 48px);
      align-self: start;
    }

    .how-list {
      grid-column: 5 / 13;
      margin-top: 0;
    }

    .how-row {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      column-gap: var(--gap);
      padding-block: 40px 42px;
    }

    .how-idx {
      grid-column: 1 / 2;
    }

    .how-text {
      grid-column: 2 / 9;
    }
  }

  /* =====================================================================
     3. company facts + hours
     ===================================================================== */
  .facts-title {
    max-width: 12ch;
  }

  .facts-boxes {
    margin-top: 44px;
  }

  .facts-boxes :global(.xp:last-child),
  .hours-box :global(.xp:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .table {
    display: grid;
  }

  .t-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 4px;
    padding-block: 12px 13px;
    border-top: 1px solid var(--line);
  }

  .t-row:first-child {
    border-top: 0;
    padding-top: 2px;
  }

  .t-row dt {
    color: var(--ink-2);
  }

  .t-row dd {
    margin: 0;
    font-stretch: var(--wd-display);
    font-size: 1.0625rem;
    font-weight: 520;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .t-row {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--gap);
      align-items: baseline;
    }

    .t-row dt {
      grid-column: 1 / 3;
    }

    .t-row dd {
      grid-column: 3 / 7;
    }
  }

  .hours {
    margin-top: 88px;
  }

  .hours-title {
    color: var(--ink-2);
  }

  /* the numeral: every digit is a drum (a strip of 0–9 twice) in a window
     exactly one figure tall. Default = the final digit on the second copy,
     so no-JS and motion-off read the hours; armed, the strips wait on the
     first copy and roll one full turn on .is-in, right to left. */
  .hours-n {
    margin-top: 20px;
    color: var(--ink);
    white-space: nowrap;
    font-variant-numeric: normal;
    letter-spacing: 0;
  }

  .drums {
    display: inline-flex;
    align-items: flex-start;
    line-height: 1;
  }

  .drum {
    display: inline-block;
    width: 0.64em;
    height: 1em;
    overflow: clip;
    text-align: center;
  }

  .strip {
    display: block;
    line-height: 1;
    transform: translate3d(0, calc((var(--v) + 10) * -1em), 0);
    transition: transform 1500ms var(--ease-expo);
    transition-delay: calc(240ms + var(--k, 0) * 90ms);
  }

  .glyph {
    display: inline-block;
    height: 1em;
    transition: opacity 700ms linear 500ms;
  }

  .glyph.dash {
    padding-inline: 0.06em;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .hours-n:not(.is-in) .strip {
    transform: translate3d(0, calc(var(--v) * -1em), 0);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .hours-n:not(.is-in) .glyph {
    opacity: 0;
  }

  .hours-meta {
    margin-top: 18px;
    color: var(--ink-2);
    line-height: 1.6;
  }

  .nw {
    white-space: nowrap;
  }

  .sep {
    color: var(--ink-3);
  }

  .hours-box {
    margin-top: 36px;
  }

  /* Expand without an index: keep the icon in the last column */
  .hours-box :global(.xp-head:first-child) {
    grid-column: 1 / 3;
  }

  @media (min-width: 768px) {
    .facts-main {
      grid-column: 1 / 8;
    }

    .hours {
      grid-column: 1 / 7;
    }
  }

  @media (min-width: 1100px) {
    .facts-main {
      grid-column: 1 / 7;
    }

    .facts-boxes {
      margin-top: 64px;
    }

    .hours {
      grid-column: 8 / 13;
      grid-row: 1;
      margin-top: 0;
      padding-top: 10px;
    }
  }

  /* =====================================================================
     4. the name
     ===================================================================== */
  .name {
    position: relative;
    overflow: clip;
  }

  .name-grid {
    position: relative;
    z-index: 1;
    align-items: start;
  }

  .name-first {
    max-width: 20ch;
    margin-top: 32px;
    font-stretch: var(--wd-display);
    font-size: var(--t-d3);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.012em;
    color: var(--starlight);
    text-wrap: balance;
  }

  .name-boxes {
    margin-top: 40px;
  }

  .name-boxes :global(.xp:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .name-boxes :global(.xp-inner) > :global(p + p) {
    margin-top: 14px;
  }

  /* ---- 4 Vesta, the hero object ---- */
  .vesta-fig {
    position: relative;
    margin: 48px 0 0;
  }

  /* the rock arrives out of depth: from far behind the plane, turned away,
