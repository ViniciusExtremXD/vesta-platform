  /* =====================================================================
     5. closing (the finale, compact)
     ===================================================================== */
  .close {
    overflow-x: clip;
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
  }

  /* the 3D scene entrance must never widen the page */
  .facts {
