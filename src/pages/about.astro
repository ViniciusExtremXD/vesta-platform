---
import Base from '../layouts/Base.astro';
import Founder from '../components/home/Founder.astro';
import Process from '../components/home/Process.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { brand, terms } from '../data/site';
import Icon from '../components/Icon.astro';

const termCards = [
  { icon: 'bolt', title: 'How you pay', body: terms.payment },
  { icon: 'shield', title: 'What you receive', body: terms.documents },
  { icon: 'check', title: 'The contract', body: terms.contract },
  { icon: 'check', title: 'Who owns the work', body: terms.ownership },
  { icon: 'clock', title: 'If it is not right', body: terms.revisions },
] as const;

const title = `About ${brand.name} — one founder, no hand-offs`;
const description =
  'Vesta is a one-person web studio in São Paulo building sub-second sites and landing pages for businesses abroad. How it works, how you pay, what you own.';
---

<Base title={title} description={description} canonical="/about/">
  <section class="page-head on-void">
    <div class="wrap wrap-wide">
      <p class="kicker" data-reveal="up">About</p>
      <h1 data-split>The studio is one person. <em>That is the product.</em></h1>
      <p class="lead" data-reveal="up" style="--i:2">
        Vesta builds websites and landing pages for businesses outside Brazil — most of them in the United States — that pay
        for traffic and need the page to earn it back. Every project is designed, written, coded and launched by the founder.
      </p>
    </div>
  </section>

  <Founder level={2} />

  <section class="terms section on-paper" id="terms">
    <div class="wrap wrap-wide">
      <div class="section-head">
        <p class="kicker" data-reveal="up">Working together</p>
        <h2 data-split>The operational questions, <em>answered before you ask.</em></h2>
      </div>
      <ul class="terms-grid">
        {
          termCards.map((t, i) => (
            <li data-reveal="up" style={`--i:${i + 1}`}>
              <article class="card terms-card" data-glow>
                <span class="terms-icon">
                  <Icon name={t.icon} size={18} />
                </span>
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Process />
  <FinalCta />
</Base>

<style>
  .page-head {
    padding-block: calc(var(--nav-h) + clamp(3rem, 2rem + 5vw, 6rem)) clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .page-head > .wrap > * + * {
    margin-top: var(--space-m);
  }

  .page-head h1 {
    max-width: 16ch;
  }

  .terms-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .terms-card {
    height: 100%;
    gap: var(--space-xs);
  }

  .terms-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-s);
    background: var(--violet-soft);
    color: var(--violet-ink);
    margin-bottom: var(--space-2xs);
  }

  .terms-card h3 {
    font-size: var(--step-1);
  }

  .terms-card p {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
