</style>

<script>
  import { addFrame, isReduced, vestibular } from '../scripts/motion';

  const onScreen = (el: Element, cb: (visible: boolean) => void) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver((entries) => entries.forEach((e) => cb(e.isIntersecting)), { rootMargin: '120px 0px' }).observe(el);
  };

  /* ---- 1. the orbits around the portrait and around 4 Vesta ------------
     CSS draws each ring once its host is in; the planet starts when the
     line has closed (2.3s later), then loops. Paused offscreen and in
     hidden tabs; motion off leaves the planet at rest on the near side. */
  document.querySelectorAll<HTMLElement>('[data-ringed]').forEach((host) => {
    const rings = Array.from(host.querySelectorAll<HTMLElement>('.ring'));
    if (!rings.length) return;
    let started = false;
    let inView = true;
    const sync = () => rings.forEach((r) => r.classList.toggle('is-paused', !inView || document.hidden));
    const start = () => {
      if (started || isReduced()) return;
      started = true;
      window.setTimeout(() => rings.forEach((r) => r.classList.add('is-live')), 2300);
    };
    if (host.classList.contains('is-in')) start();
    else host.addEventListener('vesta:reveal', start, { once: true });
    document.addEventListener('vesta:motion', () => {
      if (!isReduced()) start();
    });
    onScreen(host, (v) => {
      inView = v;
      sync();
    });
    document.addEventListener('visibilitychange', sync);
  });

  /* ---- pointer light inside the portrait (fine pointers) ----------------- */
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-light]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        if (isReduced()) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--lx', ((e.clientX - r.left) / r.width).toFixed(3));
        el.style.setProperty('--ly', ((e.clientY - r.top) / r.height).toFixed(3));
        el.classList.add('is-lit');
      });
      el.addEventListener('pointerleave', () => el.classList.remove('is-lit'));
    });
  }

  /* ---- 2. how vesta works: the reading line ------------------------------ */
  const how = document.querySelector<HTMLElement>('[data-how]');
  if (how) {
    const rows = Array.from(how.querySelectorAll<HTMLElement>('.how-row'));
    let scrub = false;
    let near = false;
    let p = 0;
    let active = -1;
    addFrame({
      read(_y, vh) {
        scrub = !vestibular();
        const r = how.getBoundingClientRect();
        near = r.bottom > -vh * 0.5 && r.top < vh * 1.5;
        if (!scrub || !near) return;
        const line = vh * 0.62;
        p = Math.min(1, Math.max(0, (line - r.top) / r.height));
        active = -1;
        rows.forEach((row, i) => {
          if (row.getBoundingClientRect().top < line) active = i;
        });
      },
      write() {
        how.classList.toggle('is-scrub', scrub);
        if (!scrub || !near) return;
        how.style.setProperty('--hp', p.toFixed(4));
        rows.forEach((row, i) => {
          row.classList.toggle('is-lit', i <= active);
          row.classList.toggle('is-now', i === active);
        });
      },
    });
  }

  /* ---- 4. the orbit diagram (inside "The orbit, to scale") -------------
     On reveal (the box opening) Vesta rides the head of its own line for
     one lap (same easing, duration and delay as the stroke), then all three
     bodies keep moving at their true relative periods, sampled at equal
     time (Kepler). Transform only; paused offscreen and in hidden tabs. */
  const stage = document.querySelector<HTMLElement>('[data-name-orbit]');
  const vestaDot = stage?.querySelector<SVGCircleElement>('[data-vesta-planet]');
  if (stage && vestaDot && typeof vestaDot.animate === 'function') {
    const toFrames = (s: string) =>
      s
        .split(' ')
        .filter(Boolean)
        .map((p) => {
          const [x, y] = p.split(',');
          return { transform: `translate(${x}px, ${y}px)` };
        });
    const bodies = Array.from(stage.querySelectorAll<SVGCircleElement>('[data-kepler]'));
    const DRAW_DELAY = 700;
    const DRAW_MS = 2600;
    let loops: Animation[] = [];
    let inView = true;
    let revealed = stage.classList.contains('is-in');

    const sync = () => loops.forEach((a) => (inView && !document.hidden ? a.play() : a.pause()));
    const stopLoops = () => {
      loops.forEach((a) => a.cancel());
      loops = [];
    };
    const startLoops = (delay: number) => {
      if (loops.length || isReduced()) return;
      loops = bodies
        .map((b) => {
          const frames = toFrames(b.dataset.kepler || '');
          const ms = Number(b.dataset.keplerMs) || 36000;
          if (frames.length < 3) return null;
          return b.animate(frames, { duration: ms, delay, iterations: Infinity, easing: 'linear' });
        })
        .filter((a): a is Animation => a !== null);
      sync();
    };
    const run = () => {
      revealed = true;
      if (isReduced() || document.hidden) return startLoops(0);
      const lap = toFrames(stage.dataset.trace || '');
      if (lap.length > 2) {
        vestaDot.animate(lap, { duration: DRAW_MS, delay: DRAW_DELAY, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'backwards' });
      }
      startLoops(DRAW_DELAY + DRAW_MS);
    };

    if (revealed) startLoops(0);
    else stage.addEventListener('vesta:reveal', run, { once: true });
    document.addEventListener('vesta:motion', () => {
      if (isReduced()) stopLoops();
      else if (revealed) startLoops(0);
    });
    onScreen(stage, (v) => {
      inView = v;
      sync();
    });
    document.addEventListener('visibilitychange', sync);
  }
</script>
