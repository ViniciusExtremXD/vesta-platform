---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Finale from '../components/home/Finale.astro';
import HeroPortrait from '../components/cloud/HeroPortrait.astro';
import Catalog from '../components/cloud/Catalog.astro';
import Doors from '../components/cloud/Doors.astro';
import { brand, cloudHero, cloudFinale } from '../data/site';

/* The home page is a short hub for the Azure practice: the promise with the
   founder's face, the six main services (each a link to its entry on
   /azure/), one door per page, the close. `expect` holds the first render
   until the doors are parsed, so a page transition back home can grow the
   page head back into its door. */
---

<Base title={brand.seo.title} description={brand.seo.description} canonical="/" expect="start">
  <Hero data={cloudHero} spec={false}>
    <HeroPortrait slot="stage" />
  </Hero>
  <Catalog variant="tiles" />
  <Doors />
  <Finale data={cloudFinale} />
</Base>
