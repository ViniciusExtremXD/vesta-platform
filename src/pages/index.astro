---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Problem from '../components/home/Problem.astro';
import Services from '../components/home/Services.astro';
import Shutter from '../components/home/Shutter.astro';
import Build from '../components/home/Build.astro';
import Visibility from '../components/home/Visibility.astro';
import TestDrive from '../components/home/TestDrive.astro';
import Pricing from '../components/home/Pricing.astro';
import Configurator from '../components/home/Configurator.astro';
import Process from '../components/home/Process.astro';
import Builder from '../components/home/Builder.astro';
import Faq from '../components/home/Faq.astro';
import Finale from '../components/home/Finale.astro';
import { brand, faq, packages, confirmedOnly } from '../data/site';

/* FAQPage from the same rendered, confirmed answers. */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: confirmedOnly(faq).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const offersLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${brand.name} packages`,
  itemListElement: packages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: p.name,
      description: p.tagline,
      provider: { '@type': 'ProfessionalService', name: brand.name },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        ...(p.price.max && p.price.max !== p.price.min
          ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: p.price.min, maxPrice: p.price.max, priceCurrency: 'USD' } }
          : { price: p.price.min }),
      },
    },
  })),
};
---

<Base title={brand.seo.title} description={brand.seo.description} canonical="/" jsonLd={[faqLd, offersLd]}>
  <Hero />
  <Problem />
  <Services />
  <Shutter />
  <Build />
  <Visibility />
  <TestDrive />
  <Pricing />
  <Configurator />
  <Process />
  <Builder />
  <Faq />
  <Finale />
</Base>
