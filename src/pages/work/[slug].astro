---
/**
 * /work/[slug]/ — one page per CONFIRMED case study. Nothing builds until an
 * entry in src/content/cases has `confirmed: true` (client permission plus
 * measured numbers; see content.config.ts). The template lives in
 * components/work/CaseStudy.astro.
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/work/CaseStudy.astro';
import { work } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).filter((c) => c.data.confirmed);
  return cases.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: work.label.name, item: url('/work/') },
    { '@type': 'ListItem', position: 2, name: d.title },
  ],
};
---

<Base title={`${d.title} · Vesta`} description={d.summary} canonical={`/work/${entry.id}/`} ogType="article" jsonLd={breadcrumbs}>
  <CaseStudy data={d}>
    <Content />
  </CaseStudy>
</Base>
