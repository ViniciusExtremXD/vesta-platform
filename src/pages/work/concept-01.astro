---
/**
 * /work/concept-01/ — SPEC §7 (noindex, follow). Concept 01 is a STUDY:
 * Halden Roofing is fictional, and the page never lets that slip.
 *
 *   banner (night)   persistent: sticky, rides under the nav and takes the
 *                    top edge when the nav hides (class state, transform only)
 *   head (void)      CONCEPT 01 · "Halden Roofing, rebuilt." · lead · the brief
 *   before (paper)   the 2016 template, A1–A4 on the plate + list
 *   after (void)     the rebuild, B1–B4, mirrored
 *   layers (night)   the six layers, a static exploded view
 *   pricing (paper)  "How it would be priced" — the Complete Website plate
 *
 * No LocalBusiness schema, .example domain, 555-01xx number (site.ts concept).
 */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/work/PageHead.astro';
import AnnotatedPlate from '../../components/work/AnnotatedPlate.astro';
import ExplodedPlate from '../../components/work/ExplodedPlate.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import SplitText from '../../components/ui/SplitText.astro';
import Arrow from '../../components/ui/Arrow.astro';
import WaGlyph from '../../components/ui/WaGlyph.astro';
import { conceptPage as C, concept, getPackage, pricing, wa } from '../../data/site';
import { url } from '../../lib/url';

/* TODO_SITE: strings not in site.ts — the brief's fact-table labels and the
   link from the pricing line to the full price list. */
const TODO_SITE = {
  facts: { business: 'Business', city: 'City', domain: 'Domain', phone: 'Phone', status: 'Status' },
  status: 'Fictional',
  allPrices: { label: 'See every package', href: '/#pricing' },
};

const pkg = getPackage('complete');
/* 'from $750' → the word before the amount, set small beside the numeral */
const fromWord = pkg.price.from ? pkg.price.display.replace(/\$[\d,–]+/, '').trim() : '';
const bare = (s: string) => s.replace(/\s*→\s*$/, '');

/* banner: the first sentence carries the weight, the rest reads in haze */
const cut = C.banner.indexOf('. ');
const bannerA = cut > 0 ? C.banner.slice(0, cut + 1) : C.banner;
const bannerB = cut > 0 ? C.banner.slice(cut + 2) : '';

const facts = [
  { label: TODO_SITE.facts.business, value: concept.name },
  { label: TODO_SITE.facts.city, value: concept.city },
  { label: TODO_SITE.facts.domain, value: concept.domain },
  { label: TODO_SITE.facts.phone, value: concept.phone },
  { label: TODO_SITE.facts.status, value: TODO_SITE.status },
];
---

<Base title={C.seo.title} description={C.seo.description} canonical="/work/concept-01/" noindex={C.seo.noindex}>
  <div class="cbn s-night" role="note">
    <div class="wrap cbn-in" data-load>
      <span class="stripe cbn-mark" aria-hidden="true"></span>
      <p class="small cbn-text">
        <strong class="cbn-a">{bannerA}</strong>
        {bannerB && <span class="cbn-b"> {bannerB}</span>}
      </p>
    </div>
  </div>

  <PageHead label={C.label.name} h1={C.h1} lead={C.lead} class="c-head">
    <span slot="meta">{concept.domain}</span>
    <div class="brief">
      <p class="label brief-k">{C.brief.title}</p>
      <p class="body brief-t">{C.brief.text}</p>
      <dl class="brief-facts">
        {
          facts.map((f) => (
            <div class="brief-row">
              <dt class="small">{f.label}</dt>
              <dd class="small">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </PageHead>

  <section id="before" class="s-paper section c-sec" data-nav-theme="light" aria-labelledby="before-title">
    <div class="wrap">
      <AnnotatedPlate title={C.before.title} titleId="before-title" state="before" notes={C.before.annotations} side="right" />
    </div>
  </section>

  <section id="after" class="s-void section c-sec c-after" data-nav-theme="dark" aria-labelledby="after-title">
    <div class="wrap">
      <AnnotatedPlate title={C.after.title} titleId="after-title" state="after" notes={C.after.annotations} side="left" />
    </div>
  </section>

  <section id="layers" class="s-night section c-sec c-layers" data-nav-theme="dark" aria-labelledby="layers-title">
    <div class="wrap">
      <div class="g c-layers-head">
        <SplitText as="h2" id="layers-title" class="d2 c-layers-title" text={C.layers.title} />
      </div>
      <ExplodedPlate />
    </div>
  </section>

  <section id="priced" class="s-paper section c-sec c-price" data-nav-theme="light" aria-labelledby="price-title">
    <div class="wrap g c-price-grid">
      <div class="c-price-copy">
        <SplitText as="h2" id="price-title" class="d2 c-price-title" text={C.pricing.title} />
        <p class="lead c-price-text" data-reveal style="--i:2">{C.pricing.text}</p>
        <p class="c-price-all" data-reveal style="--i:3">
          <a class="tlink" href={url(TODO_SITE.allPrices.href)}>
            <span>{TODO_SITE.allPrices.label}</span>
            <Arrow />
          </a>
        </p>
      </div>

      <div class="c-plate" data-reveal style="--d:160ms">
        <p class="label c-plate-name">{pkg.name}</p>
        <p class="c-plate-price">
          {fromWord && <span class="c-from">{fromWord}</span>}
          <span class="c-amt n2"><span class="c-cur">$</span>{pkg.price.min}</span>
          <span class="label c-usd">{pkg.price.currency}</span>
        </p>
        {pkg.price.sub && <p class="small c-plate-sub">{pkg.price.sub}</p>}
        <DimensionLine label={pkg.daysLabel} ratio={pkg.dayRange[1] / pricing.dayScaleMax} delay={300} class="c-plate-dim" />
        <div class="c-plate-cta">
          <a class="btn" href={wa(C.pricing.cta.text)} target="_blank" rel="noopener" data-wa-intent="concept-pricing">
            <WaGlyph size={16} />
            <span>{bare(C.pricing.cta.label)}</span>
            <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============================================================ banner */
  /* Persistent: sticky at the top of <main>. While the nav is showing, the
     banner rides directly under it; when the nav hides on the way down, the
     banner takes the top edge. Transform only, same easings as the nav. */
  .cbn {
    position: sticky;
    top: 0;
    z-index: calc(var(--z-nav) - 1);
    border-bottom: 1px solid var(--line-dark);
    transform: translate3d(0, var(--nav-h), 0);
    transition: transform 480ms var(--ease-expo);
  }

  :global(html:has(.nav.is-hidden:not(:focus-within))) .cbn {
    transform: none;
    transition: transform 380ms var(--ease-quint);
  }

  .cbn-in {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding-block: 10px;
  }

  .cbn-mark {
    --mark: var(--lilac);
  }

  .cbn-text {
    color: var(--haze);
    line-height: 1.4;
  }

  .cbn-a {
    color: var(--starlight);
    font-weight: 620;
  }

  /* ============================================================== head */

  .brief {
    border-top: 1px solid var(--line-dark-strong);
    padding-top: 20px;
  }

  .brief-k {
    color: var(--lilac);
  }

  .brief-t {
    margin-top: 14px;
    color: var(--starlight);
    max-width: 36ch;
  }

  .brief-facts {
    margin-top: 24px;
  }

  .brief-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 12px;
    padding-block: 9px;
    border-top: 1px solid var(--line-dark);
  }

  .brief-row dt {
    color: var(--dim);
  }

  .brief-row dd {
    margin: 0;
    color: var(--haze);
    overflow-wrap: anywhere;
  }

  /* ========================================================== sections */

  .c-after {
    overflow: clip;
    background-image: radial-gradient(45% 55% at 70% 45%, rgb(98 54 232 / 0.09), transparent 70%);
  }

  .c-layers {
    overflow: clip;
    background-image: radial-gradient(40% 50% at 32% 58%, rgb(185 162 255 / 0.06), transparent 70%);
  }

  .c-layers-head {
    margin-bottom: clamp(1rem, 0rem + 2vw, 2rem);
  }

  .c-layers-title {
    max-width: 12ch;
  }

  /* ============================================================ pricing */

  .c-price-grid {
    row-gap: 56px;
    align-items: end;
  }

  .c-price-title {
    max-width: 11ch;
  }

  .c-price-text {
    margin-top: 28px;
    color: var(--ink-2);
  }

  .c-price-all {
    margin-top: 28px;
  }

  /* the Complete Website plate: a facet of night on paper (SPEC §2.5 allows
     the chamfer here). The element paints the void itself so the contrast
     gate reads starlight on void. */
  .c-plate {
    --fg: var(--starlight);
    --fg-2: var(--haze);
    --fg-3: var(--dim);
    --line: var(--line-dark);
    --line-strong: var(--line-dark-strong);
    padding: 36px 28px 32px;
    background-color: var(--void);
    /* one faint nebula pool in the far corner (≤10%) */
    background-image: radial-gradient(70% 60% at 100% 100%, rgb(98 54 232 / 0.1), transparent 72%);
    color: var(--starlight);
    clip-path: var(--chamfer);
  }

  .c-plate-name {
    color: var(--lilac);
  }

  .c-plate-price {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 22px;
    line-height: 1;
  }

  .c-from {
    align-self: flex-end;
    padding-bottom: 0.3em;
    color: var(--haze);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .c-amt {
    display: inline-flex;
    align-items: flex-start;
    color: var(--starlight);
    font-variant-numeric: lining-nums proportional-nums;
  }

  .c-cur {
    margin-top: 0.08em;
    margin-right: 0.04em;
    font-size: 0.45em;
    font-weight: 560;
  }

  .c-usd {
    align-self: flex-end;
    padding-bottom: 0.55em;
    color: var(--haze);
    font-size: 11px;
  }

  .c-plate-sub {
    margin-top: 16px;
    color: var(--haze);
    max-width: 34ch;
  }

  .c-plate :global(.c-plate-dim) {
    margin-top: 28px;
  }

  .c-plate-cta {
    margin-top: 32px;
  }

  @media (max-width: 479px) {
    .c-plate-cta .btn {
      width: 100%;
      padding-inline: 20px;
    }
  }

  @media (min-width: 768px) {
    .c-plate {
      grid-column: 1 / span 6;
      padding: 44px 40px 40px;
    }

    .c-price-copy {
      grid-column: 1 / span 6;
    }
  }

  @media (min-width: 1100px) {
    .c-price-copy {
      grid-column: 1 / span 6;
      align-self: start;
    }

    .c-plate {
      grid-column: 8 / -1;
    }
  }
</style>
