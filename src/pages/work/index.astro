---
/**
 * /work/ — SPEC §7. No published cases yet, so the page says so plainly:
 *   head (void)        WORK · "No borrowed logos." · lead
 *   founding (paper)   three founding-client places, open, + WhatsApp CTA
 *   cases (void)       only when a collection entry is confirmed: rows
 *   studies (void)     the five concept studies as a 3D gallery — each card
 *                      scroll-scrubbed in 3D, pointer-tilted, the 2016 site
 *                      swinging out from behind on hover; always labelled
 *                      fictional (label + each plate's .example domain)
 *
 * Gating: case studies render only with `confirmed: true` (client permission
 * + measured numbers, schema-enforced in content.config.ts).
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/work/PageHead.astro';
import CaseRow from '../../components/work/CaseRow.astro';
import ConceptPlate from '../../components/ConceptPlate.astro';
import SplitText from '../../components/ui/SplitText.astro';
import Expand from '../../components/ui/Expand.astro';
import Cosmos from '../../components/Cosmos.astro';
import { concepts } from '../../data/concepts';
import Arrow from '../../components/ui/Arrow.astro';
import WaGlyph from '../../components/ui/WaGlyph.astro';
import { TODO_SITE_CASES } from '../../components/work/verticals';
import { work, founding, wa } from '../../data/site';
import { url } from '../../lib/url';

const cases = (await getCollection('cases'))
  .filter((c) => c.data.confirmed)
  .sort((a, b) => b.data.launched.getTime() - a.data.launched.getTime());

/* CTA labels carry a trailing "→" in site.ts; the arrow is drawn as a hairline
   SVG so it can nudge on hover. */
const bare = (s: string) => s.replace(/\s*→\s*$/, '');
const slots = founding.slots.map((s) => ({
  n: String(s.n).padStart(2, '0'),
  status: s.status,
  label: founding.statusLabels[s.status],
}));
---

<Base title={work.seo.title} description={work.seo.description} canonical="/work/">
  <PageHead label={work.label.name} h1={work.h1} lead={work.lead} layout="split" />

  {/* ------------------------------------------------ founding clients */}
  <section class="s-paper section wf" data-nav-theme="light" aria-labelledby="wf-title">
    <div class="wrap g" data-scene="soft">
      <div class="wf-copy">
        <SplitText as="h2" id="wf-title" class="d2 wf-title" text={work.founding.title} />
        <div class="btn-row wf-cta" data-reveal style="--i:2">
          <a class="btn" href={wa(work.founding.cta.text)} target="_blank" rel="noopener" data-wa-intent="work-founding">
            <WaGlyph size={16} />
            <span>{bare(work.founding.cta.label)}</span>
            <Arrow />
          </a>
        </div>
        <Expand title={work.studies.foundingMore.title} keywords={work.studies.foundingMore.keys} i={3} class="wf-more">
          <p class="body wf-body">{founding.body}</p>
        </Expand>
      </div>

      <ol class="wf-slots">
        {
          slots.map((s, i) => (
            <li class={`wf-slot is-${s.status}`} data-inview style={`--r:${i}`}>
              <span class="wf-n n1" aria-hidden="true">
                <span class="wf-n-i">{s.n}</span>
              </span>
              <span class="wf-track" aria-hidden="true" />
              <span class="wf-state">
                <span class="visually-hidden">{s.n}: </span>
                <span class="node wf-node" aria-hidden="true" />
                <span class="label wf-label">{s.label}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --------------------------------------- confirmed client work (gated) */}
  {
    cases.length > 0 && (
      <section class="s-void section wk" data-nav-theme="dark" aria-labelledby="wk-title">
        <div class="wrap">
          <SplitText as="h2" id="wk-title" class="d2 wk-title" text={TODO_SITE_CASES.listTitle} />
          <ol class="wk-list">
            {cases.map((c, i) => (
              <CaseRow index={i} slug={c.id} data={c.data} />
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {/* --------------------------------------------- the five studies */}
  <section class="s-void section wg" data-nav-theme="dark" aria-labelledby="wg-title">
    <Cosmos variant="stars" />
    <div class="wrap g wg-grid">
      <div class="wg-head" data-scene="soft">
        <p class="label wg-label" data-reveal>
          <span class="stripe" aria-hidden="true"></span>
          <span>{work.studies.label}</span>
        </p>
        <SplitText as="h2" id="wg-title" class="d2 wg-title" text={work.studies.title} />
        <p class="body wg-lead" data-reveal style="--i:2">{work.studies.lead}</p>
      </div>

      <ol class="wg-list">
        {
          concepts.map((c, i) => (
            <li class:list={['wg-item', i % 2 ? 'wg-item--l' : 'wg-item--r']} data-wg style={`--side:${i % 2 ? -1 : 1}`}>
              <a class="wg-card" href={url(c.href)} data-reveal="fade">
                <span class="wg-stage" aria-hidden="true" data-tilt="6" data-wg-light>
                  <span class="wg-before">
                    <ConceptPlate concept={c.id} mode="static" state="before" bar={false} />
                    <span class="label wg-tag">{work.studies.before}</span>
                  </span>
                  <span class="wg-after">
                    <ConceptPlate concept={c.id} mode="static" />
                  </span>
                  <span class="wg-light" />
                </span>
                <span class="wg-meta">
                  <span class="wg-num" aria-hidden="true">{c.number}</span>
                  <span class="wg-txt">
                    <span class="label wg-niche">{c.label} · {c.niche}</span>
                    <span class="wg-name">{c.name}</span>
                    <span class="small wg-city">{c.city}</span>
                  </span>
                  <span class="tlink wg-go">
                    <span>{work.studies.open}</span>
                    <Arrow />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<script>
  import { addFrame, vestibular } from '../../scripts/motion';

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-wg]'));

  /* scroll-scrubbed 3D per card (one shared loop, transform-only) */
  if (items.length && !vestibular()) {
    const ps = new Array(items.length).fill(0);
    const last = new Array(items.length).fill(NaN);
    addFrame({
      read(_y, vh) {
        items.forEach((el, i) => {
          const r = el.getBoundingClientRect();
          const mid = r.top + r.height / 2;
          const p = (mid - vh / 2) / (vh * 0.9);
          ps[i] = Math.max(-1, Math.min(1, p));
        });
      },
      write() {
        items.forEach((el, i) => {
          const v = Math.round(ps[i] * 1000) / 1000;
          if (v === last[i]) return;
          last[i] = v;
          el.style.setProperty('--p', String(v));
          el.style.setProperty('--pa', String(Math.abs(v)));
        });
      },
    });
  }

  /* the pointer light inside each plate (fine pointers) */
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-wg-light]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--lx', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
        el.style.setProperty('--ly', `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
      });
    });
  }
</script>

<style>
  /* ============================================================ founding */

  .wf {
    row-gap: 0;
  }

  .wf-title {
    max-width: 12ch;
  }

  .wf-cta {
    margin-top: 40px;
  }

  /* The violet button paints its faceted fill on ::before. Repeat the fill
     on the element, clipped to the content box (clear of the cut corners and
     under ::before), so the contrast gate reads white on violet, not paper. */
  .wf-cta .btn {
    background-color: var(--btn-bg);
    background-clip: content-box;
  }

  .wf-slots {
    margin-top: 64px;
    border-bottom: 1px solid var(--line-strong);
  }

  .wf-slot {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 20px;
    padding-block: 20px;
  }

  /* the strong top hairline of each row draws from the left */
  .wf-slot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: var(--line-strong);
    transform-origin: left center;
    transition:
      transform 1000ms var(--ease-quint),
      opacity 200ms linear;
    transition-delay: calc(var(--r, 0) * 120ms);
  }

  .wf-n {
    display: inline-block;
    overflow: clip;
    /* Mona Sans' tabular figures carry a slashed zero that reads as
       monospace; ordinals don't need to align, so use the lining set */
    font-variant-numeric: lining-nums proportional-nums;
    padding-block: 0.08em;
    margin-block: -0.08em;
    color: var(--ink);
  }

  .wf-n-i {
    display: inline-block;
    transition:
      transform var(--t-mask) var(--ease-expo),
      opacity 300ms linear;
    transition-delay: calc(var(--r, 0) * 120ms + 100ms);
  }

  /* the track: a hairline from the numeral to the open node — an empty
     place, drawn to its end */
  .wf-track {
    height: 1px;
    background-color: var(--line);
    transform-origin: left center;
    transition:
      transform 1200ms var(--ease-quint),
      opacity 200ms linear;
    transition-delay: calc(var(--r, 0) * 120ms + 220ms);
  }

  .wf-state {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-2);
    transition:
      opacity 600ms linear,
      transform var(--t-reveal) var(--ease-expo);
    transition-delay: calc(var(--r, 0) * 120ms + 520ms);
  }

  .wf-node {
    color: var(--violet);
  }

  .wf-slot.is-taken .wf-node {
    background-color: var(--violet);
  }

  .wf-label {
    color: var(--ink);
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .wf-slot:not(.is-in)::before,
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .wf-slot:not(.is-in) .wf-track {
    transform: scaleX(0);
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .wf-slot:not(.is-in) .wf-n-i {
    transform: translate3d(0, 108%, 0);
    opacity: 0;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .wf-slot:not(.is-in) .wf-state {
    transform: translate3d(-8px, 0, 0);
    opacity: 0;
  }

  @media (min-width: 768px) {
    .wf-slot {
      column-gap: 32px;
      padding-block: 28px;
    }
  }

  @media (min-width: 1100px) {
    .wf-copy {
      grid-column: 1 / span 5;
    }

    .wf-slots {
      grid-column: 7 / -1;
      margin-top: 0;
      align-self: start;
    }

    .wf-slot {
      padding-block: 30px;
    }
  }

  .wf-copy :global(.wf-more) {
    margin-top: 48px;
    max-width: 32rem;
  }

  .wf-body {
    color: var(--ink-2);
    max-width: 44ch;
  }

  /* ========================================================= client work */

  .wk-list {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    border-bottom: 1px solid var(--line-strong);
  }

  /* ============================================================ studies */

  .wg {
    position: relative;
    overflow: clip;
    background-image: radial-gradient(40% 40% at 78% 18%, rgb(98 54 232 / 0.1), transparent 70%);
  }

  .wg-grid {
    position: relative;
    z-index: 1;
    row-gap: 0;
  }

  .wg-head {
    position: relative;
    z-index: 2;
  }

  .wg-label {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--lilac);
  }

  .wg-title {
    margin-top: 24px;
    max-width: 10ch;
  }

  .wg-lead {
    margin-top: 24px;
    color: var(--haze);
    max-width: 36ch;
  }

  /* --------------------------------------------------------- the list */
  .wg-list {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 2rem + 6vw, 7rem);
    margin-top: clamp(3.5rem, 2rem + 4vw, 5rem);
  }

  .wg-item {
    --p: 0;
    --pa: 0;
    position: relative;
    perspective: 1800px;
  }

  /* scroll-scrubbed 3D: the card turns toward the viewer as it reaches the
     middle of the screen and away as it leaves (motion.ts frame loop writes
     --p ∈ [-1, 1] and --pa = |p|; no JS = flat) */
  .wg-card {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--p) * -9deg)) rotateY(calc(var(--p) * var(--side) * 11deg))
      translate3d(0, 0, calc(var(--pa) * -160px));
    transform-origin: 50% 50%;
  }

  .wg-stage {
    position: relative;
    display: block;
    padding: 0 0 12% 10%;
  }

  .wg-after {
    position: relative;
    z-index: 2;
    display: block;
    transition: transform 900ms var(--ease-expo);
  }

  /* the 2016 site waits behind the rebuild, lower-left, and swings out */
  .wg-before {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    display: block;
    width: 44%;
    transform-origin: 100% 50%;
    transition: transform 1000ms var(--ease-expo);
  }

  .wg-tag {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 8px;
    color: var(--haze);
    background-color: var(--void);
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  /* a soft light that follows the pointer, inside the plate surface */
  .wg-light {
    position: absolute;
    z-index: 3;
    inset: 0 0 12% 10%;
    pointer-events: none;
    background-image: radial-gradient(360px circle at var(--lx, 50%) var(--ly, 30%), rgb(243 240 250 / 0.1), transparent 62%);
    opacity: 0;
    transition: opacity 500ms linear;
  }

  .wg-meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 20px;
    row-gap: 16px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line-dark);
  }

  .wg-num {
    color: var(--lilac);
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4.25rem);
    font-weight: 640;
    line-height: 0.82;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums proportional-nums;
  }

  .wg-txt {
    display: grid;
    gap: 8px;
  }

  .wg-niche {
    color: var(--lilac);
  }

  .wg-name {
    color: var(--starlight);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .wg-city {
    color: var(--haze);
  }

  .wg-go {
    grid-column: 2;
    justify-self: start;
    color: var(--starlight);
  }

  @media (hover: hover) and (pointer: fine) {
    .wg-card:hover .wg-after,
    .wg-card:focus-visible .wg-after {
      transform: translate3d(1.5%, -3%, 50px);
    }

    .wg-card:hover .wg-before,
    .wg-card:focus-visible .wg-before {
      transform: translate3d(-8%, -6%, -30px) rotateY(18deg) rotateZ(-2deg);
    }

    .wg-card:hover .wg-light {
      opacity: 1;
    }

    .wg-card:hover .wg-go::after {
      animation: underline-redraw 360ms var(--ease-quint) both;
    }

    .wg-card:hover .wg-go :global(.arrow) {
      transform: translateX(4px);
    }
  }

  @media (min-width: 768px) {
    .wg-head {
      grid-column: 1 / span 6;
    }

    .wg-item {
      width: 78%;
    }

    .wg-item--r {
      margin-left: auto;
    }

    .wg-meta {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 28px;
    }

    .wg-go {
      grid-column: 3;
      padding-bottom: 4px;
    }
  }

  @media (min-width: 1100px) {
    /* the head sits beside the first plate; the plates zigzag down */
    .wg-head {
      grid-column: 1 / span 4;
      grid-row: 1;
      align-self: start;
      padding-top: 40px;
    }

    .wg-list {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-top: 0;
      gap: 64px;
    }

    .wg-item {
      width: 60%;
    }

  }
</style>
