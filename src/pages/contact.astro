---
/**
 * /contact/ (SPEC §7 /contact/, SPEC_COSMOS; ROUND2 points 5 and 10; ROUND3
 * 3D and motion). No clocks, no QR.
 *
 * 1. Head (void, living star field): label, H1 (3D word flip on load), one
 *    line of lead. Two channels, equal weight:
 *    - WhatsApp: the faceted violet plate. It swings in out of depth on
 *      load, tilts toward the pointer (a soft light follows the pointer
 *      inside the plate), and a planet rides the hairline orbit in its
 *      corner. The number at N2, three quick-starts, "Copy number". The
 *      plate is the page's sticky-bar anchor.
 *    - Email: the address set large on its own line, flipping up from its
 *      baseline, with "Write an email" and "Copy address".
 * 2. Compose (paper): the message helper. Left, its title and "What to
 *    include" folded into an expandable box; right, the form. The preview
 *    flips when the message changes; the message opens in WhatsApp OR in the
 *    visitor's email app. Nothing is stored or sent by the page. Hidden
 *    without JS (the links above remain).
 * 3. Details (paper-2): LinkedIn, the time zone line, the company facts in a
 *    box, and "Or configure a build →".
 */
import Base from '../layouts/Base.astro';
import Cosmos from '../components/Cosmos.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import SplitText from '../components/ui/SplitText.astro';
import Expand from '../components/ui/Expand.astro';
import Arrow from '../components/ui/Arrow.astro';
import WaGlyph from '../components/ui/WaGlyph.astro';
import MailGlyph from '../components/ui/MailGlyph.astro';
import { brand, contact, contactPage, finale, mail, wa, type HelperNeed } from '../data/site';
import { url, absolute } from '../lib/url';

/* ---- typesetting helpers (the words are unchanged) --------------------- */
const WJ = String.fromCharCode(0x2060);
const keepRange = (s: string) => s.replace(/(\w)–(\w)/g, `$1${WJ}–${WJ}$2`);

/* ---- the number: country + area code set small, the line at N2 -------- */
const numParts = contactPage.panel.number.match(/^(\+\d+\s\d+)\s(.+)$/);
const [cc, local] = numParts ? [numParts[1], numParts[2]] : ['', contactPage.panel.number];
const copyNumber = `+${contact.whatsapp.e164}`;

/* ---- the address: may break before the @ on the narrowest phones ------- */
const address = contact.email.address;
const [mailUser, mailHost] = address.includes('@') ? [address.slice(0, address.indexOf('@')), address.slice(address.indexOf('@'))] : [address, ''];
const mailHref = mail(contact.email.subject);

/* ---- the helper's message template -------------------------------------
   The message wording lives in site.ts (contactPage.helper.message). To keep
   that one source without shipping site.ts to the browser, the template is
   derived here: the function runs with private-use sentinels in place of the
   visitor's words, and with empty fields to learn its defaults ("not
   given", "none"). The browser only substitutes. */
const SENT = { business: String.fromCharCode(0xe000), currentUrl: String.fromCharCode(0xe001), extra: String.fromCharCode(0xe002) };
const msg = contactPage.helper.message;
const needs = contactPage.helper.fields.need.options.map((o) => o.id) as HelperNeed[];
const withExtra = Object.fromEntries(needs.map((need) => [need, msg({ ...SENT, need })]));
const noExtra = Object.fromEntries(needs.map((need) => [need, msg({ ...SENT, need, extra: '' })]));
/** the text the function puts where an empty field would go */
const defaultFor = (field: 'business' | 'currentUrl') => {
  const tpl = noExtra[needs[0]];
  const filled = msg({ ...SENT, [field]: '', need: needs[0], extra: '' });
  const at = tpl.indexOf(SENT[field]);
  if (at < 0) return '';
  const tail = tpl.length - at - 1;
  return filled.slice(at, filled.length - tail);
};
const helperTpl = JSON.stringify({
  sent: SENT,
  withExtra,
  noExtra,
  defaults: { business: defaultFor('business'), currentUrl: defaultFor('currentUrl') },
});
const firstNeed = needs[0];
const initialMessage = msg({ business: '', currentUrl: '', need: firstNeed, extra: '' });

const linkedinText = contactPage.linkedin.label;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: contactPage.seo.title,
  url: absolute('/contact/', Astro.site),
  description: contactPage.seo.description,
  about: { '@id': `${absolute('/', Astro.site).replace(/\/$/, '')}/#organization` },
};
---

<Base title={contactPage.seo.title} description={contactPage.seo.description} canonical="/contact/" jsonLd={jsonLd}>
  {/* ----------------------------------------------------------------- head */}
  <section class="head s-void" data-nav-theme="dark" aria-labelledby="contact-title">
    <div class="sky" aria-hidden="true"><Cosmos variant="stars" /></div>

    <div class="wrap g head-grid">
      <header class="head-copy">
        <div data-load>
          <SectionLabel name={contactPage.label.name} reveal={false} />
        </div>
        <SplitText as="h1" id="contact-title" class="h1" text={contactPage.h1} load delay={80} />
        <p class="lead head-lead" data-load style="--d:420ms">{keepRange(contactPage.lead)}</p>
      </header>

      {
        contact.whatsapp.confirmed && (
          <div class="panel-in" data-sticky-anchor data-contact-panel>
            <div class="panel" data-tilt="3" data-light>
              <div class="panel-fx" aria-hidden="true">
                <svg class="panel-orbit" viewBox="0 0 400 300" preserveAspectRatio="xMaxYMin slice" focusable="false" data-loop>
                  <g transform="translate(330 40) rotate(-24)">
                    <ellipse rx="190" ry="72" />
                    <g class="p-orb-x">
                      <g class="p-orb-y">
                        <circle r="3" />
                      </g>
                    </g>
                  </g>
                </svg>
                <span class="panel-light"></span>
              </div>

              <p class="panel-label label">
                <WaGlyph size={16} />
                <span>{contactPage.panel.label}</span>
              </p>

              <p class="panel-number">
                <a class="n2 number" href={contact.whatsapp.url} target="_blank" rel="noopener" data-wa-intent="contact-number" id="wa-number">
                  {cc && <span class="cc">{cc}</span>}
                  {cc && ' '}
                  <span class="local">{local}</span>
                </a>
              </p>
              <p class="small panel-note">{finale.reassurance}</p>

              <ul class="quick">
                {
                  contactPage.panel.quickStarts.map((q, k) => (
                    <li class="q-cell" style={`--k:${k}`}>
                      <a class="btn btn-star q" href={wa(q.text)} target="_blank" rel="noopener" data-wa-intent={`contact-${q.id}`}>
                        <span class="q-lbl">{q.label}</span>
                        <Arrow />
                      </a>
                    </li>
                  ))
                }
              </ul>

              <p class="panel-copy">
                <button
                  type="button"
                  class="copy"
                  data-copy={copyNumber}
                  data-copy-target="wa-number"
                  data-copied={finale.number.copied}
                  data-copied-ms={finale.number.copiedMs}
                >
                  <span class="copy-text">
                    <span class="copy-label" data-copy-label>{finale.number.copy}</span>
                    <span class="copy-sizer" aria-hidden="true">{finale.number.copy}</span>
                  </span>
                </button>
                <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
              </p>
            </div>
          </div>
        )
      }

      {
        contact.email.confirmed && (
          <div class="mailline">
            <p class="label ml-k" data-load style="--d:560ms">
              <MailGlyph size={16} />
              <span>{contactPage.email.label}</span>
              <span class="ml-rule" aria-hidden="true" />
            </p>
            <p class="ml-addr-row">
              <a class="ml-addr" href={mailHref} data-mail-intent="contact-address" id="mail-address">
                <span class="ml-user">{mailUser}</span>
                <wbr />
                <span class="ml-host">{mailHost}</span>
              </a>
            </p>
            <p class="ml-acts" data-load style="--d:900ms">
              <a class="tlink" href={mailHref} data-mail-intent="contact-write">
                <span>{contactPage.email.write}</span>
                <Arrow />
              </a>
              <button
                type="button"
                class="copy"
                data-copy={address}
                data-copy-target="mail-address"
                data-copied={contactPage.email.copied}
                data-copied-ms={finale.number.copiedMs}
              >
                <span class="copy-text">
                  <span class="copy-label" data-copy-label>{contactPage.email.copy}</span>
                  <span class="copy-sizer" aria-hidden="true">{contactPage.email.copy}</span>
                </span>
              </button>
              <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
            </p>
          </div>
        )
      }
    </div>
  </section>

  {/* -------------------------------------------------------------- compose */}
  <section class="compose s-paper section" data-nav-theme="light" aria-labelledby="helper-title">
    <div class="wrap g compose-grid" data-scene>
      <div class="compose-head">
        <SplitText as="h2" id="helper-title" class="d2 helper-title" text={contactPage.helper.title} />
        <div class="include">
          <Expand title={contactPage.include.title} keywords={contactPage.more.include.keywords} index="01" i={1}>
            <ol class="inc-list">
              {
                contactPage.include.items.map((it) => (
                  <li class="inc-row">
                    <span class="label inc-n" aria-hidden="true">{it.index}</span>
                    <span class="inc-text">{it.text}</span>
                  </li>
                ))
              }
            </ol>
          </Expand>
        </div>
      </div>

      <div class="helper" hidden data-helper data-sticky-hide data-tpl={helperTpl}>
        <form class="form" data-helper-form novalidate autocomplete="off">
          <div class="field" data-reveal style="--i:1">
            <label class="label f-label" for="h-business">{contactPage.helper.fields.business.label}</label>
            <input class="input" id="h-business" name="business" type="text" autocomplete="organization" maxlength="120" />
          </div>
          <div class="field" data-reveal style="--i:2">
            <label class="label f-label" for="h-url">{contactPage.helper.fields.currentUrl.label}</label>
            <input
              class="input"
              id="h-url"
              name="currentUrl"
              type="text"
              inputmode="url"
              autocapitalize="off"
              spellcheck="false"
              maxlength="200"
              placeholder={contactPage.helper.fields.currentUrl.placeholder}
            />
          </div>
          <fieldset class="field needs" data-reveal style="--i:3">
            <legend class="label f-label">{contactPage.helper.fields.need.legend}</legend>
            <div class="chips">
              {
                contactPage.helper.fields.need.options.map((o, k) => (
                  <label class="chip">
                    <input class="visually-hidden" type="radio" name="need" value={o.id} checked={k === 0} />
                    <span class="chip-face">
                      <span class="chip-node" aria-hidden="true" />
                      <span class="chip-text">{o.label}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="field" data-reveal style="--i:4">
            <label class="label f-label" for="h-extra">{contactPage.helper.fields.extra.label}</label>
            <textarea class="input area" id="h-extra" name="extra" rows="3" maxlength="600"></textarea>
          </div>
        </form>
      </div>

      <div class="outbox" hidden data-outbox data-sticky-hide>
        <div class="preview-wrap" data-reveal style="--i:5">
          <div class="preview" data-helper-card data-tilt="4">
            <p class="label preview-label" id="h-preview-label">{contactPage.helper.preview}</p>
            <p class="preview-text" data-helper-preview aria-labelledby="h-preview-label">{initialMessage}</p>
          </div>
        </div>

        <div class="send" data-reveal style="--i:6">
          <div class="send-btns">
            <a class="btn send-btn" href={wa(initialMessage)} target="_blank" rel="noopener" data-wa-intent="contact-helper" data-helper-send data-magnetic=".18">
              <WaGlyph size={16} />
              <span class="b-lbl">{contactPage.helper.button}</span>
              <Arrow />
            </a>
            {
              contact.email.confirmed && (
                <a
                  class="btn btn-line send-mail"
                  href={mail(contact.email.subject, initialMessage)}
                  data-mail-intent="contact-helper"
                  data-helper-mail
                  data-subject={contact.email.subject}
                  data-magnetic=".18"
                >
                  <MailGlyph size={16} />
                  <span>{contactPage.helper.emailButton}</span>
                  <Arrow />
                </a>
              )
            }
          </div>
          <p class="small send-note">{contactPage.helper.note}</p>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- details */}
  <section class="details s-paper-2 section" data-nav-theme="light" aria-label={contactPage.company.title}>
    <div class="wrap g details-grid" data-scene="soft">
      {
        contact.linkedin.confirmed && (
          <div class="d-block d-li">
            <h2 class="label d-title" data-reveal>{contactPage.linkedin.title}</h2>
            <span class="rule d-rule" data-reveal="draw" aria-hidden="true" />
            <p class="d-text" data-reveal style="--i:1">
              <a class="tlink li" href={contactPage.linkedin.href} target="_blank" rel="noopener">
                <span>{linkedinText}</span>
                <Arrow dir="up-right" />
              </a>
            </p>
          </div>
        )
      }

      <div class="d-block d-hours">
        <h2 class="label d-title" data-reveal>{contactPage.hours.title}</h2>
        <span class="rule d-rule" data-reveal="draw" style="--d:90ms" aria-hidden="true" />
        <p class="d-text d-hours-text" data-reveal style="--i:1">{keepRange(contactPage.hours.text)}</p>
        <p class="small d-hours-offset" data-reveal style="--i:2">{keepRange(contactPage.hours.offset)}</p>
      </div>

      <div class="d-block d-company">
        <h2 class="label d-title" data-reveal>{contactPage.company.title}</h2>
        <span class="rule d-rule" data-reveal="draw" style="--d:180ms" aria-hidden="true" />
        <Expand title={brand.legalName} keywords={contactPage.more.company.keywords} i={2}>
          <dl class="d-table">
            {
              contactPage.company.rows.filter((row) => row.value !== brand.legalName).map((row) => (
                <div class="d-row">
                  <dt class="small">{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </Expand>
      </div>

      <p class="configure" data-reveal>
        <a class="conf-link" href={url(contactPage.configureLink.href)}>
          <span class="conf-text">{contactPage.configureLink.label.replace(/\s*→\s*$/, '')}</span>
          <span class="conf-arrow" data-magnetic=".35"><Arrow size={22} /></span>
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* =====================================================================
     1. head: the two channels
     ===================================================================== */
  .head {
    position: relative;
    overflow: clip;
    padding-block: calc(var(--nav-h) + clamp(3rem, 1.6rem + 5.4vw, 7rem)) clamp(4.5rem, 3rem + 5vw, 8.5rem);
  }

  .sky {
    position: absolute;
    inset: 0;
  }

  .head-grid {
    position: relative;
    z-index: 1;
    align-items: start;
  }

  .h1 {
    max-width: 10.5ch;
    margin-top: 28px;
    font-size: clamp(2.5rem, 1.1rem + 5vw, 5.5rem);
    line-height: 0.98;
  }

  .head-lead {
    max-width: 32ch;
    margin-top: 32px;
    color: var(--haze);
  }

  /* ---- the WhatsApp plate: swings in out of depth, then tilts ---- */
  .panel-in {
    position: relative;
    margin-top: 48px;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .panel-in {
    animation: plate-in 1700ms var(--ease-expo) 380ms both;
  }

  @keyframes plate-in {
    from {
      opacity: 0;
      transform: perspective(1600px) translate3d(80px, 40px, -260px) rotateY(-30deg) rotateX(10deg);
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .panel {
    --pcut: 18px;
    position: relative;
    isolation: isolate;
    padding: 28px 20px 20px;
    color: var(--starlight);
  }

  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: var(--violet);
    clip-path: polygon(var(--pcut) 0, 100% 0, 100% calc(100% - var(--pcut)), calc(100% - var(--pcut)) 100%, 0 100%, 0 var(--pcut));
  }

  /* orbit + pointer light live inside the facet */
  .panel-fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    clip-path: polygon(var(--pcut) 0, 100% 0, 100% calc(100% - var(--pcut)), calc(100% - var(--pcut)) 100%, 0 100%, 0 var(--pcut));
  }

  .panel-orbit {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .panel-orbit ellipse {
    fill: none;
    stroke: rgb(243 240 250 / 0.3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .panel-orbit circle {
    fill: var(--starlight);
  }

  /* the planet rides the ellipse: x and y run a quarter lap apart */
  .p-orb-x {
    transform: translateX(190px);
  }

  .p-orb-y {
    transform: translateY(0);
  }

  .panel-orbit {
    --lap: 13s;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .panel-orbit .p-orb-x {
    animation: p-orb-x var(--lap) cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
  }

  :global(html.js:not(.motion-reduced):not(.motion-failed)) .panel-orbit .p-orb-y {
    animation: p-orb-y var(--lap) cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
    animation-delay: calc(var(--lap) / -2);
  }

  .panel-orbit.is-paused .p-orb-x,
  .panel-orbit.is-paused .p-orb-y {
    animation-play-state: paused;
  }

  @keyframes p-orb-x {
    from {
      transform: translateX(190px);
    }
    to {
      transform: translateX(-190px);
    }
  }

  @keyframes p-orb-y {
    from {
      transform: translateY(-72px);
    }
    to {
      transform: translateY(72px);
    }
  }

  .panel-light {
    position: absolute;
    inset: -50%;
    background: radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0) 30%);
    opacity: 0;
    transform: translate3d(calc((var(--lx, 0.5) - 0.5) * 50%), calc((var(--ly, 0.5) - 0.5) * 50%), 0);
    transition: opacity 600ms var(--ease-expo);
  }

  .panel.is-lit .panel-light {
    opacity: 1;
  }

  .panel-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--starlight);
  }

  .panel-number {
    margin-top: 20px;
  }

  /* country + area code as a quiet line above; the local number at N2 in
     proportional figures (tabular zeros read as monospace at this size) */
  .number {
    display: inline-grid;
    justify-items: start;
    row-gap: 10px;
    color: var(--white);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: normal;
  }

  .cc {
    font-size: max(0.8125rem, 0.3em);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--starlight);
  }

  .local {
    letter-spacing: -0.025em;
  }

  @media (hover: hover) and (pointer: fine) {
    .number .local {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.14em;
      text-decoration-color: transparent;
      transition: text-decoration-color var(--t-micro) linear;
    }

    .number:hover .local {
      text-decoration-color: rgb(255 255 255 / 0.6);
    }
  }

  .panel-note {
    max-width: 34ch;
    margin-top: 14px;
    color: var(--starlight);
  }

  .quick {
    display: grid;
    gap: 8px;
    margin-top: 28px;
  }

  /* the quick-starts deal in after the plate lands, each from a little
     deeper than the last */
  :global(html.js:not(.motion-reduced):not(.motion-failed)) .q-cell {
    animation: q-in 1100ms var(--ease-expo) both;
    animation-delay: calc(1100ms + var(--k, 0) * 110ms);
  }

  @keyframes q-in {
    from {
      opacity: 0;
      transform: perspective(900px) translate3d(0, 18px, -60px) rotateX(-24deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .q {
    display: flex;
    width: 100%;
    min-height: 56px;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    white-space: normal;
    text-align: left;
    line-height: 1.25;
  }

  /* the label carries the fill as its own background too, so the contrast
     gate reads ink on starlight (the plate itself is painted by ::before) */
  .q-lbl {
    background-color: var(--starlight);
    transition: background-color var(--t-micro) linear;
  }

  @media (hover: hover) and (pointer: fine) {
    .q:hover .q-lbl {
      background-color: var(--white);
    }
  }

  .q:focus-visible .q-lbl {
    background-color: var(--white);
  }

  .q:focus-visible {
    outline-color: var(--starlight);
  }

  .panel-copy {
    margin-top: 16px;
  }

  /* ---- copy buttons (plate and email line) ---- */
  .copy {
    position: relative;
    padding: 8px 0;
    color: var(--starlight);
    font-stretch: var(--wd-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .copy::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background-color: currentColor;
    transform-origin: left center;
  }

  .copy-text {
    display: grid;
    perspective: 400px;
  }

  .copy-text > * {
    grid-area: 1 / 1;
  }

  .copy-sizer {
    visibility: hidden;
  }

  /* "Copied" flips in on its baseline */
  .copy-label {
    display: block;
    transform-origin: 50% 100%;
  }

  .copy.is-done .copy-label {
    animation: copy-flip 520ms var(--ease-expo) both;
  }

  @keyframes copy-flip {
    from {
      opacity: 0;
      transform: rotateX(-80deg) translate3d(0, 6px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .copy:focus-visible {
    outline-color: var(--starlight);
  }

  /* copying needs the script: without it the buttons are not offered */
  :global(html:not(.js)) .copy {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover::after {
      animation: underline-redraw 360ms var(--ease-quint) both;
    }
  }

  /* ---- the email line: the address as large as the number ---- */
  .mailline {
    margin-top: 56px;
  }

  .ml-k {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--haze);
  }

  .ml-rule {
    flex: 1 1 auto;
    height: 1px;
    margin-left: 6px;
