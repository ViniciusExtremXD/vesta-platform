  .preview-wrap::before,
  .preview-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--line-strong);
    background-color: var(--paper);
    pointer-events: none;
    transition: transform 900ms var(--ease-expo);
