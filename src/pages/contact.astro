<script>
  /* ---- copy number (panel) ---------------------------------------------- */
  const panel = document.querySelector<HTMLElement>('[data-contact-panel]');
  const copyBtn = panel?.querySelector<HTMLButtonElement>('[data-copy]');
  const copyLabel = copyBtn?.querySelector<HTMLElement>('[data-copy-label]');
  const copyStatus = panel?.querySelector<HTMLElement>('[data-copy-status]');

  if (copyBtn && copyLabel) {
    const idle = copyLabel.textContent ?? '';
    const done = copyBtn.dataset.copied || 'Copied';
    const ms = Number(copyBtn.dataset.copiedMs) || 1600;
    let timer = 0;
    copyBtn.addEventListener('click', async () => {
      const value = copyBtn.dataset.copy || '';
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          ok = true;
        }
      } catch {
        ok = false;
      }
      if (!ok) {
        /* fallback: select the number so the visitor can copy it by hand */
        const num = panel?.querySelector('.number');
        const sel = window.getSelection();
        if (num && sel) {
          const range = document.createRange();
          range.selectNodeContents(num);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        return;
      }
      copyLabel.textContent = done;
      if (copyStatus) copyStatus.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copyLabel.textContent = idle;
        if (copyStatus) copyStatus.textContent = '';
      }, ms);
    });
  }

  /* ---- message helper ----------------------------------------------------
     Runs entirely in the browser: reads the fields, fills the template that
     site.ts produced at build time, shows the exact message and points the
     button at WhatsApp with it. Nothing is stored or sent anywhere. */
  interface Tpl {
    sent: { business: string; currentUrl: string; extra: string };
    withExtra: Record<string, string>;
    noExtra: Record<string, string>;
    defaults: { business: string; currentUrl: string };
  }

  const helper = document.querySelector<HTMLElement>('[data-helper]');
  const form = helper?.querySelector<HTMLFormElement>('[data-helper-form]');
  const preview = helper?.querySelector<HTMLElement>('[data-helper-preview]');
  const send = helper?.querySelector<HTMLAnchorElement>('[data-helper-send]');

  if (helper && form && preview && send) {
    let tpl: Tpl | null = null;
    try {
      tpl = JSON.parse(helper.dataset.tpl || 'null') as Tpl;
    } catch {
      tpl = null;
    }
    const base = send.href.split('?')[0];

    if (tpl) {
      const t = tpl;
      const field = (name: string) => {
        const el = form.elements.namedItem(name);
        return el && 'value' in el ? String((el as HTMLInputElement).value).trim() : '';
      };
      const compose = () => {
        const need = (form.querySelector<HTMLInputElement>('input[name="need"]:checked')?.value || Object.keys(t.noExtra)[0]) as string;
        const extra = field('extra').replace(/\s*\n\s*/g, ' ');
        const source = extra ? t.withExtra[need] : t.noExtra[need];
        if (!source) return '';
        return source
          .split(t.sent.business)
          .join(field('business').replace(/\s+/g, ' ') || t.defaults.business)
          .split(t.sent.currentUrl)
          .join(field('currentUrl').replace(/\s+/g, '') || t.defaults.currentUrl)
          .split(t.sent.extra)
          .join(extra);
      };
      const sync = () => {
        const text = compose();
        if (!text) return;
        preview.textContent = text;
        send.href = `${base}?text=${encodeURIComponent(text)}`;
      };

      form.addEventListener('input', sync);
      form.addEventListener('change', sync);
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        sync();
        send.click();
      });
      /* fields restored by back/forward navigation */
      window.addEventListener('pageshow', sync);
      sync();
      helper.hidden = false;
    }
  }
</script>
