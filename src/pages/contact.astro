</style>

<script>
  import { isReduced } from '../scripts/motion';

  /* ---- copy buttons (number, address) ------------------------------------ */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    if (!label) return;
    const idle = label.textContent ?? '';
    const done = btn.dataset.copied || 'Copied';
    const ms = Number(btn.dataset.copiedMs) || 1600;
    let timer = 0;
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy || '';
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
          ok = true;
        }
      } catch {
        ok = false;
      }
      if (!ok) {
        /* fallback: select the value so the visitor can copy it by hand */
        const target = btn.dataset.copyTarget ? document.getElementById(btn.dataset.copyTarget) : null;
        const sel = window.getSelection();
        if (target && sel) {
          const range = document.createRange();
          range.selectNodeContents(target);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        return;
      }
      label.textContent = done;
      btn.classList.remove('is-done');
      void btn.offsetWidth;
      btn.classList.add('is-done');
      if (status) status.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = idle;
        btn.classList.remove('is-done');
        if (status) status.textContent = '';
      }, ms);
    });
  });

  /* ---- the plate: pointer light (fine pointers) + orbit paused offscreen - */
  const plate = document.querySelector<HTMLElement>('[data-contact-panel] [data-light]');
  if (plate && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    plate.addEventListener('pointermove', (e) => {
      if (isReduced()) return;
      const r = plate.getBoundingClientRect();
      plate.style.setProperty('--lx', ((e.clientX - r.left) / r.width).toFixed(3));
      plate.style.setProperty('--ly', ((e.clientY - r.top) / r.height).toFixed(3));
      plate.classList.add('is-lit');
    });
    plate.addEventListener('pointerleave', () => plate.classList.remove('is-lit'));
  }

  const loop = document.querySelector<SVGElement>('[data-loop]');
  if (loop) {
    let inView = true;
    const sync = () => loop.classList.toggle('is-paused', !inView || document.hidden);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        inView = entries.some((e) => e.isIntersecting);
        sync();
      }).observe(loop);
    }
    document.addEventListener('visibilitychange', sync);
  }

  /* ---- message helper ----------------------------------------------------
     Runs entirely in the browser: reads the fields, fills the template that
     site.ts produced at build time, shows the exact message and points both
     buttons (WhatsApp, email) at it. Nothing is stored or sent anywhere. */
  interface Tpl {
    sent: { business: string; currentUrl: string; extra: string };
    withExtra: Record<string, string>;
    noExtra: Record<string, string>;
    defaults: { business: string; currentUrl: string };
  }

  const helper = document.querySelector<HTMLElement>('[data-helper]');
  const form = helper?.querySelector<HTMLFormElement>('[data-helper-form]');
  const preview = document.querySelector<HTMLElement>('[data-helper-preview]');
  const outbox = document.querySelector<HTMLElement>('[data-outbox]');
  const card = outbox?.querySelector<HTMLElement>('[data-helper-card]');
  const send = outbox?.querySelector<HTMLAnchorElement>('[data-helper-send]');
  const mailBtn = outbox?.querySelector<HTMLAnchorElement>('[data-helper-mail]');

  if (helper && form && preview && send) {
    let tpl: Tpl | null = null;
    try {
      tpl = JSON.parse(helper.dataset.tpl || 'null') as Tpl;
    } catch {
      tpl = null;
    }
    const base = send.href.split('?')[0];
    const mailBase = mailBtn ? mailBtn.href.split('?')[0] : '';
    const subject = mailBtn?.dataset.subject || '';

    if (tpl) {
      const t = tpl;
      const field = (name: string) => {
        const el = form.elements.namedItem(name);
        return el && 'value' in el ? String((el as HTMLInputElement).value).trim() : '';
      };
      const compose = () => {
        const need = (form.querySelector<HTMLInputElement>('input[name="need"]:checked')?.value || Object.keys(t.noExtra)[0]) as string;
        const extra = field('extra').replace(/\s*\n\s*/g, ' ');
        const source = extra ? t.withExtra[need] : t.noExtra[need];
        if (!source) return '';
        return source
          .split(t.sent.business)
          .join(field('business').replace(/\s+/g, ' ') || t.defaults.business)
          .split(t.sent.currentUrl)
          .join(field('currentUrl').replace(/\s+/g, '') || t.defaults.currentUrl)
          .split(t.sent.extra)
          .join(extra);
      };
      const sync = (flip = false) => {
        const text = compose();
        if (!text) return;
        preview.textContent = text;
        send.href = `${base}?text=${encodeURIComponent(text)}`;
        if (mailBtn) mailBtn.href = `${mailBase}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
        if (flip && card && !isReduced()) {
          const stack = card.parentElement;
          card.classList.remove('is-flip');
          stack?.classList.remove('is-shuffle');
          void card.offsetWidth;
          card.classList.add('is-flip');
          stack?.classList.add('is-shuffle');
        }
      };

      form.addEventListener('input', () => sync(false));
      /* a new choice of need turns the card over; typing just updates it */
      form.addEventListener('change', (e) => sync((e.target as HTMLInputElement | null)?.name === 'need'));
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        sync();
        send.click();
      });
      /* fields restored by back/forward navigation */
      window.addEventListener('pageshow', () => sync());
      sync();
      helper.hidden = false;
      if (outbox) outbox.hidden = false;
    }
  }
</script>
