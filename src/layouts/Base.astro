---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { brand, contact, founder, tracking } from '../data/site';
import type { Link, PageCta } from '../data/site';
import { url, absolute } from '../lib/url';

export interface Props {
  /** Becomes the <title>. Required, unique per page. */
  title: string;
  /** Meta description. Required, never equal to the title. */
  description: string;
  /** Canonical path, with trailing slash. */
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD beyond Organization/WebSite/Person. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  /** Lab pages: render the slot without nav, footer and sticky bar. */
  bare?: boolean;
  /** Page-level action for the nav button, mobile menu and sticky bar.
      Defaults to the Azure practice; /websites/ passes the studio's. */
  cta?: Link & PageCta;
  /** Element id the first render waits for (rel=expect), so a page
      transition finds it parsed: the home page's doors, an inner page's
      head (#page-head). */
  expect?: string;
}

const { title, description, canonical, ogImage, ogType = 'website', noindex = false, jsonLd, bodyClass = '', bare = false, cta, expect } = Astro.props;

const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = canonical ?? (Astro.url.pathname.replace(basePrefix, '') || '/');
const canonicalUrl = absolute(path, Astro.site);
const ogImageUrl = absolute(ogImage ?? '/og/default.png', Astro.site);
const siteUrl = Astro.site ? Astro.site.origin + (basePrefix || '') : 'https://vesta-consult.com.br';

const sameAs = [contact.linkedin.confirmed ? contact.linkedin.url : null].filter(Boolean);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteUrl}/#organization`,
  name: brand.name,
  legalName: brand.legalName,
  url: siteUrl,
  logo: absolute('/og/logo.png', Astro.site),
  description: brand.description,
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
  areaServed: [{ '@type': 'Country', name: 'United States' }, { '@type': 'Place', name: 'Worldwide' }],
  founder: { '@id': `${siteUrl}/#founder` },
  sameAs,
  knowsAbout: founder.knowsAbout,
  ...(brand.schema.priceRange ? { priceRange: brand.schema.priceRange } : {}),
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#founder`,
  name: founder.name,
  jobTitle: `${founder.role}, ${founder.title}`,
  knowsAbout: founder.knowsAbout,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Mackenzie Presbyterian University' },
  worksFor: { '@id': `${siteUrl}/#organization` },
  sameAs,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: brand.name,
  inLanguage: 'en-US',
  publisher: { '@id': `${siteUrl}/#organization` },
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/*
      Before first paint:
      1. mark html.js — the armed (hidden) reveal states only exist under it,
         so with JavaScript off the page renders complete;
      2. clear any old motion opt-out (motion is always on);
      3. if the engine hasn't reported in within 4 s, html.motion-failed
         reveals everything. Invisible content is the one unacceptable defect.
    */}
    <script is:inline>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        // Motion is always on (owner's decision); drop any old saved opt-out.
        try {
          localStorage.removeItem('vesta-motion');
        } catch (e) {}
        window.setTimeout(function () {
          if (!window.__vestaMotionReady) h.classList.add('motion-failed');
        }, 4000);
      })();
    </script>

    {/*
      Page transitions (see global.css §11). Registered before first render:
      pagereveal only reaches listeners that exist by then.
      - direction: a traverse compares history indexes; anything else
        compares path depth (/ < /azure/ < /work/concept-01/), so going home
        by the logo also reads as coming back. html[data-vt] carries it.
      - the door ↔ head morph: leaving the home page for a door's page names
        that door "page-head" (pageswap); arriving back home from it names
        the door again (pagereveal). Only a door on screen is named, and the
        page's own head gives the name up meanwhile (names must be unique).
    */}
    <script is:inline define:vars={{ vtBase: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
      (function () {
        var NAME = 'page-head';
        var root = document.documentElement;
        function path(u) {
          var p = new URL(u, location.href).pathname;
          if (vtBase && p.indexOf(vtBase) === 0) p = p.slice(vtBase.length) || '/';
          return p;
        }
        function depth(u) {
          return path(u).split('/').filter(Boolean).length;
        }
        function onScreen(el) {
          var r = el.getBoundingClientRect();
          return r.width > 0 && r.bottom > 0 && r.top < innerHeight;
        }
        function doorFor(u) {
          var want = path(u);
          var list = document.querySelectorAll('[data-door]');
          for (var i = 0; i < list.length; i++) {
            if (path(list[i].href) === want && onScreen(list[i])) return list[i];
          }
          return null;
        }
        function clear() {
          var named = document.querySelectorAll('[data-door], [data-vt-head]');
          for (var i = 0; i < named.length; i++) named[i].style.viewTransitionName = '';
        }
        function name(door, vt) {
          clear();
          var heads = document.querySelectorAll('[data-vt-head]');
          for (var i = 0; i < heads.length; i++) heads[i].style.viewTransitionName = 'none';
          door.style.viewTransitionName = NAME;
          if (vt && vt.finished) vt.finished.then(clear, clear);
        }
        addEventListener('pageswap', function (e) {
          if (!e.viewTransition) return;
          var to = e.activation && e.activation.entry && e.activation.entry.url;
          var door = to && doorFor(to);
          if (door) name(door, e.viewTransition);
        });
        addEventListener('pagereveal', function (e) {
          // also a bfcache restore: drop the name pageswap left on the way out
          clear();
          var vt = e.viewTransition;
          if (!vt) return;
          var act = window.navigation && window.navigation.activation;
          var from = act && act.from ? act.from.url : document.referrer;
          var dir = 'forward';
          if (act && act.navigationType === 'traverse' && act.from && act.entry && act.from.index !== act.entry.index) {
            dir = act.entry.index < act.from.index ? 'back' : 'forward';
          } else if (from) {
            try {
              if (new URL(from).origin === location.origin && depth(location.href) < depth(from)) dir = 'back';
            } catch (err) {}
          }
          root.setAttribute('data-vt', dir);
          try {
            if (vt.types) vt.types.add(dir);
          } catch (err) {}
          var door = from && doorFor(from);
          if (door) name(door, vt);
          vt.finished.then(
            function () { root.removeAttribute('data-vt'); },
            function () { root.removeAttribute('data-vt'); }
          );
        });
      })();
    </script>

    <title>{title}</title>
    {expect && <link rel="expect" href={`#${expect}`} {...{ blocking: 'render' }} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#08070d" />
    <link rel="icon" href={url('/favicon-48.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <Font cssVariable="--font-sans" preload />

    {tracking.searchConsoleToken && <meta name="google-site-verification" content={tracking.searchConsoleToken} />}
    {
      /* Google Tag Manager — loads after the page's own script, never blocks
         the first paint. Conversion events come from scripts/track.ts. */
      tracking.gtmId && (
        <script is:inline define:vars={{ id: tracking.gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', id);
        </script>
      )
    }

    <script is:inline set:html={JSON.stringify(organization)} type="application/ld+json" />
    <script is:inline set:html={JSON.stringify(person)} type="application/ld+json" />
    <script is:inline set:html={JSON.stringify(website)} type="application/ld+json" />
    {extraLd.map((ld) => <script is:inline set:html={JSON.stringify(ld)} type="application/ld+json" />)}
  </head>

  <body class={bodyClass}>
    {
      tracking.gtmId && (
        <noscript>
          <iframe src={`https://www.googletagmanager.com/ns.html?id=${tracking.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" />
        </noscript>
      )
    }
    {
      !bare && (
        <Fragment>
          <a class="skip-link" href="#content">Skip to content</a>
          <div class="progress" data-progress aria-hidden="true">
            <div class="progress-bar" />
          </div>
          <Nav cta={cta} />
        </Fragment>
      )
    }

    <main id="content">
      <slot />
    </main>

    {
      !bare && (
        <Fragment>
          <Footer />
          <StickyBar cta={cta} />
        </Fragment>
      )
    }

    <script>
      import '../scripts/motion';
      import '../scripts/track';
    </script>
  </body>
</html>
